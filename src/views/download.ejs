<!--
  Download landing — App Store + Android APK + open in browser.
  Linked from the footer, the main landing hero, and external Gitee /
  GitHub README badges.

  The four URLs at the top of the file are the only things to change
  when we cut a new release. Server reads them from this template's
  locals (set in src/web/index.ts) so an admin redeploys without
  touching the EJS layout.
-->

<section class="relative overflow-hidden text-center py-12 sm:py-16">
  <div class="absolute inset-0 -z-10 bg-gradient-to-br from-brand-50 via-white to-slate-50"></div>
  <div class="absolute -z-10 top-10 left-1/2 -translate-x-1/2 h-72 w-72 rounded-full bg-brand-400/10 blur-3xl"></div>

  <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-slate-900">
    随处可用 · 始终归你
  </h1>
  <p class="mt-4 max-w-2xl mx-auto text-base sm:text-lg text-slate-600 leading-relaxed">
    iOS / Android / 网页 三端共享你的<span class="text-slate-900 font-medium"><%= siteName %></span>日程，
    <br class="hidden sm:block"/>
    数据始终在你绑定的服务器上。
  </p>
</section>

<!-- Download cards -->
<section class="grid gap-4 sm:grid-cols-2 mt-2 max-w-4xl mx-auto">
  <!-- iOS -->
  <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-7 flex flex-col">
    <div class="flex items-center gap-3 mb-4">
      <div class="h-12 w-12 rounded-xl bg-slate-900 text-white flex items-center justify-center shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
      </div>
      <div class="text-left">
        <h2 class="text-xl font-semibold text-slate-900">iOS</h2>
        <p class="text-xs text-slate-500">iPhone · iPad</p>
      </div>
    </div>

    <ul class="text-sm text-slate-600 space-y-1 mb-5">
      <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> iOS 16.0+</li>
      <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> 当前版本 <%= iosVersion %></li>
      <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> 中文 / 英文 双语</li>
      <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> Passkey · MFA · 多账号</li>
    </ul>

    <div class="mt-auto">
      <% if (iosAppStoreUrl) { %>
        <a href="<%= iosAppStoreUrl %>" target="_blank" rel="noopener"
           class="block w-full text-center rounded-lg bg-slate-900 hover:bg-slate-800 text-white px-5 py-3 text-sm font-medium shadow-md transition">
          App Store 下载 →
        </a>
      <% } else { %>
        <button disabled
                class="block w-full text-center rounded-lg bg-slate-200 text-slate-500 px-5 py-3 text-sm font-medium cursor-not-allowed">
          🍎 App Store 审核中 · 敬请期待
        </button>
        <p class="text-xs text-slate-400 mt-2 text-center">
          已通过 TestFlight 测试，预计 <%= iosEtaWeek %> 上架
        </p>
      <% } %>
    </div>
  </div>

  <!-- Android -->
  <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-7 flex flex-col">
    <div class="flex items-center gap-3 mb-4">
      <div class="h-12 w-12 rounded-xl bg-emerald-500 text-white flex items-center justify-center shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M17.523 15.34a1.123 1.123 0 1 1-.001-2.247 1.123 1.123 0 0 1 .001 2.247m-11.046 0a1.123 1.123 0 1 1 0-2.247 1.123 1.123 0 0 1 0 2.247m11.45-6.155l2.196-3.801a.452.452 0 0 0-.78-.452l-2.226 3.85A13.49 13.49 0 0 0 12 7.5c-1.83 0-3.555.336-5.118.94L4.658 4.59a.452.452 0 0 0-.78.452l2.196 3.802C2.27 10.93 0 14.193 0 17.952h24c0-3.76-2.27-7.022-5.073-8.767"/></svg>
      </div>
      <div class="text-left">
        <h2 class="text-xl font-semibold text-slate-900">Android</h2>
        <p class="text-xs text-slate-500">Phone · Tablet</p>
      </div>
    </div>

    <ul class="text-sm text-slate-600 space-y-1 mb-5">
      <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> Android 8.0+ (API 26)</li>
      <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> 当前版本 <%= androidVersion %></li>
      <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> Kotlin + Jetpack Compose 原生</li>
      <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> 仅 APK 直装，不上应用商店</li>
    </ul>

    <div class="mt-auto space-y-2">
      <% if (androidApkUrl) { %>
        <a href="<%= androidApkUrl %>" target="_blank" rel="noopener"
           class="block w-full text-center rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-3 text-sm font-medium shadow-md transition">
          下载 APK (<%= androidApkSize %>) →
        </a>
        <div class="flex gap-2 text-xs">
          <a href="<%= androidApkGitHub %>" target="_blank" rel="noopener"
             class="flex-1 text-center rounded-md border border-slate-200 px-3 py-2 text-slate-600 hover:bg-slate-50">
            GitHub Releases
          </a>
          <a href="<%= androidApkGitee %>" target="_blank" rel="noopener"
             class="flex-1 text-center rounded-md border border-slate-200 px-3 py-2 text-slate-600 hover:bg-slate-50">
            Gitee Releases
          </a>
        </div>
      <% } else { %>
        <button disabled
                class="block w-full text-center rounded-lg bg-slate-200 text-slate-500 px-5 py-3 text-sm font-medium cursor-not-allowed">
          🤖 v0.1 即将发布
        </button>
        <p class="text-xs text-slate-400 mt-2 text-center">
          首版预计 <%= androidEtaWeek %> 发布，关注 GitHub Releases 接收通知
        </p>
      <% } %>
    </div>
  </div>
</section>

<!-- Browser fallback -->
<section class="max-w-4xl mx-auto mt-6 rounded-2xl border border-slate-200 bg-white p-6 flex flex-col sm:flex-row items-center gap-4">
  <div class="h-12 w-12 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center shrink-0">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>
  </div>
  <div class="flex-1 text-center sm:text-left">
    <h3 class="font-semibold text-slate-900">不下载也能用 · 浏览器直接打开</h3>
    <p class="text-sm text-slate-600 mt-1">
      网页版功能完整，PWA 可一键安装到桌面 / 主屏。地铁飞机离线也能查日程。
    </p>
  </div>
  <a href="/app" class="rounded-lg bg-brand-600 hover:bg-brand-700 text-white px-5 py-2.5 text-sm font-medium shadow transition shrink-0">
    打开网页版 →
  </a>
</section>

<!-- Android APK install hint (collapsed by default) -->
<section class="max-w-4xl mx-auto mt-4 rounded-2xl border border-amber-100 bg-amber-50/50 p-5">
  <details>
    <summary class="cursor-pointer font-medium text-sm text-amber-900">📦 怎么安装 APK？（点开看 3 步）</summary>
    <ol class="mt-3 ml-4 list-decimal space-y-1.5 text-sm text-amber-900/90">
      <li>下载 APK 文件到手机</li>
      <li>系统弹「未知来源」警告 → 选择「允许」（设置 → 应用 → 特殊权限 → 安装未知应用）</li>
      <li>点击 APK 安装，跟着流程走</li>
    </ol>
    <p class="mt-2 text-xs text-amber-700/80">
      首次安装可能需要在「设置 → 安全」里允许浏览器/文件管理器安装应用；
      系统不会上传安装数据到任何第三方。
    </p>
  </details>
</section>

<!-- Source code -->
<section class="max-w-4xl mx-auto mt-6 mb-10 text-center">
  <p class="text-xs uppercase tracking-wider text-slate-500 mb-3">开源 · 自托管</p>
  <div class="flex flex-wrap justify-center gap-3">
    <a href="https://github.com/wuha-like-sleep/by-wave-calendar" target="_blank" rel="noopener"
       class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:border-slate-300 transition">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.387.6.113.82-.26.82-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.305-5.467-1.334-5.467-5.93 0-1.31.468-2.382 1.235-3.222-.135-.303-.54-1.524.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.4 3-.405 1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.652.24 2.873.12 3.176.765.84 1.23 1.912 1.23 3.222 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22v3.293c0 .32.21.694.825.577C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z"/></svg>
      GitHub
    </a>
    <a href="https://gitee.com/zhaorunsen/by-wave-calendar" target="_blank" rel="noopener"
       class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:border-slate-300 transition">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .587L8.793 7.219.587 8.397l5.94 5.79-1.404 8.181L12 18.51l6.876 3.858L17.471 14.187l5.94-5.79-8.205-1.178z"/></svg>
      Gitee 镜像
    </a>
    <a href="/support" class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:border-slate-300 transition">
      📧 技术支持
    </a>
  </div>
  <p class="mt-4 text-xs text-slate-400">
    iOS 与 Android 客户端的代码也开放在仓库的 <code class="font-mono">apps/ios</code> 与 <code class="font-mono">apps/android</code>。
  </p>
</section>
