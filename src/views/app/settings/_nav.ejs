<%# /app/settings sub-page nav. Mirrors src/views/admin/_nav.ejs: a
   tab bar across the top, current tab highlighted via activeNav.
   Each page passes its own route as activeNav so the bar lights
   up the right entry.

   The single-page settings.ejs with #anchor jumps was replaced in
   v1.3.16 with one route per tab so users land directly on the
   thing they came for (e.g. clicking 「修改密码」 from an email
   takes them to /app/settings/security#password, not a 20kB scroll
   on the kitchen-sink page). Old anchor URLs (#profile, #passkey,
   etc.) still resolve via redirects in src/web/index.ts. %>
<nav class="mb-6">
  <div class="text-sm text-slate-500 mb-3">
    <a href="/app" class="hover:text-slate-700">日历</a>
    <span class="px-2">/</span>
    <span class="text-slate-900">账号设置</span>
  </div>
  <div class="-mx-4 sm:mx-0 overflow-x-auto">
    <ul class="flex gap-1 px-4 sm:px-0 sm:flex-wrap border-b border-slate-200 min-w-max sm:min-w-0">
      <% [
        { href: '/app/settings',               label: '账户' },
        { href: '/app/settings/security',      label: '安全' },
        { href: '/app/settings/devices',       label: '设备' },
        { href: '/app/settings/notifications', label: '通知' },
        { href: '/app/settings/appearance',    label: '外观' },
      ].forEach(function(item){ %>
        <li>
          <a href="<%= item.href %>"
             class="inline-block px-3 sm:px-4 py-2 text-sm <%= activeNav === item.href ? 'text-brand-700 border-b-2 border-brand-600 font-medium' : 'text-slate-600 hover:text-slate-900' %>">
            <%= item.label %>
          </a>
        </li>
      <% }) %>
    </ul>
  </div>
</nav>
