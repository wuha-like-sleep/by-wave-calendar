  <div class="text-sm text-slate-500 mb-3">
    <a href="/app" class="hover:text-slate-700">日历</a>
    <span class="px-2">/</span>
    <span class="text-slate-900">账号设置</span>
  </div>
  <div class="-mx-4 sm:mx-0 overflow-x-auto sticky top-14 bg-slate-50/95 backdrop-blur z-20">
    <ul id="settings-tabs" class="flex gap-1 px-4 sm:px-0 sm:flex-wrap border-b border-slate-200 min-w-max sm:min-w-0">
      <% [
        { href: '#profile',  label: '资料' },
        { href: '#passkey',  label: 'Passkey' },
        { href: '#mfa',      label: '二次验证' },
        { href: '#app-passwords', label: '应用密码' },
        { href: '#push',     label: '推送通知' },
        { href: '#theme',    label: '外观' },
        { href: '#password', label: '密码' },
      ].forEach(function(item){ %>
        <li>
          <a href="<%= item.href %>" data-settings-tab
             class="inline-block px-3 sm:px-4 py-2 text-sm text-slate-600 hover:text-slate-900 border-b-2 border-transparent transition">
            <%= item.label %>
          </a>
        </li>
