<section id="profile" class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6 scroll-mt-32">
  <h2 class="text-lg font-semibold text-slate-900 mb-4">资料</h2>
  <dl class="space-y-3 text-sm">
    <div class="flex justify-between"><dt class="text-slate-500">邮箱</dt><dd class="font-medium text-slate-900"><%= user.email %></dd></div>
    <div class="flex justify-between"><dt class="text-slate-500">昵称</dt><dd class="font-medium text-slate-900"><%= user.displayName || '—' %></dd></div>
    <div class="flex justify-between"><dt class="text-slate-500">注册时间</dt><dd class="font-medium text-slate-900"><%- createdAtLocal %></dd></div>
  </dl>
  <div class="mt-4 pt-4 border-t border-slate-100 flex flex-wrap gap-3 text-sm">
    <a href="/app/logins" class="text-brand-700 hover:text-brand-800 hover:underline inline-flex items-center gap-1">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
      登录历史
    </a>
    <% if (user.isAdmin) { %>
      <a href="/admin" class="text-slate-600 hover:text-slate-900 hover:underline inline-flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0z"/><path d="M3 12h18"/></svg>
        管理后台
      </a>
    <% } %>
  </div>
</section>

<section id="passkey" class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6 scroll-mt-32">
  <div class="flex items-center justify-between mb-4">
    <div>
      <h2 class="text-lg font-semibold text-slate-900">Passkey</h2>
      <p class="text-sm text-slate-500">用指纹 / Face ID / 硬件密钥免密码登录，比密码 + MFA 更安全更快</p>
    </div>
    <button type="button" id="add-passkey"
            class="inline-flex items-center gap-1 rounded-lg bg-brand-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-brand-700">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
      添加 Passkey
    </button>
  </div>

  <% if (passkeys.length === 0) { %>
    <div class="rounded-lg bg-slate-50 p-4 text-center text-sm text-slate-500">还没有 Passkey</div>
  <% } else { %>
    <ul class="divide-y divide-slate-100 border-t border-slate-100">
      <% passkeys.forEach(function(pk){ %>
        <li class="py-3 flex items-center justify-between gap-3">
          <div class="min-w-0">
            <div class="text-sm font-medium text-slate-900"><%= pk.deviceName || 'Passkey' %></div>
            <div class="text-xs text-slate-500">
              添加于 <%- pk.createdAtLocal %>
              <% if (pk.lastUsedAtLocal) { %> · 最近使用 <%- pk.lastUsedAtLocal %><% } %>
            </div>
          </div>
          <button type="button" class="text-xs text-red-600 hover:text-red-700 px-2 py-1"
                  data-delete-passkey="<%= pk.id %>">删除</button>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section id="mfa" class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6 scroll-mt-32">
  <h2 class="text-lg font-semibold text-slate-900 mb-2">二次验证 (TOTP)</h2>
  <% if (user.mfaEnabled) { %>
    <p class="text-sm text-emerald-700 mb-4">✓ 二次验证已启用 —— 登录时需要输入认证器中的 6 位验证码</p>
    <details class="mb-4">
      <summary class="cursor-pointer text-sm text-slate-700 hover:text-slate-900">重新生成备用码</summary>
      <form method="post" action="/app/settings/mfa/regenerate-codes" class="mt-3" onsubmit="return confirm('生成新备用码会让旧的失效，确定？');">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50">生成新备用码</button>
      </form>
    </details>
    <details>
      <summary class="cursor-pointer text-sm text-red-700 hover:text-red-900">关闭二次验证</summary>
      <form method="post" action="/app/settings/mfa/disable" class="mt-3 flex gap-2">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="text" name="code" required pattern="[0-9]{6}" maxlength="6" placeholder="输入当前 6 位验证码"
               inputmode="numeric"
               class="flex-1 rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-mono focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
        <button type="submit" class="rounded-lg border border-red-200 bg-white px-3 py-1.5 text-sm text-red-700 hover:bg-red-50">关闭 MFA</button>
      </form>
    </details>
  <% } else { %>
    <p class="text-sm text-slate-500 mb-4">没启用 —— 启用后登录需要密码 + 认证器 6 位码（除非用 Passkey）</p>
    <a href="/app/settings/mfa/setup" class="inline-flex items-center gap-1 rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">启用 TOTP</a>
  <% } %>
</section>

<section id="push" class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6 scroll-mt-32">
  <h2 class="text-lg font-semibold text-slate-900 mb-1">浏览器推送通知</h2>
  <p class="text-sm text-slate-500 mb-4">允许浏览器在事件到达提醒时间时显示桌面通知（手机锁屏也能弹）。无需邮件，但需要浏览器开启过这个站点的通知权限。</p>
  <div id="push-status" class="text-sm text-slate-500 mb-3">检测中…</div>
  <div class="flex gap-2">
    <button type="button" id="btn-push-enable" class="hidden inline-flex items-center gap-1.5 rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">
      🔔 开启推送
    </button>
    <button type="button" id="btn-push-disable" class="hidden inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm text-slate-700 hover:bg-slate-50">
      关闭推送
    </button>
    <button type="button" id="btn-push-test" class="hidden inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm text-slate-700 hover:bg-slate-50">
      发送测试通知
    </button>
  </div>
</section>

<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
// Web Push opt-in flow. Pure browser-side: gets the VAPID public key from
// /api/push/public-key, calls PushManager.subscribe(), forwards the
// resulting subscription to /api/push/subscribe.
(async function () {
  const status = document.getElementById("push-status");
  const enableBtn = document.getElementById("btn-push-enable");
  const disableBtn = document.getElementById("btn-push-disable");
  const testBtn = document.getElementById("btn-push-test");
  if (!status || !enableBtn || !disableBtn) return;

  if (!("serviceWorker" in navigator) || !("PushManager" in window)) {
    status.textContent = "你的浏览器不支持 Web Push（试试 Chrome / Edge / Safari 16+）";
    return;
  }
  if (Notification.permission === "denied") {
    status.textContent = "浏览器已拒绝通知权限。要重新开启，请在地址栏左侧的小锁图标里手动允许通知。";
    return;
  }

  const reg = await navigator.serviceWorker.ready;
  let sub = await reg.pushManager.getSubscription();

  function urlBase64ToUint8Array(b64) {
    const padding = "=".repeat((4 - b64.length % 4) % 4);
    const base64 = (b64 + padding).replace(/-/g, "+").replace(/_/g, "/");
    const raw = atob(base64);
    return new Uint8Array(Array.from(raw, c => c.charCodeAt(0)));
  }

  function updateUI() {
    if (sub) {
      status.textContent = "✓ 已开启 —— 提醒会同时发到这台设备的浏览器通知";
      enableBtn.classList.add("hidden");
      disableBtn.classList.remove("hidden");
      testBtn.classList.remove("hidden");
    } else {
      status.textContent = "还没开启";
      enableBtn.classList.remove("hidden");
      disableBtn.classList.add("hidden");
      testBtn.classList.add("hidden");
    }
  }
  updateUI();

  enableBtn.addEventListener("click", async () => {
    enableBtn.disabled = true;
    try {
      const r = await fetch("/api/push/public-key");
      const { publicKey } = await r.json();
      sub = await reg.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: urlBase64ToUint8Array(publicKey),
      });
      const csrf = document.querySelector('meta[name="csrf-token"]')?.content || "";
      await fetch("/api/push/subscribe", {
        method: "POST",
        credentials: "same-origin",
        headers: { "Content-Type": "application/json", "X-CSRF-Token": csrf },
        body: JSON.stringify(sub.toJSON()),
      });
      updateUI();
    } catch (e) {
      status.textContent = "开启失败：" + (e && e.message ? e.message : e);
    }
    enableBtn.disabled = false;
  });

  disableBtn.addEventListener("click", async () => {
    if (!sub) return;
    const endpoint = sub.endpoint;
    await sub.unsubscribe().catch(() => undefined);
    const csrf = document.querySelector('meta[name="csrf-token"]')?.content || "";
    await fetch("/api/push/unsubscribe", {
      method: "POST",
      credentials: "same-origin",
      headers: { "Content-Type": "application/json", "X-CSRF-Token": csrf },
      body: JSON.stringify({ endpoint }),
    });
    sub = null;
    updateUI();
  });
})();
</script>

<section id="caldav-connect" class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6 scroll-mt-32">
  <div class="flex items-start justify-between gap-4 mb-3">
    <div>
      <h2 class="text-lg font-semibold text-slate-900">CalDAV 同步</h2>
      <p class="mt-1 text-sm text-slate-500">把 ByWave 日历直接接到 iPhone / Mac / Outlook / Thunderbird，双向同步事件 + 邀请 + RSVP。</p>
    </div>
  </div>

  <dl class="space-y-3">
    <div class="grid grid-cols-[6.5rem_1fr_auto] items-center gap-2">
      <dt class="text-xs text-slate-500">服务器地址</dt>
      <dd><code id="caldav-url" class="block break-all rounded-md bg-slate-50 border border-slate-200 px-3 py-2 text-sm font-mono text-slate-900"><%= caldavBaseUrl %></code></dd>
      <button type="button" data-copy="caldav-url"
              class="rounded-md border border-slate-300 bg-white px-2 py-2 text-xs text-slate-700 hover:bg-slate-50">复制</button>
    </div>
    <div class="grid grid-cols-[6.5rem_1fr_auto] items-center gap-2">
      <dt class="text-xs text-slate-500">用户名</dt>
      <dd><code id="caldav-user" class="block break-all rounded-md bg-slate-50 border border-slate-200 px-3 py-2 text-sm font-mono text-slate-900"><%= user.email %></code></dd>
      <button type="button" data-copy="caldav-user"
              class="rounded-md border border-slate-300 bg-white px-2 py-2 text-xs text-slate-700 hover:bg-slate-50">复制</button>
    </div>
    <div class="grid grid-cols-[6.5rem_1fr_auto] items-center gap-2">
      <dt class="text-xs text-slate-500">密码</dt>
      <dd class="text-sm text-slate-700">
        建议<a href="#app-passwords" class="text-brand-700 hover:underline">生成下方应用密码</a>，主账号密码也可（不推荐 — 开启 MFA 后必须用应用密码）
      </dd>
      <span></span>
    </div>
  </dl>

  <details class="mt-4 rounded-lg border border-slate-200 bg-slate-50">
    <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-slate-900">iPhone / iPad 接入步骤</summary>
    <ol class="list-decimal space-y-1 px-8 py-3 text-sm text-slate-700">
      <li>设置 → 日历 → 帐户 → 添加帐户 → 其他 → 添加 CalDAV 帐户</li>
      <li>服务器：粘贴上方「服务器地址」</li>
      <li>用户名：邮箱；密码：应用专属密码</li>
      <li>描述：随意，例如 "ByWave"；下一步保存</li>
      <li>日历 App 打开「ByWave」分组即可看到所有日历；新建事件 + 邀请同事都会实时同步</li>
    </ol>
  </details>

  <details class="mt-2 rounded-lg border border-slate-200 bg-slate-50">
    <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-slate-900">macOS Calendar.app 接入步骤</summary>
    <ol class="list-decimal space-y-1 px-8 py-3 text-sm text-slate-700">
      <li>日历 → 设置 → 帐户 → 左下角 + → 选择「其他 CalDAV 帐户」</li>
      <li>帐户类型：手动；用户名：邮箱；密码：应用密码；服务器地址：上方「服务器地址」</li>
      <li>登录 → 选取要同步的日历 → 完成</li>
    </ol>
  </details>

  <details class="mt-2 rounded-lg border border-slate-200 bg-slate-50">
    <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-slate-900">Thunderbird / DAVx⁵ / Outlook</summary>
    <ul class="list-disc space-y-1 px-8 py-3 text-sm text-slate-700">
      <li><strong>Thunderbird</strong>：日历 → 新建日历 → 网络上 → CalDAV → 粘贴服务器地址</li>
      <li><strong>Android (DAVx⁵)</strong>：添加帐户 → 用 URL 和用户名登录 → 服务器地址 + 邮箱 + 应用密码</li>
      <li><strong>Outlook</strong>：原生不支持 CalDAV，可用 <code>Outlook CalDav Synchronizer</code> 插件或导出 .ics 订阅</li>
    </ul>
  </details>

  <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs text-amber-800">
    💡 邀请功能在 CalDAV 上是双向的：你在手机上把同事的邮箱加进 ATTENDEE，对方会收到 ByWave 的邀请邮件；对方点击 Accept/Decline 后，下次手机同步就能看到对方的回执。
  </div>
</section>

<script nonce="<%= cspNonce %>">
  (function() {
    document.querySelectorAll("[data-copy]").forEach(function(btn) {
      btn.addEventListener("click", async function() {
        var id = btn.getAttribute("data-copy");
        var target = document.getElementById(id);
        if (!target) return;
        try {
          await navigator.clipboard.writeText(target.textContent.trim());
          var old = btn.textContent;
          btn.textContent = "已复制";
          setTimeout(function() { btn.textContent = old; }, 1500);
        } catch (e) { /* clipboard blocked — leave UI silent */ }
      });
    });
  })();
</script>

<section id="app-passwords" class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6 scroll-mt-32">
  <div class="flex items-start justify-between gap-4 mb-3">
    <div>
      <h2 class="text-lg font-semibold text-slate-900">CalDAV 应用专属密码 <span class="ml-1 inline-block rounded-full bg-slate-100 px-2 py-0.5 text-xs font-normal text-slate-500">可选</span></h2>
      <p class="mt-1 text-sm text-slate-500">为手机 / 桌面日历客户端单独生成密码，避免在第三方 App 里填主账号密码。开启 MFA 后建议使用应用密码连接 CalDAV。</p>
    </div>
  </div>

  <% if (newAppPassword) { %>
    <div class="mb-4 rounded-lg border border-emerald-200 bg-emerald-50 p-4">
      <div class="flex items-center justify-between gap-2 mb-2">
        <div class="text-sm font-medium text-emerald-900">已生成「<%= newAppLabel || '新应用密码' %>」—— 只显示这一次</div>
        <button type="button" data-copy-app-pwd
                class="rounded-md bg-white border border-emerald-300 px-2 py-1 text-xs text-emerald-700 hover:bg-emerald-50">复制</button>
      </div>
      <code id="new-app-password" class="block break-all rounded-md bg-white border border-emerald-200 px-3 py-2 text-sm font-mono text-slate-900"><%= newAppPassword %></code>
      <p class="mt-2 text-xs text-emerald-800">把这串密码粘贴到 CalDAV 客户端的密码字段；用户名填邮箱即可。刷新页面后这段密码会消失，请立即保存。</p>
    </div>
  <% } %>

  <form method="post" action="/app/settings/app-passwords" class="flex flex-col sm:flex-row gap-2 mb-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="text" name="label" required maxlength="60"
           placeholder="设备标签（如：iPhone 日历 / Mac Calendar.app）"
           class="flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
    <button type="submit"
            class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">
      生成新应用密码
    </button>
  </form>

  <% if (appPasswords.length === 0) { %>
    <div class="rounded-lg bg-slate-50 p-4 text-center text-sm text-slate-500">还没有应用密码 —— 主账号密码仍可用于 CalDAV 登录</div>
  <% } else { %>
    <ul class="divide-y divide-slate-100 border-t border-slate-100">
      <% appPasswords.forEach(function(ap){ %>
        <li class="py-3 flex items-center justify-between gap-3">
          <div class="min-w-0">
            <div class="text-sm font-medium text-slate-900"><%= ap.label %></div>
            <div class="text-xs text-slate-500">
              前缀 <code class="font-mono text-slate-700"><%= ap.prefix %></code> ·
              创建于 <%- ap.createdAtLocal %>
              <% if (ap.lastUsedAtLocal) { %> · 最近使用 <%- ap.lastUsedAtLocal %><% } else { %> · 从未使用<% } %>
            </div>
          </div>
          <form method="post" action="/app/settings/app-passwords/<%= ap.id %>/revoke" onsubmit="return confirm('撤销后这个应用密码立即失效，对应客户端需重新生成。确定？');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="text-xs text-red-600 hover:text-red-700 px-2 py-1">撤销</button>
          </form>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section id="theme" class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6 scroll-mt-32">
  <div class="flex items-start justify-between gap-3 mb-3">
    <div>
      <h2 class="text-lg font-semibold text-slate-900">外观 <span class="ml-1 inline-block rounded-full bg-slate-100 px-2 py-0.5 text-xs font-normal text-slate-500">仅你自己可见</span></h2>
      <p class="mt-1 text-sm text-slate-500">为你自己选个色系和密度，覆盖站点默认。不填则跟随管理员的站点设置。</p>
    </div>
    <% if (userPalette || userDensity) { %>
      <form method="post" action="/app/settings/theme" class="m-0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="reset" value="1" />
        <button type="submit" class="text-xs text-slate-500 hover:text-slate-700 underline">恢复站点默认</button>
      </form>
    <% } %>
  </div>

  <form method="post" action="/app/settings/theme" class="space-y-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div>
      <label class="block text-sm font-medium text-slate-700 mb-2">主题色（站点默认：<span class="font-mono"><%= sitePalette %></span>）</label>
      <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-7 gap-2">
        <% const palettes = [
          { id: 'indigo',  name: '靛蓝',   c1: '#a5b4fc', c2: '#6366f1', c3: '#4338ca' },
          { id: 'emerald', name: '翠绿',   c1: '#6ee7b7', c2: '#10b981', c3: '#047857' },
          { id: 'rose',    name: '玫瑰',   c1: '#fda4af', c2: '#f43f5e', c3: '#be123c' },
          { id: 'sky',     name: '天蓝',   c1: '#7dd3fc', c2: '#0ea5e9', c3: '#0369a1' },
          { id: 'amber',   name: '琥珀',   c1: '#fcd34d', c2: '#f59e0b', c3: '#b45309' },
          { id: 'violet',  name: '紫罗兰', c1: '#c4b5fd', c2: '#8b5cf6', c3: '#6d28d9' },
          { id: 'slate',   name: '石板灰', c1: '#cbd5e1', c2: '#64748b', c3: '#334155' },
        ]; palettes.forEach(function(p){ %>
          <label class="user-palette-card cursor-pointer rounded-xl border-2 p-2 transition <%= userPalette === p.id ? 'border-brand-600 bg-brand-50' : 'border-slate-200 hover:border-slate-300 bg-white' %>">
            <input type="radio" name="palette" value="<%= p.id %>" <%= userPalette === p.id ? 'checked' : '' %> class="sr-only" />
            <div class="flex items-center gap-1 mb-1.5">
              <span class="block h-4 w-4 rounded" style="background: <%= p.c1 %>"></span>
              <span class="block h-4 w-4 rounded" style="background: <%= p.c2 %>"></span>
              <span class="block h-4 w-4 rounded" style="background: <%= p.c3 %>"></span>
            </div>
            <div class="text-xs font-medium text-slate-900"><%= p.name %></div>
          </label>
        <% }) %>
      </div>
      <p class="mt-1 text-xs text-slate-400">不选 = 跟随站点设置</p>
    </div>

    <div>
      <label class="block text-sm font-medium text-slate-700 mb-2">密度（站点默认：<span class="font-mono"><%= siteDensity %></span>）</label>
      <div class="grid grid-cols-2 gap-2 max-w-md">
        <label class="cursor-pointer rounded-xl border-2 p-3 transition <%= userDensity === 'comfortable' ? 'border-brand-600 bg-brand-50' : 'border-slate-200 hover:border-slate-300 bg-white' %>">
          <input type="radio" name="density" value="comfortable" <%= userDensity === 'comfortable' ? 'checked' : '' %> class="sr-only" />
          <div class="text-sm font-medium text-slate-900">舒适</div>
          <div class="text-xs text-slate-500 mt-0.5">默认间距</div>
        </label>
        <label class="cursor-pointer rounded-xl border-2 p-3 transition <%= userDensity === 'compact' ? 'border-brand-600 bg-brand-50' : 'border-slate-200 hover:border-slate-300 bg-white' %>">
          <input type="radio" name="density" value="compact" <%= userDensity === 'compact' ? 'checked' : '' %> class="sr-only" />
          <div class="text-sm font-medium text-slate-900">紧凑</div>
          <div class="text-xs text-slate-500 mt-0.5">一屏多塞内容</div>
        </label>
      </div>
    </div>

    <div class="pt-2 border-t border-slate-100">
      <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">保存外观</button>
    </div>
  </form>
</section>

<section id="password" class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6 scroll-mt-32">
  <h2 class="text-lg font-semibold text-slate-900 mb-4">修改密码</h2>
  <p class="text-xs text-slate-500 mb-3">修改后所有设备的登录会话都会失效，需要重新登录</p>
  <form method="post" action="/app/settings/password" class="space-y-3 max-w-md">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div>
      <label class="block text-sm font-medium text-slate-700">当前密码</label>
      <input type="password" name="currentPassword" required autocomplete="current-password"
             class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700">新密码</label>
      <input type="password" name="newPassword" required minlength="8" autocomplete="new-password"
             class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
    </div>
    <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">更新密码</button>
  </form>
</section>

<section id="danger" class="rounded-2xl border-2 border-red-200 bg-red-50/40 p-5 sm:p-6 mb-6 scroll-mt-32">
  <h2 class="text-lg font-semibold text-red-900 mb-2">⚠️ 删除账号</h2>
  <p class="text-sm text-red-800 mb-4">永久删除你的账号 —— 所有日历、事件、订阅、Passkey、API token、登录历史<strong>立即</strong>从数据库消失，无法恢复。其他人参加过你建的活动的邀请记录也会一起删除。</p>
  <details>
    <summary class="cursor-pointer text-sm font-medium text-red-700 hover:text-red-800">我了解风险，继续删除</summary>
    <form method="post" action="/app/settings/delete-account" class="mt-3 space-y-3 max-w-md">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div>
        <label class="block text-xs font-medium text-red-900 mb-1">当前密码</label>
        <input type="password" name="password" required autocomplete="current-password"
               class="block w-full rounded-lg border border-red-300 bg-white px-3 py-2 text-sm focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-100" />
      </div>
      <div>
        <label class="block text-xs font-medium text-red-900 mb-1">输入「删除我的账号」以确认</label>
        <input type="text" name="confirm" required placeholder="删除我的账号"
               class="block w-full rounded-lg border border-red-300 bg-white px-3 py-2 text-sm font-mono focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-100" />
      </div>
      <button type="submit" class="rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700"
              onclick="return confirm('最终确认：账号永久删除，不可恢复。继续？');">
        永久删除我的账号
      </button>
    </form>
  </details>
</section>

<script src="/static/lib/simplewebauthn.umd.min.js"></script>
<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
(function(){
  // Highlight the visible section in the sticky tab bar as the user scrolls.
  const tabLinks = Array.from(document.querySelectorAll("#settings-tabs [data-settings-tab]"));
  const sectionIds = tabLinks.map((a) => a.getAttribute("href").slice(1)).filter(Boolean);
  const sections = sectionIds.map((id) => document.getElementById(id)).filter(Boolean);
  function highlight(activeId) {
    tabLinks.forEach((a) => {
      const on = a.getAttribute("href") === "#" + activeId;
      a.classList.toggle("text-brand-700", on);
      a.classList.toggle("border-brand-600", on);
      a.classList.toggle("font-medium", on);
      a.classList.toggle("border-transparent", !on);
      a.classList.toggle("text-slate-600", !on);
    });
  }
  if (sections.length) {
    const io = new IntersectionObserver((entries) => {
      const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.target.offsetTop - b.target.offsetTop)[0];
      if (visible) highlight(visible.target.id);
    }, { rootMargin: "-30% 0px -55% 0px" });
    sections.forEach((s) => io.observe(s));
    highlight(sections[0].id);
  }
})();
(function(){
  const csrf = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

  document.getElementById("add-passkey")?.addEventListener("click", async () => {
    try {
      const name = prompt("给这把 Passkey 起个名字（比如 Mac TouchID / iPhone）", "");
      const opts = await (await fetch("/webauthn/register/options", {
        method: "POST",
        headers: { "Content-Type": "application/json", "X-CSRF-Token": csrf },
        credentials: "same-origin",
        body: JSON.stringify({})
      })).json();
      if (opts.error) throw new Error(opts.error);
      const att = await SimpleWebAuthnBrowser.startRegistration({ optionsJSON: opts });
      const verify = await (await fetch("/webauthn/register/verify", {
        method: "POST",
        headers: { "Content-Type": "application/json", "X-CSRF-Token": csrf },
        credentials: "same-origin",
        body: JSON.stringify({ response: att, deviceName: name || undefined })
      })).json();
      if (!verify.ok) throw new Error(verify.error || "verify_failed");
      window.bwc.toast("Passkey 添加成功", "success");
      setTimeout(() => window.location.reload(), 500);
    } catch (err) {
      console.error(err);
      window.bwc.toast("添加失败：" + (err.message || err), "error");
    }
  });

  document.querySelector("[data-copy-app-pwd]")?.addEventListener("click", async () => {
    const el = document.getElementById("new-app-password");
    if (!el) return;
    try {
      await navigator.clipboard.writeText(el.textContent.trim());
      window.bwc.toast("已复制到剪贴板", "success");
    } catch {
      const r = document.createRange();
      r.selectNode(el);
      window.getSelection().removeAllRanges();
      window.getSelection().addRange(r);
      window.bwc.toast("已选中，按 Cmd/Ctrl+C 复制", "info");
    }
  });

  document.querySelectorAll("[data-delete-passkey]").forEach(btn => {
    btn.addEventListener("click", async () => {
      if (!confirm("确定删除这把 Passkey？")) return;
      const id = btn.getAttribute("data-delete-passkey");
      const resp = await fetch("/webauthn/credentials/" + id + "/delete", {
        method: "POST",
        headers: { "X-CSRF-Token": csrf },
        credentials: "same-origin"
      });
      if (resp.ok) {
        window.bwc.toast("已删除", "success");
        setTimeout(() => window.location.reload(), 400);
      } else {
        window.bwc.toast("删除失败", "error");
      }
    });
  });
})();
</script>
