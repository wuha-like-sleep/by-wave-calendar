<%# v1.3.16: replaced the in-page anchor-scrolling tabs with admin-
   style separate routes. `currentTab` (passed by /app/settings,
   /app/settings/security, /app/settings/devices, /app/settings/
   notifications, /app/settings/appearance) controls which section
   blocks render. Backward-compat: visiting /app/settings still
   works (lands on "account" tab); old anchor URLs like
   #passkey resolve too because the routes are still mounted, the
   anchor just goes to the section within the current tab. %>
<% const tab = (typeof currentTab !== 'undefined' && currentTab) || 'account';
   // Per-tab section visibility map. Section IDs that aren't in the
   // active tab's list get a `hidden` class — keeps all the JS in one
   // file (avoids splitting modal+script blocks that span sections).
   const sectionsByTab = {
     // Language lives under 账户/Account (it's a per-account preference).
     // It sits between profile and the danger zone in the file, so it
     // renders profile → language → danger on this tab.
     account:       ['profile', 'language', 'danger'],
     security:      ['passkey', 'mfa', 'password', 'login-methods'],
     devices:       ['devices', 'app-passwords', 'caldav-connect'],
     notifications: ['push'],
     appearance:    ['theme'],
   };
   const visibleSections = sectionsByTab[tab] || sectionsByTab.account;
   function isVisible(id){ return visibleSections.indexOf(id) !== -1; }
%>
<%- include('settings/_nav', { activeNav: '/app/settings' + (tab === 'account' ? '' : '/' + tab) }) %>

<section id="profile" class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6 scroll-mt-32"<% if (!isVisible('profile')) { %> style="display:none"<% } %>>
