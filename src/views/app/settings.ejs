<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
(function() {
  const BWC_I18N = (() => {
    try { return JSON.parse(document.getElementById('bwc-settings-i18n').textContent); }
    catch { return {}; }
  })();
  const fmt = (s, vars) => s.replace(/\{(\w+)\}/g, (_, k) => vars[k] ?? '');
  const csrf = '<%= csrfToken %>';
  const list = document.getElementById("device-list");
  const modal = document.getElementById("modal-pair-device");
  const qrBox = document.getElementById("pair-qr");
  const pairUrl = document.getElementById("pair-url");
  const pairCode = document.getElementById("pair-code");
  const pairExp = document.getElementById("pair-expires");
  const btnPair = document.getElementById("btn-pair-device");
  const btnClose = document.getElementById("btn-pair-close");
  // Feature is admin-disabled — the EJS didn't render the device list or
  // the pair button, so there's nothing to wire up. Bail before any
  // null-deref. addEventListener calls below would throw otherwise.
  if (!list || !btnPair) return;

  function fmtAgo(iso) {
    if (!iso) return BWC_I18N.agoNever;
    const diff = Date.now() - new Date(iso).getTime();
    const min = Math.floor(diff / 60000);
    if (min < 1) return BWC_I18N.agoJustNow;
    if (min < 60) return fmt(BWC_I18N.agoMinutes, { n: min });
    const hr = Math.floor(min / 60);
    if (hr < 24) return fmt(BWC_I18N.agoHours, { n: hr });
    const d = Math.floor(hr / 24);
    return fmt(BWC_I18N.agoDays, { n: d });
  }
  function kindLabel(k) {
    return ({ ios: "iOS", android: "Android", desktop: BWC_I18N.kindDesktop }[k]) || BWC_I18N.kindOther;
  }

  async function loadDevices() {
    try {
      const resp = await fetch("/api/v1/devices", { credentials: "same-origin" });
      const data = await resp.json();
      const devs = (data && (data.devices || data.data?.devices)) || [];
      if (devs.length === 0) {
        list.innerHTML = '<li class="py-6 text-center text-sm text-slate-400">' + escapeHtml(BWC_I18N.empty) + '</li>';
        return;
      }
      list.innerHTML = devs.map(function(d) {
        return '<li class="py-3 flex items-center justify-between gap-3">' +
          '<div class="min-w-0">' +
            '<div class="text-sm font-medium text-slate-900">' +
              escapeHtml(d.label) +
              ' <span class="ml-1 inline-block rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-normal text-slate-500">' + escapeHtml(kindLabel(d.kind)) + '</span>' +
            '</div>' +
            '<div class="text-xs text-slate-500 mt-0.5">' +
              escapeHtml(BWC_I18N.lastActive) + ' ' + escapeHtml(fmtAgo(d.lastSeenAt)) + (d.lastSeenIp ? ' · ' + escapeHtml(d.lastSeenIp) : '') +
              (d.appVersion ? ' · v' + escapeHtml(d.appVersion) : '') +
            '</div>' +
          '</div>' +
          '<button type="button" data-revoke="' + d.id + '" class="text-xs text-red-600 hover:text-red-700 px-2 py-1">' + escapeHtml(BWC_I18N.revoke) + '</button>' +
        '</li>';
      }).join("");
    } catch (err) {
      console.error("load_devices", err);
      list.innerHTML = '<li class="py-6 text-center text-sm text-red-500">' + escapeHtml(BWC_I18N.loadFailed) + '</li>';
    }
  }
  function escapeHtml(s) {
    return String(s == null ? "" : s).replace(/[&<>"']/g, function(c) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
    });
  }

  list.addEventListener("click", async function(e) {
    const btn = e.target.closest("[data-revoke]");
    if (!btn) return;
    if (!(await window.bwc.confirm({ message: BWC_I18N.revokeConfirm, danger: true, confirmLabel: BWC_I18N.revokeConfirmOk }))) return;
    try {
      const resp = await fetch("/api/v1/devices/" + encodeURIComponent(btn.dataset.revoke), {
        method: "DELETE",
        credentials: "same-origin",
        headers: { "X-CSRF-Token": csrf },
      });
      if (!resp.ok) throw new Error();
      window.bwc.toast(BWC_I18N.revokeSuccess, "success");
      loadDevices();
    } catch (_e) { window.bwc.toast(BWC_I18N.revokeFailed, "error"); }
  });

  btnPair.addEventListener("click", async function() {
    modal.classList.remove("hidden");
    qrBox.innerHTML = '<span class="text-xs text-slate-400">' + escapeHtml(BWC_I18N.modalGenerating) + '</span>';
    try {
      const resp = await fetch("/api/v1/devices/pair-init", {
        method: "POST",
        credentials: "same-origin",
        headers: { "Content-Type": "application/json", "X-CSRF-Token": csrf },
      });
      const data = await resp.json();
      const d = (data && data.data) || data;
      qrBox.innerHTML = d.qrSvg;
      // SVG fills its container; cap with inline width
      const svg = qrBox.querySelector("svg");
      if (svg) { svg.setAttribute("width", "100%"); svg.setAttribute("height", "100%"); }
      // Parse payload for the manual-input fallback
      try {
        const p = JSON.parse(d.payload);
        pairUrl.textContent = p.url;
        pairCode.textContent = p.code;
      } catch (_e) {}
      const expMs = new Date(d.expiresAt).getTime() - Date.now();
      pairExp.textContent = fmt(BWC_I18N.expiresIn, { n: Math.max(0, Math.floor(expMs / 60000)) });
      // Refresh device list 30s later so the new device appears once the
      // app finishes the claim (we don't have push for this — polling is fine).
      setTimeout(loadDevices, 30000);
    } catch (err) {
      console.error("pair_init", err);
      qrBox.innerHTML = '<span class="text-xs text-red-500">' + escapeHtml(BWC_I18N.pairInitFailed) + '</span>';
    }
  });
  btnClose.addEventListener("click", function() { modal.classList.add("hidden"); loadDevices(); });
  modal.addEventListener("click", function(e) { if (e.target === modal) { modal.classList.add("hidden"); loadDevices(); } });

  loadDevices();
})();
</script>

