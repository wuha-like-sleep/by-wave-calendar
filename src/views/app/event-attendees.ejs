<nav class="mb-4 text-sm text-slate-500">
  <a href="/app" class="hover:text-slate-700"><%= t("nav.calendar") %></a>
  <span class="px-2">/</span>
  <a href="/app/calendars/<%= calendar.id %>" class="hover:text-slate-700"><%= calendar.name %></a>
  <span class="px-2">/</span>
  <span class="text-slate-900"><%= t("page.attendees", { summary: event.summary }) %></span>
</nav>

<% if (event.deletedAt) { %>
  <div class="rounded-lg border-2 border-red-200 bg-red-50 p-4 mb-4">
    <div class="text-sm font-semibold text-red-900"><%= t("attendees.cancelledTitle") %></div>
    <div class="text-xs text-red-700 mt-1"><%= t("attendees.cancelledBody") %></div>
  </div>
<% } %>

<header class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6 <%= event.deletedAt ? 'opacity-70' : '' %>">
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
    <div class="min-w-0">
      <h1 class="text-xl sm:text-2xl font-semibold text-slate-900 truncate <%= event.deletedAt ? 'line-through' : '' %>"><%= event.summary %></h1>
      <div class="mt-1 text-sm text-slate-500">
        <%- event.startsAtLocal %> → <%- event.endsAtLocal %>
      </div>
      <% if (event.location) { %>
        <div class="mt-1 text-sm text-slate-500">📍 <%= event.location %></div>
      <% } %>
    </div>
    <a href="/app" class="text-sm text-slate-500 hover:text-slate-700">← <%= t("attendees.back") %></a>
  </div>
</header>

<% if (!event.deletedAt) { %>
<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-4"><%= t("attendees.inviteHeading") %></h2>
  <form method="post" action="/app/events/<%= event.id %>/attendees/invite" class="flex flex-col sm:flex-row gap-2">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="email" name="email" required maxlength="254" placeholder="<%= t('attendees.emailPlaceholder') %>"
           class="flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
    <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"><%= t("attendees.sendInvite") %></button>
  </form>
</section>
<% } %>

<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-3"><%= t("attendees.currentHeading") %> <span class="text-slate-400 text-sm font-normal">(<%= attendees.length + 1 %>)</span></h2>
  <ul class="divide-y divide-slate-100 border-t border-slate-100">
    <li class="py-3 flex items-center gap-3">
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm font-semibold text-white"><%= (organizer.name || organizer.email).slice(0, 1).toUpperCase() %></span>
      <div class="min-w-0 flex-1">
        <div class="text-sm font-medium text-slate-900 truncate"><%= organizer.name %></div>
        <div class="text-xs text-slate-400 truncate"><%= organizer.email %></div>
      </div>
      <span class="inline-flex items-center rounded-full bg-brand-50 text-brand-700 px-2 py-0.5 text-xs"><%= t("attendees.organizerBadge") %></span>
      <span class="inline-flex items-center rounded-full bg-slate-100 text-slate-500 px-2 py-0.5 text-xs"><%= t("attendees.youBadge") %></span>
    </li>
    <% attendees.forEach(function(email){
         const tok = tokens.find(function(t){ return t.recipientEmail === email; });
         const displayName = attendeeNames[email]; %>
      <li class="py-3 flex items-center gap-3">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-200 text-sm font-semibold text-slate-600"><%= (displayName || email).slice(0, 1).toUpperCase() %></span>
        <div class="min-w-0 flex-1">
          <div class="text-sm font-medium text-slate-900 truncate"><%= displayName || email %></div>
          <% if (displayName) { %><div class="text-xs text-slate-400 truncate"><%= email %></div><% } %>
          <% if (tok) { %>
            <div class="text-xs mt-0.5 flex flex-wrap items-center gap-1.5">
              <% if (tok.responseStatus === 'accepted') { %>
                <span class="inline-flex items-center rounded-full bg-emerald-50 text-emerald-700 px-2 py-0.5">✓ <%= t("attendees.statusAccepted") %></span>
              <% } else if (tok.responseStatus === 'declined') { %>
                <span class="inline-flex items-center rounded-full bg-red-50 text-red-700 px-2 py-0.5">✗ <%= t("attendees.statusDeclined") %></span>
              <% } else if (tok.responseStatus === 'tentative') { %>
                <span class="inline-flex items-center rounded-full bg-amber-50 text-amber-700 px-2 py-0.5">? <%= t("attendees.statusTentative") %></span>
              <% } else { %>
                <span class="inline-flex items-center rounded-full bg-slate-100 text-slate-500 px-2 py-0.5">⏳ <%= t("attendees.statusPending") %></span>
              <% } %>
              <% if (tok.acceptedAtLocal) { %>
                <span class="text-slate-500"><%= t("attendees.addedToCalendar") %> · <%- tok.acceptedAtLocal %></span>
              <% } else { %>
                <span class="text-slate-400"><%= t("attendees.invitedOn") %> <%- tok.createdAtLocal %> · <%= t("attendees.expiresOn") %> <%- tok.expiresAtLocal %></span>
              <% } %>
            </div>
          <% } else { %>
            <div class="text-xs text-slate-400 mt-0.5"><%= t("attendees.manualNote") %></div>
          <% } %>
        </div>
        <% if (!event.deletedAt) { %>
        <form method="post" action="/app/events/<%= event.id %>/attendees/revoke" class="m-0"
              data-confirm="<%= t('attendees.revokeConfirm', { email }) %>" data-confirm-danger="1" data-confirm-ok="<%= t('attendees.revoke') %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="email" value="<%= email %>" />
          <button type="submit" class="text-xs text-red-600 hover:text-red-700 px-2 py-1"><%= t("attendees.revoke") %></button>
        </form>
        <% } %>
      </li>
    <% }) %>
  </ul>
  <% if (attendees.length === 0) { %>
    <div class="rounded-lg bg-slate-50 p-4 text-center text-sm text-slate-500 mt-3"><%= t("attendees.empty") %></div>
  <% } %>
</section>

<% if (proposals.length > 0) { %>
<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-3"><%= t("attendees.proposalsHeading") %>
    <% if (pendingProposalCount > 0) { %>
      <span class="ml-1 inline-flex items-center rounded-full bg-amber-50 text-amber-700 px-2 py-0.5 text-xs font-normal"><%= t("attendees.proposalsWaiting", { count: pendingProposalCount }) %></span>
    <% } %>
  </h2>
  <ul class="divide-y divide-slate-100 border-t border-slate-100">
    <% proposals.forEach(function(p){ %>
      <li class="py-3">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <div class="text-sm font-medium text-slate-900"><%= t("attendees.proposalFrom", { email: p.proposerEmail }) %></div>
          <div class="text-xs">
            <% if (p.status === 'accepted') { %><span class="text-emerald-700">✓ <%= t("attendees.proposalStatusAccepted") %></span>
            <% } else if (p.status === 'declined') { %><span class="text-red-700">✗ <%= t("attendees.proposalStatusDeclined") %></span>
            <% } else if (p.status === 'superseded') { %><span class="text-slate-400"><%= t("attendees.proposalStatusSuperseded") %></span>
            <% } else { %><span class="text-amber-700">⏳ <%= t("attendees.statusPending") %></span><% } %>
          </div>
        </div>
        <div class="mt-0.5 text-sm text-slate-600"><%- p.startsAtLocal %> → <%- p.endsAtLocal %></div>
        <% if (p.note) { %><div class="mt-0.5 text-xs text-slate-500"><%= p.note %></div><% } %>
        <% if (p.status === 'pending' && !event.deletedAt) { %>
          <div class="mt-2 flex gap-2">
            <form method="post" action="/app/events/<%= event.id %>/proposals/<%= p.id %>/accept" class="m-0">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-emerald-700"><%= t("attendees.proposalAccept") %></button>
            </form>
            <form method="post" action="/app/events/<%= event.id %>/proposals/<%= p.id %>/decline" class="m-0">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50"><%= t("attendees.proposalDecline") %></button>
            </form>
          </div>
        <% } %>
      </li>
    <% }) %>
  </ul>
</section>
<% } %>

<% if (tokens.length > 0) { %>
  <section class="rounded-2xl border border-slate-200 bg-slate-50 p-5 sm:p-6">
    <details>
      <summary class="cursor-pointer text-sm font-medium text-slate-700"><%= t("attendees.recordsHeading", { count: tokens.length }) %></summary>
      <table class="mt-3 min-w-full text-xs">
        <thead class="text-slate-400 uppercase">
          <tr><th class="text-left py-1.5 pr-3"><%= t("attendees.colEmail") %></th><th class="text-left py-1.5 pr-3"><%= t("attendees.colSent") %></th><th class="text-left py-1.5 pr-3"><%= t("attendees.colExpires") %></th><th class="text-left py-1.5"><%= t("attendees.colStatus") %></th></tr>
        </thead>
        <tbody>
          <% tokens.forEach(function(tk){ %>
            <tr class="border-t border-slate-200">
              <td class="py-1.5 pr-3 text-slate-700"><%= tk.recipientEmail %></td>
              <td class="py-1.5 pr-3 text-slate-500"><%- tk.createdAtLocal %></td>
              <td class="py-1.5 pr-3 text-slate-500"><%- tk.expiresAtLocal %></td>
              <td class="py-1.5 text-slate-500"><%= tk.acceptedAt ? t("attendees.recordAdded") : (tk.expiresAt < new Date() ? t("attendees.recordExpired") : t("attendees.recordPending")) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </details>
  </section>
<% } %>
