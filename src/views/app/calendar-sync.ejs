<%- include('settings/_nav', { activeNav: '/app/settings/calendar-sync' }) %>
<div class="max-w-4xl mx-auto space-y-6">
  <header class="mb-8"><p class="text-xs uppercase tracking-widest font-semibold text-brand-600 mb-2">BYWAVE CONNECT</p><h1 class="text-3xl font-semibold text-slate-900"><%= t('calendarSync.title') %></h1><p class="text-slate-500 mt-3"><%= t('calendarSync.intro') %></p></header>
  <section class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
    <h2 class="text-xl font-semibold text-slate-900"><%= t('calendarSync.appleTitle') %></h2><p class="text-sm text-slate-500 mt-2 mb-6"><%= t('calendarSync.appleIntro') %></p>
    <% if (appleAvailable) { %>
      <% if (flash.newAppPassword) { %><div class="rounded-xl border border-brand-200 bg-brand-50 p-4 mb-5"><p class="text-sm text-brand-800 mb-2"><%= t('calendarSync.passwordOnce') %></p><code class="block select-all break-all text-lg font-semibold"><%= flash.newAppPassword %></code></div><% } %>
      <div class="flex flex-wrap gap-3 mb-5">
        <form method="post" action="/app/settings/calendar-sync/apple-password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rounded-xl bg-brand-600 text-white font-medium px-4 py-3 hover:bg-brand-700"><%= t('calendarSync.appleStep1') %></button></form>
        <a href="/app/settings/calendar-sync/apple.mobileconfig" class="rounded-xl border border-slate-200 px-4 py-3 font-medium hover:bg-slate-50"><%= t('calendarSync.appleStep2') %></a>
      </div><p class="text-sm leading-relaxed text-slate-600"><%= t('calendarSync.appleStep3') %></p>
    <% } else { %><p class="rounded-xl bg-amber-50 text-amber-800 p-4 text-sm"><%= t('calendarSync.https') %></p><% } %>
    <a href="/app/settings/devices#app-passwords" class="inline-block text-sm text-brand-700 mt-4 hover:underline"><%= t('calendarSync.managePasswords') %></a>
  </section>
  <section class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
    <h2 class="text-xl font-semibold text-slate-900"><%= t('calendarSync.outlookTitle') %></h2><p class="text-sm text-slate-500 mt-2 mb-5"><%= t('calendarSync.outlookIntro') %></p>
    <% if (!configured) { %><div class="rounded-xl bg-slate-50 p-5 text-sm text-slate-600"><p><%= t('calendarSync.notConfigured') %></p><a class="inline-block mt-3 text-brand-700 hover:underline" href="https://github.com/wuha-like-sleep/by-wave-calendar/blob/main/docs/system-calendar-sync.md" target="_blank" rel="noopener noreferrer"><%= t('calendarSync.registerGuide') %> ↗</a></div><% } %>
    <% if (login) { %>
      <div class="rounded-xl bg-brand-50 border border-brand-200 p-5 my-5"><p class="text-sm text-brand-900"><%= t('calendarSync.loginHelp') %></p><code class="block text-3xl font-semibold tracking-widest my-4 select-all"><%= login.userCode %></code><div class="flex flex-wrap gap-3"><a href="<%= login.verificationUri %>" target="_blank" rel="noopener noreferrer" class="rounded-lg bg-brand-600 text-white px-4 py-2"><%= t('calendarSync.loginOpen') %> ↗</a><form method="post" action="/app/settings/calendar-sync/microsoft/finish"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rounded-lg border border-brand-300 px-4 py-2 text-brand-800"><%= t('calendarSync.finish') %></button></form></div><p class="text-xs text-slate-500 mt-4"><%= t('calendarSync.expires') %></p></div>
    <% } %>
    <% if (account) { %><p class="rounded-xl bg-emerald-50 text-emerald-800 p-4 text-sm font-medium mb-4"><%= account.label %></p><% } %>
    <% if (configured) { %><form method="post" action="/app/settings/calendar-sync/microsoft/start"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rounded-xl border border-slate-200 px-4 py-3 font-medium hover:bg-slate-50"><%= t(account ? 'calendarSync.reconnect' : 'calendarSync.connect') %></button></form><% } %>
    <% if (account) { %>
      <div class="mt-7 pt-6 border-t border-slate-100"><h3 class="font-semibold text-slate-900"><%= t('calendarSync.pairTitle') %></h3><p class="text-sm text-slate-500 mt-2 mb-4"><%= t('calendarSync.pairHelp') %></p>
        <% if (remoteError) { %><p class="rounded-xl bg-amber-50 p-4 text-amber-800 text-sm"><%= t('calendarSync.remoteUnavailable') %></p><% } else { %>
          <form method="post" action="/app/settings/calendar-sync/microsoft/calendar" class="mb-5"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-sm text-brand-700 hover:underline">+ <%= t('calendarSync.createCalendar') %></button></form>
          <form method="post" action="/app/settings/calendar-sync/pairs" class="grid sm:grid-cols-2 gap-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="text-sm text-slate-600">ByWave<select name="calendarId" required class="block w-full rounded-xl border-slate-200 mt-2"><option value=""><%= t('calendarSync.choose') %></option><% calendars.filter(c => !pairs.some(p => p.calendarId === c.id)).forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }); %></select></label>
            <label class="text-sm text-slate-600">Outlook<select name="remoteId" required class="block w-full rounded-xl border-slate-200 mt-2"><option value=""><%= t('calendarSync.choose') %></option><% remote.filter(c => !pairs.some(p => p.remoteId === c.id)).forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }); %></select></label>
            <button class="sm:col-span-2 justify-self-start rounded-xl bg-brand-600 text-white px-5 py-3 font-medium hover:bg-brand-700"><%= t('calendarSync.start') %></button>
          </form>
        <% } %>
      </div>
    <% } %>
    <p class="text-xs text-slate-500 leading-relaxed mt-6 rounded-xl bg-slate-50 p-4"><%= t('calendarSync.scope') %></p>
  </section>
  <% if (pairs.length) { %><section class="space-y-4"><h2 class="text-xl font-semibold text-slate-900"><%= t('calendarSync.statusTitle') %></h2><% pairs.forEach(p => { %>
    <article class="rounded-2xl border border-slate-200 bg-white p-6"><h3 class="font-semibold text-slate-900"><%= calendars.find(c => c.id === p.calendarId)?.name || 'ByWave' %> <span class="text-slate-400 px-2">↔</span> <%= p.remoteName %></h3>
      <p class="text-sm text-slate-500 mt-2"><% if (!p.enabled) { %><%= t('calendarSync.paused') %><% } else if (p.lastSyncedAt) { %><%= t('calendarSync.lastSync') %> · <%= p.lastSyncedAt.toISOString().replace('T', ' ').slice(0, 19) %> UTC<% } else { %><%= t('calendarSync.pending') %><% } %></p>
      <% if (p.error) { %><p class="text-sm text-amber-800 bg-amber-50 rounded-xl p-3 mt-3"><% const errorKey = 'calendarSync.error.' + (['invalid_grant','microsoft_reconnect','calendar_changed_retry'].includes(p.error) ? p.error : 'unavailable'); %><%= t(errorKey) %></p><% } %>
      <form method="post" action="/app/settings/calendar-sync/pairs/action" class="flex gap-3 my-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= p.id %>"><button name="action" value="<%= p.enabled ? 'pause' : 'resume' %>" class="rounded-lg border border-slate-200 px-3 py-2 text-sm"><%= t(p.enabled ? 'calendarSync.pause' : 'calendarSync.resume') %></button><% if (p.enabled) { %><button name="action" value="sync" class="rounded-lg bg-brand-50 text-brand-700 px-3 py-2 text-sm"><%= t('calendarSync.syncNow') %></button><% } %></form>
      <% (p.conflicts || []).forEach(c => { %><div class="rounded-xl border border-amber-200 bg-amber-50 p-4 mt-4"><h4 class="text-sm font-medium text-amber-900"><%= t('calendarSync.conflictTitle') %></h4><div class="grid sm:grid-cols-2 gap-3 my-3"><% [['ByWave',c.left],['Outlook',c.right]].forEach(([name,item]) => { %><div class="rounded-lg bg-white p-3 text-sm"><p class="text-xs text-slate-500 mb-2"><%= name %></p><p class="font-medium break-words"><%= item?.content.summary || t('calendarSync.deleted') %></p><% if (item) { %><p class="text-xs text-slate-500 mt-1"><%= item.content.startsAt %> — <%= item.content.endsAt %></p><p class="text-xs mt-2 whitespace-pre-wrap break-words"><%= item.content.location %></p><p class="text-xs mt-2 whitespace-pre-wrap break-words"><%= item.content.description %></p><% } %></div><% }); %></div><form method="post" action="/app/settings/calendar-sync/pairs/action" class="flex flex-wrap gap-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= p.id %>"><input type="hidden" name="action" value="resolve"><input type="hidden" name="key" value="<%= c.key %>"><button name="side" value="left" class="rounded-lg bg-white border border-amber-200 px-3 py-2 text-sm"><%= t('calendarSync.keepLeft') %></button><button name="side" value="right" class="rounded-lg bg-white border border-amber-200 px-3 py-2 text-sm"><%= t('calendarSync.keepRight') %></button></form></div><% }); %>
    </article><% }); %></section><% } %>
  <% if (account) { %><details class="rounded-2xl border border-slate-200 p-6"><summary class="cursor-pointer text-sm font-medium text-slate-700"><%= t('calendarSync.disconnectTitle') %></summary><p class="text-sm text-slate-500 mt-4"><%= t('calendarSync.disconnectHelp') %></p><form method="post" action="/app/settings/calendar-sync/microsoft/disconnect" class="mt-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="flex gap-2 text-sm text-slate-600 mb-4"><input type="checkbox" name="confirm" value="disconnect" required><%= t('calendarSync.disconnectConfirm') %></label><button class="rounded-lg border border-red-200 text-red-700 px-4 py-2 text-sm"><%= t('calendarSync.disconnect') %></button></form></details><% } %>
</div>
