<nav class="mb-4 text-sm text-slate-500">
  <a href="/app" class="hover:text-slate-700"><%= t("calendar.breadcrumb.myCalendars") %></a>
  <span class="px-2">/</span>
  <span class="text-slate-900"><%= calendar.name %></span>
</nav>

<header class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6">
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
    <div class="flex items-start gap-3 min-w-0">
      <span class="inline-block h-10 w-10 rounded-lg flex-shrink-0" style="background:<%= calendar.color %>"></span>
      <div class="min-w-0">
        <h1 class="text-xl sm:text-2xl font-semibold text-slate-900 truncate"><%= calendar.name %></h1>
        <% if (calendar.description) { %>
          <p class="mt-1 text-sm text-slate-500"><%= calendar.description %></p>
        <% } %>
        <p class="mt-1 text-xs text-slate-400"><%= t("calendar.timezone", { tz: calendar.timezone }) %></p>
      </div>
    </div>
    <div class="flex flex-wrap gap-2">
      <form method="post" action="/app/calendars/<%= calendar.id %>/delete" data-confirm="<%= t('calendar.deleteCalendar.confirm') %>" data-confirm-danger="1" data-confirm-ok="<%= t('calendar.deleteCalendar.ok') %>" data-confirm-title="<%= t('calendar.deleteCalendar.title') %>" class="m-0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="rounded-lg border border-red-200 bg-white px-3 py-1.5 text-sm text-red-700 hover:bg-red-50"><%= t("calendar.deleteCalendar.button") %></button>
      </form>
    </div>
  </div>
</header>

<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">

<section class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-5">
  <details>
    <summary class="cursor-pointer flex items-center justify-between gap-2">
      <span class="text-base font-semibold text-slate-900"><%= t("calendar.invite.heading") %> <% if (members && members.length > 0) { %><span class="ml-1 text-xs font-normal text-slate-400"><%= t("calendar.invite.memberCount", { count: members.length }) %></span><% } %></span>
      <span class="text-xs text-slate-400"><%= t("calendar.expand") %></span>
    </summary>
    <div class="mt-3 text-sm text-slate-500 mb-3"><%= t("calendar.invite.intro") %></div>

  <form method="post" action="/app/calendars/<%= calendar.id %>/invitations" class="grid grid-cols-1 sm:grid-cols-[1fr_auto_auto] gap-2 mb-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="email" name="email" required maxlength="254" placeholder="<%= t('calendar.invite.emailPlaceholder') %>"
           class="rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
    <select name="role" class="rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100">
      <option value="viewer"><%= t("calendar.invite.roleViewer") %></option>
      <option value="editor"><%= t("calendar.invite.roleEditor") %></option>
    </select>
    <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"><%= t("calendar.invite.send") %></button>
  </form>
  <textarea name="message" placeholder="<%= t('calendar.invite.messagePlaceholder') %>" maxlength="500" rows="2"
            class="hidden w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100"></textarea>

  <% if (members && members.length > 0) { %>
    <div class="mt-2">
      <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-2"><%= t("calendar.members.heading") %></h3>
      <ul class="divide-y divide-slate-100 border-t border-slate-100">
        <% members.forEach(function(m){ %>
          <li class="py-2.5 flex items-center justify-between gap-3">
            <div class="min-w-0">
              <div class="text-sm font-medium text-slate-900"><%= m.displayName || m.email %></div>
              <div class="text-xs text-slate-500"><%= m.email %> · <%= m.role === 'editor' ? t('calendar.members.roleEditorShort') : t('calendar.members.roleViewerShort') %></div>
            </div>
            <form method="post" action="/app/calendars/<%= calendar.id %>/members/<%= m.id %>/remove" class="m-0" data-confirm="<%= t('calendar.members.removeConfirm') %>" data-confirm-danger="1" data-confirm-ok="<%= t('calendar.members.removeOk') %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="text-xs text-red-600 hover:text-red-700 px-2 py-1"><%= t("calendar.members.remove") %></button>
            </form>
          </li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <% if (pendingInvitations && pendingInvitations.length > 0) { %>
    <div class="mt-4">
      <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-2"><%= t("calendar.invitations.pendingHeading") %></h3>
      <ul class="divide-y divide-slate-100 border-t border-slate-100">
        <% pendingInvitations.forEach(function(inv){ %>
          <li class="py-2.5 flex items-center justify-between gap-3">
            <div class="min-w-0">
              <div class="text-sm font-medium text-slate-900"><%= inv.email %></div>
              <div class="text-xs text-slate-500"><%= inv.role === 'editor' ? t('calendar.members.roleEditorShort') : t('calendar.members.roleViewerShort') %> · <%- t("calendar.invitations.expiresAt", { at: inv.expiresAtLocal }) %></div>
            </div>
            <form method="post" action="/app/calendars/<%= calendar.id %>/invitations/<%= encodeURIComponent(inv.token) %>/revoke" class="m-0" data-confirm="<%= t('calendar.invitations.revokeConfirm') %>" data-confirm-danger="1" data-confirm-ok="<%= t('calendar.invitations.revokeOk') %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="text-xs text-red-600 hover:text-red-700 px-2 py-1"><%= t("calendar.invitations.revoke") %></button>
            </form>
          </li>
        <% }) %>
      </ul>
    </div>
  <% } %>
  </details>
</section>

<section class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-5">
  <details>
    <summary class="cursor-pointer flex items-center justify-between gap-2">
      <span class="text-base font-semibold text-slate-900"><%= t("calendar.share.heading") %> <% if (shareTokens && shareTokens.length > 0) { %><span class="ml-1 text-xs font-normal text-slate-400"><%= t("calendar.share.count", { count: shareTokens.length }) %></span><% } %></span>
      <span class="text-xs text-slate-400"><%= t("calendar.expand") %></span>
    </summary>
    <div class="mt-3 text-sm text-slate-500 mb-3"><%= t("calendar.share.intro") %></div>

    <!-- One-shot snapshot download: 你的当前日历状态打包成 .ics，不需要订阅链接也不需要撤销。
         适合"我就是想把这本日历存档/给朋友/迁移到其他工具"的场景。 -->
    <a href="/app/calendars/<%= calendar.id %>/export.ics"
       class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-100 mb-4"
       download>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
      <%= t("calendar.share.downloadIcs") %>
    </a>

  <form method="post" action="/app/calendars/<%= calendar.id %>/share-tokens" class="flex flex-col sm:flex-row gap-2 mb-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="text" name="label" maxlength="100" placeholder="<%= t('calendar.share.labelPlaceholder') %>"
           class="flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
    <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"><%= t("calendar.share.generate") %></button>
  </form>

  <% if (shareTokens.length === 0) { %>
    <p class="text-sm text-slate-400 text-center py-4"><%= t("calendar.share.empty") %></p>
  <% } else { %>
    <ul class="divide-y divide-slate-100 border-t border-slate-100">
      <%
        // Loop variable renamed from `t` to `tok` to avoid shadowing the
        // i18n `t()` view helper inside the body of this forEach block.
        // Without this rename, every `t("key")` inside the loop would
        // throw "t is not a function" because `t` would be the share-
        // token object.
      %>
      <% shareTokens.forEach(function(tok){ %>
        <li class="py-3 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3">
          <div class="min-w-0 flex-1">
            <div class="text-sm font-medium text-slate-700"><%= tok.label || t("calendar.share.unnamed") %></div>
            <div class="mt-1 flex items-center gap-2">
              <code class="text-xs text-slate-500 truncate flex-1 bg-slate-50 px-2 py-1 rounded"><%= tok.url %></code>
            </div>
          </div>
          <div class="flex gap-2 flex-shrink-0 flex-wrap">
            <button type="button" class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50"
                    onclick="window.bwc.copy('<%= tok.url %>')"><%= t("calendar.share.copyIcs") %></button>
            <button type="button" class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50"
                    onclick="window.bwc.copy('&lt;iframe src=&quot;<%= tok.url.replace('/ics/', '/embed/').replace('.ics', '') %>&quot; width=&quot;100%&quot; height=&quot;600&quot; frameborder=&quot;0&quot;&gt;&lt;/iframe&gt;')"><%= t("calendar.share.copyEmbed") %></button>
            <form method="post" action="/app/calendars/<%= calendar.id %>/share-tokens/<%= tok.token %>/revoke" class="m-0" data-confirm="<%= t('calendar.share.revokeConfirm') %>" data-confirm-danger="1" data-confirm-ok="<%= t('calendar.share.revokeOk') %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="rounded-lg border border-red-200 bg-white px-3 py-1.5 text-xs text-red-700 hover:bg-red-50"><%= t("calendar.share.revoke") %></button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
  </details>
</section>

</div><!-- /two-col grid -->

<section class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-5 mb-6">
  <details>
    <summary class="cursor-pointer flex items-center justify-between gap-2">
      <span class="text-base font-semibold text-slate-900"><%= t("calendar.import.heading") %> <% if (subscriptions && subscriptions.length > 0) { %><span class="ml-1 text-xs font-normal text-slate-400"><%= t("calendar.import.subCount", { count: subscriptions.length }) %></span><% } %></span>
      <span class="text-xs text-slate-400"><%= t("calendar.expand") %></span>
    </summary>
    <div class="mt-3 text-sm text-slate-500 mb-3"><%= t("calendar.import.intro") %></div>

  <div class="mb-3 flex flex-wrap gap-2 border-b border-slate-200" id="import-tabs">
    <button type="button" data-tab="file"  class="import-tab px-3 py-2 text-sm font-medium border-b-2 border-brand-600 text-brand-700"><%= t("calendar.import.tabFile") %></button>
    <button type="button" data-tab="url"   class="import-tab px-3 py-2 text-sm font-medium border-b-2 border-transparent text-slate-500 hover:text-slate-700"><%= t("calendar.import.tabUrl") %></button>
    <button type="button" data-tab="sub"   class="import-tab px-3 py-2 text-sm font-medium border-b-2 border-transparent text-slate-500 hover:text-slate-700"><%= t("calendar.import.tabSub") %></button>
    <button type="button" data-tab="paste" class="import-tab px-3 py-2 text-sm font-medium border-b-2 border-transparent text-slate-500 hover:text-slate-700"><%= t("calendar.import.tabPaste") %></button>
  </div>

  <div data-pane="file" class="import-pane">
    <form method="post" action="/app/calendars/<%= calendar.id %>/import/file" enctype="multipart/form-data" class="flex flex-col sm:flex-row gap-2">
      <input type="file" name="file" accept=".ics,text/calendar" required
             class="flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm file:mr-3 file:rounded-md file:border-0 file:bg-slate-100 file:px-3 file:py-1 file:text-sm file:text-slate-700 hover:file:bg-slate-200" />
      <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"><%= t("calendar.import.fileSubmit") %></button>
    </form>
    <p class="mt-2 text-xs text-slate-400"><%= t("calendar.import.fileHint") %></p>
  </div>

  <div data-pane="url" class="import-pane hidden">
    <form method="post" action="/app/calendars/<%= calendar.id %>/import/url-once" class="flex flex-col sm:flex-row gap-2">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="url" name="url" required placeholder="<%= t('calendar.import.urlPlaceholder') %>"
             class="flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
      <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"><%= t("calendar.import.urlSubmit") %></button>
    </form>
    <p class="mt-2 text-xs text-slate-400"><%= t("calendar.import.urlHint") %></p>
  </div>

  <div data-pane="sub" class="import-pane hidden">
    <form method="post" action="/app/calendars/<%= calendar.id %>/subscriptions" class="space-y-2">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="flex flex-col sm:flex-row gap-2">
        <input type="url" name="url" required placeholder="<%= t('calendar.import.subUrlPlaceholder') %>"
               class="flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
        <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"><%= t("calendar.import.subSubmit") %></button>
      </div>
      <div class="flex flex-col sm:flex-row gap-2">
        <input type="text" name="label" maxlength="60" placeholder="<%= t('calendar.import.subLabelPlaceholder') %>"
               class="flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
        <select name="refreshMinutes"
                class="rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100">
          <option value="60"><%= t("calendar.import.refresh.hourly") %></option>
          <option value="360" selected><%= t("calendar.import.refresh.6h") %></option>
          <option value="720"><%= t("calendar.import.refresh.12h") %></option>
          <option value="1440"><%= t("calendar.import.refresh.daily") %></option>
          <option value="10080"><%= t("calendar.import.refresh.weekly") %></option>
        </select>
      </div>
    </form>
    <p class="mt-2 text-xs text-slate-400"><%= t("calendar.import.subHint") %></p>

    <% if (subscriptions && subscriptions.length > 0) { %>
      <ul class="mt-4 divide-y divide-slate-100 border-t border-slate-100">
        <% subscriptions.forEach(function(s){ %>
          <li class="py-3 flex items-center justify-between gap-3">
            <div class="min-w-0">
              <div class="text-sm font-medium text-slate-900 truncate"><%= s.label || s.url %></div>
              <div class="text-xs text-slate-500 break-all"><%= s.url %></div>
              <div class="text-xs mt-1">
                <% if (s.lastStatus === 'ok') { %>
                  <span class="text-emerald-600"><%- t("calendar.import.subStatus.ok", { at: s.lastFetchedAtLocal, count: s.lastEventCount }) %></span>
                <% } else if (s.lastStatus === 'error') { %>
                  <span class="text-red-600"><%- t("calendar.import.subStatus.error", { at: s.lastFetchedAtLocal, err: s.lastError }) %></span>
                <% } else { %>
                  <span class="text-slate-400"><%= t("calendar.import.subStatus.never") %></span>
                <% } %>
                <%= t("calendar.import.subStatus.every", { min: s.refreshMinutes }) %>
              </div>
            </div>
            <div class="flex gap-2 shrink-0">
              <form method="post" action="/app/calendars/<%= calendar.id %>/subscriptions/<%= s.id %>/refresh" class="m-0">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="text-xs text-brand-600 hover:text-brand-700 px-2 py-1"><%= t("calendar.import.subRefresh") %></button>
              </form>
              <form method="post" action="/app/calendars/<%= calendar.id %>/subscriptions/<%= s.id %>/delete" class="m-0" data-confirm="<%= t('calendar.import.subDelete.confirm') %>" data-confirm-danger="1" data-confirm-ok="<%= t('calendar.import.subDelete.ok') %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="text-xs text-red-600 hover:text-red-700 px-2 py-1"><%= t("calendar.import.subDelete.ok") %></button>
              </form>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>

  <div data-pane="paste" class="import-pane hidden">
    <form method="post" action="/app/calendars/<%= calendar.id %>/import/text" class="space-y-2">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <textarea name="text" required rows="6" placeholder="<%= t('calendar.import.pastePlaceholder') %>"
                class="w-full rounded-lg border border-slate-300 px-3 py-2 text-xs font-mono focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100"></textarea>
      <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"><%= t("calendar.import.pasteSubmit") %></button>
    </form>
    <p class="mt-2 text-xs text-slate-400"><%= t("calendar.import.pasteHint") %></p>
  </div>
  </details>
</section>

<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
(function(){
  const tabs = document.querySelectorAll(".import-tab");
  const panes = document.querySelectorAll(".import-pane");
  tabs.forEach(t => t.addEventListener("click", () => {
    const name = t.getAttribute("data-tab");
    tabs.forEach(x => {
      const active = x.getAttribute("data-tab") === name;
      x.classList.toggle("border-brand-600", active);
      x.classList.toggle("text-brand-700", active);
      x.classList.toggle("border-transparent", !active);
      x.classList.toggle("text-slate-500", !active);
    });
    panes.forEach(p => p.classList.toggle("hidden", p.getAttribute("data-pane") !== name));
  }));
})();
</script>

<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
  <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
    <h2 class="text-lg font-semibold text-slate-900"><%= t("calendar.events.heading") %></h2>
    <div class="flex items-center gap-2">
      <input type="date" id="event-filter-from"
             class="rounded-lg border border-slate-300 px-2 py-1 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
      <label class="inline-flex items-center gap-1 text-xs text-slate-600 cursor-pointer">
        <input type="checkbox" id="event-show-past" class="h-3.5 w-3.5 rounded border-slate-300 accent-brand-600" />
        <%= t("calendar.events.showPast") %>
      </label>
      <button type="button" onclick="document.getElementById('new-event-form').classList.toggle('hidden')"
              class="inline-flex items-center gap-1 rounded-lg bg-brand-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-brand-700">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
        <%= t("calendar.events.newButton") %>
      </button>
    </div>
  </div>

  <form id="new-event-form" method="post" action="/app/calendars/<%= calendar.id %>/events" class="hidden mb-4 grid sm:grid-cols-2 gap-3 rounded-lg bg-slate-50 p-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="sm:col-span-2">
      <label class="block text-xs font-medium text-slate-600 mb-1"><%= t("calendar.events.titleLabel") %></label>
      <input type="text" name="summary" required maxlength="500"
             class="block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
    </div>
    <div>
      <label class="block text-xs font-medium text-slate-600 mb-1"><%= t("calendar.events.startLabel") %></label>
      <input type="datetime-local" name="startsAt" required
             class="block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
    </div>
    <div>
      <label class="block text-xs font-medium text-slate-600 mb-1"><%= t("calendar.events.endLabel") %></label>
      <input type="datetime-local" name="endsAt" required
             class="block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
    </div>
    <div class="sm:col-span-2">
      <label class="block text-xs font-medium text-slate-600 mb-1"><%= t("calendar.events.locationLabel") %></label>
      <input type="text" name="location" maxlength="500"
             class="block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
    </div>
    <div class="sm:col-span-2">
      <label class="block text-xs font-medium text-slate-600 mb-1"><%= t("calendar.events.descriptionLabel") %></label>
      <textarea name="description" maxlength="5000" rows="2"
                class="block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100"></textarea>
    </div>
    <div class="sm:col-span-2 flex justify-end gap-2">
      <button type="button" onclick="document.getElementById('new-event-form').classList.add('hidden')"
              class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm text-slate-700 hover:bg-slate-50"><%= t("common.cancel") %></button>
      <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"><%= t("calendar.events.add") %></button>
    </div>
  </form>

  <% if (events.length === 0) { %>
    <p class="text-sm text-slate-400 text-center py-8"><%= t("calendar.events.empty") %></p>
  <% } else { %>
    <ul id="event-list" class="divide-y divide-slate-100">
      <% events.forEach(function(ev){ %>
        <li class="event-row py-3 flex items-start justify-between gap-3"
            data-starts="<%= ev.startsAt.toISOString() %>"
            data-ends="<%= ev.endsAt.toISOString() %>">
          <div class="min-w-0 flex-1">
            <div class="text-sm font-medium text-slate-900"><%= ev.summary %></div>
            <div class="mt-0.5 text-xs text-slate-500">
              <%- ev.startsAtLocal %> → <%- ev.endsAtLocal %>
              <% if (ev.location) { %> · <%= ev.location %><% } %>
            </div>
            <% if (ev.description) { %>
              <p class="mt-1 text-xs text-slate-500 whitespace-pre-wrap"><%= ev.description %></p>
            <% } %>
          </div>
          <form method="post" action="/app/events/<%= ev.id %>/delete" class="m-0 flex-shrink-0" data-confirm="<%= t('calendar.events.deleteConfirm') %>" data-confirm-danger="1" data-confirm-ok="<%= t('calendar.events.deleteOk') %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="text-xs text-red-600 hover:text-red-700 px-2 py-1"><%= t("calendar.events.delete") %></button>
          </form>
        </li>
      <% }) %>
    </ul>
    <p id="event-empty-msg" class="hidden text-sm text-slate-400 text-center py-8"><%= t("calendar.events.emptyFiltered") %></p>
  <% } %>
</section>

<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
(function(){
  // Default filter: today onwards, past events hidden. User can change the
  // "from" date or tick "显示过去事件" to widen the window.
  const fromEl = document.getElementById("event-filter-from");
  const pastEl = document.getElementById("event-show-past");
  const list = document.getElementById("event-list");
  const empty = document.getElementById("event-empty-msg");
  if (!fromEl || !list) return;

  const today = new Date(); today.setHours(0, 0, 0, 0);
  fromEl.value = today.toISOString().slice(0, 10);

  function apply() {
    const fromISO = fromEl.value ? new Date(fromEl.value + "T00:00:00") : null;
    const showPast = pastEl.checked;
    let visible = 0;
    list.querySelectorAll(".event-row").forEach((row) => {
      const ends = new Date(row.dataset.ends);
      const starts = new Date(row.dataset.starts);
      const inFuture = ends >= today;
      const afterFrom = fromISO ? starts >= fromISO : true;
      const keep = showPast ? afterFrom : (afterFrom && inFuture);
      row.classList.toggle("hidden", !keep);
      if (keep) visible++;
    });
    if (empty) empty.classList.toggle("hidden", visible > 0);
  }
  fromEl.addEventListener("change", apply);
  pastEl.addEventListener("change", apply);
  apply();
})();
</script>
