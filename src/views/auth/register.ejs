<div class="mx-auto max-w-md">
  <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
    <h1 class="text-2xl font-semibold text-slate-900"><%= t("register.title") %></h1>
    <p class="mt-1 text-sm text-slate-500"><%= t("register.subtitle") %></p>
    <div class="mt-4 rounded-lg bg-brand-50 border border-brand-100 px-3 py-2 text-xs text-brand-800">
      <%= t("register.verifyNotice") %>
    </div>

    <% if (typeof inviteToken !== "undefined" && inviteToken) { %>
    <div class="mt-4 flex items-center gap-2 rounded-lg bg-emerald-50 border border-emerald-100 px-3 py-2 text-xs text-emerald-800">
      <svg class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/></svg>
      <span><%= t("register.inviteNotice") %></span>
    </div>
    <% } %>

    <form method="post" action="/register" class="mt-6 space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <% if (typeof inviteToken !== "undefined" && inviteToken) { %>
      <input type="hidden" name="invite" value="<%= inviteToken %>" />
      <% } %>
      <!-- honeypot for bots -->
      <input type="text" name="company" tabindex="-1" autocomplete="off"
             class="absolute -left-[9999px] w-px h-px opacity-0" aria-hidden="true" />
      <div>
        <label class="block text-sm font-medium text-slate-700"><%= t("register.emailLabel") %></label>
        <input type="email" name="email" required autocomplete="email"
               value="<%= form?.email || '' %>"
               <%= (typeof inviteEmailLocked !== "undefined" && inviteEmailLocked) ? "readonly" : "" %>
               class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100 read-only:bg-slate-50 read-only:text-slate-500" />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700"><%= t("register.displayNameLabel") %></label>
        <input type="text" name="displayName" autocomplete="nickname" maxlength="100"
               value="<%= form?.displayName || '' %>"
               class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700"><%= t("register.passwordLabel") %></label>
        <input type="password" name="password" required minlength="8" autocomplete="new-password"
               class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
        <p class="mt-1 text-xs text-slate-500"><%= t("register.passwordHint") %></p>
      </div>
      <% if (typeof captcha !== "undefined" && captcha && captcha.provider !== "none") { %>
      <div>
        <% if (captcha.provider === "builtin") { %>
          <div data-bwc-captcha="builtin"
               data-mode="<%= captcha.builtin.mode %>"
               data-token="<%= captcha.builtin.token %>"
               data-challenge="<%= captcha.builtin.challenge %>"
               data-salt="<%= captcha.builtin.salt %>"
               data-difficulty="<%= captcha.builtin.difficulty %>"></div>
        <% } else { %>
          <div data-bwc-captcha="<%= captcha.provider %>" data-sitekey="<%= captcha.siteKey %>"></div>
        <% } %>
      </div>
      <% } %>
      <label class="flex items-start gap-2 text-xs text-slate-500">
        <input type="checkbox" name="agreeTerms" required class="mt-0.5 rounded border-slate-300 text-brand-600 focus:ring-brand-100" />
        <span><%- t("register.agreeTerms") %></span>
      </label>
      <button type="submit" class="w-full inline-flex justify-center rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-brand-700"><%= t("register.submit") %></button>
    </form>

    <script src="<%= (typeof jsBasePath !== 'undefined' ? jsBasePath : '/static') %>/bwc-captcha.js<%= (typeof assetVersion !== 'undefined' ? '?v=' + assetVersion : '') %>" defer></script>

    <p class="mt-6 text-center text-sm text-slate-500">
      <%= t("register.haveAccount") %><a href="/login" class="text-brand-600 hover:text-brand-700 font-medium"><%= t("register.signIn") %></a>
    </p>
  </div>
</div>
