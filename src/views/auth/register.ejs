<div class="mx-auto max-w-md">
  <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
    <h1 class="text-2xl font-semibold text-slate-900">创建账号</h1>
    <p class="mt-1 text-sm text-slate-500">免费使用，无需信用卡</p>

    <form method="post" action="/register" class="mt-6 space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div>
        <label class="block text-sm font-medium text-slate-700">邮箱</label>
        <input type="email" name="email" required autocomplete="email"
               value="<%= form?.email || '' %>"
               class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700">昵称（可选）</label>
        <input type="text" name="displayName" autocomplete="nickname" maxlength="100"
               value="<%= form?.displayName || '' %>"
               class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700">密码</label>
        <input type="password" name="password" required minlength="8" autocomplete="new-password"
               class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
        <p class="mt-1 text-xs text-slate-500">至少 8 个字符，建议混合字母数字</p>
      </div>
      <button type="submit" class="w-full inline-flex justify-center rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-brand-700">创建账号</button>
    </form>

    <p class="mt-6 text-center text-sm text-slate-500">
      已有账号？<a href="/login" class="text-brand-600 hover:text-brand-700 font-medium">登录</a>
    </p>
  </div>
</div>
