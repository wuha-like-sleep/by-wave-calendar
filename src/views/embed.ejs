<!DOCTYPE html>
<html lang="<%= currentLocale %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= calendar.name %></title>
  <link rel="stylesheet" href="/static/lib/toastui-calendar.min.css" />
  <style>
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; height: 100%; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #fff; color: #0f172a; }
    .embed-toolbar {
      display: flex; align-items: center; gap: 8px;
      padding: 8px 12px; border-bottom: 1px solid #e2e8f0;
      font-size: 13px;
    }
    .embed-toolbar .title { flex: 1; font-weight: 600; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .embed-toolbar button {
      background: #fff; border: 1px solid #e2e8f0; border-radius: 6px;
      padding: 4px 10px; font-size: 12px; cursor: pointer;
    }
    .embed-toolbar button:hover { background: #f8fafc; }
    .embed-toolbar .period { color: #475569; font-size: 12px; min-width: 0; padding: 0 4px; }
    #embed-cal { height: calc(100% - 41px); }
    /* "Now" line: one fixed red in light and dark mode, above the event
       blocks — same treatment as the main app (see app.css). Toast UI
       colours the segments/bullet via inline styles, hence !important. */
    .toastui-calendar-timegrid .toastui-calendar-timegrid-now-indicator {
      z-index: 30;
      pointer-events: none;
    }
    .toastui-calendar-timegrid .toastui-calendar-timegrid-now-indicator-left,
    .toastui-calendar-timegrid .toastui-calendar-timegrid-now-indicator-today,
    .toastui-calendar-timegrid .toastui-calendar-timegrid-now-indicator-right {
      border-top: 1px solid #e5484d !important;
    }
    .toastui-calendar-timegrid .toastui-calendar-timegrid-now-indicator-marker {
      background-color: #e5484d !important;
    }
    .powered {
      position: fixed; bottom: 6px; right: 8px; font-size: 10px;
      color: #94a3b8; text-decoration: none; background: rgba(255,255,255,0.85);
      padding: 2px 6px; border-radius: 4px;
    }
    /* The embed has no account context, so it follows the OS colour scheme
       of the embedding browser. Event blocks keep the calendar colour. */
    @media (prefers-color-scheme: dark) {
      html, body { background: #0f172a; color: #f1f5f9; color-scheme: dark; }
      .embed-toolbar { border-bottom-color: #334155; }
      .embed-toolbar button { background: #1e293b; border-color: #334155; color: #f1f5f9; }
      .embed-toolbar button:hover { background: #334155; }
      .embed-toolbar .period { color: #94a3b8; }
      #view-select { background: #1e293b !important; border-color: #334155 !important; color: #f1f5f9; }
      .powered { background: rgba(15,23,42,0.85); color: #64748b; }
      .toastui-calendar-timegrid-time,
      .toastui-calendar-weekday-event-title { color: #94a3b8; }
      .toastui-calendar-timezone-labels-slot,
      .toastui-calendar-timegrid-timezone-label { background-color: #1e293b; }
      .toastui-calendar-popup-container { background-color: #1e293b; color: #f1f5f9; border-color: #334155; }
      .toastui-calendar-popup-section-item { background-color: #0f172a; border-color: #334155; color: #f1f5f9; }
    }
  </style>
</head>
<body>
  <div class="embed-toolbar">
    <button type="button" id="btn-prev" aria-label="<%= t('embed.prevAria') %>">◀</button>
    <button type="button" id="btn-today"><%= t("embed.todayButton") %></button>
    <button type="button" id="btn-next" aria-label="<%= t('embed.nextAria') %>">▶</button>
    <span class="period" id="period-label">…</span>
    <span class="title" style="color: <%= calendar.color || '#6366f1' %>">● <%= calendar.name %></span>
    <select id="view-select" style="border:1px solid #e2e8f0;border-radius:6px;padding:4px 6px;font-size:12px;background:#fff;">
      <option value="month"><%= t("embed.viewMonth") %></option>
      <option value="week" selected><%= t("embed.viewWeek") %></option>
      <option value="day"><%= t("embed.viewDay") %></option>
    </select>
  </div>
  <div id="embed-cal"></div>
  <a class="powered" href="<%= publicBaseUrl %>" target="_blank" rel="noopener">Powered by ByWave</a>

  <script type="application/json" id="bwc-embed-i18n" nonce="<%= cspNonce %>"><%-
    JSON.stringify({
      dayLong: [
        t("embed.dayLongSun"),
        t("embed.dayLongMon"),
        t("embed.dayLongTue"),
        t("embed.dayLongWed"),
        t("embed.dayLongThu"),
        t("embed.dayLongFri"),
        t("embed.dayLongSat"),
      ],
      dayShort: [
        t("embed.dayShortSun"),
        t("embed.dayShortMon"),
        t("embed.dayShortTue"),
        t("embed.dayShortWed"),
        t("embed.dayShortThu"),
        t("embed.dayShortFri"),
        t("embed.dayShortSat"),
      ],
    })
  %></script>

  <!-- Load first: toastui-calendar embeds DOMPurify 2.3.8 but defers to an
       existing window.DOMPurify, so this replaces the vulnerable copy. -->
  <script src="/static/lib/purify.min.js"></script>
  <script src="/static/lib/toastui-calendar.min.js"></script>
  <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
  (function(){
    const EVENTS = <%- jsonForScript(events) %>;
    const CAL_COLOR = "<%= calendar.color || '#6366f1' %>";
    const LOCALE = "<%= currentLocale %>";
    const BWC_I18N = (() => {
      try { return JSON.parse(document.getElementById('bwc-embed-i18n').textContent); }
      catch { return { dayLong: [], dayShort: [] }; }
    })();
    // Same luminance rule as the main calendar app: bright calendar
    // colours get dark event text so titles stay readable.
    function textOn(hex) {
      const m = /^#?([0-9a-f]{6})$/i.exec(String(hex || "").trim());
      if (!m) return "#ffffff";
      const n = parseInt(m[1], 16);
      const lin = (v) => { const s = v / 255; return s <= 0.03928 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4); };
      const lum = 0.2126 * lin((n >> 16) & 255) + 0.7152 * lin((n >> 8) & 255) + 0.0722 * lin(n & 255);
      return lum > 0.21 ? "#1e293b" : "#ffffff";
    }
    const cal = new tui.Calendar("#embed-cal", {
      defaultView: "week",
      useFormPopup: false,
      useDetailPopup: true,
      isReadOnly: true,
      week: {
        taskView: false, eventView: ["time", "allday"],
        hourStart: 7, hourEnd: 23, startDayOfWeek: 1,
        dayNames: BWC_I18N.dayLong,
        showNowIndicator: true,
      },
      month: { startDayOfWeek: 1, dayNames: BWC_I18N.dayShort, visibleWeeksCount: 0, isAlways6Weeks: false },
      calendars: [{ id: "embed", name: "", backgroundColor: CAL_COLOR, borderColor: CAL_COLOR, dragBackgroundColor: CAL_COLOR, color: textOn(CAL_COLOR) }],
      // Same fixed-red "now" line as the main app (Toast UI's default is
      // indigo, and its future segment has no border at all).
      theme: {
        week: {
          nowIndicatorPast: { border: "1px solid #e5484d" },
          nowIndicatorToday: { border: "1px solid #e5484d" },
          nowIndicatorFuture: { border: "1px solid #e5484d" },
          nowIndicatorBullet: { backgroundColor: "#e5484d" },
        },
      },
    });
    cal.createEvents(EVENTS.map(e => ({
      id: e.id, calendarId: "embed",
      title: e.summary, location: e.location || undefined, body: e.description || undefined,
      start: e.allDay ? e.startsAt.slice(0,10) : e.startsAt,
      end:   e.allDay ? e.endsAt.slice(0,10)   : e.endsAt,
      isAllday: !!e.allDay, category: e.allDay ? "allday" : "time",
    })));

    let view = "week";
    function updateLabel(){
      const s = cal.getDateRangeStart().toDate();
      const e = cal.getDateRangeEnd().toDate();
      const fmt = new Intl.DateTimeFormat(LOCALE, { year:"numeric", month:"long", day:"numeric" });
      if (view === "month") {
        const mid = new Date((+s + +e)/2);
        document.getElementById("period-label").textContent = new Intl.DateTimeFormat(LOCALE, { year:"numeric", month:"long" }).format(mid);
      } else if (view === "day") {
        document.getElementById("period-label").textContent = new Intl.DateTimeFormat(LOCALE, { year:"numeric", month:"long", day:"numeric", weekday:"long" }).format(s);
      } else {
        document.getElementById("period-label").textContent = `${fmt.format(s)} – ${fmt.format(e)}`;
      }
    }
    document.getElementById("btn-today").addEventListener("click", () => { cal.today(); updateLabel(); });
    document.getElementById("btn-prev").addEventListener("click", () => { cal.prev(); updateLabel(); });
    document.getElementById("btn-next").addEventListener("click", () => { cal.next(); updateLabel(); });
    document.getElementById("view-select").addEventListener("change", (e) => {
      view = e.target.value; cal.changeView(view); updateLabel();
    });
    updateLabel();

    // Iframe auto-resize: tell the parent how tall we should be so the
    // hosting page (Notion / 个人主页) doesn't need to guess. Falls
    // through harmlessly when not embedded (window.parent === window).
    function emitHeight(){
      try {
        if (window.parent !== window) {
          const h = document.documentElement.scrollHeight;
          window.parent.postMessage({ type: "bwc-embed-height", height: h }, "*");
        }
      } catch {}
    }
    setTimeout(emitHeight, 200);
    window.addEventListener("resize", () => setTimeout(emitHeight, 100));
  })();
  </script>
</body>
</html>
