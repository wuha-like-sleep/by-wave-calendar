<div class="mx-auto max-w-md">
  <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
    <div class="mb-5 flex items-start gap-3">
      <% if (calendar) { %>
        <span class="inline-block h-10 w-10 rounded-lg flex-shrink-0" style="background:<%= calendar.color %>"></span>
      <% } %>
      <div>
        <h1 class="text-xl font-semibold text-slate-900">日历协作邀请</h1>
        <p class="mt-1 text-sm text-slate-500">
          <strong><%= inviterName %></strong> 邀请你加入日历
          <% if (calendar) { %><strong>「<%= calendar.name %>」</strong><% } %>
        </p>
      </div>
    </div>

    <div class="rounded-lg bg-slate-50 border border-slate-200 p-3 text-sm text-slate-700 mb-4">
      <div class="flex justify-between"><span class="text-slate-500">邀请邮箱</span><span class="font-medium"><%= invitation.email %></span></div>
      <div class="flex justify-between mt-1"><span class="text-slate-500">权限</span><span class="font-medium"><%= invitation.role === 'editor' ? '可编辑' : '只读查看' %></span></div>
    </div>

    <% if (invitation.message) { %>
      <div class="mb-4 rounded-lg border-l-3 border-brand-300 bg-brand-50/30 px-3 py-2 text-sm text-slate-700 whitespace-pre-wrap">
        <span class="block text-xs text-brand-700 font-medium mb-1">邀请人留言</span>
        <%= invitation.message %>
      </div>
    <% } %>

    <% if (!user) { %>
      <div class="rounded-lg bg-amber-50 border border-amber-200 p-3 text-sm text-amber-800 mb-4">
        你还没登录。请先用 <strong><%= invitation.email %></strong> 登录或注册同邮箱账号。
      </div>
      <div class="flex gap-2">
        <a href="/login" class="flex-1 inline-flex justify-center rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">登录</a>
        <% if (registrationOpen) { %>
          <a href="/register" class="flex-1 inline-flex justify-center rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">注册同邮箱账号</a>
        <% } %>
      </div>
    <% } else if (!emailMatches) { %>
      <div class="rounded-lg bg-amber-50 border border-amber-200 p-3 text-sm text-amber-800 mb-4">
        当前登录账号是 <strong><%= user.email %></strong>，不匹配邀请的邮箱 <strong><%= invitation.email %></strong>。<br/>
        请先<a href="/logout-then-login" class="underline">退出登录</a>，用 <%= invitation.email %> 重新登录。
      </div>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="w-full inline-flex justify-center rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">退出当前账号</button>
      </form>
    <% } else { %>
      <form method="post" action="/invite/<%= encodeURIComponent(invitation.token) %>/accept">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="w-full inline-flex justify-center rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-brand-700">接受邀请，加入日历</button>
      </form>
    <% } %>

    <p class="mt-6 text-center text-xs text-slate-400">邀请 7 天内有效，可随时被发起方撤销。</p>
  </div>
</div>
