<div class="mx-auto max-w-xl">
  <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">

    <% if (sourceEvent.deletedAt) { %>
      <div class="rounded-lg border-2 border-red-200 bg-red-50 p-4 mb-5">
        <div class="text-sm font-semibold text-red-900 mb-1"><%= t("inviteAccept.cancelledTitle") %></div>
        <div class="text-xs text-red-700"><%= t("inviteAccept.cancelledBody") %></div>
      </div>
    <% } %>

    <!-- Event card -->
    <div class="border-l-4 <%= sourceEvent.deletedAt ? 'border-red-400' : 'border-brand-500' %> pl-4 mb-5 <%= sourceEvent.deletedAt ? 'opacity-60' : '' %>">
      <h1 class="text-xl font-semibold text-slate-900 <%= sourceEvent.deletedAt ? 'line-through' : '' %>"><%= sourceEvent.summary %></h1>
      <div class="mt-1 text-sm text-slate-600">📅 <%- sourceEvent.startsAtLocal %> → <%- sourceEvent.endsAtLocal %></div>
      <% if (sourceEvent.location) { %><div class="mt-1 text-sm text-slate-600">📍 <%= sourceEvent.location %></div><% } %>
      <% if (sourceEvent.description) { %><div class="mt-2 text-sm text-slate-600 whitespace-pre-wrap line-clamp-4"><%= sourceEvent.description %></div><% } %>
      <div class="mt-2 text-xs text-slate-400"><%- t("inviteAccept.invitedAs", { email: recipientEmail }) %></div>
    </div>

    <% if (!sourceEvent.deletedAt) { %>
    <!-- Organizer + invitees -->
    <% if (organizer || invitees.length > 0) { %>
    <section class="mb-6">
      <h2 class="text-sm font-semibold text-slate-700 mb-2"><%= t("inviteAccept.inviteesHeading", { count: invitees.length }) %></h2>
      <ul class="divide-y divide-slate-100 rounded-xl border border-slate-200">
        <% if (organizer) { %>
          <li class="flex items-center gap-3 px-3 py-2.5">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm font-semibold text-white"><%= (organizer.name || organizer.email).slice(0, 1).toUpperCase() %></span>
            <span class="min-w-0 flex-1">
              <span class="block truncate text-sm font-medium text-slate-900"><%= organizer.name %></span>
              <span class="block truncate text-xs text-slate-400"><%= organizer.email %></span>
            </span>
            <span class="inline-flex items-center rounded-full bg-brand-50 text-brand-700 px-2 py-0.5 text-xs"><%= t("inviteAccept.organizerLabel") %></span>
          </li>
        <% } %>
        <% invitees.forEach(function(inv){ %>
          <li class="flex items-center gap-3 px-3 py-2.5">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-200 text-sm font-semibold text-slate-600"><%= (inv.name || inv.email).slice(0, 1).toUpperCase() %></span>
            <span class="min-w-0 flex-1">
              <span class="block truncate text-sm font-medium text-slate-900"><%= inv.name || inv.email %></span>
              <% if (inv.name) { %><span class="block truncate text-xs text-slate-400"><%= inv.email %></span><% } %>
            </span>
            <% if (inv.isMe) { %><span class="inline-flex items-center rounded-full bg-slate-100 text-slate-500 px-2 py-0.5 text-xs"><%= t("inviteAccept.youBadge") %></span><% } %>
            <% if (inv.status === 'accepted') { %>
              <span class="inline-flex items-center rounded-full bg-emerald-50 text-emerald-700 px-2 py-0.5 text-xs">✓ <%= t("inviteAccept.statusAccepted") %></span>
            <% } else if (inv.status === 'declined') { %>
              <span class="inline-flex items-center rounded-full bg-red-50 text-red-700 px-2 py-0.5 text-xs">✗ <%= t("inviteAccept.statusDeclined") %></span>
            <% } else if (inv.status === 'tentative') { %>
              <span class="inline-flex items-center rounded-full bg-amber-50 text-amber-700 px-2 py-0.5 text-xs">? <%= t("inviteAccept.statusTentative") %></span>
            <% } else { %>
              <span class="inline-flex items-center rounded-full bg-slate-100 text-slate-500 px-2 py-0.5 text-xs"><%= t("inviteAccept.statusPending") %></span>
            <% } %>
          </li>
        <% }) %>
      </ul>
    </section>
    <% } %>

    <!-- RSVP -->
    <section class="mb-6">
      <h2 class="text-sm font-semibold text-slate-700 mb-2"><%= t("inviteAccept.rsvpHeading") %></h2>
      <% if (responseStatus !== 'pending') { %>
        <div class="rounded-lg bg-slate-50 border border-slate-200 px-3 py-2.5 text-sm text-slate-700 mb-2">
          <% if (responseStatus === 'accepted') { %><%- t("inviteAccept.repliedAccepted") %>
          <% } else if (responseStatus === 'declined') { %><%- t("inviteAccept.repliedDeclined") %>
          <% } else { %><%- t("inviteAccept.repliedTentative") %><% } %>
          <%= t("inviteAccept.repliedSuffix") %>
        </div>
      <% } %>
      <div class="grid grid-cols-3 gap-2">
        <form method="post" action="/event-invite/<%= encodeURIComponent(token) %>/respond" class="m-0">
          <input type="hidden" name="status" value="accepted" />
          <button type="submit" class="w-full rounded-lg <%= responseStatus === 'accepted' ? 'bg-emerald-600 text-white' : 'border border-emerald-300 bg-emerald-50 text-emerald-800 hover:bg-emerald-100' %> px-3 py-2 text-sm font-medium">
            <%= t("inviteAccept.rsvpAccept") %>
          </button>
        </form>
        <form method="post" action="/event-invite/<%= encodeURIComponent(token) %>/respond" class="m-0">
          <input type="hidden" name="status" value="tentative" />
          <button type="submit" class="w-full rounded-lg <%= responseStatus === 'tentative' ? 'bg-amber-500 text-white' : 'border border-amber-300 bg-amber-50 text-amber-800 hover:bg-amber-100' %> px-3 py-2 text-sm font-medium">
            <%= t("inviteAccept.rsvpTentative") %>
          </button>
        </form>
        <form method="post" action="/event-invite/<%= encodeURIComponent(token) %>/respond" class="m-0">
          <input type="hidden" name="status" value="declined" />
          <button type="submit" class="w-full rounded-lg <%= responseStatus === 'declined' ? 'bg-red-600 text-white' : 'border border-red-300 bg-red-50 text-red-800 hover:bg-red-100' %> px-3 py-2 text-sm font-medium">
            <%= t("inviteAccept.rsvpDecline") %>
          </button>
        </form>
      </div>
    </section>

    <!-- Propose a new time -->
    <section class="mb-6">
      <h2 class="text-sm font-semibold text-slate-700 mb-2"><%= t("inviteAccept.proposeHeading") %></h2>
      <% if (myProposals.length > 0) { %>
        <ul class="mb-3 space-y-2">
          <% myProposals.forEach(function(p){ %>
            <li class="rounded-lg bg-slate-50 border border-slate-200 px-3 py-2.5 text-sm text-slate-700">
              <div><%- p.startsAtLocal %> → <%- p.endsAtLocal %></div>
              <% if (p.note) { %><div class="mt-0.5 text-xs text-slate-500"><%= p.note %></div><% } %>
              <div class="mt-1 text-xs">
                <% if (p.status === 'pending') { %><span class="text-amber-700"><%= t("inviteAccept.proposalPending") %></span>
                <% } else if (p.status === 'accepted') { %><span class="text-emerald-700">✓ <%= t("inviteAccept.proposalAccepted") %></span>
                <% } else if (p.status === 'declined') { %><span class="text-red-700">✗ <%= t("inviteAccept.proposalDeclined") %></span>
                <% } else { %><span class="text-slate-400"><%= t("inviteAccept.proposalSuperseded") %></span><% } %>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
      <form method="post" action="/event-invite/<%= encodeURIComponent(token) %>/propose" class="rounded-xl border border-slate-200 p-3">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <label class="block">
            <span class="text-xs text-slate-500"><%= t("inviteAccept.proposeStart") %></span>
            <input type="<%= sourceEvent.allDay ? 'date' : 'datetime-local' %>" name="start" required value="<%= proposalDefaults.start %>"
                   class="mt-0.5 w-full rounded-lg border border-slate-300 bg-white px-2.5 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
          </label>
          <label class="block">
            <span class="text-xs text-slate-500"><%= t("inviteAccept.proposeEnd") %></span>
            <input type="<%= sourceEvent.allDay ? 'date' : 'datetime-local' %>" name="end" required value="<%= proposalDefaults.end %>"
                   class="mt-0.5 w-full rounded-lg border border-slate-300 bg-white px-2.5 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
          </label>
        </div>
        <% if (!sourceEvent.allDay) { %>
          <p class="mt-1.5 text-xs text-slate-400"><%= t("inviteAccept.proposeTzNote", { tz: displayTz }) %></p>
        <% } %>
        <input type="text" name="note" maxlength="500" placeholder="<%= t('inviteAccept.proposeNote') %>"
               class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-2.5 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
        <button type="submit" class="mt-2 w-full rounded-lg border border-brand-300 bg-brand-50 px-3 py-2 text-sm font-medium text-brand-800 hover:bg-brand-100">
          <%= t("inviteAccept.proposeSubmit") %>
        </button>
      </form>
    </section>

    <!-- Add to calendar (multi-platform) -->
    <section>
      <h2 class="text-sm font-semibold text-slate-700 mb-3"><%= t("inviteAccept.addToCalendarHeading") %></h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        <a href="<%= googleCalendarUrl %>" target="_blank" rel="noopener"
           class="flex items-center justify-between gap-2 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 px-4 py-3 group">
          <span class="flex items-center gap-2.5">
            <svg class="h-5 w-5" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" fill="none">
              <rect x="8" y="8" width="32" height="32" rx="3" fill="#fff" stroke="#dadce0"/>
              <text x="24" y="30" text-anchor="middle" font-family="system-ui" font-size="14" font-weight="700" fill="#1a73e8"><%= new Date(sourceEvent.startsAt).getUTCDate() %></text>
            </svg>
            <span class="text-sm font-medium text-slate-900">Google Calendar</span>
          </span>
          <span class="text-xs text-slate-400 group-hover:text-slate-600"><%= t("inviteAccept.externalLink") %></span>
        </a>

        <a href="<%= icsDownloadUrl %>"
           class="flex items-center justify-between gap-2 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 px-4 py-3 group">
          <span class="flex items-center gap-2.5">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2.5a5.5 5.5 0 0 0-5.5 5.5v8a5.5 5.5 0 0 0 11 0V8A5.5 5.5 0 0 0 12 2.5Z" fill="#000"/>
              <path d="M16 6.5c-.5 0-1 .2-1.3.6-.3-.4-.8-.6-1.3-.6-1 0-1.7.8-1.7 1.8 0 .6.3 1.2.7 1.5l1.7 1.5c.3.3.7.3 1 0l1.7-1.5c.4-.3.7-.9.7-1.5 0-1-.7-1.8-1.7-1.8Z" fill="#fff"/>
            </svg>
            <span class="text-sm font-medium text-slate-900"><%= t("inviteAccept.icsLabel") %></span>
          </span>
          <span class="text-xs text-slate-400 group-hover:text-slate-600"><%= t("inviteAccept.icsDownload") %></span>
        </a>
      </div>

      <% if (user && calendars.length > 0) { %>
        <form method="post" action="/event-invite/<%= encodeURIComponent(token) %>/accept" class="mt-3 flex flex-col sm:flex-row gap-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <select name="calendarId" required
                  class="flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100">
            <% calendars.forEach(function(c){ %>
              <option value="<%= c.id %>"><%= t("inviteAccept.addToByWaveOption", { name: c.name }) %></option>
            <% }) %>
          </select>
          <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"><%= t("inviteAccept.addToByWaveButton") %></button>
        </form>
        <% if (alreadyAccepted) { %>
          <p class="mt-1 text-xs text-emerald-700"><%= t("inviteAccept.alreadyAcceptedNote") %></p>
        <% } %>
      <% } else if (!user) { %>
        <div class="mt-3 rounded-lg bg-slate-50 border border-slate-200 p-3 text-xs text-slate-500">
          <%- t("inviteAccept.loginPrompt", { email: recipientEmail }) %>
        </div>
      <% } else { %>
        <p class="mt-2 text-xs text-slate-400"><%- t("inviteAccept.noCalendarsPrompt") %></p>
      <% } %>
    </section>

    <p class="mt-6 text-center text-xs text-slate-400"><%= t("inviteAccept.footerNote") %></p>
    <% } %>

  </div>
</div>
