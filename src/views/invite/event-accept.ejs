<div class="mx-auto max-w-xl">
  <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">

    <!-- Event card -->
    <div class="border-l-4 border-brand-500 pl-4 mb-5">
      <h1 class="text-xl font-semibold text-slate-900"><%= sourceEvent.summary %></h1>
      <div class="mt-1 text-sm text-slate-600">📅 <%- sourceEvent.startsAtLocal %> → <%- sourceEvent.endsAtLocal %></div>
      <% if (sourceEvent.location) { %><div class="mt-1 text-sm text-slate-600">📍 <%= sourceEvent.location %></div><% } %>
      <% if (sourceEvent.description) { %><div class="mt-2 text-sm text-slate-600 whitespace-pre-wrap line-clamp-4"><%= sourceEvent.description %></div><% } %>
      <div class="mt-2 text-xs text-slate-400">邀请发给 <strong><%= recipientEmail %></strong></div>
    </div>

    <!-- RSVP -->
    <section class="mb-6">
      <h2 class="text-sm font-semibold text-slate-700 mb-2">你会参加吗？</h2>
      <% if (responseStatus !== 'pending') { %>
        <div class="rounded-lg bg-slate-50 border border-slate-200 px-3 py-2.5 text-sm text-slate-700 mb-2">
          <% if (responseStatus === 'accepted') { %>✅ 已回复：<strong>参加</strong>
          <% } else if (responseStatus === 'declined') { %>❌ 已回复：<strong>不参加</strong>
          <% } else { %>🤔 已回复：<strong>可能参加</strong><% } %>
          —— 邀请人可以在他们的「管理参与者」页看到。
        </div>
      <% } %>
      <div class="grid grid-cols-3 gap-2">
        <form method="post" action="/event-invite/<%= encodeURIComponent(token) %>/respond" class="m-0">
          <input type="hidden" name="status" value="accepted" />
          <button type="submit" class="w-full rounded-lg <%= responseStatus === 'accepted' ? 'bg-emerald-600 text-white' : 'border border-emerald-300 bg-emerald-50 text-emerald-800 hover:bg-emerald-100' %> px-3 py-2 text-sm font-medium">
            ✓ 参加
          </button>
        </form>
        <form method="post" action="/event-invite/<%= encodeURIComponent(token) %>/respond" class="m-0">
          <input type="hidden" name="status" value="tentative" />
          <button type="submit" class="w-full rounded-lg <%= responseStatus === 'tentative' ? 'bg-amber-500 text-white' : 'border border-amber-300 bg-amber-50 text-amber-800 hover:bg-amber-100' %> px-3 py-2 text-sm font-medium">
            ? 可能
          </button>
        </form>
        <form method="post" action="/event-invite/<%= encodeURIComponent(token) %>/respond" class="m-0">
          <input type="hidden" name="status" value="declined" />
          <button type="submit" class="w-full rounded-lg <%= responseStatus === 'declined' ? 'bg-red-600 text-white' : 'border border-red-300 bg-red-50 text-red-800 hover:bg-red-100' %> px-3 py-2 text-sm font-medium">
            ✗ 不参加
          </button>
        </form>
      </div>
    </section>

    <!-- Add to calendar (multi-platform) -->
    <section>
      <h2 class="text-sm font-semibold text-slate-700 mb-3">加到我的日历</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        <a href="<%= googleCalendarUrl %>" target="_blank" rel="noopener"
           class="flex items-center justify-between gap-2 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 px-4 py-3 group">
          <span class="flex items-center gap-2.5">
            <svg class="h-5 w-5" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" fill="none">
              <rect x="8" y="8" width="32" height="32" rx="3" fill="#fff" stroke="#dadce0"/>
              <text x="24" y="30" text-anchor="middle" font-family="system-ui" font-size="14" font-weight="700" fill="#1a73e8"><%= new Date(sourceEvent.startsAt).getUTCDate() %></text>
            </svg>
            <span class="text-sm font-medium text-slate-900">Google Calendar</span>
          </span>
          <span class="text-xs text-slate-400 group-hover:text-slate-600">外部 →</span>
        </a>

        <a href="<%= icsDownloadUrl %>"
           class="flex items-center justify-between gap-2 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 px-4 py-3 group">
          <span class="flex items-center gap-2.5">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2.5a5.5 5.5 0 0 0-5.5 5.5v8a5.5 5.5 0 0 0 11 0V8A5.5 5.5 0 0 0 12 2.5Z" fill="#000"/>
              <path d="M16 6.5c-.5 0-1 .2-1.3.6-.3-.4-.8-.6-1.3-.6-1 0-1.7.8-1.7 1.8 0 .6.3 1.2.7 1.5l1.7 1.5c.3.3.7.3 1 0l1.7-1.5c.4-.3.7-.9.7-1.5 0-1-.7-1.8-1.7-1.8Z" fill="#fff"/>
            </svg>
            <span class="text-sm font-medium text-slate-900">Apple / Outlook (.ics)</span>
          </span>
          <span class="text-xs text-slate-400 group-hover:text-slate-600">下载</span>
        </a>
      </div>

      <% if (user && calendars.length > 0) { %>
        <form method="post" action="/event-invite/<%= encodeURIComponent(token) %>/accept" class="mt-3 flex flex-col sm:flex-row gap-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <select name="calendarId" required
                  class="flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100">
            <% calendars.forEach(function(c){ %>
              <option value="<%= c.id %>">加入到 ByWave · <%= c.name %></option>
            <% }) %>
          </select>
          <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">加进去</button>
        </form>
        <% if (alreadyAccepted) { %>
          <p class="mt-1 text-xs text-emerald-700">✓ 已经加进过你的 ByWave 日历；再次加入会复制一份。</p>
        <% } %>
      <% } else if (!user) { %>
        <div class="mt-3 rounded-lg bg-slate-50 border border-slate-200 p-3 text-xs text-slate-500">
          想把它加到 ByWave 日历？<a href="/login" class="text-brand-600 underline">用 <%= recipientEmail %> 登录</a> 即可选择目标日历。
        </div>
      <% } else { %>
        <p class="mt-2 text-xs text-slate-400">你还没有 ByWave 日历 —— <a href="/app" class="text-brand-600 underline">先创建一个</a>，再回来选择目标。</p>
      <% } %>
    </section>

    <p class="mt-6 text-center text-xs text-slate-400">不论选哪个，邀请人都会在「管理参与者」页面看到你的回复状态。</p>
  </div>
</div>
