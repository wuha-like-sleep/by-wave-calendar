<!doctype html>
<html lang="zh-CN"
      data-theme="<%= typeof themePalette !== 'undefined' ? themePalette : 'indigo' %>"
      data-density="<%= typeof themeDensity !== 'undefined' ? themeDensity : 'comfortable' %>"
      data-app-version="<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="csrf-token" content="<%= csrfToken %>" />
    <title><%= title %> · <%= (typeof siteName !== 'undefined' && siteName) ? siteName : 'ByWave-Calendar' %></title>
    <link rel="icon" type="image/svg+xml" href="<%= (typeof siteLogoUrl !== 'undefined' && siteLogoUrl) ? siteLogoUrl : '/static/favicon.svg' %>" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <%# iOS reads apple-mobile-web-app-title for the home-screen icon
        label rather than the manifest's short_name — so set both. %>
    <meta name="apple-mobile-web-app-title" content="<%= (typeof siteName !== 'undefined' && siteName) ? siteName : 'ByWave-Calendar' %>" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <% const v = typeof assetVersion !== 'undefined' ? assetVersion : '1'; %>
    <link rel="stylesheet" href="/static/css/styles.css?v=<%= v %>" />
    <link rel="stylesheet" href="/static/app.css?v=<%= v %>" />
    <% const js = typeof jsBasePath !== 'undefined' ? jsBasePath : '/static'; %>
    <script defer src="/static/lib/htmx.min.js"></script>
    <script src="<%= js %>/app.js?v=<%= v %>" defer></script>
    <script src="<%= js %>/local-time.js?v=<%= v %>" defer></script>
    <script src="<%= js %>/version-check.js?v=<%= v %>" defer></script>
    <script src="<%= js %>/banners.js?v=<%= v %>" defer></script>
    <%# Inline critical splash styles. Inlined so the splash renders
        before app.css finishes downloading. The same .bwc-boot-splash
        rule lives in app.css for consistency, but having it inline
        ensures cold-cache loads (PWA killed + reopened) still get the
        nice gradient instead of a 200ms white flash. %>
    <style>
      .bwc-boot-splash {
        position: fixed; inset: 0; z-index: 9999;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 1.25rem;
        background: linear-gradient(160deg, #f8fafc 0%, #eef2ff 60%, #ede9fe 100%);
        transition: opacity 220ms ease, visibility 0s linear 220ms;
        opacity: 1; visibility: visible;
      }
      body.bwc-booted .bwc-boot-splash { opacity: 0; visibility: hidden; pointer-events: none; }
      .bwc-boot-splash__logo {
        width: 64px; height: 64px; border-radius: 16px;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        box-shadow: 0 8px 24px rgba(79, 70, 229, 0.25);
        display: flex; align-items: center; justify-content: center;
        animation: bwc-pulse 1.6s ease-in-out infinite;
      }
      .bwc-boot-splash__name { font-size: 14px; font-weight: 500; color: #475569; letter-spacing: 0.5px; }
      .bwc-boot-splash__spinner {
        width: 22px; height: 22px; border-radius: 50%;
        border: 2.5px solid rgba(79, 70, 229, 0.18);
        border-top-color: #4f46e5;
        animation: bwc-spin 0.7s linear infinite;
      }
      .bwc-boot-splash__msg { font-size: 12px; color: #64748b; margin-top: -0.25rem; min-height: 1em; }
      @keyframes bwc-pulse { 0%,100%{transform:scale(1);opacity:1} 50%{transform:scale(.95);opacity:.85} }
      @keyframes bwc-spin { to { transform: rotate(360deg); } }

      /* Page transitions: every same-origin navigation cross-fades. Chrome
         126+ / Safari 18+ honor this; older browsers just navigate normally. */
      @view-transition { navigation: auto; }
      ::view-transition-old(root),
      ::view-transition-new(root) { animation-duration: 180ms; animation-timing-function: ease; }

      /* Graceful fallback for Firefox + older browsers: a gentle fade-in
         on first paint so navigation doesn't feel like a hard flash.
         Skipped when prefers-reduced-motion is set. */
      @media (prefers-reduced-motion: no-preference) {
        body { animation: bwc-page-in 160ms ease-out; }
      }
      @keyframes bwc-page-in { from { opacity: .85; } to { opacity: 1; } }
    </style>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased font-sans flex flex-col">
    <%# Boot splash — shows immediately on every page load + every time
        the PWA cold-launches from the home-screen icon (iOS clears the
        app state when killed). app.js adds `.bwc-booted` to <body> on
        DOMContentLoaded which fades it out. Also programmatically
        controllable via window.bwc.loading.show() / .hide() for long
        in-page operations (route changes, big imports, etc). %>
    <div class="bwc-boot-splash" id="bwc-boot-splash" role="status" aria-live="polite">
      <div class="bwc-boot-splash__logo">
        <%# 12px white inner mark — keeps splash recognizable without
            depending on an external image fetch (which could itself be
            slow on cold cache). %>
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2.5"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
      </div>
      <div class="bwc-boot-splash__spinner"></div>
      <div class="bwc-boot-splash__name"><%= (typeof siteName !== 'undefined' && siteName) ? siteName : 'ByWave-Calendar' %></div>
      <div class="bwc-boot-splash__msg" id="bwc-boot-splash-msg"></div>
    </div>
    <%- include('partials/nav', { user: user, siteName: typeof siteName !== 'undefined' ? siteName : 'ByWave-Calendar', siteLogoUrl: typeof siteLogoUrl !== 'undefined' ? siteLogoUrl : null }) %>
    <% if (typeof appShell !== 'undefined' && appShell) { %>
      <main class="flex-1 min-h-0 flex flex-col">
        <%- body %>
      </main>
    <% } else { %>
      <main class="flex-1 mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
        <%- include('partials/flash', { flash: flash }) %>
        <%- include('partials/banners') %>
        <%- body %>
      </main>
      <footer class="mt-16 border-t border-slate-200 bg-white">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-6 text-sm text-slate-500 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div class="flex items-center gap-3 flex-wrap">
            <span>© <%= (typeof siteName !== 'undefined' && siteName) ? siteName : 'ByWave-Calendar' %> · 日历共享平台</span>
            <a href="https://github.com/wuha-like-sleep/by-wave-calendar" target="_blank" rel="noopener"
               class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs text-slate-700 hover:bg-slate-100 hover:border-slate-300 transition">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.387.6.113.82-.26.82-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.305-5.467-1.334-5.467-5.93 0-1.31.468-2.382 1.235-3.222-.135-.303-.54-1.524.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.4 3-.405 1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.652.24 2.873.12 3.176.765.84 1.23 1.912 1.23 3.222 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22v3.293c0 .32.21.694.825.577C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z"/></svg>
              我们的开源项目
            </a>
          </div>
          <div class="flex flex-wrap gap-3 text-xs text-slate-400 items-center">
            <a href="/" class="hover:text-slate-700">首页</a>
            <a href="/about" class="hover:text-slate-700">关于</a>
            <a href="https://github.com/wuha-like-sleep/by-wave-calendar" target="_blank" rel="noopener" class="hover:text-slate-700">源代码</a>
            <% if (typeof icpNumber !== 'undefined' && icpNumber) { %>
              <span class="text-slate-300">·</span>
              <a href="<%= icpUrl %>" target="_blank" rel="noopener" class="hover:text-slate-700"><%= icpNumber %></a>
            <% } %>
          </div>
        </div>
      </footer>
    <% } %>
    <% if (typeof appShell !== 'undefined' && appShell) { %>
      <div class="border-t border-slate-200 bg-white py-1.5 px-4 text-center text-[11px] text-slate-400">
        © <%= (typeof siteName !== 'undefined' && siteName) ? siteName : 'ByWave-Calendar' %> · 我们的开源项目
        <% if (typeof icpNumber !== 'undefined' && icpNumber) { %>
          · <a href="<%= icpUrl %>" target="_blank" rel="noopener" class="hover:text-slate-600"><%= icpNumber %></a>
        <% } %>
      </div>
    <% } %>
    <div id="toast-root" class="fixed inset-x-0 bottom-4 z-50 flex flex-col items-center gap-2 px-4 sm:items-end sm:right-4 sm:left-auto pointer-events-none"></div>

    <!-- Cmd+K command palette — available on every page so users can jump
         to any calendar / event / page without going through the nav. The
         modal stays in the DOM but hidden; only opens on Cmd/Ctrl-K, "/"
         (when not in an input), or a click on the small "⌘K" hint in the
         nav (auth pages don't render the palette at all). -->
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
    <div id="bwc-palette" class="hidden fixed inset-0 z-[60] bg-slate-900/40 backdrop-blur-sm flex items-start justify-center pt-[15vh] px-4">
      <div class="w-full max-w-xl bg-white rounded-2xl shadow-2xl overflow-hidden border border-slate-200">
        <div class="border-b border-slate-100 flex items-center px-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-5-5"/></svg>
          <input type="text" id="palette-input" placeholder="搜索事件、跳转页面…"
                 class="flex-1 py-3 px-3 text-sm bg-transparent border-0 focus:outline-none focus:ring-0 placeholder:text-slate-400" />
          <kbd class="text-xs text-slate-400 bg-slate-100 rounded px-1.5 py-0.5">Esc</kbd>
        </div>
        <ul id="palette-results" class="max-h-[50vh] overflow-y-auto py-1 text-sm"></ul>
        <div class="border-t border-slate-100 px-4 py-2 text-xs text-slate-400 flex items-center gap-3">
          <span>↑↓ 导航</span><span>↵ 选择</span><span>Esc 关闭</span>
        </div>
      </div>
    </div>
    <% } %>

    <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
    <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>" src="<%= (typeof jsBasePath !== 'undefined' ? jsBasePath : '/static') %>/palette.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>" defer></script>
    <% } %>
  </body>
</html>
