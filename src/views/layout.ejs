<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'zh-CN' %>"
      data-theme="<%= typeof themePalette !== 'undefined' ? themePalette : 'indigo' %>"
      data-density="<%= typeof themeDensity !== 'undefined' ? themeDensity : 'comfortable' %>"
      data-mode-pref="<%= typeof themeMode !== 'undefined' ? themeMode : 'system' %>"
      data-app-version="<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>">
  <head>
    <meta charset="utf-8" />
    <%# theme-color sits BEFORE the mode script on purpose: the script
        re-tints this meta to the resolved colour mode, and it can only
        find the element if it is already parsed. Static value is the
        light surface; the script corrects it before first paint (and,
        unlike a media-attribute pair of metas, also follows a manual
        light/dark preference). %>
    <meta name="theme-color" content="#f8fafc" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <%# Colour mode resolution — MUST run before the stylesheets below are
        applied, or a dark-mode user gets a white flash on every navigation.
        The server renders the saved preference into data-mode-pref (cookie
        backed, so logged-out pages get "system"); "system" resolves here
        through matchMedia, synchronously, and a listener keeps "system"
        live when the OS flips while the page is open. %>
    <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
      (function () {
        var root = document.documentElement;
        var mq = window.matchMedia("(prefers-color-scheme: dark)");
        function apply() {
          var pref = root.getAttribute("data-mode-pref") || "system";
          var dark = pref === "dark" || (pref === "system" && mq.matches);
          root.setAttribute("data-mode", dark ? "dark" : "light");
          root.style.colorScheme = dark ? "dark" : "light";
          // Keep the browser/PWA chrome tint on the resolved mode, not the
          // OS scheme alone: a manual light/dark preference must win. The
          // values match the app surfaces (slate-50 / the dark splash's
          // deep end) so the status-bar area blends into the page.
          var tc = document.querySelector('meta[name="theme-color"]');
          if (tc) tc.setAttribute("content", dark ? "#0b1120" : "#f8fafc");
        }
        apply();
        if (mq.addEventListener) mq.addEventListener("change", apply);
        else if (mq.addListener) mq.addListener(apply);
      })();
    </script>
    <meta name="csrf-token" content="<%= csrfToken %>" />
    <title><%= title %> · <%= (typeof siteName !== 'undefined' && siteName) ? siteName : 'ByWave-Calendar' %></title>
    <%# SEO / 分享卡片：公开页（首页、下载、支持、法律页）靠这几行在搜索
        结果和聊天软件里有个像样的摘要。页面可传 metaDescription 覆盖，
        缺省走全站文案。og:url / og:image 需要绝对地址，而本站是自托管、
        域名由运营者决定，服务端没有可靠的公开 origin，就不写死。 %>
    <% const metaDesc = (typeof metaDescription !== 'undefined' && metaDescription) ? metaDescription : t("meta.description"); %>
    <meta name="description" content="<%= metaDesc %>" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="<%= (typeof siteName !== 'undefined' && siteName) ? siteName : 'ByWave-Calendar' %>" />
    <meta property="og:title" content="<%= title %> · <%= (typeof siteName !== 'undefined' && siteName) ? siteName : 'ByWave-Calendar' %>" />
    <meta property="og:description" content="<%= metaDesc %>" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="<%= title %> · <%= (typeof siteName !== 'undefined' && siteName) ? siteName : 'ByWave-Calendar' %>" />
    <meta name="twitter:description" content="<%= metaDesc %>" />
    <% const v = typeof assetVersion !== 'undefined' ? assetVersion : '1'; %>
    <link rel="icon" type="image/svg+xml" href="<%= (typeof siteLogoUrl !== 'undefined' && siteLogoUrl) ? siteLogoUrl : '/static/favicon.svg?v=' + encodeURIComponent(v) %>" />
    <% if (typeof siteLogoUrl !== 'undefined' && siteLogoUrl) { %>
    <link rel="apple-touch-icon" href="<%= siteLogoUrl %>" />
    <% } else { %>
    <%# Default icon in the three sizes iOS asks for (180 current phones,
        167 iPad, 152 older iPads) so no device has to upscale a favicon. %>
    <link rel="apple-touch-icon" href="/static/icons/apple-touch-icon.png?v=<%= encodeURIComponent(v) %>" />
    <link rel="apple-touch-icon" sizes="167x167" href="/static/icons/apple-touch-icon-167.png?v=<%= encodeURIComponent(v) %>" />
    <link rel="apple-touch-icon" sizes="152x152" href="/static/icons/apple-touch-icon-152.png?v=<%= encodeURIComponent(v) %>" />
    <%# iOS launch screens. Without these, a cold-started home-screen app
        shows the system default blank until first paint; with them it
        shows the brand gradient + icon, which the in-page boot splash
        then continues seamlessly. Portrait sizes of the current iPhone
        range; devices without an exact match (e.g. foldables) fall back
        to the default behaviour. %>
    <link rel="apple-touch-startup-image" media="(device-width: 375px) and (device-height: 667px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait)" href="/static/icons/splash/apple-splash-750-1334.png?v=<%= encodeURIComponent(v) %>" />
    <link rel="apple-touch-startup-image" media="(device-width: 375px) and (device-height: 812px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href="/static/icons/splash/apple-splash-1125-2436.png?v=<%= encodeURIComponent(v) %>" />
    <link rel="apple-touch-startup-image" media="(device-width: 390px) and (device-height: 844px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href="/static/icons/splash/apple-splash-1170-2532.png?v=<%= encodeURIComponent(v) %>" />
    <link rel="apple-touch-startup-image" media="(device-width: 393px) and (device-height: 852px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href="/static/icons/splash/apple-splash-1179-2556.png?v=<%= encodeURIComponent(v) %>" />
    <link rel="apple-touch-startup-image" media="(device-width: 402px) and (device-height: 874px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href="/static/icons/splash/apple-splash-1206-2622.png?v=<%= encodeURIComponent(v) %>" />
    <link rel="apple-touch-startup-image" media="(device-width: 414px) and (device-height: 896px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait)" href="/static/icons/splash/apple-splash-828-1792.png?v=<%= encodeURIComponent(v) %>" />
    <link rel="apple-touch-startup-image" media="(device-width: 414px) and (device-height: 896px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href="/static/icons/splash/apple-splash-1242-2688.png?v=<%= encodeURIComponent(v) %>" />
    <link rel="apple-touch-startup-image" media="(device-width: 428px) and (device-height: 926px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href="/static/icons/splash/apple-splash-1284-2778.png?v=<%= encodeURIComponent(v) %>" />
    <link rel="apple-touch-startup-image" media="(device-width: 430px) and (device-height: 932px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href="/static/icons/splash/apple-splash-1290-2796.png?v=<%= encodeURIComponent(v) %>" />
    <link rel="apple-touch-startup-image" media="(device-width: 440px) and (device-height: 956px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href="/static/icons/splash/apple-splash-1320-2868.png?v=<%= encodeURIComponent(v) %>" />
    <% } %>
    <link rel="manifest" href="/manifest.webmanifest" />
    <%# iOS reads apple-mobile-web-app-title for the home-screen icon
        label rather than the manifest's short_name — so set both. %>
    <meta name="apple-mobile-web-app-title" content="<%= (typeof siteName !== 'undefined' && siteName) ? siteName : 'ByWave-Calendar' %>" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <%# "default": the status bar keeps its own (light) background and the
        page starts below it — declared explicitly so every page makes the
        same choice. Paired with viewport-fit=cover, landscape side insets
        are handled by the safe-area padding in the CSS. %>
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="mobile-web-app-capable" content="yes" />
    <link rel="stylesheet" href="/static/css/styles.css?v=<%= v %>" />
    <link rel="stylesheet" href="/static/app.css?v=<%= v %>" />
    <% const js = typeof jsBasePath !== 'undefined' ? jsBasePath : '/static'; %>
    <%# auth-guard first: wraps window.fetch before any app script runs, so an
        expired-session 401 bounces the user to /login instead of silently
        failing in place. %>
    <script src="<%= js %>/auth-guard.js?v=<%= v %>" defer></script>
    <%# htmx 不再全局加载：全站模板里没有任何 hx-* 属性在用它（只有 app.js /
        auth-guard 里几个监听 htmx 事件的防御性钩子，没装 htmx 时它们就是
        空转的 addEventListener）。以前每个页面都白下载 52KB（gzip 17KB）
        再执行一遍。哪个页面真需要时自己引，别让所有页面替它买单。 %>
    <script src="<%= js %>/app.js?v=<%= v %>" defer></script>
    <script src="<%= js %>/local-time.js?v=<%= v %>" defer></script>
    <%# version-check.js 在所有页面都跑，拿不到 /app 才注入的 BWC_T。
        沿用 login 页的办法：把它的几条文案在服务端先解析好递过去，
        免得英文/日文用户看到一个中文的「新版本就绪」浮标和离线横幅。
        jsonForScript 是服务端注册进视图默认值的；直接渲染这个模板的
        场景（测试）可能没有它 —— 那时退回同款转义手工做一遍，
        不能因为少一个辅助函数就让整个 layout 渲染不出来。 %>
    <% const bwcUpdateStrings = {
      chip: t("webUpdate.chip"),
      chipTitle: t("webUpdate.chipTitle"),
      offlineText: t("webUpdate.offlineText"),
      offlinePurge: t("webUpdate.offlinePurge"),
      offlineDismiss: t("webUpdate.offlineDismiss"),
    }; %>
    <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
      window.BWC_UPDATE_T = <%- typeof jsonForScript !== 'undefined'
        ? jsonForScript(bwcUpdateStrings)
        : JSON.stringify(bwcUpdateStrings).replace(/</g, "\\u003c").replace(/>/g, "\\u003e").replace(/&/g, "\\u0026") %>;
    </script>
    <%# 同上：app.js 的 copy() 在所有页面跑，通用「链接已复制 / 复制失败」
        文案在服务端按当前语言解析好递过去；具体复制对象的文案由各模板
        用 data-bwc-copy-msg 自己带（t("app.js.copy.*")）。 %>
    <% const bwcCopyStrings = {
      link: t("app.js.copy.link"),
      failed: t("app.js.copy.failed"),
    }; %>
    <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
      window.BWC_COPY_T = <%- typeof jsonForScript !== 'undefined'
        ? jsonForScript(bwcCopyStrings)
        : JSON.stringify(bwcCopyStrings).replace(/</g, "\\u003c").replace(/>/g, "\\u003e").replace(/&/g, "\\u0026") %>;
    </script>
    <script src="<%= js %>/version-check.js?v=<%= v %>" defer></script>
    <script src="<%= js %>/banners.js?v=<%= v %>" defer></script>
    <%# 铃铛未读角标：脚本自己找 #bwc-notif-badge，没有这个元素（未登录页）
        就直接退出。轮询走带 ETag 的计数端点，没新通知时是 304 空响应。 %>
    <script src="<%= js %>/notifications-badge.js?v=<%= v %>" defer></script>
    <%# Inline critical splash styles. Inlined so the splash renders
        before app.css finishes downloading. The same .bwc-boot-splash
        rule lives in app.css for consistency, but having it inline
        ensures cold-cache loads (PWA killed + reopened) still get the
        nice gradient instead of a 200ms white flash. %>
    <style>
      .bwc-boot-splash {
        position: fixed; inset: 0; z-index: 9999;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 1.25rem;
        background: linear-gradient(160deg, #f8fafc 0%, #eef2ff 60%, #ede9fe 100%);
        transition: opacity 220ms ease, visibility 0s linear 220ms;
        opacity: 1; visibility: visible;
      }
      body.bwc-booted .bwc-boot-splash { opacity: 0; visibility: hidden; pointer-events: none; }
      .bwc-boot-splash__logo {
        width: 80px; height: 80px;
        display: flex; align-items: center; justify-content: center;
        animation: bwc-pulse 1.6s ease-in-out infinite;
      }
      .bwc-boot-splash__logo img { width: 64px; height: 64px; object-fit: contain; border-radius: 16px; }
      .bwc-boot-splash__name { font-size: 14px; font-weight: 500; color: #475569; letter-spacing: 0.5px; }
      .bwc-boot-splash__spinner {
        width: 22px; height: 22px; border-radius: 50%;
        border: 2.5px solid rgba(79, 70, 229, 0.18);
        border-top-color: #4f46e5;
        animation: bwc-spin 0.7s linear infinite;
      }
      .bwc-boot-splash__msg { font-size: 12px; color: #64748b; margin-top: -0.25rem; min-height: 1em; }
      /* Splash in dark mode: same gradient idea, deep end of the scale. */
      [data-mode="dark"] .bwc-boot-splash {
        background: linear-gradient(160deg, #0b1120 0%, #111c33 60%, #1e1b4b 100%);
      }
      [data-mode="dark"] .bwc-boot-splash__name { color: #94a3b8; }
      [data-mode="dark"] .bwc-boot-splash__msg { color: #64748b; }
      [data-mode="dark"] .bwc-boot-splash__spinner {
        border-color: rgba(129, 140, 248, 0.25);
        border-top-color: #818cf8;
      }
      @keyframes bwc-pulse { 0%,100%{transform:scale(1);opacity:1} 50%{transform:scale(.95);opacity:.85} }
      @keyframes bwc-spin { to { transform: rotate(360deg); } }

      /* Page transitions: every same-origin navigation cross-fades. Chrome
         126+ / Safari 18+ honor this; older browsers just navigate normally. */
      @view-transition { navigation: auto; }
      ::view-transition-old(root),
      ::view-transition-new(root) { animation-duration: 180ms; animation-timing-function: ease; }

      /* Graceful fallback for Firefox + older browsers: a gentle fade-in
         on first paint so navigation doesn't feel like a hard flash.
         Skipped when prefers-reduced-motion is set. */
      @media (prefers-reduced-motion: no-preference) {
        body { animation: bwc-page-in 160ms ease-out; }
      }
      @keyframes bwc-page-in { from { opacity: .85; } to { opacity: 1; } }
    </style>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased font-sans flex flex-col">
    <%# Boot splash — shows immediately on every page load + every time
        the PWA cold-launches from the home-screen icon (iOS clears the
        app state when killed). The inline script below adds `.bwc-booted`
        to <body> on DOMContentLoaded which fades it out. %>
    <div class="bwc-boot-splash" id="bwc-boot-splash" role="status" aria-live="polite">
      <div class="bwc-boot-splash__logo">
        <% if (typeof siteLogoUrl !== 'undefined' && siteLogoUrl) { %>
          <img src="<%= siteLogoUrl %>" alt="" />
        <% } else { %>
          <%- include('partials/default-brand') %>
        <% } %>
      </div>
      <div class="bwc-boot-splash__spinner"></div>
      <div class="bwc-boot-splash__name"><%= (typeof siteName !== 'undefined' && siteName) ? siteName : 'ByWave-Calendar' %></div>
      <div class="bwc-boot-splash__msg" id="bwc-boot-splash-msg"></div>
    </div>
    <%# Splash auto-hide. Inlined here (not in app.js) so the splash
        can never get permanently stuck: even if app.js fails to load
        (CSP block / 404 / network drop), this script still runs and
        kills the overlay. Without it, ANY page where app.js doesn't
        execute would leave the user staring at a gradient mask. %>
    <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
      (function () {
        function bootDone() {
          if (!document.body.classList.contains("bwc-booted")) {
            document.body.classList.add("bwc-booted");
          }
        }
        // Primary path: hide as soon as DOM is ready. Double rAF so the
        // initial paint has a chance to commit, otherwise the fade
        // transition skips entirely on cold loads.
        function scheduleHide() {
          requestAnimationFrame(function () {
            requestAnimationFrame(bootDone);
          });
        }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", scheduleHide, { once: true });
        } else {
          scheduleHide();
        }
        // Hard fallback. If something weird happens to rAF (background
        // tab throttling, etc.) we still hide after 2s — the splash is
        // never supposed to be the user's destination, and a broken
        // page underneath is strictly better than an infinite spinner.
        setTimeout(bootDone, 2000);
      })();
    </script>
    <% if (typeof bareLayout !== 'undefined' && bareLayout) { %>
      <%# Single-purpose pages (e.g. password reset): NO header nav, NO footer,
          NO command palette — just a non-clickable brand mark + the body, so the
          page can do exactly one thing and offers no way to navigate elsewhere.
          The one exception is the language switcher, placed AFTER the body:
          these are exactly the pages a user lands on from an email (reset /
          verify / login challenge), quite possibly in a language they don't
          read, and with no nav they'd have no way to change it. It navigates
          nowhere — it only re-renders this same page in another language.
          After, not before, on purpose: the page's own form must stay the
          FIRST form in DOM order (the native-login consent flow — and
          form-autofill heuristics — key on that), so the switcher's form
          must not jump the queue. %>
      <main class="flex-1 mx-auto w-full max-w-md px-4 pt-12 sm:pt-20 pb-4">
        <div class="mb-6 flex items-center justify-center gap-2.5">
          <% if (typeof siteLogoUrl !== 'undefined' && siteLogoUrl) { %>
            <img src="<%= siteLogoUrl %>" alt="" class="h-9 w-9 rounded-xl object-cover ring-1 ring-slate-200" />
          <% } else { %>
            <img src="/static/brand/logo-small.svg?v=<%= v %>" alt="" width="36" height="36" class="h-9 w-9" />
          <% } %>
          <span class="text-base font-semibold text-slate-900"><%= (typeof siteName !== 'undefined' && siteName) ? siteName : 'ByWave-Calendar' %></span>
        </div>
        <%- include('partials/flash', { flash: flash }) %>
        <%- body %>
      </main>
      <div class="mx-auto w-full max-w-md px-4 pb-8 flex justify-end">
        <%- include('partials/lang-switcher') %>
      </div>
    <% } else { %>
    <%- include('partials/nav', { user: user, siteName: typeof siteName !== 'undefined' ? siteName : 'ByWave-Calendar', siteLogoUrl: typeof siteLogoUrl !== 'undefined' ? siteLogoUrl : null }) %>
    <% if (typeof appShell !== 'undefined' && appShell) { %>
      <main class="flex-1 min-h-0 flex flex-col">
        <%- body %>
      </main>
    <% } else { %>
      <main class="flex-1 mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
        <%- include('partials/flash', { flash: flash }) %>
        <%- include('partials/banners') %>
        <%- body %>
      </main>
      <footer class="mt-16 border-t border-slate-200 bg-white">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-6 text-sm text-slate-500 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div class="flex items-center gap-3 flex-wrap">
            <span>© <%= (typeof siteName !== 'undefined' && siteName) ? siteName : 'ByWave-Calendar' %> · <%= t("footer.copyrightSeparator") %></span>
            <a href="https://github.com/wuha-like-sleep/by-wave-calendar" target="_blank" rel="noopener"
               class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs text-slate-700 hover:bg-slate-100 hover:border-slate-300 transition">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.387.6.113.82-.26.82-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.305-5.467-1.334-5.467-5.93 0-1.31.468-2.382 1.235-3.222-.135-.303-.54-1.524.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.4 3-.405 1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.652.24 2.873.12 3.176.765.84 1.23 1.912 1.23 3.222 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22v3.293c0 .32.21.694.825.577C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z"/></svg>
              <%= t("footer.ourOpenSource") %>
            </a>
          </div>
          <div class="flex flex-wrap gap-3 text-xs text-slate-400 items-center">
            <a href="/" class="bwc-tap hover:text-slate-700"><%= t("footer.linkHome") %></a>
            <a href="/download" class="bwc-tap hover:text-slate-700"><%= t("footer.linkDownload") %></a>
            <a href="/about" class="bwc-tap hover:text-slate-700"><%= t("footer.linkAbout") %></a>
            <a href="/privacy" class="bwc-tap hover:text-slate-700"><%= t("footer.linkPrivacy") %></a>
            <a href="/data-processing" class="bwc-tap hover:text-slate-700"><%= t("footer.linkDataProcessing") %></a>
            <a href="/terms" class="bwc-tap hover:text-slate-700"><%= t("footer.linkTerms") %></a>
            <a href="/support" class="bwc-tap hover:text-slate-700"><%= t("footer.linkSupport") %></a>
            <a href="/open-source" class="bwc-tap hover:text-slate-700"><%= t("footer.linkOpenSource") %></a>
            <a href="https://github.com/wuha-like-sleep/by-wave-calendar" target="_blank" rel="noopener" class="bwc-tap hover:text-slate-700"><%= t("footer.linkSource") %></a>
            <% if (typeof icpNumber !== 'undefined' && icpNumber) { %>
              <span class="text-slate-300">·</span>
              <a href="<%= icpUrl %>" target="_blank" rel="noopener" class="bwc-tap hover:text-slate-700"><%= icpNumber %></a>
            <% } %>
          </div>
        </div>
      </footer>
    <% } %>
    <% if (typeof appShell !== 'undefined' && appShell) { %>
      <div id="bwc-app-strip" class="border-t border-slate-200 bg-white py-1.5 px-4 text-center text-[11px] text-slate-400">
        © <%= (typeof siteName !== 'undefined' && siteName) ? siteName : 'ByWave-Calendar' %> · <%= t("footer.ourOpenSource") %>
        <% if (typeof icpNumber !== 'undefined' && icpNumber) { %>
          · <a href="<%= icpUrl %>" target="_blank" rel="noopener" class="hover:text-slate-600"><%= icpNumber %></a>
        <% } %>
      </div>
    <% } %>
    <% } %>
    <div id="toast-root" class="fixed inset-x-0 bottom-4 z-50 flex flex-col items-center gap-2 px-4 sm:items-end sm:right-4 sm:left-auto pointer-events-none"></div>

    <!-- Cmd+K command palette — available on every page so users can jump
         to any calendar / event / page without going through the nav. The
         modal stays in the DOM but hidden; only opens on Cmd/Ctrl-K, "/"
         (when not in an input), or a click on the small "⌘K" hint in the
         nav (auth pages don't render the palette at all). -->
    <% if ((typeof currentUser !== 'undefined' && currentUser) && !(typeof bareLayout !== 'undefined' && bareLayout)) { %>
    <div id="bwc-palette" class="hidden fixed inset-0 z-[60] bg-slate-900/40 backdrop-blur-sm flex items-start justify-center pt-[15vh] px-4">
      <div class="w-full max-w-xl bg-white rounded-2xl shadow-2xl overflow-hidden border border-slate-200">
        <div class="border-b border-slate-100 flex items-center px-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-5-5"/></svg>
          <input type="text" id="palette-input" placeholder="<%= t('layout.palette.placeholder') %>"
                 class="flex-1 py-3 px-3 text-sm bg-transparent border-0 focus:outline-none focus:ring-0 placeholder:text-slate-400" />
          <kbd class="text-xs text-slate-400 bg-slate-100 rounded px-1.5 py-0.5">Esc</kbd>
        </div>
        <ul id="palette-results" class="overflow-y-auto py-1 text-sm" style="max-height: 50vh; max-height: 50dvh"></ul>
        <div class="border-t border-slate-100 px-4 py-2 text-xs text-slate-400 flex items-center gap-3">
          <span><%= t("layout.palette.hintNavigate") %></span><span><%= t("layout.palette.hintSelect") %></span><span><%= t("layout.palette.hintClose") %></span>
        </div>
      </div>
    </div>
    <% } %>

    <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
    <% if ((typeof currentUser !== 'undefined' && currentUser) && !(typeof bareLayout !== 'undefined' && bareLayout)) { %>
    <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>" src="<%= (typeof jsBasePath !== 'undefined' ? jsBasePath : '/static') %>/palette.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>" defer></script>
    <% } %>
  </body>
</html>
