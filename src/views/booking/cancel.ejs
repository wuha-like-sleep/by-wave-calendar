<div class="mx-auto max-w-md">
  <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
    <h1 class="text-xl font-semibold text-slate-900 mb-2"><%= t("booking.cancel.heading") %></h1>
    <% if (booking.cancelledAt) { %>
      <div class="rounded-lg bg-emerald-50 border border-emerald-200 p-3 text-sm text-emerald-800 mb-4">
        <%= t("booking.cancel.alreadyCancelled") %>
      </div>
    <% } else { %>
      <p class="text-sm text-slate-500 mb-4"><%= t("booking.cancel.intro") %></p>
      <div class="rounded-lg bg-slate-50 border border-slate-200 p-3 text-sm text-slate-700 mb-5">
        <div class="text-xs text-slate-500"><%= t("booking.cancel.guestLabel") %></div>
        <div class="font-medium"><%= booking.guestName %> &lt;<%= booking.guestEmail %>&gt;</div>
      </div>
      <form method="post" action="/book-cancel/<%= encodeURIComponent(booking.cancelToken) %>"
            data-confirm="<%= t('booking.cancel.confirmPrompt') %>" data-confirm-danger="1" data-confirm-ok="<%= t('booking.cancel.confirmOk') %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="w-full inline-flex items-center justify-center rounded-lg bg-red-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-red-700">
          <%= t("booking.cancel.button") %>
        </button>
      </form>
    <% } %>
  </div>
</div>
