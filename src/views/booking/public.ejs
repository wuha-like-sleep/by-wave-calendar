<div class="mx-auto max-w-2xl">
  <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
    <div class="border-l-4 border-brand-500 pl-4 mb-6">
      <h1 class="text-xl font-semibold text-slate-900"><%= link.title %></h1>
      <div class="mt-1 text-sm text-slate-600">与 <strong><%= owner.displayName || owner.email %></strong> · <%= link.durationMinutes %> 分钟</div>
      <% if (link.description) { %>
        <p class="mt-2 text-sm text-slate-600 whitespace-pre-wrap"><%= link.description %></p>
      <% } %>
    </div>

    <% if (slotsByDate.length === 0) { %>
      <div class="rounded-lg bg-slate-50 border border-slate-200 p-6 text-center text-sm text-slate-500">
        最近没有可预约时段。请联系发布方调整可用时段，或晚些再试。
      </div>
    <% } else { %>
      <form method="post" action="/book/<%= link.userId %>/<%= encodeURIComponent(link.slug) %>" class="space-y-5" id="booking-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="startsAt" id="picked-slot" required />

        <!-- Date + slot picker -->
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2">选个时间</label>
          <div class="grid grid-cols-1 sm:grid-cols-[1fr_2fr] gap-4">
            <ul class="rounded-lg border border-slate-200 overflow-hidden max-h-72 overflow-y-auto" id="date-list">
              <% slotsByDate.forEach(function(d, i){ %>
                <li>
                  <button type="button" data-date="<%= d.date %>"
                          class="date-btn w-full text-left px-3 py-2 text-sm border-b border-slate-100 last:border-b-0 hover:bg-brand-50 hover:text-brand-700 <%= i === 0 ? 'bg-brand-50 text-brand-700 font-medium' : '' %>">
                    <%= d.date %>
                    <span class="float-right text-xs text-slate-400"><%= d.slots.length %> 个时段</span>
                  </button>
                </li>
              <% }) %>
            </ul>
            <div id="slot-grid" class="grid grid-cols-3 gap-2 content-start"></div>
          </div>
        </div>

        <!-- Guest info -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <label class="text-sm">
            <span class="block font-medium text-slate-700 mb-1">你的姓名</span>
            <input type="text" name="guestName" required maxlength="100"
                   class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
          </label>
          <label class="text-sm">
            <span class="block font-medium text-slate-700 mb-1">邮箱</span>
            <input type="email" name="guestEmail" required maxlength="254"
                   class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
          </label>
          <label class="text-sm sm:col-span-2">
            <span class="block font-medium text-slate-700 mb-1">留言（可选）</span>
            <textarea name="guestMessage" maxlength="2000" rows="3" placeholder="想讨论什么？"
                      class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100"></textarea>
          </label>
        </div>

        <button type="submit" class="w-full inline-flex items-center justify-center gap-2 rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-brand-700 disabled:opacity-40" id="confirm-btn" disabled>
          确认预约
        </button>
      </form>
    <% } %>

    <p class="mt-6 text-center text-xs text-slate-400">所有时间显示为 Asia/Shanghai 时区</p>
  </div>
</div>

<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
(function(){
  const ALL_SLOTS = <%- JSON.stringify(slotsByDate) %>;
  const dateList = document.getElementById("date-list");
  const slotGrid = document.getElementById("slot-grid");
  const picked = document.getElementById("picked-slot");
  const confirm = document.getElementById("confirm-btn");
  if (!dateList || !slotGrid) return;
  const fmt = (iso) => {
    const d = new Date(iso);
    return d.toLocaleTimeString("zh-CN", { hour: "2-digit", minute: "2-digit", hour12: false });
  };
  function renderSlots(date) {
    const entry = ALL_SLOTS.find((d) => d.date === date);
    slotGrid.innerHTML = "";
    if (!entry) return;
    entry.slots.forEach((s) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.dataset.iso = s.startsAt;
      btn.className = "slot-btn rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm hover:border-brand-500 hover:text-brand-700";
      btn.textContent = fmt(s.startsAt);
      slotGrid.appendChild(btn);
    });
  }
  dateList.addEventListener("click", (e) => {
    const t = e.target.closest("[data-date]");
    if (!t) return;
    dateList.querySelectorAll(".date-btn").forEach((b) => b.classList.remove("bg-brand-50", "text-brand-700", "font-medium"));
    t.classList.add("bg-brand-50", "text-brand-700", "font-medium");
    renderSlots(t.dataset.date);
    picked.value = "";
    confirm.disabled = true;
  });
  slotGrid.addEventListener("click", (e) => {
    const t = e.target.closest("[data-iso]");
    if (!t) return;
    slotGrid.querySelectorAll(".slot-btn").forEach((b) => b.classList.remove("bg-brand-600", "text-white", "border-brand-600"));
    t.classList.add("bg-brand-600", "text-white", "border-brand-600");
    picked.value = t.dataset.iso;
    confirm.disabled = false;
  });
  if (ALL_SLOTS.length > 0) renderSlots(ALL_SLOTS[0].date);
})();
</script>
