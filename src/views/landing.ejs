<!-- HERO -->
<section class="relative overflow-hidden text-center py-14 sm:py-20">
  <div class="absolute inset-0 -z-10 bg-gradient-to-br from-brand-50 via-white to-slate-50"></div>
  <div class="absolute -z-10 top-10 left-1/2 -translate-x-1/2 h-72 w-72 rounded-full bg-brand-400/10 blur-3xl"></div>

  <a href="https://github.com/wuha-like-sleep/by-wave-calendar" target="_blank" rel="noopener"
     class="inline-flex items-center gap-2 rounded-full bg-slate-900 hover:bg-slate-800 text-white px-3.5 py-1.5 text-xs font-medium shadow-md mb-4 transition">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.387.6.113.82-.26.82-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.305-5.467-1.334-5.467-5.93 0-1.31.468-2.382 1.235-3.222-.135-.303-.54-1.524.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.4 3-.405 1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.652.24 2.873.12 3.176.765.84 1.23 1.912 1.23 3.222 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22v3.293c0 .32.21.694.825.577C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z"/></svg>
    我们的开源项目 · 在 GitHub 给个 Star
    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>
  </a>

  <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-slate-900">
    日程<span class="text-brand-600">不只是</span>日程
  </h1>
  <p class="mt-5 max-w-2xl mx-auto text-base sm:text-lg text-slate-600 leading-relaxed">
    自托管的协作日历平台 ——
    <span class="text-slate-900 font-medium">网页 · PWA · CalDAV · ICS · 预约链接</span> 一个域名搞定<br/>
    Passkey / SSO / MFA 全家桶，Zoom 风格的第三方 API 集成。
  </p>

  <div class="mt-9 flex flex-col sm:flex-row gap-3 justify-center">
    <% if (registrationOpen) { %>
      <a href="/register" class="inline-flex items-center justify-center gap-2 rounded-lg bg-brand-600 px-6 py-3 text-sm font-medium text-white shadow-lg shadow-brand-600/20 hover:bg-brand-700 hover:shadow-xl hover:-translate-y-px transition">
        立即开始
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    <% } %>
    <a href="/login" class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-6 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:border-slate-300 transition">已有账号 → 登录</a>
    <a href="/download" class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-200 bg-white px-6 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:border-slate-300 transition">
      📱 下载 APP
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
    </a>
  </div>

  <div class="mt-6 flex flex-wrap justify-center gap-2 text-xs text-slate-500">
    <span class="inline-flex items-center gap-1 rounded-full bg-white border border-slate-200 px-2.5 py-1">🔐 Passkey</span>
    <span class="inline-flex items-center gap-1 rounded-full bg-white border border-slate-200 px-2.5 py-1">🛡 TOTP MFA</span>
    <span class="inline-flex items-center gap-1 rounded-full bg-white border border-slate-200 px-2.5 py-1">📲 PWA</span>
    <span class="inline-flex items-center gap-1 rounded-full bg-white border border-slate-200 px-2.5 py-1">🔁 CalDAV</span>
    <span class="inline-flex items-center gap-1 rounded-full bg-white border border-slate-200 px-2.5 py-1">📤 ICS</span>
    <span class="inline-flex items-center gap-1 rounded-full bg-white border border-slate-200 px-2.5 py-1">🌐 多 SSO</span>
    <span class="inline-flex items-center gap-1 rounded-full bg-white border border-slate-200 px-2.5 py-1">🔌 第三方 API</span>
  </div>
</section>

<!-- FEATURES -->
<section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 mt-2">
  <div class="rounded-2xl border border-slate-200 bg-white p-6 hover:shadow-md hover:-translate-y-px transition">
    <div class="h-10 w-10 rounded-lg bg-brand-50 text-brand-600 flex items-center justify-center mb-3">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
    </div>
    <h3 class="font-semibold text-slate-900">月/周/日 网格视图</h3>
    <p class="mt-1 text-sm text-slate-600">Toast UI Calendar 驱动，拖拽改时间、点格快速加，红色 now-line 实时移动</p>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-6 hover:shadow-md hover:-translate-y-px transition">
    <div class="h-10 w-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center mb-3">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
    </div>
    <h3 class="font-semibold text-slate-900">PWA 安装到桌面</h3>
    <p class="mt-1 text-sm text-slate-600">桌面 / 手机主屏一键安装，离线壳缓存，新版本自动弹窗</p>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-6 hover:shadow-md hover:-translate-y-px transition">
    <div class="h-10 w-10 rounded-lg bg-sky-50 text-sky-600 flex items-center justify-center mb-3">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
    </div>
    <h3 class="font-semibold text-slate-900">CalDAV 双向同步</h3>
    <p class="mt-1 text-sm text-slate-600">iPhone / Apple Calendar / Synology 直接登账号读写</p>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-6 hover:shadow-md hover:-translate-y-px transition">
    <div class="h-10 w-10 rounded-lg bg-violet-50 text-violet-600 flex items-center justify-center mb-3">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><path d="M20 8v6M23 11h-6"/></svg>
    </div>
    <h3 class="font-semibold text-slate-900">协作邀请 + RSVP</h3>
    <p class="mt-1 text-sm text-slate-600">事件邮件邀请，对方回参加/不参加 + 一键加到 Google / Apple / ByWave 日历</p>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-6 hover:shadow-md hover:-translate-y-px transition">
    <div class="h-10 w-10 rounded-lg bg-amber-50 text-amber-700 flex items-center justify-center mb-3">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
    </div>
    <h3 class="font-semibold text-slate-900">ICS 四向导入</h3>
    <p class="mt-1 text-sm text-slate-600">文件 / URL 一次性 / URL 周期订阅 / 粘贴文本 —— 任意 ICS 都能导</p>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-6 hover:shadow-md hover:-translate-y-px transition">
    <div class="h-10 w-10 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center mb-3">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
    </div>
    <h3 class="font-semibold text-slate-900">认证全家桶</h3>
    <p class="mt-1 text-sm text-slate-600">邮箱 / Passkey / TOTP / 多 SSO，应用密码避免 CalDAV 暴露主密码</p>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-6 hover:shadow-md hover:-translate-y-px transition">
    <div class="h-10 w-10 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center mb-3">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
    </div>
    <h3 class="font-semibold text-slate-900">第三方 API</h3>
    <p class="mt-1 text-sm text-slate-600">管理员发 Bearer Token，Zoom / Notion / n8n 直接 REST 读写日历</p>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-6 hover:shadow-md hover:-translate-y-px transition">
    <div class="h-10 w-10 rounded-lg bg-pink-50 text-pink-600 flex items-center justify-center mb-3">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12.5" r=".5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125 0-.937.812-1.687 1.875-1.687h1.687c2.515 0 4.5-1.875 4.5-4.375C20.835 6.875 16.785 2 12 2z"/></svg>
    </div>
    <h3 class="font-semibold text-slate-900">7 套主题 · 用户级</h3>
    <p class="mt-1 text-sm text-slate-600">每个用户自选品牌色，admin 设站点默认</p>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-6 hover:shadow-md hover:-translate-y-px transition">
    <div class="h-10 w-10 rounded-lg bg-teal-50 text-teal-600 flex items-center justify-center mb-3">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    </div>
    <h3 class="font-semibold text-slate-900">提醒 + 重复事件</h3>
    <p class="mt-1 text-sm text-slate-600">按时邮件叫人，RRULE 重复事件 ICS 标准兼容</p>
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="mt-16 mb-10">
  <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 text-center mb-2">三步开始用</h2>
  <p class="text-center text-slate-500 mb-10 text-sm sm:text-base">不写代码，5 分钟搞定。</p>
  <div class="grid gap-6 sm:grid-cols-3">
    <div class="relative rounded-2xl bg-white border border-slate-200 p-6">
      <div class="absolute -top-3 -left-3 h-8 w-8 rounded-full bg-brand-600 text-white flex items-center justify-center text-sm font-bold">1</div>
      <h3 class="font-semibold text-slate-900 mb-1.5 mt-1">注册账号</h3>
      <p class="text-sm text-slate-600">邮箱注册带验证码，或用公司 SSO 一键登录</p>
    </div>
    <div class="relative rounded-2xl bg-white border border-slate-200 p-6">
      <div class="absolute -top-3 -left-3 h-8 w-8 rounded-full bg-brand-600 text-white flex items-center justify-center text-sm font-bold">2</div>
      <h3 class="font-semibold text-slate-900 mb-1.5 mt-1">创建日历 + 加事件</h3>
      <p class="text-sm text-slate-600">网页拖拽加 / 上传 .ics / 订阅 URL，或手机 CalDAV 直接同步</p>
    </div>
    <div class="relative rounded-2xl bg-white border border-slate-200 p-6">
      <div class="absolute -top-3 -left-3 h-8 w-8 rounded-full bg-brand-600 text-white flex items-center justify-center text-sm font-bold">3</div>
      <h3 class="font-semibold text-slate-900 mb-1.5 mt-1">分享 / 协作 / 集成</h3>
      <p class="text-sm text-slate-600">订阅链接给家人，邀请同事协作，API token 接你的内部系统</p>
    </div>
  </div>
</section>

<!-- Bottom CTA -->
<section class="mt-12 rounded-2xl border-2 border-brand-200 bg-gradient-to-br from-brand-50 to-white p-8 sm:p-10 text-center">
  <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-3">把日程<span class="text-brand-600">真正掌握</span>在自己手里</h2>
  <p class="text-slate-600 max-w-xl mx-auto mb-6">完全开源、数据自托管、零外部依赖。商业部署也好、个人玩票也好，永久免费。</p>
  <% if (registrationOpen) { %>
    <a href="/register" class="inline-flex items-center justify-center gap-2 rounded-lg bg-brand-600 px-6 py-3 text-sm font-medium text-white shadow-lg shadow-brand-600/20 hover:bg-brand-700">立即创建账号</a>
  <% } else { %>
    <a href="/login" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-6 py-3 text-sm font-medium text-white shadow-lg shadow-brand-600/20 hover:bg-brand-700">登录</a>
  <% } %>
</section>
