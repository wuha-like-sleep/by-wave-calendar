<!-- HERO -->
<section class="pt-6 sm:pt-10 pb-12 border-b border-slate-200">
  <p class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-sm text-slate-500">
    <a href="https://github.com/wuha-like-sleep/by-wave-calendar" target="_blank" rel="noopener"
       class="inline-flex items-center gap-1.5 text-slate-600 hover:text-slate-900 underline decoration-slate-300 underline-offset-4 hover:decoration-slate-500 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.387.6.113.82-.26.82-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.305-5.467-1.334-5.467-5.93 0-1.31.468-2.382 1.235-3.222-.135-.303-.54-1.524.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.4 3-.405 1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.652.24 2.873.12 3.176.765.84 1.23 1.912 1.23 3.222 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22v3.293c0 .32.21.694.825.577C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z"/></svg>
      <%= t("landing.githubBadge") %>
    </a>
    <span aria-hidden="true" class="text-slate-300">·</span>
    <span><%= t("landing.licenseNote") %></span>
  </p>

  <h1 class="mt-7 max-w-3xl text-4xl sm:text-5xl font-semibold tracking-tight leading-[1.15] text-slate-900">
    <%= t("landing.heroTitle") %>
  </h1>
  <p class="mt-5 max-w-2xl text-base sm:text-lg text-slate-600 leading-relaxed">
    <%= t("landing.heroSubtitle") %>
  </p>

  <div class="mt-8 flex flex-wrap items-center gap-3">
    <% if (registrationOpen) { %>
      <a href="/register" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-brand-700 transition-colors">
        <%= t("landing.ctaStart") %>
      </a>
    <% } %>
    <a href="/login" class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:border-slate-400 transition-colors"><%= t("landing.ctaSignIn") %></a>
    <a href="/download" class="inline-flex items-center gap-1.5 px-2 py-2.5 text-sm font-medium text-slate-600 hover:text-slate-900 underline decoration-slate-300 underline-offset-4 hover:decoration-slate-500 transition-colors">
      <%= t("landing.ctaDownload") %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
  </div>

  <p class="mt-9 text-sm text-slate-500">
    Passkey<span aria-hidden="true" class="mx-2 text-slate-300">·</span>TOTP<span aria-hidden="true" class="mx-2 text-slate-300">·</span>CalDAV<span aria-hidden="true" class="mx-2 text-slate-300">·</span>ICS<span aria-hidden="true" class="mx-2 text-slate-300">·</span>PWA<span aria-hidden="true" class="mx-2 text-slate-300">·</span><%= t("landing.chipMultiSso") %><span aria-hidden="true" class="mx-2 text-slate-300">·</span><%= t("landing.chipThirdPartyApi") %><span aria-hidden="true" class="mx-2 text-slate-300">·</span><%= t("landing.chipLanguages") %>
  </p>
</section>

<!-- FEATURES -->
<section class="py-12">
  <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-slate-900"><%= t("landing.featuresTitle") %></h2>
  <div class="mt-6 divide-y divide-slate-200 border-y border-slate-200">
    <div class="grid gap-1 sm:grid-cols-[210px_1fr] sm:gap-8 py-5">
      <h3 class="text-sm font-semibold text-slate-900"><%= t("landing.feature.gridTitle") %></h3>
      <p class="text-sm sm:text-[15px] leading-relaxed text-slate-600 max-w-2xl"><%= t("landing.feature.gridDesc") %></p>
    </div>
    <div class="grid gap-1 sm:grid-cols-[210px_1fr] sm:gap-8 py-5">
      <h3 class="text-sm font-semibold text-slate-900"><%= t("landing.feature.syncTitle") %></h3>
      <p class="text-sm sm:text-[15px] leading-relaxed text-slate-600 max-w-2xl"><%= t("landing.feature.syncDesc") %></p>
    </div>
    <div class="grid gap-1 sm:grid-cols-[210px_1fr] sm:gap-8 py-5">
      <h3 class="text-sm font-semibold text-slate-900"><%= t("landing.feature.caldavTitle") %></h3>
      <p class="text-sm sm:text-[15px] leading-relaxed text-slate-600 max-w-2xl"><%= t("landing.feature.caldavDesc") %></p>
    </div>
    <div class="grid gap-1 sm:grid-cols-[210px_1fr] sm:gap-8 py-5">
      <h3 class="text-sm font-semibold text-slate-900"><%= t("landing.feature.pwaTitle") %></h3>
      <p class="text-sm sm:text-[15px] leading-relaxed text-slate-600 max-w-2xl"><%= t("landing.feature.pwaDesc") %></p>
    </div>
    <div class="grid gap-1 sm:grid-cols-[210px_1fr] sm:gap-8 py-5">
      <h3 class="text-sm font-semibold text-slate-900"><%= t("landing.feature.rsvpTitle") %></h3>
      <p class="text-sm sm:text-[15px] leading-relaxed text-slate-600 max-w-2xl"><%= t("landing.feature.rsvpDesc") %></p>
    </div>
    <div class="grid gap-1 sm:grid-cols-[210px_1fr] sm:gap-8 py-5">
      <h3 class="text-sm font-semibold text-slate-900"><%= t("landing.feature.icsTitle") %></h3>
      <p class="text-sm sm:text-[15px] leading-relaxed text-slate-600 max-w-2xl"><%= t("landing.feature.icsDesc") %></p>
    </div>
    <div class="grid gap-1 sm:grid-cols-[210px_1fr] sm:gap-8 py-5">
      <h3 class="text-sm font-semibold text-slate-900"><%= t("landing.feature.authTitle") %></h3>
      <p class="text-sm sm:text-[15px] leading-relaxed text-slate-600 max-w-2xl"><%= t("landing.feature.authDesc") %></p>
    </div>
    <div class="grid gap-1 sm:grid-cols-[210px_1fr] sm:gap-8 py-5">
      <h3 class="text-sm font-semibold text-slate-900"><%= t("landing.feature.apiTitle") %></h3>
      <p class="text-sm sm:text-[15px] leading-relaxed text-slate-600 max-w-2xl"><%= t("landing.feature.apiDesc") %></p>
    </div>
    <div class="grid gap-1 sm:grid-cols-[210px_1fr] sm:gap-8 py-5">
      <h3 class="text-sm font-semibold text-slate-900"><%= t("landing.feature.geoTitle") %></h3>
      <p class="text-sm sm:text-[15px] leading-relaxed text-slate-600 max-w-2xl"><%= t("landing.feature.geoDesc") %></p>
    </div>
    <div class="grid gap-1 sm:grid-cols-[210px_1fr] sm:gap-8 py-5">
      <h3 class="text-sm font-semibold text-slate-900"><%= t("landing.feature.themeTitle") %></h3>
      <p class="text-sm sm:text-[15px] leading-relaxed text-slate-600 max-w-2xl"><%= t("landing.feature.themeDesc") %></p>
    </div>
    <div class="grid gap-1 sm:grid-cols-[210px_1fr] sm:gap-8 py-5">
      <h3 class="text-sm font-semibold text-slate-900"><%= t("landing.feature.reminderTitle") %></h3>
      <p class="text-sm sm:text-[15px] leading-relaxed text-slate-600 max-w-2xl"><%= t("landing.feature.reminderDesc") %></p>
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="border-t border-slate-200 py-12 max-w-3xl">
  <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-slate-900"><%= t("landing.howTitle") %></h2>
  <p class="mt-2 text-sm sm:text-base text-slate-500"><%= t("landing.howSubtitle") %></p>
  <ol class="mt-9 space-y-8">
    <li class="flex gap-4 sm:gap-5">
      <span aria-hidden="true" class="text-sm font-medium tabular-nums text-slate-400 pt-0.5">1.</span>
      <div>
        <h3 class="font-semibold text-slate-900"><%= t("landing.step1Title") %></h3>
        <p class="mt-1 text-sm sm:text-[15px] leading-relaxed text-slate-600"><%= t("landing.step1Desc") %></p>
      </div>
    </li>
    <li class="flex gap-4 sm:gap-5">
      <span aria-hidden="true" class="text-sm font-medium tabular-nums text-slate-400 pt-0.5">2.</span>
      <div>
        <h3 class="font-semibold text-slate-900"><%= t("landing.step2Title") %></h3>
        <p class="mt-1 text-sm sm:text-[15px] leading-relaxed text-slate-600"><%= t("landing.step2Desc") %></p>
      </div>
    </li>
    <li class="flex gap-4 sm:gap-5">
      <span aria-hidden="true" class="text-sm font-medium tabular-nums text-slate-400 pt-0.5">3.</span>
      <div>
        <h3 class="font-semibold text-slate-900"><%= t("landing.step3Title") %></h3>
        <p class="mt-1 text-sm sm:text-[15px] leading-relaxed text-slate-600"><%= t("landing.step3Desc") %></p>
      </div>
    </li>
  </ol>
</section>

<!-- Bottom CTA -->
<section class="border-t border-slate-200 py-12">
  <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-slate-900"><%= t("landing.bottomCtaTitle") %></h2>
  <p class="mt-3 max-w-xl leading-relaxed text-slate-600"><%= t("landing.bottomCtaDesc") %></p>
  <div class="mt-7 flex flex-wrap items-center gap-3">
    <% if (registrationOpen) { %>
      <a href="/register" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-brand-700 transition-colors"><%= t("landing.bottomCtaButton") %></a>
    <% } else { %>
      <a href="/login" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-brand-700 transition-colors"><%= t("nav.signIn") %></a>
    <% } %>
    <a href="https://github.com/wuha-like-sleep/by-wave-calendar" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-2 py-2.5 text-sm font-medium text-slate-600 hover:text-slate-900 underline decoration-slate-300 underline-offset-4 hover:decoration-slate-500 transition-colors">
      <%= t("landing.githubBadge") %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
  </div>
</section>
