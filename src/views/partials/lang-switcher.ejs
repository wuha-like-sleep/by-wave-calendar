<%# Compact language switcher. POSTs to /locale (sets the bwc_locale
    cookie; works logged-out too) and bounces back to the current page
    via return_to. csrfToken / currentPath / locales / currentLocale /
    localeLabel are global view locals (src/server.ts). onchange
    auto-submit — inline JS is permitted by the site CSP
    (script-src-attr 'unsafe-inline').
    Option labels come from localeLabel() — the one site-wide rule
    (native name always, no flag icons; see lib/i18n.ts). Callers with
    room to spare (the mobile menu) pass `wide: true` to lift the
    compact max-width cap that keeps the cramped logged-out top bar
    from overflowing at 390px. %>
<form method="post" action="/locale" class="m-0">
  <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
  <input type="hidden" name="return_to" value="<%= typeof currentPath !== 'undefined' ? currentPath : '' %>" />
  <select name="locale" data-bwc-autosubmit aria-label="<%= t("nav.languageLabel") %>"
          class="<%= (typeof wide !== 'undefined' && wide) ? 'w-full max-w-xs' : 'max-w-24 sm:max-w-none' %> text-sm rounded-md border border-slate-200 bg-white px-2 py-1.5 text-slate-600 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-brand-100 cursor-pointer">
    <% (typeof locales !== 'undefined' ? locales : []).forEach(function(l){ %>
      <option value="<%= l.code %>" <%= (typeof currentLocale !== 'undefined' && currentLocale === l.code) ? 'selected' : '' %>><%= (typeof localeLabel !== 'undefined') ? localeLabel(l) : l.label %></option>
    <% }) %>
  </select>
</form>
