<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/80 backdrop-blur supports-[backdrop-filter]:bg-white/70">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-14 items-center justify-between gap-4">
      <a href="<%= user ? '/app' : '/' %>" class="flex items-center gap-2 font-semibold text-slate-900">
        <span class="inline-block h-7 w-7 rounded-lg bg-gradient-to-br from-brand-500 to-brand-700 shadow-sm"></span>
        <span class="hidden sm:inline">by-wave 日历</span>
        <span class="sm:hidden">by-wave</span>
      </a>

      <% if (user) { %>
        <nav class="hidden md:flex items-center gap-1 text-sm text-slate-600">
          <a href="/app" class="px-3 py-1.5 rounded-md hover:bg-slate-100">日历</a>
          <a href="/app/settings" class="px-3 py-1.5 rounded-md hover:bg-slate-100">设置</a>
        </nav>
        <div class="flex items-center gap-2">
          <span class="hidden sm:inline text-sm text-slate-500"><%= user.displayName || user.email %></span>
          <form method="post" action="/logout" class="m-0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="text-sm px-3 py-1.5 rounded-md border border-slate-200 hover:bg-slate-50">退出</button>
          </form>
          <button type="button" class="md:hidden p-2 rounded-md hover:bg-slate-100" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')" aria-label="menu">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
        </div>
      <% } else { %>
        <div class="flex items-center gap-2 text-sm">
          <a href="/login" class="px-3 py-1.5 rounded-md text-slate-700 hover:bg-slate-100">登录</a>
          <% if (registrationOpen) { %>
            <a href="/register" class="px-3 py-1.5 rounded-md bg-brand-600 text-white hover:bg-brand-700 shadow-sm">注册</a>
          <% } %>
        </div>
      <% } %>
    </div>

    <% if (user) { %>
      <nav id="mobile-menu" class="md:hidden hidden pb-3 flex-col gap-1 text-sm text-slate-700">
        <a href="/app" class="px-3 py-2 rounded-md hover:bg-slate-100">日历</a>
        <a href="/app/settings" class="px-3 py-2 rounded-md hover:bg-slate-100">设置</a>
      </nav>
    <% } %>
  </div>
</header>
