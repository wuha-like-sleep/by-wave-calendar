<% if (typeof currentUser !== 'undefined' && currentUser && !currentUser.emailVerified) { %>
  <div id="bwc-verify-banner" class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 mb-4 flex flex-col sm:flex-row sm:items-center gap-3">
    <div class="flex-1 text-sm text-amber-900">
      <%# t() output is raw because the dictionary string carries <strong>;
          the interpolated email is HTML-escaped inside translate(). %>
      <%- t("banners.verifyEmail.text", { email: currentUser.email }) %>
    </div>
    <div class="flex gap-2">
      <form method="post" action="/app/verify-email/send" class="m-0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="rounded-md bg-amber-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-amber-700"><%= t("banners.verifyEmail.send") %></button>
      </form>
      <button type="button" data-dismiss="bwc-verify-banner" class="rounded-md border border-amber-300 bg-white px-2 py-1.5 text-xs text-amber-700 hover:bg-amber-100"><%= t("banners.later") %></button>
    </div>
  </div>
<% } %>

<div id="bwc-pwa-banner" class="hidden rounded-lg border border-brand-200 bg-brand-50 px-4 py-3 mb-4 flex flex-col sm:flex-row sm:items-center gap-3">
  <div class="flex-1 text-sm text-brand-900">
    <%- t("banners.pwa.text", { name: (typeof siteName !== 'undefined' && siteName) ? siteName : 'ByWave-Calendar' }) %>
  </div>
  <div class="flex gap-2">
    <button type="button" id="bwc-pwa-install" class="rounded-md bg-brand-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-brand-700"><%= t("banners.pwa.install") %></button>
    <button type="button" data-dismiss="bwc-pwa-banner" class="rounded-md border border-brand-300 bg-white px-2 py-1.5 text-xs text-brand-700 hover:bg-brand-100"><%= t("banners.later") %></button>
  </div>
</div>
