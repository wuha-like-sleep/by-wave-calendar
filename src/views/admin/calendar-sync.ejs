<%- include('_nav') %>
<header class="mb-7">
  <h1 class="text-2xl sm:text-3xl font-semibold text-slate-900"><%= t('adminCalendar.title') %></h1>
  <p class="text-sm text-slate-500 mt-3 max-w-2xl"><%= t('adminCalendar.intro') %></p>
</header>
<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7 mb-6">
  <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
    <div><h2 class="text-lg font-semibold text-slate-900">Microsoft Outlook</h2><p class="text-sm text-slate-500 mt-1"><%= t('adminCalendar.outlook') %></p></div>
    <span data-microsoft-state="<%= config.configured ? 'configured' : 'unconfigured' %>" role="status" class="rounded-full px-3 py-1 text-xs font-medium <%= config.configured ? 'bg-emerald-50 text-emerald-800' : 'bg-slate-100 text-slate-600' %>"><%= t(config.configured ? 'adminCalendar.ready' : 'adminCalendar.unconfigured') %></span>
  </div>
  <div class="rounded-xl bg-slate-50 p-4 mb-6 text-sm text-slate-600">
    <p><%= t('adminCalendar.source') %> <strong data-config-source="<%= config.source %>" class="text-slate-900"><%= t(config.source === 'environment' ? 'adminCalendar.source.environment' : config.source === 'admin' ? 'adminCalendar.source.admin' : 'adminCalendar.source.disabled') %></strong></p>
    <p class="mt-2 text-xs leading-relaxed"><%= t('adminCalendar.effect') %></p>
  </div>
  <form method="post" action="/admin/calendar-sync" class="space-y-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="action" value="save">
    <div>
      <label for="microsoft-client-id" class="block text-sm font-medium text-slate-900 mb-2"><%= t('adminCalendar.clientId') %></label>
      <input id="microsoft-client-id" name="clientId" type="text" value="<%= config.clientId %>" maxlength="36" pattern="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" autocomplete="off" autocapitalize="none" spellcheck="false" aria-describedby="microsoft-client-help" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" class="block w-full rounded-xl border border-slate-300 px-4 py-3 text-sm font-mono focus:border-brand-500 focus:ring-brand-500">
      <p id="microsoft-client-help" class="text-xs text-slate-500 mt-2 leading-relaxed"><%= t('adminCalendar.clientHelp') %></p>
    </div>
    <p class="text-xs text-slate-500 leading-relaxed"><%= t('adminCalendar.clearHelp') %></p>
    <div class="flex flex-wrap items-center gap-3">
      <button type="submit" class="rounded-xl bg-brand-600 px-5 py-3 text-sm font-medium text-white hover:bg-brand-700"><%= t('common.save') %></button>
      <a href="/app/settings/calendar-sync" class="rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-700 hover:bg-slate-50"><%= t('adminCalendar.preview') %> →</a>
    </div>
  </form>
  <% if (config.source !== 'environment') { %>
    <form method="post" action="/admin/calendar-sync" class="mt-5 pt-4 border-t border-slate-100">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="environment">
      <button type="submit" class="text-sm text-slate-500 underline hover:text-slate-900"><%= t('adminCalendar.restore') %></button>
    </form>
  <% } %>
</section>
<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7 mb-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-4"><%= t('adminCalendar.setup') %></h2>
  <ol class="list-decimal pl-5 space-y-3 text-sm text-slate-600 leading-relaxed">
    <li><%= t('adminCalendar.accounts') %></li>
    <li><%= t('adminCalendar.publicFlow') %></li>
    <li><%= t('adminCalendar.permissions') %> <code class="text-xs">Calendars.ReadWrite · User.Read · offline_access</code></li>
  </ol>
  <div class="flex flex-wrap gap-5 mt-5 text-sm text-brand-700">
    <a href="https://entra.microsoft.com/" target="_blank" rel="noopener noreferrer" class="hover:underline"><%= t('adminCalendar.entra') %> ↗</a>
    <a href="https://github.com/wuha-like-sleep/by-wave-calendar/blob/main/docs/system-calendar-sync.md" target="_blank" rel="noopener noreferrer" class="hover:underline"><%= t('calendarSync.registerGuide') %> ↗</a>
  </div>
</section>
<section class="rounded-2xl border border-slate-200 p-5 sm:p-7">
  <h2 class="text-lg font-semibold text-slate-900">Apple Calendar</h2>
  <p class="text-sm text-slate-500 mt-2"><%= t('adminCalendar.apple') %></p>
</section>
<%- include('_nav_end') %>
