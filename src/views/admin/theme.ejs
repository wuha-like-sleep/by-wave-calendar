<%- include('_nav') %>

<form method="post" action="/admin/theme" class="space-y-6">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
    <h1 class="text-xl font-semibold text-slate-900 mb-1"><%= t("adminTheme.heading") %></h1>
    <p class="text-sm text-slate-500 mb-5"><%= t("adminTheme.lead") %></p>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
      <%
        const palettes = [
          { id: 'indigo',  name: t("adminTheme.palette.indigo"),  colors: ['#eef2ff','#a5b4fc','#6366f1','#4338ca'] },
          { id: 'emerald', name: t("adminTheme.palette.emerald"), colors: ['#ecfdf5','#6ee7b7','#10b981','#047857'] },
          { id: 'rose',    name: t("adminTheme.palette.rose"),    colors: ['#fff1f2','#fda4af','#f43f5e','#be123c'] },
          { id: 'sky',     name: t("adminTheme.palette.sky"),     colors: ['#f0f9ff','#7dd3fc','#0ea5e9','#0369a1'] },
          { id: 'amber',   name: t("adminTheme.palette.amber"),   colors: ['#fffbeb','#fcd34d','#f59e0b','#b45309'] },
          { id: 'violet',  name: t("adminTheme.palette.violet"),  colors: ['#f5f3ff','#c4b5fd','#8b5cf6','#6d28d9'] },
          { id: 'slate',   name: t("adminTheme.palette.slate"),   colors: ['#f8fafc','#cbd5e1','#64748b','#334155'] },
        ];
      %>
      <% palettes.forEach(function(p){ %>
        <label class="palette-card group cursor-pointer rounded-xl border-2 p-3 transition <%= currentPalette === p.id ? 'border-brand-600 bg-brand-50' : 'border-slate-200 hover:border-slate-300 bg-white' %>">
          <input type="radio" name="palette" value="<%= p.id %>" <%= currentPalette === p.id ? 'checked' : '' %> class="sr-only" />
          <div class="flex items-center gap-1.5 mb-2">
            <% p.colors.forEach(function(c){ %>
              <span class="block h-6 w-6 rounded-md shadow-sm border border-slate-200/60" style="background: <%= c %>"></span>
            <% }) %>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm font-medium text-slate-900"><%= p.name %></span>
            <span class="text-xs text-slate-400 font-mono"><%= p.id %></span>
          </div>
        </label>
      <% }) %>
    </div>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
    <h2 class="text-lg font-semibold text-slate-900 mb-1"><%= t("adminTheme.density.title") %></h2>
    <p class="text-sm text-slate-500 mb-4"><%= t("adminTheme.density.lead") %></p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <% const densities = [
        { id: 'comfortable', name: t("adminTheme.density.comfortable"), desc: t("adminTheme.density.comfortableDesc") },
        { id: 'compact',     name: t("adminTheme.density.compact"),     desc: t("adminTheme.density.compactDesc") },
      ]; densities.forEach(function(d){ %>
        <label class="cursor-pointer rounded-xl border-2 p-4 transition <%= currentDensity === d.id ? 'border-brand-600 bg-brand-50' : 'border-slate-200 hover:border-slate-300 bg-white' %>">
          <input type="radio" name="density" value="<%= d.id %>" <%= currentDensity === d.id ? 'checked' : '' %> class="sr-only" />
          <div class="text-sm font-medium text-slate-900"><%= d.name %></div>
          <div class="mt-1 text-xs text-slate-500"><%= d.desc %></div>
        </label>
      <% }) %>
    </div>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
    <h2 class="text-lg font-semibold text-slate-900 mb-3"><%= t("adminTheme.preview.title") %></h2>
    <div class="rounded-xl border border-slate-200 p-4 bg-slate-50 space-y-3">
      <div class="flex flex-wrap gap-2 items-center">
        <button type="button" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white"><%= t("adminTheme.preview.primary") %></button>
        <button type="button" class="rounded-lg border border-brand-300 bg-brand-50 px-4 py-2 text-sm font-medium text-brand-700"><%= t("adminTheme.preview.secondary") %></button>
        <a href="#" class="text-sm text-brand-600 hover:text-brand-700 font-medium"><%= t("adminTheme.preview.link") %></a>
      </div>
      <div class="rounded-lg border border-brand-200 bg-brand-50 p-3">
        <div class="text-sm font-medium text-brand-800"><%= t("adminTheme.preview.card") %></div>
        <div class="text-xs text-brand-700"><%= t("adminTheme.preview.cardDesc") %></div>
      </div>
      <div class="flex gap-2">
        <span class="inline-block rounded-full bg-brand-100 text-brand-700 px-2.5 py-1 text-xs font-medium"><%= t("adminTheme.preview.badgeA") %></span>
        <span class="inline-block rounded-full bg-brand-600 text-white px-2.5 py-1 text-xs font-medium"><%= t("adminTheme.preview.badgeB") %></span>
      </div>
    </div>
  </section>

  <div class="flex justify-end gap-2">
    <button type="submit" class="rounded-lg bg-brand-600 px-5 py-2 text-sm font-medium text-white hover:bg-brand-700"><%= t("adminTheme.save") %></button>
  </div>
</form>

<%- include('_nav_end') %>
