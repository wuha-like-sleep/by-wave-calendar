<%- include('_nav', { activeNav: '/admin/site' }) %>

<h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 mb-6"><%= t("adminSite.heading") %></h1>

<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
  <form method="post" action="/admin/settings" class="space-y-4 max-w-xl">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div>
      <label class="block text-sm font-medium text-slate-700"><%= t("adminSite.siteNameLabel") %></label>
      <input type="text" name="siteName" required maxlength="200" value="<%= settings.siteName %>"
             class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
      <p class="mt-1 text-xs text-slate-500"><%= t("adminSite.siteNameHint") %></p>
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700"><%= t("adminSite.registrationModeLabel") %></label>
      <select name="registrationMode" required
              class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100">
        <option value="public" <%= settings.registrationMode === "public" ? "selected" : "" %>><%= t("adminSite.registrationPublic") %></option>
        <option value="invite" <%= settings.registrationMode === "invite" ? "selected" : "" %>><%= t("adminSite.registrationInvite") %></option>
        <option value="closed" <%= settings.registrationMode === "closed" ? "selected" : "" %>><%= t("adminSite.registrationClosed") %></option>
      </select>
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700"><%= t("adminSite.icpNumberLabel") %></label>
      <input type="text" name="icpNumber" maxlength="100" value="<%= settings.icpNumber || '' %>"
             placeholder="<%= t('adminSite.icpNumberPlaceholder') %>"
             class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
      <p class="mt-1 text-xs text-slate-500"><%= t("adminSite.icpNumberHint") %></p>
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700"><%= t("adminSite.icpUrlLabel") %></label>
      <input type="url" name="icpUrl" value="<%= settings.icpUrl %>"
             class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
    </div>
    <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"><%= t("common.save") %></button>
  </form>
</section>

<section id="signup-gates" class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mt-6 mb-6 scroll-mt-32">
  <div class="mb-4">
    <h2 class="text-lg font-semibold text-slate-900"><%= t("adminSite.gates.heading") %></h2>
    <p class="text-sm text-slate-500 mt-1"><%= t("adminSite.gates.desc") %></p>
    <a href="/admin/signups" class="mt-1 inline-block text-xs text-brand-600 hover:text-brand-700"><%= t("adminSite.gates.seeSignups") %></a>
  </div>
  <form method="post" action="/admin/signup-gates" class="space-y-4 max-w-xl">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div>
      <label for="signupDomainAllowlist" class="block text-sm font-medium text-slate-700"><%= t("adminSite.gates.domainLabel") %></label>
      <textarea id="signupDomainAllowlist" name="signupDomainAllowlist" rows="3" maxlength="4000"
                placeholder="<%= t('adminSite.gates.domainPlaceholder') %>"
                class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100"><%= settings.signupDomainAllowlist %></textarea>
      <p class="mt-1 text-xs text-slate-500"><%= t("adminSite.gates.domainHintEmpty") %></p>
      <p class="mt-1 text-xs text-slate-500"><%= t("adminSite.gates.domainHintSubdomain") %></p>
    </div>
    <div>
      <label for="signupDailyQuota" class="block text-sm font-medium text-slate-700"><%= t("adminSite.gates.quotaLabel") %></label>
      <input id="signupDailyQuota" type="number" name="signupDailyQuota" min="0" max="100000" step="1" value="<%= settings.signupDailyQuota %>"
             class="mt-1 block w-40 rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
      <p class="mt-1 text-xs text-slate-500"><%= t("adminSite.gates.quotaHintZero") %></p>
      <p class="mt-1 text-xs text-slate-500"><%= t("adminSite.gates.quotaHintWindow") %></p>
    </div>
    <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"><%= t("common.save") %></button>
  </form>
</section>

<section id="language" class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6 scroll-mt-32">
  <div class="flex items-start justify-between gap-3 mb-3">
    <div>
      <h2 class="text-lg font-semibold text-slate-900"><%= t("admin.siteLanguageTitle") %></h2>
      <p class="text-sm text-slate-500 mt-1"><%= t("admin.siteLanguageDesc") %></p>
      <p class="text-xs text-slate-400 mt-1"><%= t("adminSite.languageWarning") %></p>
    </div>
  </div>
  <form method="post" action="/admin/site/locale" class="flex items-end gap-2 max-w-md">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="flex-1">
      <label class="block text-sm font-medium text-slate-700 mb-1"><%= t("adminSite.defaultLocaleLabel") %></label>
      <select name="defaultLocale"
              class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100">
        <% siteLocaleOptions.forEach(function(opt){ %>
          <option value="<%= opt.code %>" <%= settings.defaultLocale === opt.code ? "selected" : "" %>>
            <%= opt.label %><% if (opt.code !== "auto" && currentLocale === "en") { %> (<%= opt.labelEn %>)<% } %>
          </option>
        <% }) %>
      </select>
    </div>
    <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"><%= t("common.save") %></button>
  </form>
</section>

<%- include('_nav_end') %>
