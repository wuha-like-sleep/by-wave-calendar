<%- include('_nav') %>

<h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 mb-2"><%= t("adminBackup.heading") %></h1>
<p class="text-sm text-slate-500 mb-6"><%= t("adminBackup.lead") %></p>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">

  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
    <h2 class="text-lg font-semibold text-slate-900 mb-1"><%= t("adminBackup.export.heading") %></h2>
    <p class="text-sm text-slate-500 mb-4"><%= t("adminBackup.export.lead") %></p>
    <a href="/admin/backup/export" class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
      <%= t("adminBackup.export.button") %>
    </a>
    <div class="mt-4 rounded-lg bg-amber-50 border border-amber-200 p-3 text-xs text-amber-800 leading-relaxed">
      <%- t("adminBackup.export.warning") %>
    </div>
  </section>

  <section class="rounded-2xl border border-red-200 bg-red-50/40 p-5 sm:p-6">
    <h2 class="text-lg font-semibold text-red-900 mb-1"><%= t("adminBackup.import.heading") %></h2>
    <p class="text-sm text-red-800 mb-4"><%- t("adminBackup.import.lead") %></p>

    <form method="post" action="/admin/backup/import" enctype="multipart/form-data" class="space-y-3"
          id="backup-restore-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="file" name="file" accept=".json,application/json" required
             class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm file:mr-3 file:rounded-md file:border-0 file:bg-slate-100 file:px-3 file:py-1 file:text-sm file:text-slate-700 hover:file:bg-slate-200" />
      <label class="flex items-start gap-2 text-xs text-red-900">
        <input type="checkbox" id="confirm-restore" required class="mt-0.5 h-3.5 w-3.5 rounded border-red-300 accent-red-600" />
        <span><%= t("adminBackup.import.confirmCheckbox") %></span>
      </label>
      <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
        <%= t("adminBackup.import.button") %>
      </button>
    </form>
  </section>

</div>

<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
  <h2 class="text-base font-semibold text-slate-900 mb-3"><%= t("adminBackup.structure.heading") %></h2>
  <div class="text-sm text-slate-600 space-y-2 mb-3">
    <p><%= t("adminBackup.structure.intro") %></p>
    <pre class="rounded-lg bg-slate-50 border border-slate-200 p-3 text-xs font-mono overflow-x-auto">{
  "bundleVersion": <%= bundleVersion %>,
  "exportedAt": "2026-05-21T12:34:56.000Z",
  "productId": "by-wave-calendar",
  "tables": {
    "site_settings": [ { ... } ],
    "users": [ { "id": "...", "email": "...", "passwordHash": "$2b$...", ... }, ... ],
    "calendars": [ ... ],
    "events": [ ... ],
    "sso_providers": [ ... ],
    "api_tokens": [ ... ],
    ...
  }
}</pre>
    <p><%- t("adminBackup.structure.verifyNote") %></p>
  </div>
  <ul class="text-xs text-slate-500 list-disc pl-5 space-y-1">
    <li><%- t("adminBackup.structure.included") %></li>
    <li><%- t("adminBackup.structure.excluded") %></li>
    <li><%- t("adminBackup.structure.transactional") %></li>
  </ul>
</section>

<script type="application/json" id="bwc-backup-i18n" nonce="<%= cspNonce %>"><%-
JSON.stringify({
  needCheckbox: t("adminBackup.import.needCheckbox"),
  modalTitle: t("adminBackup.import.modalTitle"),
  modalMessage: t("adminBackup.import.modalMessage"),
  modalConfirm: t("adminBackup.import.modalConfirm"),
}) %></script>

<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
// The restore form needs the checkbox AND an extra modal confirm. We
// can't use plain data-confirm because of the checkbox dependency.
const BWC_I18N = (() => {
  try { return JSON.parse(document.getElementById('bwc-backup-i18n').textContent); }
  catch { return {}; }
})();
document.getElementById("backup-restore-form")?.addEventListener("submit", async function(e) {
  if (this.__bwcConfirmed) { this.__bwcConfirmed = false; return; }
  e.preventDefault();
  if (!document.getElementById("confirm-restore").checked) {
    window.bwc.toast(BWC_I18N.needCheckbox, "error");
    return;
  }
  const ok = await window.bwc.confirm({
    title: BWC_I18N.modalTitle,
    message: BWC_I18N.modalMessage,
    danger: true,
    confirmLabel: BWC_I18N.modalConfirm,
  });
  if (!ok) return;
  this.__bwcConfirmed = true;
  this.requestSubmit();
});
</script>
