<%- include('_nav', { activeNav: '/admin/webhooks' }) %>

<header class="mb-4 flex items-start justify-between gap-3 flex-wrap">
  <div class="min-w-0">
    <div class="text-xs text-slate-500 mb-1">
      <a href="/admin/webhooks" class="hover:text-slate-700">← 所有 Webhook</a>
    </div>
    <h1 class="text-xl sm:text-2xl font-semibold text-slate-900 truncate"><%= hook.label %></h1>
    <code class="block mt-1 text-xs font-mono text-slate-500 break-all"><%= hook.url %></code>
  </div>
  <div class="text-right text-xs text-slate-500">
    <div>状态：<span class="<%= hook.enabled ? 'text-emerald-700' : 'text-amber-700' %>"><%= hook.enabled ? '✓ 已启用' : '⏸ 暂停' %></span></div>
    <div class="mt-1">订阅事件：<%= (hook.events || []).join(', ') || '（无）' %></div>
  </div>
</header>

<% if (deliveries.length === 0) { %>
  <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500">
    还没有任何投递记录。等触发事件后这里会出现。
  </div>
<% } else { %>
  <div class="rounded-2xl border border-slate-200 bg-white overflow-hidden">
    <ul class="divide-y divide-slate-100">
      <% deliveries.forEach(function(d){ %>
        <li class="p-4 sm:p-5">
          <div class="flex items-start justify-between gap-3 mb-2">
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-xs font-medium <%= d.ok ? 'bg-emerald-50 text-emerald-700' : 'bg-red-50 text-red-700' %>">
                  <%= d.ok ? '✓' : '✗' %>
                  <%= d.statusCode != null ? 'HTTP ' + d.statusCode : '网络失败' %>
                </span>
                <code class="text-xs font-mono text-slate-600"><%= d.eventName %></code>
                <span class="text-xs text-slate-400">尝试 <%= d.attemptCount %> 次</span>
              </div>
              <div class="text-xs text-slate-500 mt-1"><%- d.createdAtLocal %></div>
            </div>
            <% if (!d.ok) { %>
              <form method="post" action="/admin/webhooks/<%= hook.id %>/deliveries/<%= d.id %>/retry" class="m-0">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="rounded-md border border-brand-200 bg-white px-2.5 py-1 text-xs font-medium text-brand-700 hover:bg-brand-50">重试</button>
              </form>
            <% } %>
          </div>
          <% if (d.errorMessage) { %>
            <div class="mt-2 rounded-md bg-red-50 border border-red-200 px-3 py-2 text-xs text-red-900 font-mono whitespace-pre-wrap break-all"><%= d.errorMessage %></div>
          <% } %>
          <% if (d.responseShort) { %>
            <details class="mt-2">
              <summary class="cursor-pointer text-xs text-slate-500 hover:text-slate-700">响应正文 (<%= d.responseBody ? d.responseBody.length : 0 %> 字节)</summary>
              <pre class="mt-2 rounded-md bg-slate-50 border border-slate-200 p-3 text-xs font-mono whitespace-pre-wrap break-all overflow-x-auto"><%= d.responseBody %></pre>
            </details>
          <% } %>
          <details class="mt-2">
            <summary class="cursor-pointer text-xs text-slate-500 hover:text-slate-700">请求 payload</summary>
            <pre class="mt-2 rounded-md bg-slate-50 border border-slate-200 p-3 text-xs font-mono whitespace-pre-wrap break-all overflow-x-auto"><%= JSON.stringify(d.payload, null, 2) %></pre>
          </details>
        </li>
      <% }) %>
    </ul>
  </div>
  <p class="mt-3 text-xs text-slate-400">最近 200 条记录。更早的会被定期清理。</p>
<% } %>
