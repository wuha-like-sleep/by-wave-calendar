<%- include('_nav') %>

<h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 mb-2"><%= t("adminSecurity.heading") %></h1>
<p class="text-sm text-slate-500 mb-6"><%= t("adminSecurity.lead") %></p>

<form method="post" action="/admin/security" class="space-y-6">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
    <div class="flex items-start justify-between gap-4 mb-3">
      <div>
        <h2 class="text-lg font-semibold text-slate-900"><%= t("adminSecurity.risk.title") %></h2>
        <p class="mt-1 text-sm text-slate-500"><%= t("adminSecurity.risk.desc") %></p>
      </div>
    </div>
    <label class="inline-flex items-center gap-2 cursor-pointer">
      <input type="checkbox" name="riskLoginEnabled" <%= settings.riskLoginEnabled ? "checked" : "" %>
             class="h-4 w-4 rounded border-slate-300 accent-brand-600" />
      <span class="text-sm font-medium text-slate-700"><%= t("adminSecurity.risk.enable") %></span>
    </label>
    <p class="mt-2 text-xs text-slate-400"><%= t("adminSecurity.risk.offNote") %></p>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
    <div class="flex items-start justify-between gap-4 mb-3">
      <div>
        <h2 class="text-lg font-semibold text-slate-900"><%= t("adminSecurity.lockout.title") %></h2>
        <p class="mt-1 text-sm text-slate-500"><%= t("adminSecurity.lockout.desc") %></p>
      </div>
    </div>
    <label class="inline-flex items-center gap-2 cursor-pointer mb-4">
      <input type="checkbox" name="lockoutEnabled" <%= settings.lockoutEnabled ? "checked" : "" %>
             class="h-4 w-4 rounded border-slate-300 accent-brand-600" />
      <span class="text-sm font-medium text-slate-700"><%= t("adminSecurity.lockout.enable") %></span>
    </label>
    <div class="grid grid-cols-2 gap-3 max-w-md">
      <div>
        <label class="block text-sm font-medium text-slate-700"><%= t("adminSecurity.lockout.threshold") %></label>
        <input type="number" name="lockoutThreshold" required min="1" max="100"
               value="<%= settings.lockoutThreshold %>"
               class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700"><%= t("adminSecurity.lockout.minutes") %></label>
        <input type="number" name="lockoutMinutes" required min="1" max="10080"
               value="<%= settings.lockoutMinutes %>"
               class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
      </div>
    </div>
    <p class="mt-2 text-xs text-slate-400"><%= t("adminSecurity.lockout.hint") %></p>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
    <div class="flex items-start justify-between gap-4 mb-3">
      <div>
        <h2 class="text-lg font-semibold text-slate-900"><%= t("adminSecurity.adminMfa.title") %></h2>
        <p class="mt-1 text-sm text-slate-500"><%- t("adminSecurity.adminMfa.desc") %></p>
      </div>
    </div>
    <label class="inline-flex items-center gap-2 cursor-pointer">
      <input type="checkbox" name="forceAdminMfa" <%= settings.forceAdminMfa ? "checked" : "" %>
             class="h-4 w-4 rounded border-slate-300 accent-brand-600" />
      <span class="text-sm font-medium text-slate-700"><%= t("adminSecurity.adminMfa.enable") %></span>
    </label>
    <p class="mt-2 text-xs text-amber-700"><%= t("adminSecurity.adminMfa.warn") %></p>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
    <div class="flex items-start justify-between gap-4 mb-3">
      <div>
        <h2 class="text-lg font-semibold text-slate-900"><%= t("adminSecurity.passkeyUv.title") %></h2>
        <p class="mt-1 text-sm text-slate-500"><%= t("adminSecurity.passkeyUv.desc") %></p>
      </div>
    </div>
    <label class="inline-flex items-center gap-2 cursor-pointer">
      <input type="checkbox" name="requirePasskeyUv" <%= settings.requirePasskeyUv ? "checked" : "" %>
             class="h-4 w-4 rounded border-slate-300 accent-brand-600" />
      <span class="text-sm font-medium text-slate-700"><%= t("adminSecurity.passkeyUv.enable") %></span>
    </label>
    <p class="mt-2 text-xs text-slate-500"><%- t("adminSecurity.passkeyUv.note") %></p>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
    <div class="flex items-start justify-between gap-4 mb-3">
      <div>
        <h2 class="text-lg font-semibold text-slate-900"><%= t("adminSecurity.ssoMfa.title") %></h2>
        <p class="mt-1 text-sm text-slate-500"><%= t("adminSecurity.ssoMfa.desc") %></p>
      </div>
    </div>
    <label class="inline-flex items-center gap-2 cursor-pointer">
      <input type="checkbox" name="ssoSatisfiesMfa" <%= settings.ssoSatisfiesMfa ? "checked" : "" %>
             class="h-4 w-4 rounded border-slate-300 accent-brand-600" />
      <span class="text-sm font-medium text-slate-700"><%= t("adminSecurity.ssoMfa.enable") %></span>
    </label>
    <p class="mt-2 text-xs text-amber-700"><%- t("adminSecurity.ssoMfa.warn") %></p>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
    <div class="flex items-start justify-between gap-4 mb-3">
      <div>
        <h2 class="text-lg font-semibold text-slate-900"><%= t("adminSecurity.embed.title") %></h2>
        <p class="mt-1 text-sm text-slate-500"><%- t("adminSecurity.embed.desc", { base: typeof publicBaseUrl !== 'undefined' ? publicBaseUrl : '' }) %></p>
      </div>
    </div>
    <label class="inline-flex items-center gap-2 cursor-pointer">
      <input type="checkbox" name="embedEnabled" <%= settings.embedEnabled ? "checked" : "" %>
             class="h-4 w-4 rounded border-slate-300 accent-brand-600" />
      <span class="text-sm font-medium text-slate-700"><%= t("adminSecurity.embed.enable") %></span>
    </label>
    <p class="mt-2 text-xs text-slate-500"><%= t("adminSecurity.embed.note") %></p>
  </section>

  <div class="flex justify-end">
    <button type="submit" class="rounded-lg bg-brand-600 px-5 py-2 text-sm font-medium text-white hover:bg-brand-700"><%= t("adminSecurity.save") %></button>
  </div>
</form>

<%
  const captchaLabels = {
    none: t("adminSecurity.captcha.provider.none"),
    builtin: t("adminSecurity.captcha.provider.builtin"),
    turnstile: t("adminSecurity.captcha.provider.turnstile"),
    recaptcha: t("adminSecurity.captcha.provider.recaptcha"),
    hcaptcha: t("adminSecurity.captcha.provider.hcaptcha"),
  };
  const thirdPartyProviders = ["turnstile", "recaptcha", "hcaptcha"];
  const captchaThirdParty = thirdPartyProviders.indexOf(settings.captchaProvider) !== -1;
  const captchaBuiltin = settings.captchaProvider === "builtin";
%>
<form method="post" action="/admin/security/captcha" id="captcha" class="space-y-6 mt-6">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
    <div class="mb-4">
      <h2 class="text-lg font-semibold text-slate-900"><%= t("adminSecurity.captcha.title") %></h2>
      <p class="mt-1 text-sm text-slate-500"><%- t("adminSecurity.captcha.desc") %></p>
    </div>

    <div class="max-w-lg space-y-4">
      <div>
        <label class="block text-sm font-medium text-slate-700"><%= t("adminSecurity.captcha.method") %></label>
        <select name="captchaProvider"
                <%# 面板用 data-bwc-when 声明自己在哪些取值下显示；app.js 里的
                    委托监听负责切换。初始状态仍由下面两个 div 的 style 服务端渲染。 %>
                data-bwc-switch
                class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100">
          <% captchaProviders.forEach(function (p) { %>
            <option value="<%= p %>" <%= settings.captchaProvider === p ? "selected" : "" %>><%= captchaLabels[p] || p %></option>
          <% }); %>
        </select>
      </div>

      <div id="captcha-builtin" data-bwc-when="builtin" style="<%= captchaBuiltin ? '' : 'display:none' %>" class="space-y-2 rounded-xl bg-slate-50 border border-slate-200 p-4">
        <div class="text-sm font-medium text-slate-700"><%= t("adminSecurity.captcha.builtinTitle") %></div>
        <label class="flex items-start gap-2 cursor-pointer">
          <input type="radio" name="captchaBuiltinMode" value="invisible" <%= settings.captchaBuiltinMode !== 'interactive' ? 'checked' : '' %> class="mt-0.5 accent-brand-600" />
          <span class="text-sm text-slate-700"><%- t("adminSecurity.captcha.modeInvisible") %></span>
        </label>
        <label class="flex items-start gap-2 cursor-pointer">
          <input type="radio" name="captchaBuiltinMode" value="interactive" <%= settings.captchaBuiltinMode === 'interactive' ? 'checked' : '' %> class="mt-0.5 accent-brand-600" />
          <span class="text-sm text-slate-700"><%- t("adminSecurity.captcha.modeInteractive") %></span>
        </label>
        <p class="text-xs text-slate-400"><%- t("adminSecurity.captcha.modeNote") %></p>
      </div>

      <div id="captcha-thirdparty" data-bwc-when="turnstile recaptcha hcaptcha" style="<%= captchaThirdParty ? '' : 'display:none' %>" class="space-y-4 rounded-xl bg-slate-50 border border-slate-200 p-4">
        <div>
          <label class="block text-sm font-medium text-slate-700"><%= t("adminSecurity.captcha.siteKey") %></label>
          <input type="text" name="captchaSiteKey" maxlength="500" autocomplete="off"
                 value="<%= settings.captchaSiteKey || '' %>"
                 placeholder="0x4AAAAAAA…"
                 class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-mono focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
          <p class="mt-1 text-xs text-slate-400"><%= t("adminSecurity.captcha.siteKeyHint") %></p>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700"><%= t("adminSecurity.captcha.secretKey") %></label>
          <input type="password" name="captchaSecret" maxlength="2000" autocomplete="new-password"
                 placeholder="<%= settings.captchaProvider !== 'none' && settings.captchaProvider !== 'builtin' ? t("adminSecurity.captcha.secretKeep") : '' %>"
                 class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-mono focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
          <p class="mt-1 text-xs text-slate-400"><%- t("adminSecurity.captcha.secretHint") %></p>
        </div>
      </div>

      <p class="text-xs text-amber-700"><%- t("adminSecurity.captcha.failClosed") %></p>
    </div>
  </section>

  <div class="flex justify-end">
    <button type="submit" class="rounded-lg bg-brand-600 px-5 py-2 text-sm font-medium text-white hover:bg-brand-700"><%= t("adminSecurity.captcha.save") %></button>
  </div>
</form>

<%- include('_nav_end') %>
