<%- include('_nav') %>

<h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 mb-2">安全设置</h1>
<p class="text-sm text-slate-500 mb-6">登录风控的两个关键开关 —— 都可以独立关掉。如果你这个站点只在内网用、或不想给用户增加摩擦，可以全关。</p>

<form method="post" action="/admin/security" class="space-y-6">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
    <div class="flex items-start justify-between gap-4 mb-3">
      <div>
        <h2 class="text-lg font-semibold text-slate-900">陌生设备验证（密码登录）</h2>
        <p class="mt-1 text-sm text-slate-500">密码登录时，如果 IP / 浏览器之前没成功登录过，会先发一封 6 位验证码到注册邮箱，输完才放行。MFA / Passkey 登录跳过这步。</p>
      </div>
    </div>
    <label class="inline-flex items-center gap-2 cursor-pointer">
      <input type="checkbox" name="riskLoginEnabled" <%= settings.riskLoginEnabled ? "checked" : "" %>
             class="h-4 w-4 rounded border-slate-300 accent-brand-600" />
      <span class="text-sm font-medium text-slate-700">启用 —— 陌生设备需要邮件验证码</span>
    </label>
    <p class="mt-2 text-xs text-slate-400">关闭后所有密码登录直接放行；登录提醒邮件仍然会发。</p>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
    <div class="flex items-start justify-between gap-4 mb-3">
      <div>
        <h2 class="text-lg font-semibold text-slate-900">账号锁定（密码错误次数）</h2>
        <p class="mt-1 text-sm text-slate-500">连续输错密码达到阈值后，账号被临时锁定。用户可以用「忘记密码」自助解锁（重设密码会清零计数器并解锁）。</p>
      </div>
    </div>
    <label class="inline-flex items-center gap-2 cursor-pointer mb-4">
      <input type="checkbox" name="lockoutEnabled" <%= settings.lockoutEnabled ? "checked" : "" %>
             class="h-4 w-4 rounded border-slate-300 accent-brand-600" />
      <span class="text-sm font-medium text-slate-700">启用 —— 错误超限自动锁定</span>
    </label>
    <div class="grid grid-cols-2 gap-3 max-w-md">
      <div>
        <label class="block text-sm font-medium text-slate-700">阈值（连续错误次数）</label>
        <input type="number" name="lockoutThreshold" required min="1" max="100"
               value="<%= settings.lockoutThreshold %>"
               class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700">锁定时长（分钟）</label>
        <input type="number" name="lockoutMinutes" required min="1" max="10080"
               value="<%= settings.lockoutMinutes %>"
               class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
      </div>
    </div>
    <p class="mt-2 text-xs text-slate-400">默认 5 次 / 15 分钟。设过低会被弱密码扫描器锁到怀疑人生，设过高就失去防护意义。</p>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
    <div class="flex items-start justify-between gap-4 mb-3">
      <div>
        <h2 class="text-lg font-semibold text-slate-900">管理员强制启用 MFA</h2>
        <p class="mt-1 text-sm text-slate-500">勾上之后任何管理员账号必须先在 <code class="bg-slate-100 px-1 rounded">/app/settings/mfa/setup</code> 启用 TOTP 才能进入后台。Passkey 登录也算（Passkey 等同二要素）。</p>
      </div>
    </div>
    <label class="inline-flex items-center gap-2 cursor-pointer">
      <input type="checkbox" name="forceAdminMfa" <%= settings.forceAdminMfa ? "checked" : "" %>
             class="h-4 w-4 rounded border-slate-300 accent-brand-600" />
      <span class="text-sm font-medium text-slate-700">管理员必须启用 MFA</span>
    </label>
    <p class="mt-2 text-xs text-amber-700">⚠️ 开启前确认所有管理员（包括你自己）已经启用 MFA；否则会被自己锁在门外，需要数据库手工恢复。</p>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
    <div class="flex items-start justify-between gap-4 mb-3">
      <div>
        <h2 class="text-lg font-semibold text-slate-900">允许第三方网页嵌入日历</h2>
        <p class="mt-1 text-sm text-slate-500">用户在「订阅链接」区块可以复制一段 <code class="bg-slate-100 px-1 rounded">&lt;iframe src="<%= typeof publicBaseUrl !== 'undefined' ? publicBaseUrl : '' %>/embed/&lt;token&gt;"&gt;</code>，贴到 Notion、个人主页或第三方网站直接展示。关掉这个开关后，<code class="bg-slate-100 px-1 rounded">/embed/&lt;token&gt;</code> 立即 404；订阅 .ics 不受影响。</p>
      </div>
    </div>
    <label class="inline-flex items-center gap-2 cursor-pointer">
      <input type="checkbox" name="embedEnabled" <%= settings.embedEnabled ? "checked" : "" %>
             class="h-4 w-4 rounded border-slate-300 accent-brand-600" />
      <span class="text-sm font-medium text-slate-700">允许 iframe 嵌入（默认开启）</span>
    </label>
    <p class="mt-2 text-xs text-slate-500">嵌入只能展示一个已经发出 share token 的日历，且全程只读 —— 关 iframe 主要是为了控制品牌曝光面，不是安全关键。</p>
  </section>

  <div class="flex justify-end">
    <button type="submit" class="rounded-lg bg-brand-600 px-5 py-2 text-sm font-medium text-white hover:bg-brand-700">保存安全设置</button>
  </div>
</form>

<%
  const captchaLabels = {
    none: "关闭 —— 不做人机验证",
    builtin: "内置无感验证（Proof-of-Work，自托管 / 无 CDN，推荐）",
    turnstile: "Cloudflare Turnstile（第三方，加载 challenges.cloudflare.com）",
    recaptcha: "Google reCAPTCHA v2（第三方，加载 www.google.com）",
  };
  const captchaThirdParty = settings.captchaProvider === "turnstile" || settings.captchaProvider === "recaptcha";
%>
<form method="post" action="/admin/security/captcha" id="captcha" class="space-y-6 mt-6">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
    <div class="mb-4">
      <h2 class="text-lg font-semibold text-slate-900">注册人机验证（CAPTCHA）</h2>
      <p class="mt-1 text-sm text-slate-500">控制注册页用哪种人机验证。<strong>内置</strong>是自托管的无感 Proof-of-Work —— 浏览器要真实消耗 CPU 算出哈希，F12 看不到任何「正确答案」，且不依赖任何外部 CDN。如果你更信任大厂，可切到 Cloudflare / Google，把它们后台拿到的 Site Key / Secret 填进来即可。</p>
    </div>

    <div class="max-w-lg space-y-4">
      <div>
        <label class="block text-sm font-medium text-slate-700">验证方式</label>
        <select name="captchaProvider"
                onchange="document.getElementById('captcha-thirdparty').style.display = (this.value==='turnstile'||this.value==='recaptcha') ? '' : 'none'"
                class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100">
          <% captchaProviders.forEach(function (p) { %>
            <option value="<%= p %>" <%= settings.captchaProvider === p ? "selected" : "" %>><%= captchaLabels[p] || p %></option>
          <% }); %>
        </select>
      </div>

      <div id="captcha-thirdparty" style="<%= captchaThirdParty ? '' : 'display:none' %>" class="space-y-4 rounded-xl bg-slate-50 border border-slate-200 p-4">
        <div>
          <label class="block text-sm font-medium text-slate-700">Site Key（公开）</label>
          <input type="text" name="captchaSiteKey" maxlength="500" autocomplete="off"
                 value="<%= settings.captchaSiteKey || '' %>"
                 placeholder="0x4AAAAAAA…"
                 class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
          <p class="mt-1 text-xs text-slate-400">显示在前端的公开密钥，可以放心暴露。</p>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700">Secret Key（保密）</label>
          <input type="password" name="captchaSecret" maxlength="2000" autocomplete="new-password"
                 placeholder="<%= settings.captchaProvider !== 'none' && settings.captchaProvider !== 'builtin' ? '留空则保持当前已保存的 Secret' : '' %>"
                 class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
          <p class="mt-1 text-xs text-slate-400">服务端校验用的密钥，<strong>只写不显</strong>。留空表示沿用已保存的值，不会被清空。</p>
        </div>
      </div>

      <p class="text-xs text-amber-700">⚠️ 选第三方但 Secret 缺失时，系统<strong>故意「验证失败」</strong>（fail-closed），宁可挡住注册也不放机器人进来。要彻底关掉验证请选「关闭」。</p>
    </div>
  </section>

  <div class="flex justify-end">
    <button type="submit" class="rounded-lg bg-brand-600 px-5 py-2 text-sm font-medium text-white hover:bg-brand-700">保存验证设置</button>
  </div>
</form>
