<%- include('_nav', { activeNav: '/admin/users' }) %>

<div class="mb-5">
  <a href="/admin/users" class="text-sm text-slate-500 hover:text-slate-700"><%= t("adminMerge.back") %></a>
  <h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 mt-2"><%= t("adminMerge.heading") %></h1>
  <p class="mt-1 text-sm text-slate-500"><%- t("adminMerge.lead") %></p>
</div>

<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6 max-w-2xl">
  <form method="get" action="/admin/users/merge" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    <label class="text-sm">
      <span class="block font-medium text-slate-700 mb-1"><%= t("adminMerge.source") %> <span class="text-xs text-slate-400"><%= t("adminMerge.sourceHint") %></span></span>
      <input type="text" name="source" value="<%= sourceInput %>" placeholder="<%= t("adminMerge.emailOrId") %>" required
             class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
    </label>
    <label class="text-sm">
      <span class="block font-medium text-slate-700 mb-1"><%= t("adminMerge.target") %> <span class="text-xs text-slate-400"><%= t("adminMerge.targetHint") %></span></span>
      <input type="text" name="target" value="<%= targetInput %>" placeholder="<%= t("adminMerge.emailOrId") %>" required
             class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
    </label>
    <div class="sm:col-span-2">
      <button type="submit" class="rounded-lg bg-slate-700 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800"><%= t("adminMerge.preview") %></button>
    </div>
  </form>
</section>

<% if (error) { %>
  <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900 max-w-2xl"><%= error %></div>
<% } %>

<% if (source && target && summary) { %>
  <section class="rounded-2xl border border-red-200 bg-red-50/40 p-5 sm:p-6 max-w-2xl">
    <h2 class="text-lg font-semibold text-red-900 mb-3"><%= t("adminMerge.confirmHeading") %></h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4 text-sm">
      <div class="rounded-lg bg-white border border-slate-200 p-3">
        <div class="text-xs text-slate-400 mb-1"><%= t("adminMerge.sourceCard") %></div>
        <div class="font-medium text-slate-900 break-all"><%= source.email %></div>
        <div class="text-xs text-slate-500"><%= source.displayName || '—' %></div>
      </div>
      <div class="rounded-lg bg-white border border-slate-200 p-3">
        <div class="text-xs text-slate-400 mb-1"><%= t("adminMerge.targetCard") %></div>
        <div class="font-medium text-slate-900 break-all"><%= target.email %></div>
        <div class="text-xs text-slate-500"><%= target.displayName || '—' %></div>
      </div>
    </div>

    <div class="rounded-lg bg-white border border-slate-200 p-3 mb-4 text-sm">
      <div class="text-xs text-slate-400 mb-2"><%= t("adminMerge.migrateTitle") %></div>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-1 text-slate-700">
        <li><%= t("adminMerge.m.calendars") %><strong><%= summary.calendars %></strong></li>
        <li><%= t("adminMerge.m.events") %><strong><%= summary.events %></strong></li>
        <li><%= t("adminMerge.m.bookingLinks") %><strong><%= summary.bookingLinks %></strong></li>
        <li><%= t("adminMerge.m.shoppingLists") %><strong><%= summary.shoppingLists %></strong></li>
        <li><%= t("adminMerge.m.memberships") %><strong><%= summary.memberships %></strong></li>
        <li><%= t("adminMerge.m.identities") %><strong><%= summary.identities %></strong></li>
      </ul>
    </div>

    <div class="rounded-lg bg-white border border-red-200 p-3 mb-4 text-sm">
      <div class="text-xs text-red-500 mb-2"><%- t("adminMerge.deleteTitle") %></div>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-1 text-slate-700">
        <li><%= t("adminMerge.d.devices") %><strong><%= deleteCounts.devices %></strong></li>
        <li><%= t("adminMerge.d.apiTokens") %><strong><%= deleteCounts.apiTokens %></strong></li>
        <li><%= t("adminMerge.d.passkeys") %><strong><%= deleteCounts.passkeys %></strong></li>
        <li><%= t("adminMerge.d.appPasswords") %><strong><%= deleteCounts.appPasswords %></strong></li>
      </ul>
      <div class="text-xs text-slate-400 mt-2"><%= t("adminMerge.deleteNote") %></div>
    </div>

    <form method="post" action="/admin/users/merge"
          data-confirm="<%= t("adminMerge.executeConfirm", { source: source.email, target: target.email }) %>"
          data-confirm-danger="1" data-confirm-ok="<%= t("adminMerge.executeOk") %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="sourceId" value="<%= source.id %>" />
      <input type="hidden" name="targetId" value="<%= target.id %>" />
      <button type="submit" class="rounded-lg bg-red-600 px-5 py-2 text-sm font-medium text-white hover:bg-red-700"><%= t("adminMerge.execute") %></button>
    </form>
  </section>
<% } %>

<%- include('_nav_end') %>
