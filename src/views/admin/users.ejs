<%- include('_nav', { activeNav: '/admin/users' }) %>

<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-5">
  <div>
    <h1 class="text-2xl sm:text-3xl font-semibold text-slate-900"><%= t("adminUsers.heading") %></h1>
    <p class="mt-1 text-sm text-slate-500"><%- t("adminUsers.summary", { total: stats.total, admins: stats.admins, disabled: stats.disabled }) %></p>
    <a href="/admin/users/merge" class="mt-1 inline-block text-xs text-brand-600 hover:text-brand-700">合并重复账号 →</a>
  </div>
  <form method="get" action="/admin/users" class="relative w-full sm:w-72">
    <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 3.555 9.7l3.122 3.123a.75.75 0 1 0 1.06-1.06l-3.122-3.123A5.5 5.5 0 0 0 9 3.5zM4.5 9a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0z" clip-rule="evenodd"/></svg>
    <input type="search" name="q" value="<%= query %>" autocomplete="off" placeholder="<%= t('adminUsers.searchPlaceholder') %>"
           class="w-full rounded-lg border border-slate-300 bg-white pl-9 pr-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
  </form>
</div>

<div class="rounded-2xl border border-slate-200 bg-white overflow-x-auto">
  <table class="min-w-full text-sm">
    <thead class="bg-slate-50 border-b border-slate-200">
      <tr class="text-left text-xs uppercase tracking-wide text-slate-500">
        <th class="px-4 py-3"><%= t("adminUsers.col.email") %></th>
        <th class="px-4 py-3"><%= t("adminUsers.col.displayName") %></th>
        <th class="px-4 py-3"><%= t("adminUsers.col.verified") %></th>
        <th class="px-4 py-3"><%= t("adminUsers.col.loginMethod") %></th>
        <th class="px-4 py-3"><%= t("adminUsers.col.createdAt") %></th>
        <th class="px-4 py-3"><%= t("adminUsers.col.role") %></th>
        <th class="px-4 py-3"><%= t("adminUsers.col.actions") %></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% if (users.length === 0) { %>
        <tr>
          <td colspan="7" class="px-4 py-12 text-center">
            <div class="text-3xl mb-2">👥</div>
            <div class="text-sm text-slate-500"><%- query ? t("adminUsers.emptyFiltered", { q: query }) : t("adminUsers.empty") %></div>
          </td>
        </tr>
      <% } %>
      <% users.forEach(function(u){ %>
        <tr>
          <td class="px-4 py-3 text-slate-900 truncate max-w-[260px]">
            <%= u.email %>
            <% if (u.disabledAt) { %><span class="ml-1 inline-flex items-center rounded-full bg-amber-50 text-amber-700 px-1.5 py-0.5 text-[10px]"><%= t("adminUsers.badge.disabled") %></span><% } %>
          </td>
          <td class="px-4 py-3 text-slate-700"><%= u.displayName || '—' %></td>
          <td class="px-4 py-3">
            <% if (u.emailVerified) { %>
              <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-xs text-emerald-700"><%= t("adminUsers.badge.emailVerified") %></span>
            <% } else { %>
              <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs text-amber-700"><%= t("adminUsers.badge.emailUnverified") %></span>
            <% } %>
          </td>
          <td class="px-4 py-3">
            <div class="flex flex-wrap gap-1 max-w-[220px]">
              <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-700" title="<%= t("adminUsers.badge.passwordTitle") %>"><%= t("adminUsers.badge.password") %></span>
              <% if (u.passkeyCount > 0) { %>
                <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-xs text-emerald-700">Passkey × <%= u.passkeyCount %></span>
              <% } %>
              <% if (u.mfaEnabled) { %>
                <span class="inline-flex items-center rounded-full bg-indigo-50 px-2 py-0.5 text-xs text-indigo-700">MFA</span>
              <% } %>
              <% if (u.ssoProviderSlug) { %>
                <span class="inline-flex items-center rounded-full bg-violet-50 px-2 py-0.5 text-xs text-violet-700">SSO · <%= u.ssoProviderSlug %></span>
              <% } %>
            </div>
            <% if (u.lastLoginMethod) { %>
              <div class="mt-0.5 text-[10px] text-slate-400"><%= t("adminUsers.lastLoginPrefix") %><%= u.lastLoginMethod %></div>
            <% } %>
          </td>
          <td class="px-4 py-3 text-xs text-slate-500">
            <%= new Intl.DateTimeFormat('zh-CN', { year:'numeric', month:'2-digit', day:'2-digit' }).format(u.createdAt) %>
          </td>
          <td class="px-4 py-3">
            <% if (u.isAdmin) { %>
              <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs text-amber-800"><%= t("adminUsers.role.admin") %></span>
            <% } else { %>
              <span class="text-xs text-slate-400"><%= t("adminUsers.role.normal") %></span>
            <% } %>
          </td>
          <td class="px-4 py-3">
            <% if (u.id !== user.id) { %>
              <div class="flex flex-wrap gap-x-3 gap-y-1 items-center text-xs">
                <form method="post" action="/admin/users/<%= u.id %>/toggle-admin" class="m-0 inline"
                      data-confirm="<%= u.isAdmin ? t("adminUsers.confirm.revokeAdmin") : t("adminUsers.confirm.promoteAdmin") %>"
                      data-confirm-danger="<%= u.isAdmin ? '1' : '0' %>"
                      data-confirm-ok="<%= u.isAdmin ? t("adminUsers.action.revokeAdmin") : t("adminUsers.action.promoteAdmin") %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="<%= u.isAdmin ? 'text-red-600 hover:text-red-700' : 'text-brand-600 hover:text-brand-700' %>">
                    <%= u.isAdmin ? t("adminUsers.action.revokeAdmin") : t("adminUsers.action.promoteAdmin") %>
                  </button>
                </form>
                <form method="post" action="/admin/users/<%= u.id %>/toggle-disabled" class="m-0 inline"
                      data-confirm="<%= u.disabledAt ? t("adminUsers.confirm.enable") : t("adminUsers.confirm.disable") %>"
                      data-confirm-danger="<%= u.disabledAt ? '0' : '1' %>"
                      data-confirm-ok="<%= u.disabledAt ? t("adminUsers.action.enable") : t("adminUsers.action.disable") %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="<%= u.disabledAt ? 'text-emerald-600 hover:text-emerald-700' : 'text-amber-600 hover:text-amber-700' %>">
                    <%= u.disabledAt ? t("adminUsers.action.enable") : t("adminUsers.action.disable") %>
                  </button>
                </form>
                <form method="post" action="/admin/users/<%= u.id %>/revoke-sessions" class="m-0 inline"
                      data-confirm="<%= t("adminUsers.confirm.kick") %>" data-confirm-danger="1" data-confirm-ok="<%= t("adminUsers.confirmOk.kick") %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="text-slate-600 hover:text-slate-900"><%= t("adminUsers.action.kick") %></button>
                </form>
              </div>
            <% } else { %>
              <span class="text-xs text-slate-300"><%= t("adminUsers.self") %></span>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('_nav_end') %>
