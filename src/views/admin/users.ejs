<%- include('_nav', { activeNav: '/admin/users' }) %>

<h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 mb-6">用户管理</h1>

<div class="rounded-2xl border border-slate-200 bg-white overflow-x-auto">
  <table class="min-w-full text-sm">
    <thead class="bg-slate-50 border-b border-slate-200">
      <tr class="text-left text-xs uppercase tracking-wide text-slate-500">
        <th class="px-4 py-3">邮箱</th>
        <th class="px-4 py-3">昵称</th>
        <th class="px-4 py-3">验证</th>
        <th class="px-4 py-3">登录方式</th>
        <th class="px-4 py-3">注册</th>
        <th class="px-4 py-3">角色</th>
        <th class="px-4 py-3">操作</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% users.forEach(function(u){ %>
        <tr>
          <td class="px-4 py-3 text-slate-900 truncate max-w-[260px]">
            <%= u.email %>
            <% if (u.disabledAt) { %><span class="ml-1 inline-flex items-center rounded-full bg-amber-50 text-amber-700 px-1.5 py-0.5 text-[10px]">已停用</span><% } %>
          </td>
          <td class="px-4 py-3 text-slate-700"><%= u.displayName || '—' %></td>
          <td class="px-4 py-3">
            <% if (u.emailVerified) { %>
              <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-xs text-emerald-700">✓ 已验证</span>
            <% } else { %>
              <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs text-amber-700">未验证</span>
            <% } %>
          </td>
          <td class="px-4 py-3">
            <div class="flex flex-wrap gap-1 max-w-[220px]">
              <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-700" title="所有账号都支持密码登录（SSO 账号的密码是随机生成且不可登录，除非自助走「忘记密码」重设）">密码</span>
              <% if (u.passkeyCount > 0) { %>
                <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-xs text-emerald-700">Passkey × <%= u.passkeyCount %></span>
              <% } %>
              <% if (u.mfaEnabled) { %>
                <span class="inline-flex items-center rounded-full bg-indigo-50 px-2 py-0.5 text-xs text-indigo-700">MFA</span>
              <% } %>
              <% if (u.ssoProviderSlug) { %>
                <span class="inline-flex items-center rounded-full bg-violet-50 px-2 py-0.5 text-xs text-violet-700">SSO · <%= u.ssoProviderSlug %></span>
              <% } %>
            </div>
            <% if (u.lastLoginMethod) { %>
              <div class="mt-0.5 text-[10px] text-slate-400">上次：<%= u.lastLoginMethod %></div>
            <% } %>
          </td>
          <td class="px-4 py-3 text-xs text-slate-500">
            <%= new Intl.DateTimeFormat('zh-CN', { year:'numeric', month:'2-digit', day:'2-digit' }).format(u.createdAt) %>
          </td>
          <td class="px-4 py-3">
            <% if (u.isAdmin) { %>
              <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs text-amber-800">管理员</span>
            <% } else { %>
              <span class="text-xs text-slate-400">普通</span>
            <% } %>
          </td>
          <td class="px-4 py-3">
            <% if (u.id !== user.id) { %>
              <div class="flex flex-wrap gap-x-3 gap-y-1 items-center text-xs">
                <form method="post" action="/admin/users/<%= u.id %>/toggle-admin" class="m-0 inline"
                      onsubmit="return confirm('<%= u.isAdmin ? '撤销该用户的管理员身份？' : '将该用户提升为管理员？' %>');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="<%= u.isAdmin ? 'text-red-600 hover:text-red-700' : 'text-brand-600 hover:text-brand-700' %>">
                    <%= u.isAdmin ? '撤销管理员' : '设为管理员' %>
                  </button>
                </form>
                <form method="post" action="/admin/users/<%= u.id %>/toggle-disabled" class="m-0 inline"
                      onsubmit="return confirm('<%= u.disabledAt ? '重新启用此账号？' : '停用此账号？该用户所有设备会被踢下线，登录会被拒绝。' %>');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="<%= u.disabledAt ? 'text-emerald-600 hover:text-emerald-700' : 'text-amber-600 hover:text-amber-700' %>">
                    <%= u.disabledAt ? '重新启用' : '停用账号' %>
                  </button>
                </form>
                <form method="post" action="/admin/users/<%= u.id %>/revoke-sessions" class="m-0 inline"
                      onsubmit="return confirm('踢出该用户的所有登录会话？需要重新登录。');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="text-slate-600 hover:text-slate-900">踢出登录</button>
                </form>
              </div>
            <% } else { %>
              <span class="text-xs text-slate-300">你自己</span>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
