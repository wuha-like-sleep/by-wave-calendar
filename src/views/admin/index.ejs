<%- include('_nav', { activeNav: '/admin' }) %>

<h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 mb-6">管理后台</h1>

<section class="grid grid-cols-3 gap-3 sm:gap-4 mb-6">
  <div class="rounded-xl border border-slate-200 bg-white p-4 text-center">
    <div class="text-2xl font-bold text-slate-900"><%= stats.users %></div>
    <div class="text-xs text-slate-500 mt-1">用户</div>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-4 text-center">
    <div class="text-2xl font-bold text-slate-900"><%= stats.calendars %></div>
    <div class="text-xs text-slate-500 mt-1">日历</div>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-4 text-center">
    <div class="text-2xl font-bold text-slate-900"><%= stats.events %></div>
    <div class="text-xs text-slate-500 mt-1">事件</div>
  </div>
</section>

<section class="grid sm:grid-cols-2 gap-3 sm:gap-4">
  <a href="/admin/site" class="rounded-xl border border-slate-200 bg-white p-4 hover:border-brand-300 hover:shadow-sm transition">
    <div class="text-sm font-semibold text-slate-900">站点设置</div>
    <div class="text-xs text-slate-500 mt-1">站点名、注册策略、ICP 备案</div>
    <div class="mt-3 text-xs text-slate-600 truncate"><%= settings.siteName %> · <%= settings.registrationMode %></div>
  </a>
  <a href="/admin/logo" class="rounded-xl border border-slate-200 bg-white p-4 hover:border-brand-300 hover:shadow-sm transition">
    <div class="text-sm font-semibold text-slate-900">平台 Logo</div>
    <div class="text-xs text-slate-500 mt-1">上传 / 删除自定义 logo</div>
    <div class="mt-3 flex items-center gap-2">
      <% if (settings.logoUrl) { %>
        <img src="<%= settings.logoUrl %>" alt="logo" class="h-8 w-8 rounded-md object-cover border border-slate-200" />
        <span class="text-xs text-emerald-700">已上传</span>
      <% } else { %>
        <div class="h-8 w-8 rounded-md bg-gradient-to-br from-brand-500 to-brand-700"></div>
        <span class="text-xs text-slate-500">默认渐变</span>
      <% } %>
    </div>
  </a>
  <a href="/admin/smtp" class="rounded-xl border border-slate-200 bg-white p-4 hover:border-brand-300 hover:shadow-sm transition">
    <div class="text-sm font-semibold text-slate-900">SMTP 邮件</div>
    <div class="text-xs text-slate-500 mt-1">注册验证码、登录提醒、邀请的发件配置</div>
    <div class="mt-3 text-xs">
      <% if (settings.smtpHost) { %>
        <span class="text-emerald-700">✓ 已配置</span>
        <span class="text-slate-500 ml-1">· <%= settings.smtpHost %></span>
      <% } else { %>
        <span class="text-amber-700">⚠ 未配置 — 邮件功能停用</span>
      <% } %>
    </div>
  </a>
  <a href="/admin/sso" class="rounded-xl border border-slate-200 bg-white p-4 hover:border-brand-300 hover:shadow-sm transition">
    <div class="text-sm font-semibold text-slate-900">SSO · OIDC</div>
    <div class="text-xs text-slate-500 mt-1">Keycloak / Authelia / 任何 OIDC 兼容 IDP</div>
    <div class="mt-3 text-xs">
      <% if (settings.ssoKeycloakEnabled) { %>
        <span class="text-emerald-700">✓ 已启用</span>
      <% } else { %>
        <span class="text-slate-400">已关闭</span>
      <% } %>
    </div>
  </a>
  <a href="/admin/users" class="rounded-xl border border-slate-200 bg-white p-4 hover:border-brand-300 hover:shadow-sm transition sm:col-span-2">
    <div class="text-sm font-semibold text-slate-900">用户管理</div>
    <div class="text-xs text-slate-500 mt-1">查看 / 设管理员</div>
    <div class="mt-3 text-xs text-slate-600">共 <%= stats.users %> 个用户</div>
  </a>
</section>
