<%- include('_nav', { activeNav: '/admin/users' }) %>

<div class="max-w-2xl">
  <a href="/admin/users/<%= target.id %>" class="text-sm text-brand-600 hover:text-brand-700">← <%= t("adminUserDelete.back") %></a>

  <h1 class="mt-2 text-2xl font-semibold text-slate-900"><%= t("adminUserDelete.heading") %></h1>
  <p class="mt-1 text-sm text-slate-600"><%= target.email %><%= target.displayName ? ' · ' + target.displayName : '' %></p>

  <%# 先说清楚「和停用不是一回事」。站长点进来时脑子里想的多半还是停用。 %>
  <div class="mt-4 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-900">
    <p class="font-medium"><%= t("adminUserDelete.warnTitle") %></p>
    <p class="mt-1"><%= t("adminUserDelete.warnBody") %></p>
  </div>

  <%# 逐项列清楚会跟着消失的东西。**0 也要显示,整行不许消失** ——
      少一行,读的人分不清是「没有」还是「这一版没算」。 %>
  <section class="mt-4 rounded-2xl border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-semibold text-slate-900 mb-3"><%= t("adminUserDelete.impactHeading") %></h2>
    <dl class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm">
      <% [
        [t("adminUserDetail.assets.calendars"),     impact.calendars],
        [t("adminUserDetail.assets.events"),        impact.events],
        [t("adminUserDelete.impact.bookings"),      impact.bookings],
        [t("adminUserDetail.assets.bookingLinks"),  impact.bookingLinks],
        [t("adminUserDetail.assets.devices"),       impact.devices],
        [t("adminUserDetail.assets.shareTokens"),   impact.shareTokens],
        [t("adminUserDetail.assets.subscriptions"), impact.subscriptions],
        [t("adminUserDetail.assets.apiTokens"),     impact.apiTokens],
        [t("adminUserDetail.assets.appPasswords"),  impact.appPasswords]
      ].forEach(function (row) { %>
        <div class="flex items-baseline justify-between gap-2">
          <dt class="text-slate-500 truncate"><%= row[0] %></dt>
          <dd class="font-medium tabular-nums <%= row[1] > 0 ? 'text-red-700' : 'text-slate-300' %>"><%= row[1] %></dd>
        </div>
      <% }) %>
    </dl>
    <% if (impact.bookings > 0) { %>
      <p class="mt-3 pt-3 border-t border-slate-100 text-xs text-amber-700"><%= t("adminUserDelete.bookingsNote") %></p>
    <% } %>
  </section>

  <% if (blockReason) { %>
    <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
      <%# 同理:键要写全,不能拼。 %>
      <%= blockReason === 'self' ? t("adminUserDelete.blocked.self") : t("adminUserDelete.blocked.lastAdmin") %>
    </div>
  <% } else { %>
    <%# 打字确认。不是仪式感 —— 它把「点错了一行」和「我确实要删这个人」
        分开了,而这两件事在一个确认弹窗上长得一模一样。 %>
    <form method="post" action="/admin/users/<%= target.id %>/delete" class="mt-4 rounded-2xl border border-slate-200 bg-white p-5">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label for="confirmEmail" class="block text-sm text-slate-700">
        <%- t("adminUserDelete.typeToConfirm", { email: target.email }) %>
      </label>
      <input id="confirmEmail" name="confirmEmail" type="text" autocomplete="off" spellcheck="false" required
             class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-100" />
      <div class="mt-4 flex items-center gap-3">
        <button type="submit" class="rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700">
          <%= t("adminUserDelete.confirmButton") %>
        </button>
        <a href="/admin/users/<%= target.id %>" class="text-sm text-slate-500 hover:text-slate-700"><%= t("adminUserDelete.cancel") %></a>
      </div>
    </form>
  <% } %>
</div>

<%- include('_nav_end') %>
