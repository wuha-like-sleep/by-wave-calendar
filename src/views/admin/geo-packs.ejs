<%- include('_nav') %>
<%
  function fmtBytes(n) {
    if (n >= 1024 * 1024 * 1024) return (n / (1024 * 1024 * 1024)).toFixed(2) + " GiB";
    if (n >= 1024 * 1024) return (n / (1024 * 1024)).toFixed(1) + " MiB";
    if (n >= 1024) return (n / 1024).toFixed(1) + " KiB";
    return n + " B";
  }
  function fmtRows(n) {
    return n == null ? "—" : n.toLocaleString("en-US");
  }
%>

<h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 mb-2"><%= t("adminGeoPacks.heading") %></h1>
<p class="text-sm text-slate-500 mb-6"><%= t("adminGeoPacks.lead") %></p>

<% if (flash && flash.issuedToken) { %>
<section class="rounded-2xl border border-amber-300 bg-amber-50 p-5 sm:p-6 mb-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-1"><%= t("adminGeoPacks.tokens.issuedHeading") %></h2>
  <p class="text-sm text-slate-600 mb-3"><%= t("adminGeoPacks.tokens.issuedLead") %></p>
  <p class="font-mono text-sm break-all rounded-lg bg-white border border-amber-200 px-3 py-2 text-slate-900"><%= flash.issuedToken %></p>
</section>
<% } %>

<% if (!listing.configured) { %>
<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-1"><%= t("adminGeoPacks.notConfigured.heading") %></h2>
  <p class="text-sm text-slate-500"><%= t("adminGeoPacks.notConfigured.lead") %></p>
</section>
<% } else { %>
<p class="text-sm text-slate-500 mb-4"><%= t("adminGeoPacks.providerNote", { provider: provider }) %></p>
<p class="text-sm text-slate-500 mb-4"><%= t("adminGeoPacks.dirNote", { dir: packDir }) %></p>

<% if (listing.packs.length === 0) { %>
<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
  <p class="text-sm text-slate-500"><%= t("adminGeoPacks.empty") %></p>
</section>
<% } %>

<% listing.packs.forEach(function (pack) { %>
<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6">
  <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
    <div>
      <h2 class="text-lg font-semibold text-slate-900 font-mono"><%= pack.file %></h2>
      <p class="text-sm text-slate-500">
        <%= pack.region || "—" %> · <%= fmtBytes(pack.bytes) %>
        <% if (pack.packVersion) { %> · v<%= pack.packVersion %><% } %>
      </p>
      <% var sync = syncByFile[pack.file]; %>
      <p class="text-sm mt-1">
        <span class="text-slate-400"><%= t("adminGeoPacks.sync.colStatus") %>:</span>
        <% if (!sync) { %>
          <span class="text-slate-500"><%= t("adminGeoPacks.sync.statusNone") %></span>
        <% } else if (sync.status === "active") { %>
          <span class="text-emerald-600 font-medium"><%= t("adminGeoPacks.sync.statusActive") %></span>
        <% } else if (sync.status === "receiving") { %>
          <span class="text-amber-600 font-medium"><%= t("adminGeoPacks.sync.statusReceiving") %> · <%= t("adminGeoPacks.sync.progress", { received: sync.received, total: sync.total }) %></span>
        <% } else if (sync.status === "failed") { %>
          <span class="text-red-600 font-medium"><%= t("adminGeoPacks.sync.statusFailed") %><% if (sync.error) { %> · <span class="font-mono text-xs"><%= sync.error %></span><% } %></span>
        <% } else { %>
          <span class="text-slate-500"><%= t("adminGeoPacks.sync.statusAborted") %></span>
        <% } %>
      </p>
    </div>
    <a href="/admin/geo-packs/download?file=<%= encodeURIComponent(pack.file) %>"
       class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
      <%= t("adminGeoPacks.download") %>
    </a>
  </div>
  <dl class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm mb-4">
    <div>
      <dt class="text-xs font-medium uppercase tracking-wider text-slate-400"><%= t("adminGeoPacks.colRows") %></dt>
      <dd class="mt-1 tabular-nums text-slate-900"><%= fmtRows(pack.rows) %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wider text-slate-400"><%= t("adminGeoPacks.colBuilt") %></dt>
      <dd class="mt-1 text-slate-900"><%= pack.buildDate || "—" %></dd>
    </div>
    <div class="min-w-0">
      <dt class="text-xs font-medium uppercase tracking-wider text-slate-400"><%= t("adminGeoPacks.colSha") %></dt>
      <dd class="mt-1 font-mono text-xs text-slate-900 break-all"><%= pack.sha256 || "—" %></dd>
    </div>
  </dl>
  <% if (pack.companions.length > 0) { %>
  <h3 class="text-sm font-medium text-slate-700 mb-2"><%= t("adminGeoPacks.companions") %></h3>
  <ul class="divide-y divide-slate-100 text-sm">
    <% pack.companions.forEach(function (f) { %>
    <li class="flex items-center justify-between gap-3 py-2">
      <span class="font-mono text-slate-700"><%= f.name %></span>
      <span class="flex items-center gap-3">
        <span class="tabular-nums text-slate-400"><%= fmtBytes(f.bytes) %></span>
        <a href="/admin/geo-packs/download?file=<%= encodeURIComponent(f.name) %>" class="text-brand-700 hover:underline"><%= t("adminGeoPacks.download") %></a>
      </span>
    </li>
    <% }); %>
  </ul>
  <% } %>
</section>
<% }); %>

<% if (listing.sharedFiles.length > 0) { %>
<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-1"><%= t("adminGeoPacks.shared.heading") %></h2>
  <p class="text-sm text-slate-500 mb-4"><%= t("adminGeoPacks.shared.lead") %></p>
  <ul class="divide-y divide-slate-100 text-sm">
    <% listing.sharedFiles.forEach(function (f) { %>
    <li class="flex items-center justify-between gap-3 py-2">
      <span class="font-mono text-slate-700"><%= f.name %></span>
      <span class="flex items-center gap-3">
        <span class="tabular-nums text-slate-400"><%= fmtBytes(f.bytes) %></span>
        <a href="/admin/geo-packs/download?file=<%= encodeURIComponent(f.name) %>" class="text-brand-700 hover:underline"><%= t("adminGeoPacks.download") %></a>
      </span>
    </li>
    <% }); %>
  </ul>
</section>
<% } %>
<% } %>

<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-1"><%= t("adminGeoPacks.fetch.heading") %></h2>
  <p class="text-sm text-slate-500 mb-4"><%= t("adminGeoPacks.fetch.lead", { base: releaseBaseUrl }) %></p>
  <% if (fetchJob) { %>
  <div class="text-sm mb-4">
    <% if (fetchJob.status === "running") { %>
      <p class="text-amber-600 font-medium"><%= t("adminGeoPacks.fetch.running") %></p>
    <% } else if (fetchJob.status === "done") { %>
      <p class="text-emerald-600 font-medium"><%= t("adminGeoPacks.fetch.done", { time: fetchJob.finishedAt ? fetchJob.finishedAt.slice(0, 19).replace("T", " ") : "" }) %></p>
    <% } else { %>
      <p class="text-red-600 font-medium"><%= t("adminGeoPacks.fetch.failed", { time: fetchJob.finishedAt ? fetchJob.finishedAt.slice(0, 19).replace("T", " ") : "" }) %><% if (fetchJob.error) { %> · <span class="font-mono text-xs"><%= fetchJob.error %></span><% } %></p>
    <% } %>
    <% if (fetchJob.release) { %><p class="text-slate-400 mt-1"><%= t("adminGeoPacks.fetch.release") %>: <span class="font-mono"><%= fetchJob.release %></span></p><% } %>
    <% if (fetchJob.files.length > 0) { %>
    <ul class="divide-y divide-slate-100 mt-2">
      <% fetchJob.files.forEach(function (f) { %>
      <li class="flex flex-wrap items-center justify-between gap-3 py-2">
        <span class="font-mono text-slate-700"><%= f.file %></span>
        <span class="text-slate-400">
          <%= fmtBytes(f.bytesDone) %> / <%= fmtBytes(f.bytesTotal) %> ·
          <% if (f.status === "done") { %><span class="text-emerald-600"><%= t("adminGeoPacks.fetch.fileDone") %></span>
          <% } else if (f.status === "skipped") { %><span class="text-slate-500"><%= t("adminGeoPacks.fetch.fileSkipped") %></span>
          <% } else if (f.status === "failed") { %><span class="text-red-600"><%= t("adminGeoPacks.fetch.fileFailed") %><% if (f.error) { %> · <%= f.error %><% } %></span>
          <% } else if (f.status === "activating") { %><span class="text-amber-600"><%= t("adminGeoPacks.fetch.fileActivating") %></span>
          <% } else if (f.status === "verifying") { %><span class="text-amber-600"><%= t("adminGeoPacks.fetch.fileVerifying") %></span>
          <% } else if (f.status === "downloading") { %><span class="text-amber-600"><%= t("adminGeoPacks.fetch.fileDownloading") %></span>
          <% } else { %><%= t("adminGeoPacks.fetch.filePending") %><% } %>
        </span>
      </li>
      <% }); %>
    </ul>
    <% } %>
  </div>
  <% } %>
  <form method="post" action="/admin/geo-packs/fetch">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <% var fetchRunning = fetchJob && fetchJob.status === "running"; %>
    <button type="submit"<% if (fetchRunning) { %> disabled<% } %> class="rounded-lg px-4 py-2 text-sm font-medium text-white <%= fetchRunning ? "bg-slate-300 cursor-not-allowed" : "bg-brand-600 hover:bg-brand-700" %>"><%= t("adminGeoPacks.fetch.button") %></button>
  </form>
</section>

<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-1"><%= t("adminGeoPacks.tokens.heading") %></h2>
  <p class="text-sm text-slate-500 mb-4"><%= t("adminGeoPacks.tokens.lead") %></p>
  <% if (syncTokens.length === 0) { %>
  <p class="text-sm text-slate-500 mb-4"><%= t("adminGeoPacks.tokens.empty") %></p>
  <% } else { %>
  <ul class="divide-y divide-slate-100 text-sm mb-4">
    <% syncTokens.forEach(function (tok) { %>
    <li class="flex flex-wrap items-center justify-between gap-3 py-2">
      <span class="min-w-0">
        <span class="font-medium text-slate-900"><%= tok.label %></span>
        <span class="font-mono text-xs text-slate-400">bwgs_<%= tok.prefix %>_…</span>
        <span class="text-slate-400">· <%= t("adminGeoPacks.tokens.colLastUsed") %>: <%= tok.lastUsedAt ? tok.lastUsedAt.toISOString().slice(0, 19).replace("T", " ") : "—" %></span>
      </span>
      <% if (tok.revokedAt) { %>
        <span class="text-slate-400"><%= t("adminGeoPacks.tokens.statusRevoked") %></span>
      <% } else { %>
        <span class="flex items-center gap-3">
          <span class="text-emerald-600 font-medium"><%= t("adminGeoPacks.tokens.statusActive") %></span>
          <form method="post" action="/admin/geo-packs/sync-tokens/<%= tok.id %>/revoke" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="text-red-600 hover:underline"><%= t("adminGeoPacks.tokens.revoke") %></button>
          </form>
        </span>
      <% } %>
    </li>
    <% }); %>
  </ul>
  <% } %>
  <form method="post" action="/admin/geo-packs/sync-tokens" class="flex flex-wrap items-end gap-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label class="block">
      <span class="block text-xs font-medium uppercase tracking-wider text-slate-400 mb-1"><%= t("adminGeoPacks.tokens.createLabel") %></span>
      <input type="text" name="label" maxlength="100" placeholder="打包机"
             class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 w-56" />
    </label>
    <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"><%= t("adminGeoPacks.tokens.create") %></button>
  </form>
</section>

<% if (recentUploads.length > 0) { %>
<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-4"><%= t("adminGeoPacks.recent.heading") %></h2>
  <ul class="divide-y divide-slate-100 text-sm">
    <% recentUploads.forEach(function (up) { %>
    <li class="flex flex-wrap items-center justify-between gap-3 py-2">
      <span class="font-mono text-slate-700"><%= up.fileName %></span>
      <span class="text-slate-400">
        <%= up.createdAt.toISOString().slice(0, 19).replace("T", " ") %> ·
        <% if (up.status === "active") { %><span class="text-emerald-600"><%= t("adminGeoPacks.sync.statusActive") %></span>
        <% } else if (up.status === "receiving") { %><span class="text-amber-600"><%= t("adminGeoPacks.sync.statusReceiving") %> · <%= t("adminGeoPacks.sync.progress", { received: Array.isArray(up.receivedChunks) ? up.receivedChunks.length : 0, total: up.chunkCount }) %></span>
        <% } else if (up.status === "failed") { %><span class="text-red-600"><%= t("adminGeoPacks.sync.statusFailed") %><% if (up.error) { %> · <%= up.error %><% } %></span>
        <% } else { %><%= t("adminGeoPacks.sync.statusAborted") %><% } %>
      </span>
    </li>
    <% }); %>
  </ul>
</section>
<% } %>

<%- include('_nav_end') %>
