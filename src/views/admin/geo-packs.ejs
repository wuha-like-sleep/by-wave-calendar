<%- include('_nav') %>
<%
  function fmtBytes(n) {
    if (n >= 1024 * 1024 * 1024) return (n / (1024 * 1024 * 1024)).toFixed(2) + " GiB";
    if (n >= 1024 * 1024) return (n / (1024 * 1024)).toFixed(1) + " MiB";
    if (n >= 1024) return (n / 1024).toFixed(1) + " KiB";
    return n + " B";
  }
  function fmtRows(n) {
    return n == null ? "—" : n.toLocaleString("en-US");
  }
%>

<h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 mb-2"><%= t("adminGeoPacks.heading") %></h1>
<p class="text-sm text-slate-500 mb-6"><%= t("adminGeoPacks.lead") %></p>

<% if (!listing.configured) { %>
<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-1"><%= t("adminGeoPacks.notConfigured.heading") %></h2>
  <p class="text-sm text-slate-500"><%= t("adminGeoPacks.notConfigured.lead") %></p>
</section>
<% } else { %>
<p class="text-sm text-slate-500 mb-4"><%= t("adminGeoPacks.providerNote", { provider: provider }) %></p>

<% if (listing.packs.length === 0) { %>
<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
  <p class="text-sm text-slate-500"><%= t("adminGeoPacks.empty") %></p>
</section>
<% } %>

<% listing.packs.forEach(function (pack) { %>
<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6">
  <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
    <div>
      <h2 class="text-lg font-semibold text-slate-900 font-mono"><%= pack.file %></h2>
      <p class="text-sm text-slate-500">
        <%= pack.region || "—" %> · <%= fmtBytes(pack.bytes) %>
        <% if (pack.packVersion) { %> · v<%= pack.packVersion %><% } %>
      </p>
    </div>
    <a href="/admin/geo-packs/download?file=<%= encodeURIComponent(pack.file) %>"
       class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
      <%= t("adminGeoPacks.download") %>
    </a>
  </div>
  <dl class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm mb-4">
    <div>
      <dt class="text-xs font-medium uppercase tracking-wider text-slate-400"><%= t("adminGeoPacks.colRows") %></dt>
      <dd class="mt-1 tabular-nums text-slate-900"><%= fmtRows(pack.rows) %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wider text-slate-400"><%= t("adminGeoPacks.colBuilt") %></dt>
      <dd class="mt-1 text-slate-900"><%= pack.buildDate || "—" %></dd>
    </div>
    <div class="min-w-0">
      <dt class="text-xs font-medium uppercase tracking-wider text-slate-400"><%= t("adminGeoPacks.colSha") %></dt>
      <dd class="mt-1 font-mono text-xs text-slate-900 break-all"><%= pack.sha256 || "—" %></dd>
    </div>
  </dl>
  <% if (pack.companions.length > 0) { %>
  <h3 class="text-sm font-medium text-slate-700 mb-2"><%= t("adminGeoPacks.companions") %></h3>
  <ul class="divide-y divide-slate-100 text-sm">
    <% pack.companions.forEach(function (f) { %>
    <li class="flex items-center justify-between gap-3 py-2">
      <span class="font-mono text-slate-700"><%= f.name %></span>
      <span class="flex items-center gap-3">
        <span class="tabular-nums text-slate-400"><%= fmtBytes(f.bytes) %></span>
        <a href="/admin/geo-packs/download?file=<%= encodeURIComponent(f.name) %>" class="text-brand-700 hover:underline"><%= t("adminGeoPacks.download") %></a>
      </span>
    </li>
    <% }); %>
  </ul>
  <% } %>
</section>
<% }); %>

<% if (listing.sharedFiles.length > 0) { %>
<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-1"><%= t("adminGeoPacks.shared.heading") %></h2>
  <p class="text-sm text-slate-500 mb-4"><%= t("adminGeoPacks.shared.lead") %></p>
  <ul class="divide-y divide-slate-100 text-sm">
    <% listing.sharedFiles.forEach(function (f) { %>
    <li class="flex items-center justify-between gap-3 py-2">
      <span class="font-mono text-slate-700"><%= f.name %></span>
      <span class="flex items-center gap-3">
        <span class="tabular-nums text-slate-400"><%= fmtBytes(f.bytes) %></span>
        <a href="/admin/geo-packs/download?file=<%= encodeURIComponent(f.name) %>" class="text-brand-700 hover:underline"><%= t("adminGeoPacks.download") %></a>
      </span>
    </li>
    <% }); %>
  </ul>
</section>
<% } %>
<% } %>

<%- include('_nav_end') %>
