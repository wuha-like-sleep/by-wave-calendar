<%- include('_nav') %>
<%
  function fmtBytes(n) {
    if (n >= 1024 * 1024 * 1024) return (n / (1024 * 1024 * 1024)).toFixed(2) + " GiB";
    if (n >= 1024 * 1024) return (n / (1024 * 1024)).toFixed(1) + " MiB";
    if (n >= 1024) return (n / 1024).toFixed(1) + " KiB";
    return n + " B";
  }
  var pageLocale = (typeof currentLocale !== "undefined" && currentLocale) || "en-US";
  function fmtRows(n) {
    return n == null ? "—" : n.toLocaleString(pageLocale);
  }
  function badgeOf(status) {
    if (status === "latest") return { key: "adminGeoPacks.badge.latest", cls: "bg-emerald-50 text-emerald-700" };
    if (status === "update") return { key: "adminGeoPacks.badge.update", cls: "bg-amber-50 text-amber-700" };
    if (status === "missing") return { key: "adminGeoPacks.badge.notInstalled", cls: "bg-slate-100 text-slate-500" };
    return { key: "adminGeoPacks.badge.installed", cls: "bg-slate-100 text-slate-600" };
  }
  function isIsoLike(s) { return typeof s === "string" && /^\d{4}-\d{2}-\d{2}T/.test(s); }
%>

<h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 mb-2"><%= t("adminGeoPacks.heading") %></h1>
<p class="text-sm text-slate-500 mb-6"><%= t("adminGeoPacks.lead") %></p>

<% if (flash && flash.issuedToken) { %>
<section class="rounded-2xl border border-amber-300 bg-amber-50 p-5 sm:p-6 mb-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-1"><%= t("adminGeoPacks.tokens.issuedHeading") %></h2>
  <p class="text-sm text-slate-600 mb-3"><%= t("adminGeoPacks.tokens.issuedLead") %></p>
  <p class="font-mono text-sm break-all rounded-lg bg-white border border-amber-200 px-3 py-2 text-slate-900"><%= flash.issuedToken %></p>
</section>
<% } %>

<div id="geo-pack-listing">
<% if (!listing.configured) { %>
<section>
  <h2 class="text-lg font-semibold text-slate-900 mb-1"><%= t("adminGeoPacks.notConfigured.heading") %></h2>
  <p class="text-sm text-slate-500"><%= t("adminGeoPacks.notConfigured.lead") %></p>
</section>
<% } else { %>

<%# 顶部一句话结论：装了几个包 / 多少条地址 / 多大 / 什么版本 /
    数据新到什么时候 / 是否最新。整块在 #geo-pack-listing 里，获取
    任务结束时轮询脚本的局部替换会把这里一起换成最新状态。 %>
<div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-sm text-slate-600">
  <% if (summary.installedCount === 0) { %>
    <span class="font-medium text-slate-900"><%= t("adminGeoPacks.summary.none") %></span>
  <% } else { %>
    <span class="font-medium text-slate-900"><%= t("adminGeoPacks.summary.installed", { count: summary.installedCount }) %></span>
    <% if (summary.totalRows != null) { %><span aria-hidden="true" class="text-slate-300">·</span><span><%= t("adminGeoPacks.summary.addresses", { count: fmtRows(summary.totalRows) }) %></span><% } %>
    <span aria-hidden="true" class="text-slate-300">·</span><span><%= t("adminGeoPacks.summary.size", { size: fmtBytes(summary.totalBytes) }) %></span>
    <% if (summary.versions.length > 0) { %><span aria-hidden="true" class="text-slate-300">·</span><span><%= t("adminGeoPacks.summary.version", { version: summary.versions.join(", ") }) %></span><% } %>
    <% if (summary.latestBuildDate) { %><span aria-hidden="true" class="text-slate-300">·</span><span><%= t("adminGeoPacks.summary.updated") %><% if (isIsoLike(summary.latestBuildDate)) { %> <time data-tz datetime="<%= summary.latestBuildDate %>" data-style="date"><%= summary.latestBuildDate.slice(0, 10) %></time><% } else { %> <%= summary.latestBuildDate %><% } %></span><% } %>
  <% } %>
  <% if (!summary.checked) { %>
    <span aria-hidden="true" class="text-slate-300">·</span><span class="text-slate-400"><%= t("adminGeoPacks.summary.checkFailed") %></span>
  <% } else if (summary.updateCount > 0 || summary.missingCount > 0) { %>
    <% if (summary.updateCount > 0) { %><span aria-hidden="true" class="text-slate-300">·</span><span class="font-medium text-amber-600"><%= t("adminGeoPacks.summary.updatesAvailable", { count: summary.updateCount }) %></span><% } %>
    <% if (summary.missingCount > 0) { %><span aria-hidden="true" class="text-slate-300">·</span><span class="font-medium text-amber-600"><%= t("adminGeoPacks.summary.missing", { count: summary.missingCount }) %></span><% } %>
  <% } else if (summary.installedCount > 0) { %>
    <span aria-hidden="true" class="text-slate-300">·</span><span class="font-medium text-emerald-600"><%= t("adminGeoPacks.summary.upToDate") %></span>
  <% } %>
</div>

<% if (packGroups.length === 0) { %>
<p class="mt-4 text-sm text-slate-500"><%= t("adminGeoPacks.empty") %></p>
<% } %>

<% packGroups.forEach(function (group) { %>
<h2 class="mt-6 mb-1 text-base font-semibold text-slate-900"><%= group.countryName %></h2>
<ul class="divide-y divide-slate-200 border-y border-slate-200">
  <% group.rows.forEach(function (row) { var badge = badgeOf(row.status); %>
  <li class="py-3">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="min-w-0">
        <p class="flex flex-wrap items-center gap-2">
          <span class="font-medium text-slate-900"><%= row.name %></span>
          <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= badge.cls %>"><%= t(badge.key) %></span>
        </p>
        <p class="mt-0.5 text-sm text-slate-500">
          <%= t(row.national ? "adminGeoPacks.coverage.national" : "adminGeoPacks.coverage.region") %>
          <% if (row.rows != null) { %> · <%= t("adminGeoPacks.meta.addresses", { count: fmtRows(row.rows) }) %><% } %>
          · <%= fmtBytes(row.bytes) %>
          <% if (row.packVersion) { %> · v<%= row.packVersion %><% } %>
          <% if (row.status === "update" && row.releaseVersion) { %> · <span class="text-amber-600"><%= t("adminGeoPacks.meta.updateTo", { version: "v" + row.releaseVersion }) %></span><% } %>
        </p>
      </div>
      <% if (row.file) { %>
      <a href="/admin/geo-packs/download?file=<%= encodeURIComponent(row.file) %>"
         class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-brand-700">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
        <%= t("adminGeoPacks.download") %>
      </a>
      <% } %>
    </div>
    <% if (row.file) { %>
    <details class="mt-1.5">
      <summary class="cursor-pointer text-sm text-slate-400 hover:text-slate-600"><%= t("adminGeoPacks.details.toggle") %></summary>
      <div class="mt-3">
        <dl class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm mb-4">
          <div class="min-w-0">
            <dt class="text-xs font-medium uppercase tracking-wider text-slate-400"><%= t("adminGeoPacks.details.fileName") %></dt>
            <dd class="mt-1 font-mono text-xs text-slate-900 break-all"><%= row.file %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wider text-slate-400"><%= t("adminGeoPacks.colBuilt") %></dt>
            <dd class="mt-1 text-slate-900"><% if (!row.buildDate) { %>—<% } else if (isIsoLike(row.buildDate)) { %><time data-tz datetime="<%= row.buildDate %>" data-style="datetime"><%= row.buildDate.slice(0, 19).replace("T", " ") %></time><% } else { %><%= row.buildDate %><% } %></dd>
          </div>
          <div class="min-w-0">
            <dt class="text-xs font-medium uppercase tracking-wider text-slate-400"><%= t("adminGeoPacks.colSha") %></dt>
            <dd class="mt-1 font-mono text-xs text-slate-900 break-all"><%= row.sha256 || "—" %></dd>
          </div>
        </dl>
        <p class="text-sm mb-4">
          <span class="text-slate-400"><%= t("adminGeoPacks.sync.colStatus") %>:</span>
          <% if (!row.sync) { %>
            <span class="text-slate-500"><%= t("adminGeoPacks.sync.statusNone") %></span>
          <% } else if (row.sync.status === "active") { %>
            <span class="text-emerald-600 font-medium"><%= t("adminGeoPacks.sync.statusActive") %></span>
          <% } else if (row.sync.status === "receiving") { %>
            <span class="text-amber-600 font-medium"><%= t("adminGeoPacks.sync.statusReceiving") %> · <%= t("adminGeoPacks.sync.progress", { received: row.sync.received, total: row.sync.total }) %></span>
          <% } else if (row.sync.status === "failed") { %>
            <span class="text-red-600 font-medium"><%= t("adminGeoPacks.sync.statusFailed") %><% if (row.sync.error) { %> · <span class="font-mono text-xs"><%= row.sync.error %></span><% } %></span>
          <% } else { %>
            <span class="text-slate-500"><%= t("adminGeoPacks.sync.statusAborted") %></span>
          <% } %>
        </p>
        <% if (row.embedded) { %>
        <h3 class="text-sm font-medium text-slate-700 mb-2"><%= t("adminGeoPacks.attribution.heading") %></h3>
        <% if (row.embedded.licenceManifest && row.embedded.licenceManifest.derivedDatabaseNotice) { %>
        <p class="text-sm text-slate-500 mb-2"><%= row.embedded.licenceManifest.derivedDatabaseNotice %></p>
        <% } %>
        <% if (row.embedded.licenceManifest && row.embedded.licenceManifest.sources.length > 0) { %>
        <ul class="divide-y divide-slate-100 text-sm mb-3">
          <% row.embedded.licenceManifest.sources.forEach(function (s) { %>
          <li class="py-2">
            <span class="font-medium text-slate-900"><%= s.name %></span>
            <span class="text-slate-500"> · <%= s.licence %><% if (s.dataVersion) { %> · <%= s.dataVersion %><% } %><% if (s.included === false) { %> · <%= t("adminGeoPacks.attribution.notIncluded") %><% } %></span>
            <% if (s.attributionText) { %><span class="block text-slate-400"><%= s.attributionText %></span><% } %>
            <% s.restrictions.forEach(function (r) { %><span class="block text-amber-600"><%= r %></span><% }); %>
          </li>
          <% }); %>
        </ul>
        <% } %>
        <% if (row.embedded.attribution) { %>
        <details class="mb-4">
          <summary class="text-sm text-brand-700 cursor-pointer hover:underline"><%= t("adminGeoPacks.attribution.showText") %></summary>
          <pre class="mt-2 whitespace-pre-wrap break-words rounded-lg bg-slate-50 border border-slate-100 p-3 text-xs text-slate-700"><%= row.embedded.attribution %></pre>
        </details>
        <% } %>
        <% } %>
        <% if (row.companions.length > 0) { %>
        <h3 class="text-sm font-medium text-slate-700 mb-2"><%= t("adminGeoPacks.companions") %></h3>
        <ul class="divide-y divide-slate-100 text-sm">
          <% row.companions.forEach(function (f) { %>
          <li class="flex items-center justify-between gap-3 py-2">
            <span class="font-mono text-slate-700"><%= f.name %></span>
            <span class="flex items-center gap-3">
              <span class="tabular-nums text-slate-400"><%= fmtBytes(f.bytes) %></span>
              <a href="/admin/geo-packs/download?file=<%= encodeURIComponent(f.name) %>" class="text-brand-700 hover:underline"><%= t("adminGeoPacks.download") %></a>
            </span>
          </li>
          <% }); %>
        </ul>
        <% } %>
      </div>
    </details>
    <% } %>
  </li>
  <% }); %>
</ul>
<% }); %>

<% if (listing.sharedFiles.length > 0) { %>
<h2 class="mt-6 mb-1 text-base font-semibold text-slate-900"><%= t("adminGeoPacks.shared.heading") %></h2>
<p class="text-sm text-slate-500 mb-2"><%= t("adminGeoPacks.shared.lead") %></p>
<ul class="divide-y divide-slate-200 border-y border-slate-200 text-sm">
  <% listing.sharedFiles.forEach(function (f) { %>
  <li class="flex items-center justify-between gap-3 py-2">
    <span class="font-mono text-slate-700"><%= f.name %></span>
    <span class="flex items-center gap-3">
      <span class="tabular-nums text-slate-400"><%= fmtBytes(f.bytes) %></span>
      <a href="/admin/geo-packs/download?file=<%= encodeURIComponent(f.name) %>" class="text-brand-700 hover:underline"><%= t("adminGeoPacks.download") %></a>
    </span>
  </li>
  <% }); %>
</ul>
<% } %>

<details class="mt-6">
  <summary class="cursor-pointer text-sm text-slate-400 hover:text-slate-600"><%= t("adminGeoPacks.configDetails") %></summary>
  <div class="mt-2 space-y-1">
    <p class="text-sm text-slate-500"><%= t("adminGeoPacks.providerNote", { provider: provider }) %></p>
    <p class="text-sm text-slate-500"><%= t("adminGeoPacks.dirNote", { dir: packDir }) %></p>
  </div>
</details>
<% } %>
</div>

<section class="mt-10 border-t border-slate-200 pt-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-1"><%= t("adminGeoPacks.fetch.heading") %></h2>
  <p class="text-sm text-slate-500 mb-4"><%= t("adminGeoPacks.fetch.lead", { base: releaseBaseUrl }) %></p>
  <div class="mb-4">
    <button type="button" id="geo-preview-btn" class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-wait"><%= t("adminGeoPacks.fetch.previewButton") %></button>
    <div id="geo-preview" class="mt-3 hidden"></div>
  </div>
  <% if (fetchJob) { %>
  <%
    var jobPct = fetchJob.totalBytes > 0 ? Math.floor((fetchJob.downloadedBytes / fetchJob.totalBytes) * 1000) / 10 : 0;
    var jobCurrent = null;
    if (fetchJob.currentFile) {
      for (var ci = 0; ci < fetchJob.files.length; ci++) {
        if (fetchJob.files[ci].file === fetchJob.currentFile) { jobCurrent = fetchJob.files[ci]; break; }
      }
    }
    var jobCurrentPct = jobCurrent && jobCurrent.bytesTotal > 0 ? Math.floor((jobCurrent.bytesDone / jobCurrent.bytesTotal) * 1000) / 10 : 0;
  %>
  <div class="text-sm mb-4" id="geo-fetch-status">
    <% if (fetchJob.status === "running") { %>
      <p class="text-amber-600 font-medium"><%= t("adminGeoPacks.fetch.running") %></p>
      <% if (fetchJob.recovered) { %><p class="text-slate-400 mt-1"><%= t("adminGeoPacks.fetch.recovered") %></p><% } %>
      <% if (fetchJob.lastError) { %><p class="text-slate-400 mt-1"><%= t("adminGeoPacks.fetch.lastError") %>: <span class="font-mono text-xs"><%= fetchJob.lastError %></span></p><% } %>
      <div id="geo-fetch-progress" class="mt-3 max-w-xl">
        <div id="geo-fetch-bar-wrap"<% if (fetchJob.totalBytes <= 0) { %> class="hidden"<% } %>>
          <div class="flex items-baseline justify-between gap-3 text-xs text-slate-500">
            <span id="geo-fetch-pct" class="font-medium text-slate-700"><%= jobPct %>%</span>
            <span id="geo-fetch-bytes" class="tabular-nums"><%= fmtBytes(fetchJob.downloadedBytes) %> / <%= fmtBytes(fetchJob.totalBytes) %></span>
          </div>
          <div class="mt-1 h-2 overflow-hidden rounded-full bg-slate-100">
            <div id="geo-fetch-bar" class="bwc-progress-live h-full rounded-full bg-brand-600" style="width: <%= jobPct %>%"></div>
          </div>
        </div>
        <p id="geo-fetch-rate" class="mt-2 text-xs text-slate-500"><% if (jobCurrent && jobCurrent.status === "retrying") { %><%= t("adminGeoPacks.fetch.waitingRetry") %><% } else if (fetchJob.speedBps > 0) { %><%= fmtBytes(Math.round(fetchJob.speedBps)) %>/s<% } else { %><%= t("adminGeoPacks.fetch.etaUnknown") %><% } %></p>
        <div id="geo-fetch-current" class="mt-3<% if (!jobCurrent) { %> hidden<% } %>">
          <div class="flex items-baseline justify-between gap-3 text-xs">
            <span class="min-w-0 truncate text-slate-500"><%= t("adminGeoPacks.fetch.currentFile") %>: <span id="geo-fetch-current-name" class="font-mono text-slate-700"><%= jobCurrent ? jobCurrent.file : "" %></span></span>
            <span id="geo-fetch-current-pct" class="tabular-nums text-slate-500"><%= jobCurrentPct %>%</span>
          </div>
          <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-slate-100">
            <div id="geo-fetch-current-bar" class="bwc-progress-live h-full rounded-full bg-brand-400" style="width: <%= jobCurrentPct %>%"></div>
          </div>
        </div>
      </div>
    <% } else if (fetchJob.status === "done") { %>
      <p class="text-emerald-600 font-medium"><%= t("adminGeoPacks.fetch.done") %><% if (fetchJob.finishedAt) { %>: <time data-tz datetime="<%= fetchJob.finishedAt %>" data-style="datetime"><%= fetchJob.finishedAt.slice(0, 19).replace("T", " ") %></time><% } %></p>
    <% } else { %>
      <p class="text-red-600 font-medium"><%= t("adminGeoPacks.fetch.failed") %><% if (fetchJob.finishedAt) { %>: <time data-tz datetime="<%= fetchJob.finishedAt %>" data-style="datetime"><%= fetchJob.finishedAt.slice(0, 19).replace("T", " ") %></time><% } %><% if (fetchJob.error) { %> · <span class="font-mono text-xs"><%= fetchJob.error %></span><% } %></p>
    <% } %>
    <% if (fetchJob.release) { %><p class="text-slate-400 mt-1"><%= t("adminGeoPacks.fetch.release") %>: <span class="font-mono"><%= fetchJob.release %></span></p><% } %>
    <% if (fetchJob.files.length > 0) { %>
    <ul class="divide-y divide-slate-100 mt-2">
      <% fetchJob.files.forEach(function (f) { %>
      <li class="flex flex-wrap items-center justify-between gap-3 py-2" data-geo-file="<%= f.file %>">
        <span class="font-mono text-slate-700"><%= f.file %></span>
        <span class="text-slate-400">
          <span data-geo-file-bytes><%= fmtBytes(f.bytesDone) %> / <%= fmtBytes(f.bytesTotal) %></span> ·
          <span data-geo-file-status><% if (f.status === "done") { %><span class="text-emerald-600"><%= t("adminGeoPacks.fetch.fileDone") %></span>
          <% } else if (f.status === "skipped") { %><span class="text-slate-500"><%= t("adminGeoPacks.fetch.fileSkipped") %></span>
          <% } else if (f.status === "failed") { %><span class="text-red-600"><%= t("adminGeoPacks.fetch.fileFailed") %><% if (f.error) { %> · <%= f.error %><% } %></span>
          <% } else if (f.status === "activating") { %><span class="text-amber-600"><%= t("adminGeoPacks.fetch.fileActivating") %></span>
          <% } else if (f.status === "verifying") { %><span class="text-amber-600"><%= t("adminGeoPacks.fetch.fileVerifying") %></span>
          <% } else if (f.status === "downloading") { %><span class="text-amber-600"><%= t("adminGeoPacks.fetch.fileDownloading") %></span>
          <% } else if (f.status === "retrying") { %><span class="text-amber-600"><%= t("adminGeoPacks.fetch.fileRetrying", { attempt: f.attempts }) %><% if (f.error) { %> · <%= f.error %><% } %></span>
          <% } else { %><%= t("adminGeoPacks.fetch.filePending") %><% } %></span>
        </span>
      </li>
      <% }); %>
    </ul>
    <% } %>
  </div>
  <% } %>
  <form method="post" action="/admin/geo-packs/fetch">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <% var fetchRunning = fetchJob && fetchJob.status === "running"; %>
    <button type="submit" id="geo-fetch-btn"<% if (fetchRunning) { %> disabled<% } %> class="rounded-lg px-4 py-2 text-sm font-medium text-white <%= fetchRunning ? "bg-slate-300 cursor-not-allowed" : "bg-brand-600 hover:bg-brand-700" %>"><%= t("adminGeoPacks.fetch.button") %></button>
  </form>
</section>

<section class="mt-10 border-t border-slate-200 pt-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-1"><%= t("adminGeoPacks.tokens.heading") %></h2>
  <p class="text-sm text-slate-500 mb-4"><%= t("adminGeoPacks.tokens.lead") %></p>
  <% if (syncTokens.length === 0) { %>
  <p class="text-sm text-slate-500 mb-4"><%= t("adminGeoPacks.tokens.empty") %></p>
  <% } else { %>
  <ul class="divide-y divide-slate-100 text-sm mb-4">
    <% syncTokens.forEach(function (tok) { %>
    <li class="flex flex-wrap items-center justify-between gap-3 py-2">
      <span class="min-w-0">
        <span class="font-medium text-slate-900"><%= tok.label %></span>
        <span class="font-mono text-xs text-slate-400">bwgs_<%= tok.prefix %>_…</span>
        <span class="text-slate-400">· <%= t("adminGeoPacks.tokens.colLastUsed") %>: <% if (tok.lastUsedAt) { %><time data-tz datetime="<%= tok.lastUsedAt.toISOString() %>" data-style="datetime"><%= tok.lastUsedAt.toISOString().slice(0, 19).replace("T", " ") %></time><% } else { %>—<% } %></span>
      </span>
      <% if (tok.revokedAt) { %>
        <span class="text-slate-400"><%= t("adminGeoPacks.tokens.statusRevoked") %></span>
      <% } else { %>
        <span class="flex items-center gap-3">
          <span class="text-emerald-600 font-medium"><%= t("adminGeoPacks.tokens.statusActive") %></span>
          <form method="post" action="/admin/geo-packs/sync-tokens/<%= tok.id %>/revoke" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="text-red-600 hover:underline"><%= t("adminGeoPacks.tokens.revoke") %></button>
          </form>
        </span>
      <% } %>
    </li>
    <% }); %>
  </ul>
  <% } %>
  <form method="post" action="/admin/geo-packs/sync-tokens" class="flex flex-wrap items-end gap-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label class="block">
      <span class="block text-xs font-medium uppercase tracking-wider text-slate-400 mb-1"><%= t("adminGeoPacks.tokens.createLabel") %></span>
      <input type="text" name="label" maxlength="100" placeholder="<%= t('adminGeoPacks.tokens.createPlaceholder') %>"
             class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 w-56" />
    </label>
    <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"><%= t("adminGeoPacks.tokens.create") %></button>
  </form>
</section>

<% if (recentUploads.length > 0) { %>
<section class="mt-10 border-t border-slate-200 pt-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-4"><%= t("adminGeoPacks.recent.heading") %></h2>
  <ul class="divide-y divide-slate-100 text-sm">
    <% recentUploads.forEach(function (up) { %>
    <li class="flex flex-wrap items-center justify-between gap-3 py-2">
      <span class="font-mono text-slate-700"><%= up.fileName %></span>
      <span class="text-slate-400">
        <time data-tz datetime="<%= up.createdAt.toISOString() %>" data-style="datetime"><%= up.createdAt.toISOString().slice(0, 19).replace("T", " ") %></time> ·
        <% if (up.status === "active") { %><span class="text-emerald-600"><%= t("adminGeoPacks.sync.statusActive") %></span>
        <% } else if (up.status === "receiving") { %><span class="text-amber-600"><%= t("adminGeoPacks.sync.statusReceiving") %> · <%= t("adminGeoPacks.sync.progress", { received: Array.isArray(up.receivedChunks) ? up.receivedChunks.length : 0, total: up.chunkCount }) %></span>
        <% } else if (up.status === "failed") { %><span class="text-red-600"><%= t("adminGeoPacks.sync.statusFailed") %><% if (up.error) { %> · <%= up.error %><% } %></span>
        <% } else { %><%= t("adminGeoPacks.sync.statusAborted") %><% } %>
      </span>
    </li>
    <% }); %>
  </ul>
</section>
<% } %>

<script>
(function () {
  var btn = document.getElementById("geo-preview-btn");
  var box = document.getElementById("geo-preview");
  var fetchBtn = document.getElementById("geo-fetch-btn");
  if (!btn || !box) return;
  // 包的人话名（服务端按当前语言解析好，键是 packId）；查不到时
  // 回落发布清单里的 region 原文，再回落文件名。
  var NAMES = <%- packNamesJson %>;
  var T = {
    loading: <%- JSON.stringify(t("adminGeoPacks.fetch.previewLoading")) %>,
    release: <%- JSON.stringify(t("adminGeoPacks.fetch.release")) %>,
    colPack: <%- JSON.stringify(t("adminGeoPacks.fetch.previewColPack")) %>,
    colRows: <%- JSON.stringify(t("adminGeoPacks.colRows")) %>,
    colSize: <%- JSON.stringify(t("adminGeoPacks.fetch.previewColSize")) %>,
    colStatus: <%- JSON.stringify(t("adminGeoPacks.fetch.previewColStatus")) %>,
    installed: <%- JSON.stringify(t("adminGeoPacks.fetch.previewInstalled")) %>,
    pending: <%- JSON.stringify(t("adminGeoPacks.fetch.previewPending")) %>,
    parts: <%- JSON.stringify(t("adminGeoPacks.fetch.previewParts")) %>,
    summary: <%- JSON.stringify(t("adminGeoPacks.fetch.previewSummary")) %>,
    allInstalled: <%- JSON.stringify(t("adminGeoPacks.fetch.previewAllInstalled")) %>,
    buttonWithSize: <%- JSON.stringify(t("adminGeoPacks.fetch.buttonWithSize")) %>,
    errUnreachable: <%- JSON.stringify(t("adminGeoPacks.fetch.previewErrorUnreachable")) %>,
    errInvalid: <%- JSON.stringify(t("adminGeoPacks.fetch.previewErrorInvalid")) %>,
    errHttp: <%- JSON.stringify(t("adminGeoPacks.fetch.previewErrorHttp")) %>,
    errGeneric: <%- JSON.stringify(t("adminGeoPacks.fetch.previewErrorGeneric")) %>
  };
  function fmtBytes(n) {
    if (n >= 1024 * 1024 * 1024) return (n / (1024 * 1024 * 1024)).toFixed(2) + " GiB";
    if (n >= 1024 * 1024) return (n / (1024 * 1024)).toFixed(1) + " MiB";
    if (n >= 1024) return (n / 1024).toFixed(1) + " KiB";
    return n + " B";
  }
  var LOCALE = document.documentElement.lang || undefined;
  function el(tag, cls, text) {
    var e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  }
  function showError(kind, data) {
    box.textContent = "";
    var msg = T.errGeneric;
    if (kind === "unreachable") msg = T.errUnreachable;
    else if (kind === "invalid") msg = T.errInvalid;
    else if (kind === "http") msg = T.errHttp.replace("{status}", String(data && data.httpStatus != null ? data.httpStatus : "?"));
    var p = el("p", "text-sm text-red-600 font-medium", msg);
    if (data && data.code) p.appendChild(el("span", "font-mono text-xs", " · " + data.code));
    box.appendChild(p);
  }
  function render(pv) {
    box.textContent = "";
    var head = el("p", "text-sm text-slate-500 mb-2");
    head.appendChild(document.createTextNode(T.release + ": "));
    head.appendChild(el("span", "font-mono text-slate-700", pv.release));
    box.appendChild(head);
    var table = el("table", "w-full text-sm mb-2");
    var thead = el("thead");
    var hr = el("tr", "text-left text-xs uppercase tracking-wider text-slate-400");
    hr.appendChild(el("th", "py-1 pr-3 font-medium", T.colPack));
    hr.appendChild(el("th", "py-1 pr-3 font-medium", T.colRows));
    hr.appendChild(el("th", "py-1 pr-3 font-medium", T.colSize));
    hr.appendChild(el("th", "py-1 font-medium", T.colStatus));
    thead.appendChild(hr);
    table.appendChild(thead);
    var tbody = el("tbody", "divide-y divide-slate-100");
    pv.packs.forEach(function (p) {
      var tr = el("tr");
      var tdPack = el("td", "py-2 pr-3");
      tdPack.appendChild(el("span", "font-medium text-slate-900", NAMES[p.packId] || p.region || p.file));
      tdPack.appendChild(el("span", "block font-mono text-xs text-slate-400", p.file));
      tr.appendChild(tdPack);
      tr.appendChild(el("td", "py-2 pr-3 tabular-nums text-slate-700", p.rows == null ? "—" : p.rows.toLocaleString(LOCALE)));
      var tdSize = el("td", "py-2 pr-3 tabular-nums text-slate-700", fmtBytes(p.bytes));
      tdSize.appendChild(el("span", "block text-xs text-slate-400", p.bytes.toLocaleString(LOCALE) + " B"));
      tr.appendChild(tdSize);
      var tdStatus = el("td", "py-2");
      if (p.installed) tdStatus.appendChild(el("span", "text-emerald-600 font-medium", T.installed));
      else tdStatus.appendChild(el("span", "text-slate-500", T.pending));
      if (p.parts > 0) tdStatus.appendChild(el("span", "block text-xs text-slate-400", T.parts.replace("{count}", String(p.parts))));
      tr.appendChild(tdStatus);
      tbody.appendChild(tr);
    });
    table.appendChild(tbody);
    box.appendChild(table);
    if (pv.totalDownloadBytes > 0) {
      box.appendChild(el("p", "text-sm text-slate-600", T.summary
        .replace("{files}", String(pv.fileCount))
        .replace("{total}", fmtBytes(pv.totalBytes))
        .replace("{download}", fmtBytes(pv.totalDownloadBytes))));
      if (fetchBtn && !fetchBtn.disabled) {
        fetchBtn.textContent = T.buttonWithSize.replace("{size}", fmtBytes(pv.totalDownloadBytes));
      }
    } else {
      box.appendChild(el("p", "text-sm text-emerald-600 font-medium", T.allInstalled));
    }
  }
  btn.addEventListener("click", function () {
    btn.disabled = true;
    box.classList.remove("hidden");
    box.textContent = "";
    box.appendChild(el("p", "text-sm text-slate-400", T.loading));
    fetch("/admin/geo-packs/preview", { credentials: "same-origin", headers: { accept: "application/json" } })
      .then(function (resp) { return resp.json().catch(function () { return null; }).then(function (data) { return { resp: resp, data: data }; }); })
      .then(function (r) {
        if (r.data && r.data.ok && r.data.preview) render(r.data.preview);
        else showError(r.data && r.data.kind ? r.data.kind : "error", r.data);
      })
      .catch(function () { showError("unreachable", null); })
      .finally(function () { btn.disabled = false; });
  });
})();
</script>

<script>
(function () {
  // 获取进度轮询：服务端首屏渲染的是打开页面那一刻的真实状态，这
  // 里每 1.5 s 拉一次内存任务状态，把进度条 / 速度 / ETA / 当前文
  // 件 / 逐文件行就地更新；任务一结束走 finish() 的局部替换（终
  // 态文案与包列表换成服务端最新渲染），全程不需要手动刷新。
  var wrap = document.getElementById("geo-fetch-progress");
  if (!wrap) return;
  var T = {
    rateLine: <%- JSON.stringify(t("adminGeoPacks.fetch.rateLine")) %>,
    etaSeconds: <%- JSON.stringify(t("adminGeoPacks.fetch.etaSeconds")) %>,
    etaMinutes: <%- JSON.stringify(t("adminGeoPacks.fetch.etaMinutes")) %>,
    etaHoursMinutes: <%- JSON.stringify(t("adminGeoPacks.fetch.etaHoursMinutes")) %>,
    etaUnknown: <%- JSON.stringify(t("adminGeoPacks.fetch.etaUnknown")) %>,
    waitingRetry: <%- JSON.stringify(t("adminGeoPacks.fetch.waitingRetry")) %>,
    filePending: <%- JSON.stringify(t("adminGeoPacks.fetch.filePending")) %>,
    fileDownloading: <%- JSON.stringify(t("adminGeoPacks.fetch.fileDownloading")) %>,
    fileVerifying: <%- JSON.stringify(t("adminGeoPacks.fetch.fileVerifying")) %>,
    fileActivating: <%- JSON.stringify(t("adminGeoPacks.fetch.fileActivating")) %>,
    fileDone: <%- JSON.stringify(t("adminGeoPacks.fetch.fileDone")) %>,
    fileSkipped: <%- JSON.stringify(t("adminGeoPacks.fetch.fileSkipped")) %>,
    fileFailed: <%- JSON.stringify(t("adminGeoPacks.fetch.fileFailed")) %>,
    fileRetrying: <%- JSON.stringify(t("adminGeoPacks.fetch.fileRetrying")) %>
  };
  var barWrap = document.getElementById("geo-fetch-bar-wrap");
  var bar = document.getElementById("geo-fetch-bar");
  var pctEl = document.getElementById("geo-fetch-pct");
  var bytesEl = document.getElementById("geo-fetch-bytes");
  var rateEl = document.getElementById("geo-fetch-rate");
  var curWrap = document.getElementById("geo-fetch-current");
  var curName = document.getElementById("geo-fetch-current-name");
  var curPct = document.getElementById("geo-fetch-current-pct");
  var curBar = document.getElementById("geo-fetch-current-bar");
  var rows = {};
  Array.prototype.forEach.call(document.querySelectorAll("[data-geo-file]"), function (li) {
    rows[li.getAttribute("data-geo-file")] = {
      bytes: li.querySelector("[data-geo-file-bytes]"),
      status: li.querySelector("[data-geo-file-status]"),
    };
  });
  function fmtBytes(n) {
    if (n >= 1024 * 1024 * 1024) return (n / (1024 * 1024 * 1024)).toFixed(2) + " GiB";
    if (n >= 1024 * 1024) return (n / (1024 * 1024)).toFixed(1) + " MiB";
    if (n >= 1024) return (n / 1024).toFixed(1) + " KiB";
    return n + " B";
  }
  function pctOf(done, total) {
    return total > 0 ? Math.floor((done / total) * 1000) / 10 : 0;
  }
  function fmtEta(sec) {
    if (sec == null) return T.etaUnknown;
    if (sec < 60) return T.etaSeconds.replace("{count}", String(sec));
    if (sec < 3600) return T.etaMinutes.replace("{count}", String(Math.round(sec / 60)));
    var h = Math.floor(sec / 3600);
    var m = Math.round((sec % 3600) / 60);
    if (m === 60) { h += 1; m = 0; }
    return T.etaHoursMinutes.replace("{hours}", String(h)).replace("{minutes}", String(m));
  }
  function renderFileStatus(span, f) {
    var text = T.filePending, cls = "";
    if (f.status === "done") { text = T.fileDone; cls = "text-emerald-600"; }
    else if (f.status === "skipped") { text = T.fileSkipped; cls = "text-slate-500"; }
    else if (f.status === "failed") { text = T.fileFailed + (f.error ? " · " + f.error : ""); cls = "text-red-600"; }
    else if (f.status === "activating") { text = T.fileActivating; cls = "text-amber-600"; }
    else if (f.status === "verifying") { text = T.fileVerifying; cls = "text-amber-600"; }
    else if (f.status === "downloading") { text = T.fileDownloading; cls = "text-amber-600"; }
    else if (f.status === "retrying") {
      text = T.fileRetrying.replace("{attempt}", String(f.attempts)) + (f.error ? " · " + f.error : "");
      cls = "text-amber-600";
    }
    span.textContent = text;
    span.className = cls;
  }
  function render(job) {
    if (job.totalBytes > 0) {
      barWrap.classList.remove("hidden");
      var p = pctOf(job.downloadedBytes, job.totalBytes);
      bar.style.width = p + "%";
      pctEl.textContent = p + "%";
      bytesEl.textContent = fmtBytes(job.downloadedBytes) + " / " + fmtBytes(job.totalBytes);
    }
    var current = null;
    job.files.forEach(function (f) {
      if (f.file === job.currentFile) current = f;
      var row = rows[f.file];
      if (row) {
        if (row.bytes) row.bytes.textContent = fmtBytes(f.bytesDone) + " / " + fmtBytes(f.bytesTotal);
        if (row.status) renderFileStatus(row.status, f);
      }
    });
    if (current && curWrap) {
      curWrap.classList.remove("hidden");
      curName.textContent = current.file;
      var cp = pctOf(current.bytesDone, current.bytesTotal);
      curPct.textContent = cp + "%";
      curBar.style.width = cp + "%";
    } else if (curWrap) {
      curWrap.classList.add("hidden");
    }
    if (current && current.status === "retrying") {
      rateEl.textContent = T.waitingRetry;
    } else if (job.speedBps > 0) {
      rateEl.textContent = T.rateLine
        .replace("{speed}", fmtBytes(Math.round(job.speedBps)) + "/s")
        .replace("{eta}", fmtEta(job.etaSeconds));
    } else {
      rateEl.textContent = T.etaUnknown;
    }
  }
  var stopped = false;
  function swapIn(id, doc) {
    var fresh = doc.getElementById(id);
    var cur = document.getElementById(id);
    if (fresh && cur) cur.replaceWith(document.importNode(fresh, true));
  }
  function finish() {
    // 终态不整页刷新：停轮询后拉一次整页 HTML，只把状态区（换成
    // 完成/失败文案与完成时间）与包列表（版本/大小/行数已是落位
    // 后的新状态）两块换成服务端最新渲染，滚动位置与页面其余部
    // 分都不动；获取按钮恢复可用，新换入的 <time data-tz> 交给
    // local-time 的全局重排函数按浏览器时区格式化。
    stopped = true;
    fetch("/admin/geo-packs", { credentials: "same-origin", headers: { accept: "text/html" } })
      .then(function (resp) { return resp.text(); })
      .then(function (html) {
        var doc = new DOMParser().parseFromString(html, "text/html");
        swapIn("geo-fetch-status", doc);
        swapIn("geo-pack-listing", doc);
        var fb = document.getElementById("geo-fetch-btn");
        if (fb) {
          fb.disabled = false;
          fb.className = "rounded-lg px-4 py-2 text-sm font-medium text-white bg-brand-600 hover:bg-brand-700";
        }
        if (window.bwcFormatTimes) window.bwcFormatTimes();
      })
      .catch(function () { /* 换不上就保留当前画面——任务本身已经结束 */ });
  }
  function tick() {
    if (stopped) return;
    fetch("/admin/geo-packs/fetch-status", { credentials: "same-origin", headers: { accept: "application/json" } })
      .then(function (resp) { return resp.json().catch(function () { return null; }); })
      .then(function (data) {
        var job = data && data.ok ? data.job : null;
        if (!job || job.status !== "running") {
          finish();
          return;
        }
        render(job);
        setTimeout(tick, 1500);
      })
      .catch(function () { setTimeout(tick, 3000); });
  }
  setTimeout(tick, 1500);
})();
</script>

<%- include('_nav_end') %>
