      </span>
      <h2 class="text-base font-semibold text-slate-900"><%= t("adminUpdate.upload.heading") %></h2>
    </div>
    <p class="text-xs text-slate-500 mt-1"><%= t("adminUpdate.upload.desc") %></p>
  </div>

  <div class="rounded-lg border border-indigo-200 bg-indigo-50/50 p-3 text-xs text-indigo-900 mb-4 flex gap-2">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
    <span><%- t("adminUpdate.upload.note") %></span>
