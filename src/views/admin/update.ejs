<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
(function(){
  const BWC_I18N = (() => {
    try { return JSON.parse(document.getElementById('bwc-update-i18n').textContent); }
    catch { return {}; }
  })();
  const fmt = (s, vars) => s.replace(/\{(\w+)\}/g, (_, k) => vars[k] ?? '');

  const csrf = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
  const checkBtn = document.getElementById('btn-check');
  const applyBtn = document.getElementById('btn-apply');
  const restartBtn = document.getElementById('btn-restart');
  const statusBox = document.getElementById('status-box');
  const applyBox = document.getElementById('apply-box');

  // ---- Uptime widget (live ticking) ----
  (function tickUptime(){
    const el = document.getElementById('uptime-text');
    if (!el) return;
    let secs = parseInt(el.dataset.uptime || '0', 10) || 0;
    function fmtUptime(s) {
      if (s < 60) return fmt(BWC_I18N.uptimeSeconds, { n: s });
      const m = Math.floor(s / 60);
      if (m < 60) return fmt(BWC_I18N.uptimeMinutes, { n: m });
      const h = Math.floor(m / 60);
      if (h < 24) return fmt(BWC_I18N.uptimeHoursMinutes, { h: h, m: (m % 60) });
      const d = Math.floor(h / 24);
      return fmt(BWC_I18N.uptimeDaysHours, { d: d, h: (h % 24) });
    }
    function render() { el.textContent = fmtUptime(secs); }
    render();
    setInterval(() => { secs++; render(); }, 1000);
  })();

  // Read the currently-selected remote from the radio group. Falls back
  // to whatever the server picked (UPDATE_REMOTE env or "origin") if no
  // selection — shouldn't happen because we always preselect, but
  // defensive against the user un-checking everything.
  function selectedRemote() {
    const r = document.querySelector('input[name="remote"]:checked');
    return r ? r.value : '';
  }

  async function postJson(url, extra) {
    const fd = new URLSearchParams();
    fd.set('_csrf', csrf);
    const remote = selectedRemote();
    if (remote) fd.set('remote', remote);
    if (extra) for (const [k, v] of Object.entries(extra)) fd.set(k, v);
    const resp = await fetch(url, {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: fd.toString(),
    });
    return resp.json();
  }

  // Shared handler for "添加 GitHub / Gitee" buttons. The server has
  // the default URL hard-coded per remote name (see self_update.ts's
  // DEFAULT_GITHUB_URL / DEFAULT_GITEE_URL); we just send the name.
  function wireAddRemoteBtn(id, name, label) {
    const btn = document.getElementById(id);
    if (!btn) return;
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      const orig = btn.innerHTML;
      btn.textContent = BWC_I18N.sourceAddingButton;
      try {
        const r = await postJson('/admin/update/add-remote', { name });
        if (r.ok) {
          // Reload so the radio group repopulates from the server-
          // rendered template — the EJS surface is the source of truth.
          window.location.reload();
        } else {
          alert(fmt(BWC_I18N.sourceAddFailed, { label: label, error: (r.error || BWC_I18N.unknownError) }));
          btn.disabled = false;
          btn.innerHTML = orig;
        }
      } catch (e) {
        alert(fmt(BWC_I18N.sourceAddFailed, { label: label, error: (e?.message || e) }));
        btn.disabled = false;
        btn.innerHTML = orig;
      }
    });
  }
  wireAddRemoteBtn('btn-add-github', 'github', BWC_I18N.sourceAddGithubLabel);
  wireAddRemoteBtn('btn-add-gitee', 'gitee', BWC_I18N.sourceAddGiteeLabel);

  async function autoRestartAndReload() {
    const finalEl = document.getElementById('apply-final');
    const oldVersion = document.documentElement.getAttribute('data-app-version') || '0';
    try { await postJson('/admin/update/restart'); } catch (_e) {}
    const startedAt = Date.now();
    const TIMEOUT_MS = 60_000;
    let attempts = 0;
    while (Date.now() - startedAt < TIMEOUT_MS) {
      attempts++;
      finalEl.innerHTML = '<span class="text-slate-600">' + escapeHtml(fmt(BWC_I18N.restartWaitingService, { n: attempts })) + '</span>';
      await new Promise((r) => setTimeout(r, 1500));
      try {
        const resp = await fetch('/api/version', { cache: 'no-store', credentials: 'same-origin' });
        if (!resp.ok) continue;
        const data = await resp.json();
        const newV = String(data.version || '');
        if (newV && newV !== oldVersion) {
          finalEl.innerHTML = '<span class="text-emerald-700">' + escapeHtml(BWC_I18N.restartBackOnline) + '</span>';
          await new Promise((r) => setTimeout(r, 700));
          window.location.reload();
          return;
        }
      } catch (_e) {}
    }
    finalEl.innerHTML = '<span class="text-amber-700">' + escapeHtml(BWC_I18N.restartTimeout) + '</span>';
  }

  checkBtn.addEventListener('click', async () => {
    checkBtn.disabled = true;
    const orig = checkBtn.innerHTML;
    checkBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9"/></svg> ' + escapeHtml(BWC_I18N.checkButtonRunning);
    try {
      const data = await postJson('/admin/update/check');
      if (!data.ok) throw new Error(data.error || BWC_I18N.checkFailed);
      const s = data.status;
      statusBox.classList.remove('hidden');
      const upBox = document.getElementById('status-up-to-date');
      const behindBox = document.getElementById('status-behind');
      if (s.behind === 0) {
        upBox.classList.remove('hidden');
        behindBox.classList.add('hidden');
        document.getElementById('cur-sha-up').textContent = s.currentSha;
        applyBtn.disabled = true;
      } else {
        upBox.classList.add('hidden');
        behindBox.classList.remove('hidden');
        document.getElementById('behind-n').textContent = s.behind;
        document.getElementById('cur-sha').textContent = s.currentSha;
        document.getElementById('cur-subject').textContent = s.currentSubject || '';
        document.getElementById('remote-sha').textContent = s.remoteSha || '—';
        const newCommits = document.getElementById('new-commits');
        newCommits.innerHTML = '';
        s.newCommits.forEach((c) => {
          const li = document.createElement('li');
          li.className = 'flex items-start gap-2 rounded-md bg-white/80 border border-slate-100 px-2.5 py-1.5';
          li.innerHTML =
            '<code class="font-mono text-xs text-brand-700 flex-shrink-0 mt-0.5">' + c.sha + '</code>' +
            '<span class="flex-1 min-w-0">' +
              '<span class="text-slate-700 break-words">' + escapeHtml(c.subject) + '</span>' +
              '<span class="block text-xs text-slate-400 mt-0.5">' + escapeHtml(c.date) + '</span>' +
            '</span>';
          newCommits.appendChild(li);
        });
        applyBtn.disabled = false;
      }
      document.getElementById('dirty-line').classList.toggle('hidden', !s.hasLocalChanges);
    } catch (err) {
      window.bwc && window.bwc.toast(fmt(BWC_I18N.checkFailedToast, { error: err.message }), 'error');
    } finally {
      checkBtn.disabled = false;
      checkBtn.innerHTML = orig;
    }
  });

  applyBtn.addEventListener('click', async () => {
    if (!(await window.bwc.confirm({ title: BWC_I18N.applyConfirmTitle, message: BWC_I18N.applyConfirmMessage, danger: true, confirmLabel: BWC_I18N.applyConfirmOk }))) return;
    applyBtn.disabled = true;
    applyBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9"/></svg> ' + escapeHtml(BWC_I18N.applyButtonRunning);
    applyBox.classList.remove('hidden');
    const logsEl = document.getElementById('apply-logs');
    const finalEl = document.getElementById('apply-final');
    const progressBar = document.getElementById('progress-bar');
    const progressLabel = document.getElementById('progress-label');
    const progressCurrent = document.getElementById('progress-current');
    logsEl.innerHTML = '';
    finalEl.textContent = '';
    progressBar.style.width = '0%';
    progressBar.classList.remove('bg-red-600');
    progressBar.classList.add('bg-brand-600');
    progressLabel.textContent = '0 / 0';
    progressCurrent.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9"/></svg> ' + escapeHtml(BWC_I18N.progressPrep);

    function handleEvent(ev) {
      if (ev.type === 'start') {
        progressLabel.textContent = (ev.index + 1) + ' / ' + ev.total;
        progressCurrent.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9"/></svg> ' + escapeHtml(ev.step);
        progressBar.style.width = ((ev.index + 0.4) / ev.total * 100) + '%';
      } else if (ev.type === 'done') {
        progressBar.style.width = ((ev.index + 1) / ev.total * 100) + '%';
        const li = document.createElement('li');
        li.className = 'rounded-md border ' + (ev.ok ? 'border-emerald-200 bg-emerald-50' : 'border-red-200 bg-red-50') + ' overflow-hidden';
        li.innerHTML =
          '<details ' + (ev.ok ? '' : 'open') + '>' +
            '<summary class="cursor-pointer flex items-center gap-2 px-3 py-2 text-sm">' +
              '<span class="' + (ev.ok ? 'text-emerald-700' : 'text-red-700') + ' font-semibold">' + (ev.ok ? '✓' : '✗') + '</span>' +
              '<span class="font-medium ' + (ev.ok ? 'text-emerald-900' : 'text-red-900') + '">' + escapeHtml(ev.step) + '</span>' +
              '<span class="text-xs text-slate-400 ml-auto">' + escapeHtml(BWC_I18N.progressExpandHint) + '</span>' +
            '</summary>' +
            '<pre class="px-3 pb-3 mt-1 text-xs whitespace-pre-wrap break-all text-slate-700 max-h-60 overflow-y-auto">' + escapeHtml(ev.output || BWC_I18N.progressNoOutput) + '</pre>' +
          '</details>';
        logsEl.appendChild(li);
      } else if (ev.type === 'final') {
        progressBar.style.width = '100%';
        progressCurrent.innerHTML = '';
        if (ev.ok) {
          finalEl.innerHTML = '<span class="text-emerald-700">' + escapeHtml(BWC_I18N.applySuccessFinal) + '</span>';
          applyBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9"/></svg> ' + escapeHtml(BWC_I18N.applyRestarting);
          autoRestartAndReload();
        } else {
          finalEl.innerHTML = '<span class="text-red-700">' + escapeHtml(BWC_I18N.applyFailedFinal) + '</span>';
          applyBtn.disabled = false;
          applyBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9"/></svg> ' + escapeHtml(BWC_I18N.applyRetry);
          progressBar.classList.remove('bg-brand-600');
          progressBar.classList.add('bg-red-600');
        }
      }
    }

    try {
      const fd = new URLSearchParams();
      fd.set('_csrf', csrf);
      // Thread the selected remote (radio) into the body too so apply
      // pulls from the same source as the most recent check.
      const remote = selectedRemote();
      if (remote) fd.set('remote', remote);
      const resp = await fetch('/admin/update/apply-stream', {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: fd.toString(),
      });
      if (!resp.ok || !resp.body) throw new Error('HTTP ' + resp.status);
      const reader = resp.body.getReader();
      const decoder = new TextDecoder();
      let buf = '';
      while (true) {
        const { value, done } = await reader.read();
        if (done) break;
        buf += decoder.decode(value, { stream: true });
        let idx;
        while ((idx = buf.indexOf('\n\n')) >= 0) {
          const chunk = buf.slice(0, idx);
          buf = buf.slice(idx + 2);
          const line = chunk.split('\n').filter((l) => l.startsWith('data: ')).map((l) => l.slice(6)).join('');
          if (!line) continue;
          try { handleEvent(JSON.parse(line)); } catch (_e) {}
        }
      }
    } catch (err) {
      finalEl.innerHTML = '<span class="text-red-700">' + escapeHtml(fmt(BWC_I18N.applyConnectFailed, { error: err.message })) + '</span>';
      applyBtn.disabled = false;
      applyBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9"/></svg> ' + escapeHtml(BWC_I18N.applyRetry);
    }
  });

  restartBtn.addEventListener('click', async () => {
    if (!(await window.bwc.confirm({ title: BWC_I18N.restartConfirmTitle, message: BWC_I18N.restartConfirmMessage, danger: true, confirmLabel: BWC_I18N.restartConfirmOk }))) return;
    restartBtn.disabled = true;
    const orig = restartBtn.innerHTML;
    restartBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9"/></svg> ' + escapeHtml(BWC_I18N.applyRestarting);
    try {
      await postJson('/admin/update/restart');
      window.bwc && window.bwc.toast(BWC_I18N.restartToastSuccess, 'success');
    } catch (err) {
      window.bwc && window.bwc.toast(fmt(BWC_I18N.restartToastFailed, { error: err.message }), 'error');
    }
    setTimeout(() => { restartBtn.disabled = false; restartBtn.innerHTML = orig; }, 3000);
  });

  // ---- 离线 / 手动更新：上传已签名的更新包 ----
  const uploadApplyBtn = document.getElementById('btn-upload-apply');
  if (uploadApplyBtn) {
    const tarballInput = document.getElementById('upload-tarball');
    const sigInput = document.getElementById('upload-sig');
    const uploadBox = document.getElementById('upload-box');

    function handleUploadEvent(ev) {
      const logsEl = document.getElementById('upload-logs');
      const finalEl = document.getElementById('upload-final');
      const bar = document.getElementById('upload-progress-bar');
      const label = document.getElementById('upload-progress-label');
      const current = document.getElementById('upload-progress-current');
      let rejected = false;
      if (ev.type === 'start') {
        label.textContent = (ev.index + 1) + ' / ' + ev.total;
        current.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9"/></svg> ' + escapeHtml(ev.step);
        bar.style.width = ((ev.index + 0.4) / ev.total * 100) + '%';
      } else if (ev.type === 'done') {
        bar.style.width = ((ev.index + 1) / ev.total * 100) + '%';
        if (ev.step === 'verify signature' && !ev.ok) rejected = true;
        const li = document.createElement('li');
        li.className = 'rounded-md border ' + (ev.ok ? 'border-emerald-200 bg-emerald-50' : 'border-red-200 bg-red-50') + ' overflow-hidden';
        li.innerHTML =
          '<details ' + (ev.ok ? '' : 'open') + '>' +
            '<summary class="cursor-pointer flex items-center gap-2 px-3 py-2 text-sm">' +
              '<span class="' + (ev.ok ? 'text-emerald-700' : 'text-red-700') + ' font-semibold">' + (ev.ok ? '✓' : '✗') + '</span>' +
              '<span class="font-medium ' + (ev.ok ? 'text-emerald-900' : 'text-red-900') + '">' + escapeHtml(ev.step) + '</span>' +
              '<span class="text-xs text-slate-400 ml-auto">' + escapeHtml(BWC_I18N.progressExpandHint) + '</span>' +
            '</summary>' +
            '<pre class="px-3 pb-3 mt-1 text-xs whitespace-pre-wrap break-all text-slate-700 max-h-60 overflow-y-auto">' + escapeHtml(ev.output || BWC_I18N.progressNoOutput) + '</pre>' +
          '</details>';
        logsEl.appendChild(li);
        li.dataset.rejected = rejected ? '1' : '';
      } else if (ev.type === 'final') {
        bar.style.width = '100%';
        current.innerHTML = '';
        if (ev.ok) {
          finalEl.innerHTML = '<span class="text-emerald-700">' + escapeHtml(BWC_I18N.uploadSuccessFinal) + '</span>';
          uploadApplyBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9"/></svg> ' + escapeHtml(BWC_I18N.applyRestarting);
          autoRestartAndReload();
        } else {
          // 区分「验签被拒」与「其它步骤失败」的最终文案。
          const sigRejected = !!logsEl.querySelector('li[data-rejected="1"]');
          finalEl.innerHTML = '<span class="text-red-700">' + escapeHtml(sigRejected ? BWC_I18N.uploadRejectedFinal : BWC_I18N.uploadFailedFinal) + '</span>';
          uploadApplyBtn.disabled = false;
          uploadApplyBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> ' + escapeHtml(BWC_I18N.uploadRetry);
          bar.classList.remove('bg-indigo-600');
          bar.classList.add('bg-red-600');
        }
      }
    }

    uploadApplyBtn.addEventListener('click', async () => {
      const tarball = tarballInput.files && tarballInput.files[0];
      const sig = sigInput.files && sigInput.files[0];
      if (!tarball) { window.bwc && window.bwc.toast(BWC_I18N.uploadMissingTarball, 'error'); return; }
      if (!sig) { window.bwc && window.bwc.toast(BWC_I18N.uploadMissingSig, 'error'); return; }
      if (!(await window.bwc.confirm({ title: BWC_I18N.uploadConfirmTitle, message: BWC_I18N.uploadConfirmMessage, danger: true, confirmLabel: BWC_I18N.uploadConfirmOk }))) return;

      uploadApplyBtn.disabled = true;
      uploadApplyBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9"/></svg> ' + escapeHtml(BWC_I18N.uploadButtonRunning);
      uploadBox.classList.remove('hidden');
      const logsEl = document.getElementById('upload-logs');
      const finalEl = document.getElementById('upload-final');
      const bar = document.getElementById('upload-progress-bar');
      const label = document.getElementById('upload-progress-label');
      const current = document.getElementById('upload-progress-current');
      logsEl.innerHTML = '';
      finalEl.textContent = '';
      bar.style.width = '0%';
      bar.classList.remove('bg-red-600');
      bar.classList.add('bg-indigo-600');
      label.textContent = '0 / 0';
      current.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9"/></svg> ' + escapeHtml(BWC_I18N.progressPrep);

      try {
        const form = new FormData();
        form.append('_csrf', csrf);
        form.append('tarball', tarball, tarball.name);
        form.append('signature', sig, sig.name); // .sig 作为第二个文件上传
        const resp = await fetch('/admin/update/upload', {
          method: 'POST', credentials: 'same-origin', body: form,
        });
        if (!resp.ok || !resp.body) {
          // 非 SSE 错误（如 400/409/413/500 JSON）
          let msg = 'HTTP ' + resp.status;
          try { const j = await resp.json(); if (j && j.error) msg = j.error; } catch (_e) {}
          throw new Error(msg);
        }
        const reader = resp.body.getReader();
        const decoder = new TextDecoder();
        let buf = '';
        while (true) {
          const { value, done } = await reader.read();
          if (done) break;
          buf += decoder.decode(value, { stream: true });
          let idx;
          while ((idx = buf.indexOf('\n\n')) >= 0) {
            const chunk = buf.slice(0, idx);
            buf = buf.slice(idx + 2);
            const line = chunk.split('\n').filter((l) => l.startsWith('data: ')).map((l) => l.slice(6)).join('');
            if (!line) continue;
            try { handleUploadEvent(JSON.parse(line)); } catch (_e) {}
          }
        }
      } catch (err) {
        finalEl.innerHTML = '<span class="text-red-700">' + escapeHtml(fmt(BWC_I18N.uploadConnectFailed, { error: err.message })) + '</span>';
        uploadApplyBtn.disabled = false;
        uploadApplyBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> ' + escapeHtml(BWC_I18N.uploadRetry);
      }
    });
  }

  function escapeHtml(s) {
    return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }
})();
</script>

<%- include('_nav_end') %>
