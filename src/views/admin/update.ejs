    <div class="flex items-center justify-between mb-2">
      <div class="text-sm font-medium text-slate-700"><%= t("adminUpdate.progress.heading") %></div>
      <div id="upload-progress-label" class="text-xs font-mono text-slate-500">0 / 0</div>
    </div>
    <div class="w-full h-1.5 rounded-full bg-slate-200 overflow-hidden mb-3">
      <div id="upload-progress-bar" class="h-full bg-indigo-600 transition-all duration-300 ease-out" style="width: 0%"></div>
    </div>
    <div id="upload-progress-current" class="text-xs text-slate-500 mb-3 flex items-center gap-1.5"></div>
    <ul id="upload-logs" class="space-y-2 text-xs"></ul>
    <div id="upload-final" class="mt-3 text-sm font-medium"></div>
  </div>
</section>

