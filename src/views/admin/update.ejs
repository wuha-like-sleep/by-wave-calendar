<%- include('_nav') %>

<!-- ============ Header card: 当前版本一览 ============ -->
<section class="rounded-2xl border border-slate-200 bg-gradient-to-br from-white via-white to-slate-50 p-5 sm:p-6 mb-6">
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
    <div class="min-w-0">
      <div class="flex items-center gap-2 mb-1">
        <span class="inline-flex items-center justify-center h-9 w-9 rounded-xl bg-brand-50 text-brand-700">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9c2.5 0 4.8 1 6.5 2.6L21 3"/><path d="M21 3v6h-6"/></svg>
        </span>
        <h1 class="text-xl sm:text-2xl font-semibold text-slate-900">系统更新</h1>
      </div>
      <p class="text-sm text-slate-500">从 Git 远端拉新代码 → 重建 → 迁移 → 重启，全自动。</p>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs">
      <div class="rounded-lg bg-white border border-slate-200 px-3 py-2">
        <div class="text-slate-400 mb-0.5">应用版本</div>
        <div class="font-mono font-semibold text-slate-900">v<%= pkgVersion %></div>
      </div>
      <div class="rounded-lg bg-white border border-slate-200 px-3 py-2">
        <div class="text-slate-400 mb-0.5">Node</div>
        <div class="font-mono font-semibold text-slate-900"><%= nodeVersion %></div>
      </div>
      <div class="rounded-lg bg-white border border-slate-200 px-3 py-2 col-span-2 sm:col-span-1">
        <div class="text-slate-400 mb-0.5">运行时长</div>
        <div class="font-mono font-semibold text-slate-900" id="uptime-text" data-uptime="<%= uptimeSeconds %>">—</div>
      </div>
    </div>
  </div>
  <div class="mt-4 pt-4 border-t border-slate-100 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-500">
    <span>远端：<code class="bg-slate-100 px-1.5 py-0.5 rounded font-mono text-slate-700"><%= remote %></code></span>
    <span>分支：<code class="bg-slate-100 px-1.5 py-0.5 rounded font-mono text-slate-700"><%= branch %></code></span>
    <span>PM2：<code class="bg-slate-100 px-1.5 py-0.5 rounded font-mono text-slate-700"><%= pm2Name %></code></span>
  </div>
</section>

<!-- ============ 主要操作：检查 + 更新 ============ -->
<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
    <div>
      <h2 class="text-base font-semibold text-slate-900">检查并应用更新</h2>
      <p class="text-xs text-slate-500 mt-0.5">先检查 → 看到新提交 → 立即更新</p>
    </div>
    <div class="flex gap-2 flex-shrink-0">
      <button type="button" id="btn-check"
        class="inline-flex items-center gap-1.5 rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-brand-700 disabled:opacity-40 disabled:cursor-not-allowed">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9c2.5 0 4.8 1 6.5 2.6L21 3"/><path d="M21 3v6h-6"/></svg>
        检查更新
      </button>
      <button type="button" id="btn-apply" disabled
        class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-emerald-700 disabled:opacity-40 disabled:cursor-not-allowed">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        立即更新
      </button>
    </div>
  </div>

  <!-- 检查结果 -->
  <div id="status-box" class="hidden">
    <div id="status-up-to-date" class="hidden rounded-lg border border-emerald-200 bg-emerald-50 p-4 text-sm">
      <div class="flex items-center gap-2 text-emerald-800 font-medium">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12l5 5L20 7"/></svg>
        已是最新版本
      </div>
      <div class="mt-1 text-emerald-700 text-xs">当前提交 <code class="font-mono" id="cur-sha-up">—</code> 与远端一致。</div>
    </div>

    <div id="status-behind" class="hidden rounded-lg border border-brand-200 bg-brand-50/60 p-4 text-sm">
      <div class="flex items-center gap-2 text-brand-800 font-medium">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
        发现 <span id="behind-n">0</span> 个新提交
      </div>
      <div class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
        <div class="rounded-md bg-white border border-brand-100 px-3 py-2">
          <div class="text-slate-400 mb-0.5">当前</div>
          <code class="font-mono text-slate-700 text-xs break-all" id="cur-sha">—</code>
          <div class="text-slate-500 mt-1 truncate" id="cur-subject"></div>
        </div>
        <div class="rounded-md bg-white border border-emerald-100 px-3 py-2">
          <div class="text-emerald-600 mb-0.5">远端</div>
          <code class="font-mono text-slate-700 text-xs break-all" id="remote-sha">—</code>
        </div>
      </div>
      <details class="mt-3" open>
        <summary class="cursor-pointer text-xs text-brand-700 hover:text-brand-800 font-medium">📋 提交日志</summary>
        <ul id="new-commits" class="mt-2 space-y-1.5"></ul>
      </details>
      <div id="dirty-line" class="mt-3 hidden rounded-md bg-amber-50 border border-amber-200 p-2.5 text-xs text-amber-800">
        ⚠️ 工作树有未提交的本地改动 —— 更新会用 <code class="bg-amber-100 px-1 rounded">git reset --hard</code> 覆盖，建议先备份。
      </div>
    </div>
  </div>

  <!-- 执行进度 -->
  <div id="apply-box" class="hidden mt-4 rounded-lg border border-slate-200 bg-slate-50 p-4">
    <div class="flex items-center justify-between mb-2">
      <div class="text-sm font-medium text-slate-700">执行进度</div>
      <div id="progress-label" class="text-xs font-mono text-slate-500">0 / 0</div>
    </div>
    <div class="w-full h-1.5 rounded-full bg-slate-200 overflow-hidden mb-3">
      <div id="progress-bar" class="h-full bg-brand-600 transition-all duration-300 ease-out" style="width: 0%"></div>
    </div>
    <div id="progress-current" class="text-xs text-slate-500 mb-3 flex items-center gap-1.5"></div>
    <ul id="apply-logs" class="space-y-2 text-xs"></ul>
    <div id="apply-final" class="mt-3 text-sm font-medium"></div>
  </div>
</section>

<!-- ============ 维护操作 ============ -->
<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6">
  <h2 class="text-base font-semibold text-slate-900 mb-1">维护操作</h2>
  <p class="text-xs text-slate-500 mb-4">不拉新代码、只对当前部署做动作</p>
  <div class="flex flex-wrap gap-2">
    <button type="button" id="btn-restart"
      class="inline-flex items-center gap-1.5 rounded-lg border border-amber-200 bg-amber-50 px-3.5 py-2 text-sm font-medium text-amber-800 hover:bg-amber-100">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9"/><path d="M21 3v6h-6"/></svg>
      重启服务
    </button>
    <a href="/admin/backup" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-sm text-slate-700 hover:bg-slate-50">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
      下载备份
    </a>
    <a href="/admin/audit" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-sm text-slate-700 hover:bg-slate-50">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>
      审计日志
    </a>
  </div>
</section>

<!-- ============ 说明 (折叠) ============ -->
<section class="rounded-2xl border border-slate-200 bg-slate-50/40 p-5 sm:p-6">
  <details>
    <summary class="cursor-pointer text-sm font-medium text-slate-700">这些按钮到底做了什么？</summary>
    <ul class="mt-3 text-sm text-slate-600 space-y-2 list-disc pl-5">
      <li><strong class="text-slate-800">检查更新</strong> · 服务器跑 <code class="bg-slate-100 px-1 rounded text-xs">git fetch <%= remote %> <%= branch %></code>，对比 HEAD 与远端的差异，列出新增提交</li>
      <li><strong class="text-slate-800">立即更新</strong> · 依次执行 <code class="bg-slate-100 px-1 rounded text-xs">git reset --hard <%= remote %>/<%= branch %></code> → <code class="bg-slate-100 px-1 rounded text-xs">npm ci --include=dev</code> → <code class="bg-slate-100 px-1 rounded text-xs">npm run build</code> → <code class="bg-slate-100 px-1 rounded text-xs">npm run db:migrate</code>。任何一步失败立即停止</li>
      <li><strong class="text-slate-800">重启服务</strong> · 等同 <code class="bg-slate-100 px-1 rounded text-xs">pm2 restart <%= pm2Name %></code>，常用于证书续期 / 改了 .env 后</li>
      <li>远端覆盖：<code class="bg-slate-100 px-1 rounded text-xs">UPDATE_REMOTE</code> / <code class="bg-slate-100 px-1 rounded text-xs">UPDATE_BRANCH</code> 环境变量</li>
    </ul>
  </details>
</section>

<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
(function(){
  const csrf = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
  const checkBtn = document.getElementById('btn-check');
  const applyBtn = document.getElementById('btn-apply');
  const restartBtn = document.getElementById('btn-restart');
  const statusBox = document.getElementById('status-box');
  const applyBox = document.getElementById('apply-box');

  // ---- Uptime widget (live ticking) ----
  (function tickUptime(){
    const el = document.getElementById('uptime-text');
    if (!el) return;
    let secs = parseInt(el.dataset.uptime || '0', 10) || 0;
    function fmt(s) {
      if (s < 60) return s + ' 秒';
      const m = Math.floor(s / 60);
      if (m < 60) return m + ' 分钟';
      const h = Math.floor(m / 60);
      if (h < 24) return h + ' 时 ' + (m % 60) + ' 分';
      const d = Math.floor(h / 24);
      return d + ' 天 ' + (h % 24) + ' 时';
    }
    function render() { el.textContent = fmt(secs); }
    render();
    setInterval(() => { secs++; render(); }, 1000);
  })();

  async function postJson(url) {
    const fd = new URLSearchParams();
    fd.set('_csrf', csrf);
    const resp = await fetch(url, {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: fd.toString(),
    });
    return resp.json();
  }

  async function autoRestartAndReload() {
    const finalEl = document.getElementById('apply-final');
    const oldVersion = document.documentElement.getAttribute('data-app-version') || '0';
    try { await postJson('/admin/update/restart'); } catch (_e) {}
    const startedAt = Date.now();
    const TIMEOUT_MS = 60_000;
    let attempts = 0;
    while (Date.now() - startedAt < TIMEOUT_MS) {
      attempts++;
      finalEl.innerHTML = '<span class="text-slate-600">⏳ 等服务回来…（' + attempts + ' 次）</span>';
      await new Promise((r) => setTimeout(r, 1500));
      try {
        const resp = await fetch('/api/version', { cache: 'no-store', credentials: 'same-origin' });
        if (!resp.ok) continue;
        const data = await resp.json();
        const newV = String(data.version || '');
        if (newV && newV !== oldVersion) {
          finalEl.innerHTML = '<span class="text-emerald-700">✓ 服务已重新上线，正在刷新…</span>';
          await new Promise((r) => setTimeout(r, 700));
          window.location.reload();
          return;
        }
      } catch (_e) {}
    }
    finalEl.innerHTML = '<span class="text-amber-700">⚠️ 60 秒内没等到服务恢复，可能 pm2 没在前台 —— 请手动检查后再点「重启服务」。</span>';
  }

  checkBtn.addEventListener('click', async () => {
    checkBtn.disabled = true;
    const orig = checkBtn.innerHTML;
    checkBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9"/></svg> 检查中…';
    try {
      const data = await postJson('/admin/update/check');
      if (!data.ok) throw new Error(data.error || '检查失败');
      const s = data.status;
      statusBox.classList.remove('hidden');
      const upBox = document.getElementById('status-up-to-date');
      const behindBox = document.getElementById('status-behind');
      if (s.behind === 0) {
        upBox.classList.remove('hidden');
        behindBox.classList.add('hidden');
        document.getElementById('cur-sha-up').textContent = s.currentSha;
        applyBtn.disabled = true;
      } else {
        upBox.classList.add('hidden');
        behindBox.classList.remove('hidden');
        document.getElementById('behind-n').textContent = s.behind;
        document.getElementById('cur-sha').textContent = s.currentSha;
        document.getElementById('cur-subject').textContent = s.currentSubject || '';
        document.getElementById('remote-sha').textContent = s.remoteSha || '—';
        const newCommits = document.getElementById('new-commits');
        newCommits.innerHTML = '';
        s.newCommits.forEach((c) => {
          const li = document.createElement('li');
          li.className = 'flex items-start gap-2 rounded-md bg-white/80 border border-slate-100 px-2.5 py-1.5';
          li.innerHTML =
            '<code class="font-mono text-xs text-brand-700 flex-shrink-0 mt-0.5">' + c.sha + '</code>' +
            '<span class="flex-1 min-w-0">' +
              '<span class="text-slate-700 break-words">' + escapeHtml(c.subject) + '</span>' +
              '<span class="block text-xs text-slate-400 mt-0.5">' + escapeHtml(c.date) + '</span>' +
            '</span>';
          newCommits.appendChild(li);
        });
        applyBtn.disabled = false;
      }
      document.getElementById('dirty-line').classList.toggle('hidden', !s.hasLocalChanges);
    } catch (err) {
      window.bwc && window.bwc.toast('检查失败：' + err.message, 'error');
    } finally {
      checkBtn.disabled = false;
      checkBtn.innerHTML = orig;
    }
  });

  applyBtn.addEventListener('click', async () => {
    if (!confirm('开始更新？会用 git reset --hard 覆盖本地改动并自动重建。')) return;
    applyBtn.disabled = true;
    applyBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9"/></svg> 更新中…';
    applyBox.classList.remove('hidden');
    const logsEl = document.getElementById('apply-logs');
    const finalEl = document.getElementById('apply-final');
    const progressBar = document.getElementById('progress-bar');
    const progressLabel = document.getElementById('progress-label');
    const progressCurrent = document.getElementById('progress-current');
    logsEl.innerHTML = '';
    finalEl.textContent = '';
    progressBar.style.width = '0%';
    progressBar.classList.remove('bg-red-600');
    progressBar.classList.add('bg-brand-600');
    progressLabel.textContent = '0 / 0';
    progressCurrent.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9"/></svg> 准备开始…';

    function handleEvent(ev) {
      if (ev.type === 'start') {
        progressLabel.textContent = (ev.index + 1) + ' / ' + ev.total;
        progressCurrent.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9"/></svg> ' + escapeHtml(ev.step);
        progressBar.style.width = ((ev.index + 0.4) / ev.total * 100) + '%';
      } else if (ev.type === 'done') {
        progressBar.style.width = ((ev.index + 1) / ev.total * 100) + '%';
        const li = document.createElement('li');
        li.className = 'rounded-md border ' + (ev.ok ? 'border-emerald-200 bg-emerald-50' : 'border-red-200 bg-red-50') + ' overflow-hidden';
        li.innerHTML =
          '<details ' + (ev.ok ? '' : 'open') + '>' +
            '<summary class="cursor-pointer flex items-center gap-2 px-3 py-2 text-sm">' +
              '<span class="' + (ev.ok ? 'text-emerald-700' : 'text-red-700') + ' font-semibold">' + (ev.ok ? '✓' : '✗') + '</span>' +
              '<span class="font-medium ' + (ev.ok ? 'text-emerald-900' : 'text-red-900') + '">' + escapeHtml(ev.step) + '</span>' +
              '<span class="text-xs text-slate-400 ml-auto">点击展开输出</span>' +
            '</summary>' +
            '<pre class="px-3 pb-3 mt-1 text-xs whitespace-pre-wrap break-all text-slate-700 max-h-60 overflow-y-auto">' + escapeHtml(ev.output || '(no output)') + '</pre>' +
          '</details>';
        logsEl.appendChild(li);
      } else if (ev.type === 'final') {
        progressBar.style.width = '100%';
        progressCurrent.innerHTML = '';
        if (ev.ok) {
          finalEl.innerHTML = '<span class="text-emerald-700">✓ 更新成功 —— 正在自动重启服务，页面会在重启完成后自动刷新…</span>';
          applyBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9"/></svg> 重启中…';
          autoRestartAndReload();
        } else {
          finalEl.innerHTML = '<span class="text-red-700">✗ 有步骤失败，详见上方日志。已停在失败前一步。</span>';
          applyBtn.disabled = false;
          applyBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9"/></svg> 重试';
          progressBar.classList.remove('bg-brand-600');
          progressBar.classList.add('bg-red-600');
        }
      }
    }

    try {
      const fd = new URLSearchParams();
      fd.set('_csrf', csrf);
      const resp = await fetch('/admin/update/apply-stream', {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: fd.toString(),
      });
      if (!resp.ok || !resp.body) throw new Error('HTTP ' + resp.status);
      const reader = resp.body.getReader();
      const decoder = new TextDecoder();
      let buf = '';
      while (true) {
        const { value, done } = await reader.read();
        if (done) break;
        buf += decoder.decode(value, { stream: true });
        let idx;
        while ((idx = buf.indexOf('\n\n')) >= 0) {
          const chunk = buf.slice(0, idx);
          buf = buf.slice(idx + 2);
          const line = chunk.split('\n').filter((l) => l.startsWith('data: ')).map((l) => l.slice(6)).join('');
          if (!line) continue;
          try { handleEvent(JSON.parse(line)); } catch (_e) {}
        }
      }
    } catch (err) {
      finalEl.innerHTML = '<span class="text-red-700">连接失败：' + escapeHtml(err.message) + '</span>';
      applyBtn.disabled = false;
      applyBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9"/></svg> 重试';
    }
  });

  restartBtn.addEventListener('click', async () => {
    if (!confirm('立即重启 by-wave-calendar 进程？当前所有请求会被打断（一般 1-3 秒恢复）。')) return;
    restartBtn.disabled = true;
    const orig = restartBtn.innerHTML;
    restartBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9"/></svg> 重启中…';
    try {
      await postJson('/admin/update/restart');
      window.bwc && window.bwc.toast('已发送重启信号，1-3 秒后服务会重新上线', 'success');
    } catch (err) {
      window.bwc && window.bwc.toast('重启失败：' + err.message, 'error');
    }
    setTimeout(() => { restartBtn.disabled = false; restartBtn.innerHTML = orig; }, 3000);
  });

  function escapeHtml(s) {
    return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }
})();
</script>
