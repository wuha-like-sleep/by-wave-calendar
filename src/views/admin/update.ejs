<%- include('_nav') %>

<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6">
  <h1 class="text-xl font-semibold text-slate-900 mb-1">系统更新</h1>
  <p class="text-sm text-slate-500">从 <code class="bg-slate-100 px-1 rounded"><%= remote %>/<%= branch %></code> 拉取最新代码，自动重新构建并迁移数据库。需要服务器上已配置好该远端 + 有写入权限。</p>

  <div class="mt-5 flex flex-wrap gap-2">
    <button type="button" id="btn-check" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">检查更新</button>
    <button type="button" id="btn-apply" disabled class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700 disabled:opacity-40 disabled:cursor-not-allowed">立即更新</button>
    <button type="button" id="btn-restart" class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-2 text-sm font-medium text-amber-800 hover:bg-amber-100">仅重启服务</button>
  </div>

  <div id="status-box" class="mt-5 hidden rounded-lg border border-slate-200 bg-slate-50 p-4">
    <div class="text-sm text-slate-700">
      <div>当前版本：<code class="font-mono" id="cur-sha">—</code> · <span id="cur-subject" class="text-slate-500"></span></div>
      <div>远端版本：<code class="font-mono" id="remote-sha">—</code></div>
      <div id="behind-line" class="mt-2"></div>
      <div id="dirty-line" class="mt-1 text-amber-700 hidden">⚠️ 工作树有未提交的本地改动 —— 更新会用 <code>git reset --hard</code> 覆盖，建议先备份。</div>
    </div>
    <ul id="new-commits" class="mt-3 space-y-1 text-xs"></ul>
  </div>

  <div id="apply-box" class="mt-5 hidden rounded-lg border border-slate-200 bg-slate-50 p-4">
    <div class="flex items-center justify-between mb-2">
      <div class="text-sm font-medium text-slate-700">执行进度</div>
      <div id="progress-label" class="text-xs text-slate-500">0 / 0</div>
    </div>
    <div class="w-full h-2 rounded-full bg-slate-200 overflow-hidden mb-3">
      <div id="progress-bar" class="h-full bg-brand-600 transition-all duration-300 ease-out" style="width: 0%"></div>
    </div>
    <div id="progress-current" class="text-xs text-slate-500 mb-3"></div>
    <ul id="apply-logs" class="space-y-3 text-xs"></ul>
    <div id="apply-final" class="mt-3 text-sm font-medium"></div>
  </div>
</section>

<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
  <h2 class="text-base font-semibold text-slate-900 mb-2">说明</h2>
  <ul class="text-sm text-slate-600 space-y-1.5 list-disc pl-5">
    <li><strong>检查更新</strong>：在服务器上跑 <code>git fetch <%= remote %> <%= branch %></code>，对比当前 HEAD 与远端的差异，列出新增提交。</li>
    <li><strong>立即更新</strong>：依次执行 <code>git reset --hard <%= remote %>/<%= branch %></code>、<code>npm ci --include=dev</code>、<code>npm run build</code>、<code>npm run db:migrate</code>。任何一步失败会停止并显示错误。</li>
    <li><strong>仅重启服务</strong>：调用 <code>pm2 restart <%= pm2Name %></code>，常用于代码已就绪但需要重新加载（比如证书更新后）。</li>
    <li>覆盖远端可通过环境变量 <code>UPDATE_REMOTE</code> / <code>UPDATE_BRANCH</code> 配置。当前：<code><%= remote %>/<%= branch %></code>。</li>
  </ul>
</section>

<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
(function(){
  const csrf = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
  const checkBtn = document.getElementById('btn-check');
  const applyBtn = document.getElementById('btn-apply');
  const restartBtn = document.getElementById('btn-restart');
  const statusBox = document.getElementById('status-box');
  const applyBox = document.getElementById('apply-box');

  async function postJson(url) {
    const fd = new URLSearchParams();
    fd.set('_csrf', csrf);
    const resp = await fetch(url, {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: fd.toString(),
    });
    return resp.json();
  }

  async function autoRestartAndReload() {
    const finalEl = document.getElementById('apply-final');
    const oldVersion = document.documentElement.getAttribute('data-app-version') || '0';
    try {
      // Tell the server to restart; the response flushes ~800ms before pm2 kills us.
      await postJson('/admin/update/restart');
    } catch (_e) { /* server may close mid-request; that's fine */ }

    // Wait a beat, then poll until /api/version returns a DIFFERENT version
    // (or just any 200 if we can't read version). 60s timeout.
    const startedAt = Date.now();
    const TIMEOUT_MS = 60_000;
    let attempts = 0;
    while (Date.now() - startedAt < TIMEOUT_MS) {
      attempts++;
      finalEl.innerHTML = '<span class="text-slate-600">⏳ 等服务回来…（' + attempts + ' 次）</span>';
      await new Promise((r) => setTimeout(r, 1500));
      try {
        const resp = await fetch('/api/version', { cache: 'no-store', credentials: 'same-origin' });
        if (!resp.ok) continue;
        const data = await resp.json();
        const newV = String(data.version || '');
        if (newV && newV !== oldVersion) {
          finalEl.innerHTML = '<span class="text-emerald-700">✓ 服务已重新上线，正在刷新…</span>';
          await new Promise((r) => setTimeout(r, 700));
          window.location.reload();
          return;
        }
      } catch (_e) { /* still down, keep polling */ }
    }
    finalEl.innerHTML = '<span class="text-amber-700">⚠️ 60 秒内没等到服务恢复，可能 pm2 没在前台 —— 请手动检查后再点「仅重启服务」。</span>';
  }

  checkBtn.addEventListener('click', async () => {
    checkBtn.disabled = true;
    checkBtn.textContent = '检查中…';
    try {
      const data = await postJson('/admin/update/check');
      if (!data.ok) throw new Error(data.error || '检查失败');
      statusBox.classList.remove('hidden');
      const s = data.status;
      document.getElementById('cur-sha').textContent = s.currentSha;
      document.getElementById('cur-subject').textContent = s.currentSubject || '';
      document.getElementById('remote-sha').textContent = s.remoteSha || '—';
      const behindLine = document.getElementById('behind-line');
      const newCommits = document.getElementById('new-commits');
      newCommits.innerHTML = '';
      if (s.behind === 0) {
        behindLine.innerHTML = '<span class="text-emerald-700">✓ 已是最新版本</span>';
        applyBtn.disabled = true;
      } else {
        behindLine.innerHTML = '<span class="text-brand-700">📦 落后 <strong>' + s.behind + '</strong> 个提交</span>';
        applyBtn.disabled = false;
        s.newCommits.forEach((c) => {
          const li = document.createElement('li');
          li.className = 'border-l-2 border-brand-300 pl-2';
          li.innerHTML = '<code class="font-mono text-slate-500">' + c.sha + '</code> ' + escapeHtml(c.subject) + ' <span class="text-slate-400">· ' + escapeHtml(c.date) + '</span>';
          newCommits.appendChild(li);
        });
      }
      document.getElementById('dirty-line').classList.toggle('hidden', !s.hasLocalChanges);
    } catch (err) {
      window.bwc && window.bwc.toast('检查失败：' + err.message, 'error');
    } finally {
      checkBtn.disabled = false;
      checkBtn.textContent = '检查更新';
    }
  });

  applyBtn.addEventListener('click', async () => {
    if (!confirm('开始更新？这会用 git reset --hard 覆盖本地，并自动重建。')) return;
    applyBtn.disabled = true;
    applyBtn.textContent = '更新中…';
    applyBox.classList.remove('hidden');
    const logsEl = document.getElementById('apply-logs');
    const finalEl = document.getElementById('apply-final');
    const progressBar = document.getElementById('progress-bar');
    const progressLabel = document.getElementById('progress-label');
    const progressCurrent = document.getElementById('progress-current');
    logsEl.innerHTML = '';
    finalEl.textContent = '';
    progressBar.style.width = '0%';
    progressLabel.textContent = '0 / 0';
    progressCurrent.textContent = '准备开始…';

    function handleEvent(ev) {
      if (ev.type === 'start') {
        progressLabel.textContent = (ev.index + 1) + ' / ' + ev.total;
        progressCurrent.textContent = '⏳ ' + ev.step;
        // Half-step progress (so the bar moves immediately on start)
        progressBar.style.width = ((ev.index + 0.4) / ev.total * 100) + '%';
      } else if (ev.type === 'done') {
        progressBar.style.width = ((ev.index + 1) / ev.total * 100) + '%';
        const li = document.createElement('li');
        li.className = 'rounded-md border ' + (ev.ok ? 'border-emerald-200 bg-emerald-50' : 'border-red-200 bg-red-50') + ' p-2';
        li.innerHTML = '<div class="font-medium ' + (ev.ok ? 'text-emerald-800' : 'text-red-800') + '">' + (ev.ok ? '✓ ' : '✗ ') + escapeHtml(ev.step) + '</div>' +
                       '<pre class="mt-1 whitespace-pre-wrap break-all text-slate-700 max-h-40 overflow-y-auto">' + escapeHtml(ev.output || '(no output)') + '</pre>';
        logsEl.appendChild(li);
      } else if (ev.type === 'final') {
        progressBar.style.width = '100%';
        progressCurrent.textContent = '';
        if (ev.ok) {
          finalEl.innerHTML = '<span class="text-emerald-700">✓ 更新成功 —— 正在自动重启服务，页面会在重启完成后自动刷新…</span>';
          applyBtn.textContent = '重启中…';
          // Fire the restart, then poll /api/version until the server comes
          // back, then reload so the user lands on the new build.
          autoRestartAndReload();
        } else {
          finalEl.innerHTML = '<span class="text-red-700">✗ 有步骤失败，详见上方日志。已停在失败前一步。</span>';
          applyBtn.disabled = false;
          applyBtn.textContent = '重试';
          progressBar.classList.remove('bg-brand-600');
          progressBar.classList.add('bg-red-600');
        }
      }
    }

    try {
      const fd = new URLSearchParams();
      fd.set('_csrf', csrf);
      const resp = await fetch('/admin/update/apply-stream', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: fd.toString(),
      });
      if (!resp.ok || !resp.body) throw new Error('HTTP ' + resp.status);
      const reader = resp.body.getReader();
      const decoder = new TextDecoder();
      let buf = '';
      while (true) {
        const { value, done } = await reader.read();
        if (done) break;
        buf += decoder.decode(value, { stream: true });
        // SSE events are separated by blank lines; each line within an event
        // starts with "data: ".
        let idx;
        while ((idx = buf.indexOf('\n\n')) >= 0) {
          const chunk = buf.slice(0, idx);
          buf = buf.slice(idx + 2);
          const line = chunk.split('\n').filter((l) => l.startsWith('data: ')).map((l) => l.slice(6)).join('');
          if (!line) continue;
          try { handleEvent(JSON.parse(line)); } catch (_e) { /* ignore parse errors */ }
        }
      }
    } catch (err) {
      finalEl.innerHTML = '<span class="text-red-700">连接失败：' + escapeHtml(err.message) + '</span>';
      applyBtn.disabled = false;
      applyBtn.textContent = '重试';
    }
  });

  restartBtn.addEventListener('click', async () => {
    if (!confirm('立即重启 by-wave-calendar 进程？当前所有请求会被打断（一般 1-2 秒恢复）。')) return;
    restartBtn.disabled = true;
    restartBtn.textContent = '重启中…';
    try {
      await postJson('/admin/update/restart');
      window.bwc && window.bwc.toast('已发送重启信号，1-3 秒后服务会重新上线', 'success');
    } catch (err) {
      window.bwc && window.bwc.toast('重启失败：' + err.message, 'error');
    }
    setTimeout(() => { restartBtn.disabled = false; restartBtn.textContent = '仅重启服务'; }, 3000);
  });

  function escapeHtml(s) {
    return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }
})();
</script>
