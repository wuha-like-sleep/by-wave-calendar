<%- include('_nav') %>

<h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 mb-2"><%= t("adminCaldav.heading") %></h1>
<p class="text-sm text-slate-500 mb-6"><%= t("adminCaldav.lead") %></p>

<%
  // 当前标记。摆出来是为了让「按了没生效」有地方被看见 —— 按完回到这一页，
  // 这里的时间必须是刚刚；一直是老样子就说明这次没写进去。
  var epochLabel = epoch.kind === 'none'
    ? t("adminCaldav.state.never")
    : (epoch.kind === 'manual' ? t("adminCaldav.state.manual") : t("adminCaldav.state.release"));
%>
<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-3"><%= t("adminCaldav.state.heading") %></h2>
  <dl class="space-y-2 text-sm">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <dt class="text-slate-500 w-28 shrink-0"><%= t("adminCaldav.state.sourceLabel") %></dt>
      <dd class="text-slate-900"><%= epochLabel %></dd>
    </div>
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <dt class="text-slate-500 w-28 shrink-0"><%= t("adminCaldav.state.timeLabel") %></dt>
      <dd class="text-slate-900">
        <% if (epoch.atIso) { %>
          <time data-tz datetime="<%= epoch.atIso %>" data-style="datetime"><%= epoch.atIso %></time>
        <% } else { %>
          <%# 没有可显示的时间时留一个横杠：整行不许消失，否则页面看上去像「本来就没有这一项」。 %>
          <span class="text-slate-400">—</span>
        <% } %>
      </dd>
    </div>
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <dt class="text-slate-500 w-28 shrink-0"><%= t("adminCaldav.state.markerLabel") %></dt>
      <dd class="font-mono text-xs text-slate-600 break-all"><%= epoch.raw || '—' %></dd>
    </div>
  </dl>
</section>

<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-1"><%= t("adminCaldav.action.heading") %></h2>
  <p class="text-sm text-slate-500 mb-4"><%= t("adminCaldav.action.desc") %></p>
  <a href="/admin/caldav/resync"
     class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2v6h-6M3 22v-6h6"/><path d="M21 8a9 9 0 0 0-15-3.3L3 8m18 8a9 9 0 0 1-15 3.3L3 16"/></svg>
    <%= t("adminCaldav.action.button") %>
  </a>
  <p class="mt-3 text-xs text-slate-400"><%= t("adminCaldav.action.whenToUse") %></p>
</section>

<%- include('_nav_end') %>
