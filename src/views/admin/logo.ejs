<%- include('_nav', { activeNav: '/admin/logo' }) %>

<h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 mb-6"><%= t("adminLogo.heading") %></h1>

<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
  <div class="flex items-center gap-4 mb-4">
    <% if (settings.logoUrl) { %>
      <img src="<%= settings.logoUrl %>" alt="logo" class="h-16 w-16 rounded-xl object-cover border border-slate-200 bg-slate-50" />
      <form method="post" action="/admin/logo/delete" class="m-0" data-confirm="<%= t("adminLogo.deleteConfirm") %>" data-confirm-danger="1" data-confirm-ok="<%= t("common.delete") %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="text-sm text-red-600 hover:text-red-700"><%= t("adminLogo.deleteCurrent") %></button>
      </form>
    <% } else { %>
      <img src="/static/brand/logo.svg?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>" alt="ByWave" width="64" height="64" class="h-16 w-16" />
      <span class="text-sm text-slate-500"><%= t("adminLogo.defaultInUse") %></span>
    <% } %>
  </div>
  <form method="post" action="/admin/logo" enctype="multipart/form-data" class="space-y-3 max-w-md">
    <%# _csrf 必须排在文件框前面:服务端拿到文件那一刻,只有排在它前面的字段解析好了。 %>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="file" name="logo" accept="image/png,image/jpeg,image/svg+xml,image/webp" required
           class="block w-full text-sm text-slate-700 file:mr-3 file:rounded-lg file:border-0 file:bg-brand-600 file:px-3 file:py-2 file:text-sm file:font-medium file:text-white file:hover:bg-brand-700" />
    <p class="text-xs text-slate-500"><%= t("adminLogo.hint") %></p>
    <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"><%= t("adminLogo.upload") %></button>
  </form>
</section>

<%- include('_nav_end') %>
