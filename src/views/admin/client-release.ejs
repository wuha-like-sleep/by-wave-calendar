<%- include('_nav') %>

<h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 mb-2"><%= t("adminClientRelease.heading") %></h1>
<p class="text-sm text-slate-500 mb-6"><%- t("adminClientRelease.lead") %></p>

<%
  // 「生效来源」的三种取值，按站长的语言说，不是按字段名说。
  const sourceText = {
    override:  { label: t("adminClientRelease.source.override"),   cls: 'bg-amber-50 text-amber-800 border-amber-200' },
    committed: { label: t("adminClientRelease.source.committed"),   cls: 'bg-emerald-50 text-emerald-800 border-emerald-200' },
    none:      { label: t("adminClientRelease.source.none"),   cls: 'bg-slate-100 text-slate-600 border-slate-200' },
  };
%>

<%
  const fmtMB = (n) => n == null ? '—' : (n / 1048576).toFixed(1) + ' MB';
  const fmtGB = (n) => n == null ? '—' : (n / 1073741824).toFixed(1) + ' GB';
  const totalBin = binaries.android.totalBytes + binaries.desktop.totalBytes;
%>

<%# 磁盘。全仓以前一处检查都没有 —— 而 data/ 和数据库通常在同一个文件系统上，
    写满之后不是「上传失败」这么干净，是数据库拒绝写入。 %>
<div class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-5 mb-6">
  <div class="flex flex-wrap items-baseline gap-x-6 gap-y-1 text-sm">
    <span class="text-slate-500"><%= t("adminClientRelease.disk.used") %></span>
    <span class="font-semibold text-slate-900"><%= fmtMB(totalBin) %></span>
    <span class="text-slate-500"><%= t("adminClientRelease.disk.free") %></span>
    <span class="font-semibold <%= disk && disk.freeBytes < 3 * 1073741824 ? 'text-amber-600' : 'text-slate-900' %>">
      <%= disk ? fmtGB(disk.freeBytes) : '—' %><% if (disk) { %> / <%= fmtGB(disk.totalBytes) %><% } %>
    </span>
    <span class="text-slate-500"><%= t("adminClientRelease.disk.maxSingle") %></span>
    <span class="font-semibold text-slate-900"><%= Math.round(maxBinaryBytes / 1048576) %> MB</span>
  </div>
  <p class="mt-2 text-xs text-amber-700"><%- t("adminClientRelease.proxyWarning") %></p>
</div>

<div class="space-y-6">
<% platforms.forEach(function (p) { %>
  <% const bin = binaries[p.platform]; %>
  <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <h2 class="text-lg font-semibold text-slate-900"><%= p.label %></h2>
      <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium <%= sourceText[p.source].cls %>">
        <%= t("adminClientRelease.source.current", { label: sourceText[p.source].label }) %>
      </span>
    </div>

    <%# 没数据也要有骨架 —— 整块字段行消失的话，「还没发布过」和「这一页坏了」看起来一模一样。 %>
    <dl class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-5 text-sm">
      <div>
        <dt class="text-xs text-slate-500 mb-0.5"><%= t("adminClientRelease.field.versionName") %></dt>
        <dd class="font-medium text-slate-900"><%= p.versionName || '—' %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500 mb-0.5"><%= t("adminClientRelease.field.versionCode") %></dt>
        <dd class="font-medium text-slate-900"><%= p.versionCode == null ? '—' : p.versionCode %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500 mb-0.5"><%= t("adminClientRelease.field.releasedAt") %></dt>
        <dd class="font-medium text-slate-900">
          <% if (p.releasedAt) { %>
            <time data-tz datetime="<%= p.releasedAt %>" data-style="datetime"><%= p.releasedAt %></time>
          <% } else { %>—<% } %>
        </dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500 mb-0.5"><%= t("adminClientRelease.field.rollout") %></dt>
        <dd class="font-medium text-slate-900"><%= p.rolloutPercent %>%</dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500 mb-0.5"><%= t("adminClientRelease.field.graceDays") %></dt>
        <dd class="font-medium text-slate-900"><%= t("adminClientRelease.graceValue", { days: p.graceDays }) %></dd>
      </div>
    </dl>
    <p class="text-xs text-slate-500 mb-3 -mt-3"><%- t("adminClientRelease.rolloutNote") %></p>
    <%# 改比例是发布现场的高频动作，单独给一个小表单：只动 rolloutPercent，
        不用为了一个数字重贴整份 JSON（顺手改坏别的字段的风险也随之消失）。 %>
    <div class="flex flex-wrap items-end gap-2 mb-5">
      <form method="post" action="/admin/client-release/<%= p.platform %>/rollout" class="flex items-end gap-2">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <label class="block">
          <span class="text-xs text-slate-500"><%= t("adminClientRelease.rollout.label") %></span>
          <input type="number" name="percent" min="0" max="100" step="1" value="<%= p.rolloutPercent %>"
                 class="mt-1 w-24 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500" />
        </label>
        <button type="submit"
                class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
          <%= t("adminClientRelease.rollout.set") %>
        </button>
      </form>
      <form method="post" action="/admin/client-release/<%= p.platform %>/rollout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="percent" value="100" />
        <button type="submit"
                class="rounded-lg bg-brand-600 px-3 py-2 text-sm font-medium text-white hover:bg-brand-700">
          <%= t("adminClientRelease.rollout.full") %>
        </button>
      </form>
    </div>

    <%# 发布后自检：版本号对不等于链路通。地址是按「本站有没有这个文件」
        解析出来的，站长在这里亲眼看到 App 会被送去哪儿，就不用等用户
        反馈「更新下不动」才发现本地包没生效。 %>
    <% if (p.clientAssets && p.clientAssets.length) { %>
    <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 mb-4 text-xs text-slate-600 space-y-1">
      <p class="font-medium text-slate-700"><%= t("adminClientRelease.assets.heading") %></p>
      <% p.clientAssets.forEach(function (a) { %>
        <p class="break-all">
          <% if (p.platform === 'desktop') { %><span class="font-medium"><%= a.platform %></span> · <% } %>
          <%= t("adminClientRelease.assets.primary") %><a class="text-brand-700 hover:underline" href="<%= a.url %>" rel="noopener" target="_blank"><%= a.url %></a>
          <% if (a.fallbackUrl) { %><br /><%= t("adminClientRelease.assets.fallback") %><a class="text-brand-700 hover:underline" href="<%= a.fallbackUrl %>" rel="noopener" target="_blank"><%= a.fallbackUrl %></a><% } %>
          <% if (a.mirrorUrl) { %><br /><%= t("adminClientRelease.assets.mirror") %><a class="text-brand-700 hover:underline" href="<%= a.mirrorUrl %>" rel="noopener" target="_blank"><%= a.mirrorUrl %></a><% } %>
        </p>
      <% }); %>
    </div>
    <% } %>

    <% if (p.source === 'none') { %>
      <p class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-600 mb-4"><%= t("adminClientRelease.noManifest") %></p>
    <% } %>

    <%# 服务器上实际有哪些包。做这一块的理由很直接：只能传不能看不能删的话，
        盘迟早满，站长还是得回宝塔。 %>
    <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4 mb-5">
      <div class="flex flex-wrap items-baseline justify-between gap-2 mb-2">
        <h3 class="text-sm font-semibold text-slate-800"><%= t("adminClientRelease.binaries.heading") %></h3>
        <span class="text-xs text-slate-500"><%= t("adminClientRelease.binaries.count", { count: bin.files.length, size: fmtMB(bin.totalBytes) }) %></span>
      </div>

      <% if (bin.files.length === 0) { %>
        <p class="text-xs text-slate-500"><%= t("adminClientRelease.binaries.empty") %></p>
      <% } else { %>
        <ul class="divide-y divide-slate-200">
          <% bin.files.forEach(function (f) { %>
            <li class="flex flex-wrap items-center gap-x-3 gap-y-1 py-2 text-xs">
              <code class="font-mono text-slate-800 break-all"><%= f.name %></code>
              <span class="text-slate-500"><%= fmtMB(f.size) %></span>
              <% if (f.partial) { %>
                <span class="rounded-full border border-slate-300 bg-white px-2 py-0.5 text-slate-500"><%= t("adminClientRelease.badge.partial") %></span>
              <% } else if (!f.servable) { %>
                <span class="rounded-full border border-red-200 bg-red-50 px-2 py-0.5 text-red-700"><%= t("adminClientRelease.badge.unservable") %></span>
              <% } else if (!f.referenced) { %>
                <span class="rounded-full border border-slate-300 bg-white px-2 py-0.5 text-slate-500"><%= t("adminClientRelease.badge.unreferenced") %></span>
              <% } else if (f.sizeMatches === false) { %>
                <span class="rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-amber-800"><%= t("adminClientRelease.badge.sizeMismatch") %></span>
              <% } else { %>
                <span class="rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-emerald-800"><%= t("adminClientRelease.badge.inUse") %></span>
              <% } %>
              <form method="post" class="ml-auto"
                    action="/admin/client-release/<%= p.platform %>/binary/<%= encodeURIComponent(f.name) %>/delete"
                    data-confirm="<%= f.referenced ? t("adminClientRelease.binary.deleteConfirmReferenced", { name: f.name }) : t("adminClientRelease.binary.deleteConfirm", { name: f.name }) %>"
                    data-confirm-danger="1" data-confirm-ok="<%= t("common.delete") %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="text-red-600 hover:text-red-700"><%= t("common.delete") %></button>
              </form>
            </li>
          <% }); %>
        </ul>
      <% } %>

      <%# 上传。走 fetch + x-csrf-token 头 —— multipart 请求读不到 _csrf 字段
          （解析器只 done() 不塞 body），所以令牌只能走头。 %>
      <div class="mt-3 pt-3 border-t border-slate-200">
        <label class="inline-flex items-center gap-2 cursor-pointer text-xs font-medium text-slate-700">
          <input type="file" class="text-xs" data-bwc-binary-upload="<%= p.platform %>"
                 accept="<%= p.platform === 'android' ? '.apk' : '.dmg,.msi,.deb' %>" />
        </label>
        <p class="mt-1 text-xs text-slate-500" data-bwc-upload-status="<%= p.platform %>"><%= t("adminClientRelease.upload.hint") %></p>
      </div>
    </div>

    <form method="post" action="/admin/client-release/<%= p.platform %>" class="space-y-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label class="block">
        <span class="text-sm font-medium text-slate-700"><%= t("adminClientRelease.manifest.label") %></span>
        <textarea name="manifest" rows="8" spellcheck="false"
                  class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-xs
                         focus:border-brand-500 focus:ring-1 focus:ring-brand-500"
                  placeholder='<%= p.platform === "android"
                    ? "{\n  \"versionCode\": 21,\n  \"versionName\": \"0.12.0\",\n  \"downloadUrl\": \"https://…/app.apk\",\n  \"sha256\": \"…\",\n  \"sizeBytes\": 24921268\n}"
                    : "{\n  \"versionCode\": 24,\n  \"versionName\": \"1.1.1\",\n  \"assets\": {\n    \"mac\": { \"downloadUrl\": \"https://…\", \"sha256\": \"…\", \"sizeBytes\": 0 }\n  }\n}" %>'><%= p.overrideRaw || '' %></textarea>
      </label>
      <p class="text-xs text-slate-500"><%- t("adminClientRelease.manifest.note") %></p>
      <div class="flex flex-wrap gap-2">
        <button type="submit"
                class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">
          <%= t("adminClientRelease.manifest.save") %>
        </button>
      </div>
    </form>

    <% if (p.source === 'override') { %>
      <%# 用 data-confirm 而不是内联 onsubmit —— 全站 CSP 是 script-src-attr 'none'，
          内联事件处理器一律不执行，而且有一条门禁盯着这件事（我第一版就红在那儿）。
          data-confirm 由 src/public/_built/app.js 的全局委托处理。 %>
      <form method="post" action="/admin/client-release/<%= p.platform %>/clear" class="mt-3"
            data-confirm="<%= t("adminClientRelease.clear.confirm") %>"
            data-confirm-ok="<%= t("adminClientRelease.clear.ok") %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit"
                class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
          <%= t("adminClientRelease.clear.label") %>
        </button>
        <% if (!p.committedExists) { %>
          <span class="ml-2 text-xs text-amber-700"><%= t("adminClientRelease.clear.noCommitted") %></span>
        <% } %>
      </form>
    <% } %>
  </section>
<% }); %>
</div>

<%# iOS 公告。iOS 没有清单这回事 —— 它的版本只走 App Store，这里发的是
    「商店里有新版了」的一条广播，存在站点设置里，客户端启动时自己来拉。 %>
<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mt-6">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <h2 class="text-lg font-semibold text-slate-900"><%= t("adminClientRelease.ios.heading") %></h2>
    <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium <%= iosAnnouncement.live ? 'bg-emerald-50 text-emerald-800 border-emerald-200' : 'bg-slate-100 text-slate-600 border-slate-200' %>">
      <%= t("adminClientRelease.ios.status", { state: iosAnnouncement.live ? t("adminClientRelease.ios.stateLive") : t("adminClientRelease.ios.stateOff") }) %>
    </span>
  </div>
  <p class="text-sm text-slate-500 mb-4"><%= t("adminClientRelease.ios.lead") %></p>

  <%# 自检：接口实际会返回的那一份。表单里填了 ≠ 在播 —— 版本号形态不对
      这类问题在这里直接现形。 %>
  <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 mb-4 text-xs text-slate-600 space-y-1">
    <p class="font-medium text-slate-700"><%= t("adminClientRelease.ios.previewHeading") %></p>
    <% if (iosAnnouncement.live) { %>
      <p class="break-all">
        <%= t("adminClientRelease.ios.versionLine", { version: iosAnnouncement.live.version, title: iosAnnouncement.live.title || t("adminClientRelease.ios.noTitle") }) %>
        <% if (iosAnnouncement.live.storeUrl) { %><br /><%= t("adminClientRelease.ios.storeLink") %><a class="text-brand-700 hover:underline" href="<%= iosAnnouncement.live.storeUrl %>" rel="noopener" target="_blank"><%= iosAnnouncement.live.storeUrl %></a><% } %>
      </p>
    <% } else { %>
      <p><%= t("adminClientRelease.ios.notLive") %></p>
    <% } %>
  </div>

  <form method="post" action="/admin/client-release/ios-announcement" class="space-y-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
      <input type="checkbox" name="enabled" <%= iosAnnouncement.enabled ? 'checked' : '' %>
             class="rounded border-slate-300" />
      <%= t("adminClientRelease.ios.enable") %>
    </label>
    <div class="grid sm:grid-cols-2 gap-3">
      <label class="block">
        <span class="text-sm font-medium text-slate-700"><%= t("adminClientRelease.ios.field.version") %></span>
        <input type="text" name="version" value="<%= iosAnnouncement.version %>" placeholder="1.8.0"
               class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500" />
      </label>
      <label class="block">
        <span class="text-sm font-medium text-slate-700"><%= t("adminClientRelease.ios.field.storeUrl") %></span>
        <input type="text" name="storeUrl" value="<%= iosAnnouncement.storeUrl %>" placeholder="https://apps.apple.com/…"
               class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500" />
      </label>
    </div>
    <label class="block">
      <span class="text-sm font-medium text-slate-700"><%= t("adminClientRelease.ios.field.title") %></span>
      <input type="text" name="title" value="<%= iosAnnouncement.title %>" placeholder="<%= t("adminClientRelease.ios.titlePlaceholder") %>"
             class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500" />
    </label>
    <label class="block">
      <span class="text-sm font-medium text-slate-700"><%= t("adminClientRelease.ios.field.body") %></span>
      <textarea name="body" rows="3"
                class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500"
                placeholder="<%= t("adminClientRelease.ios.bodyPlaceholder") %>"><%= iosAnnouncement.body %></textarea>
    </label>
    <button type="submit"
            class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">
      <%= t("adminClientRelease.ios.save") %>
    </button>
  </form>
</section>

<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
(function () {
  var CSRF = <%- JSON.stringify(csrfToken) %>;
  var MAX = <%= maxBinaryBytes %>;
  var T = {
    tooBig: <%- JSON.stringify(t("adminClientRelease.js.tooBig")) %>,
    uploading: <%- JSON.stringify(t("adminClientRelease.js.uploading")) %>,
    starting: <%- JSON.stringify(t("adminClientRelease.js.starting")) %>,
    networkError: <%- JSON.stringify(t("adminClientRelease.js.networkError")) %>,
    saved: <%- JSON.stringify(t("adminClientRelease.js.saved")) %>,
    savedTail: <%- JSON.stringify(t("adminClientRelease.js.savedTail")) %>,
    savedUnverified: <%- JSON.stringify(t("adminClientRelease.js.savedUnverified")) %>,
    savedUnreferenced: <%- JSON.stringify(t("adminClientRelease.js.savedUnreferenced")) %>,
    failed: <%- JSON.stringify(t("adminClientRelease.js.failed")) %>,
    proxyBlocked413: <%- JSON.stringify(t("adminClientRelease.js.proxyBlocked413")) %>,
    interceptedHtml: <%- JSON.stringify(t("adminClientRelease.js.interceptedHtml")) %>
  };
  function fmt(s, vars) {
    return s.replace(/\{(\w+)\}/g, function (_, k) { return vars[k] != null ? String(vars[k]) : ""; });
  }

  function mb(n) { return (n / 1048576).toFixed(1) + ' MB'; }

  document.addEventListener('change', function (ev) {
    var input = ev.target;
    if (!input || !input.dataset || !input.dataset.bwcBinaryUpload) return;
    var platform = input.dataset.bwcBinaryUpload;
    var file = input.files && input.files[0];
    if (!file) return;
    var status = document.querySelector('[data-bwc-upload-status="' + platform + '"]');
    var say = function (text, cls) {
      if (!status) return;
      status.textContent = text;
      status.className = 'mt-1 text-xs ' + (cls || 'text-slate-500');
    };

    // 本地先拦一道 —— 让人白传 109MB 再告诉他超限是很不体面的。
    if (file.size > MAX) {
      say(fmt(T.tooBig, { size: mb(file.size), max: mb(MAX) }), 'mt-1 text-xs text-red-600');
      input.value = '';
      return;
    }

    var form = new FormData();
    form.append('binary', file, file.name);

    // 用 XHR 不用 fetch：**fetch 报不了上传进度**。109MB 传着不动的话，
    // 人会以为卡死了然后去刷新页面 —— 而刷新会中断上传。
    var xhr = new XMLHttpRequest();
    xhr.open('POST', '/admin/client-release/' + platform + '/binary');
    // multipart 的 req.body 是 undefined，_csrf 字段读不到 —— 令牌只能走头。
    xhr.setRequestHeader('x-csrf-token', CSRF);
    xhr.withCredentials = true;

    xhr.upload.onprogress = function (e) {
      if (!e.lengthComputable) return;
      var pct = Math.round((e.loaded / e.total) * 100);
      say(fmt(T.uploading, { name: file.name, pct: pct, loaded: mb(e.loaded), total: mb(e.total) }));
    };
    xhr.onerror = function () {
      say(T.networkError, 'mt-1 text-xs text-red-600');
      input.value = '';
    };
    xhr.onload = function () {
      var body = null;
      try { body = JSON.parse(xhr.responseText); } catch (e) {}
      if (xhr.status >= 200 && xhr.status < 300 && body && body.ok) {
        var parts = [fmt(T.saved, { file: body.file, size: mb(body.sizeBytes) })];
        if (body.unverified) parts.push(T.savedUnverified);
        else if (!body.referenced) parts.push(T.savedUnreferenced);
        parts.push(T.savedTail);
        say(parts.join(' '), 'mt-1 text-xs text-emerald-700');
        setTimeout(function () { window.location.reload(); }, 1200);
        return;
      }
      var msg = (body && body.error) || ('HTTP ' + xhr.status);
      // 分辨「谁拦的」——这三种情况的修法完全不同，笼统报一句
      // 「上传失败 HTTP xxx」等于让人去猜。
      var looksHtml = /^\s*<(!doctype|html)/i.test(xhr.responseText || '');
      if (!body && looksHtml) {
        if (xhr.status === 413) {
          // 反向代理自己发的 413：请求根本没到本程序。
          msg = T.proxyBlocked413;
        } else {
          // 最阴的一种：状态码 2xx，body 却是一张 HTML 错误页。
          // 宝塔 WAF 拦大 body 时就是这样（提示「Nginx缓冲区溢出」），
          // 看起来像成功，实际上请求从没到过本程序。
          msg = fmt(T.interceptedHtml, { status: xhr.status });
        }
      }
      say(fmt(T.failed, { msg: msg }), 'mt-1 text-xs text-red-600');
      input.value = '';
    };
    say(fmt(T.starting, { name: file.name }));
    xhr.send(form);
  });
})();
</script>

<%- include('_nav_end') %>
