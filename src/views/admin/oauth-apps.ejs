<%- include('_nav') %>

<h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 mb-2"><%= t("adminOauthApps.heading") %></h1>
<p class="text-sm text-slate-500 mb-6"><%= t("adminOauthApps.lead") %></p>

<% if (!apiEnabled) { %>
  <%# 总闸关着时,下面建的应用一个都用不了 —— 授权页和 token 端点整条回 503。
      默认值就是关的,所以每一台新装的服务器第一次来这儿都会撞上。 %>
  <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 mb-6">
    <h2 class="text-sm font-semibold text-amber-900 mb-1"><%= t("adminOauthApps.masterOff.title") %></h2>
    <p class="text-xs text-amber-800"><%- t("adminOauthApps.masterOff.body") %></p>
  </div>
<% } %>

<% if (issuedSecret) { %>
  <div class="rounded-lg border border-emerald-200 bg-emerald-50 p-4 mb-6">
    <h2 class="text-sm font-semibold text-emerald-900 mb-2"><%= t("adminOauthApps.issued.title") %></h2>
    <div class="text-xs text-emerald-800 mb-2"><%= t("adminOauthApps.issued.hint") %></div>
    <div class="space-y-2">
      <div>
        <div class="text-xs text-slate-500 mb-0.5">client_id</div>
        <code class="block break-all bg-white border border-emerald-200 rounded-md px-3 py-2 text-sm font-mono"><%= issuedClientId %></code>
      </div>
      <div>
        <div class="text-xs text-slate-500 mb-0.5">client_secret</div>
        <code class="block break-all bg-white border border-emerald-200 rounded-md px-3 py-2 text-sm font-mono"><%= issuedSecret %></code>
      </div>
    </div>
  </div>
<% } %>

<!-- Create new -->
<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-3"><%= t("adminOauthApps.create.title") %></h2>
  <form method="post" action="/admin/oauth-apps" class="space-y-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <label class="text-sm">
        <span class="block font-medium text-slate-700 mb-1"><%= t("adminOauthApps.field.name") %></span>
        <input type="text" name="name" required maxlength="200" placeholder="<%= t("adminOauthApps.namePlaceholder") %>"
               class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" />
      </label>
      <label class="text-sm">
        <span class="block font-medium text-slate-700 mb-1"><%= t("adminOauthApps.field.description") %></span>
        <input type="text" name="description" maxlength="500" placeholder="<%= t("adminOauthApps.descPlaceholder") %>"
               class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" />
      </label>
    </div>
    <label class="text-sm block">
      <span class="block font-medium text-slate-700 mb-1"><%= t("adminOauthApps.field.redirect") %> <span class="text-xs text-slate-400"><%= t("adminOauthApps.redirectHint") %></span></span>
      <textarea name="redirectUris" required rows="3" placeholder="https://app.example.com/oauth/callback"
                class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-mono"></textarea>
    </label>
    <div>
      <span class="block text-sm font-medium text-slate-700 mb-2"><%= t("adminOauthApps.field.scopes") %></span>
      <div class="space-y-1.5">
        <% Object.entries(scopes).forEach(function(entry){ %>
          <label class="flex items-start gap-2 text-sm">
            <input type="checkbox" name="scopes" value="<%= entry[0] %>" <%= entry[0] === 'read:events' ? 'checked' : '' %> class="mt-0.5 h-4 w-4 rounded border-slate-300 accent-brand-600" />
            <span><code class="text-xs bg-slate-100 px-1.5 py-0.5 rounded"><%= entry[0] %></code> · <%= entry[1] %></span>
          </label>
        <% }) %>
      </div>
    </div>
    <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"><%= t("adminOauthApps.create.submit") %></button>
  </form>
</section>

<!-- Existing -->
<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-3"><%= t("adminOauthApps.list.title", { count: apps.length }) %></h2>
  <% if (apps.length === 0) { %>
    <div class="rounded-xl border border-dashed border-slate-200 bg-slate-50/60 px-4 py-8 text-center">
      <div class="text-3xl mb-2">🧩</div>
      <div class="text-sm text-slate-500"><%= t("adminOauthApps.list.empty") %></div>
    </div>
  <% } else { %>
    <ul class="divide-y divide-slate-100">
      <% apps.forEach(function(a){ %>
        <li class="py-3 flex flex-col sm:flex-row sm:items-start gap-2">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-sm font-medium text-slate-800"><%= a.name %></span>
              <% if (!a.enabled) { %><span class="text-xs bg-slate-100 text-slate-500 px-1.5 py-0.5 rounded"><%= t("adminOauthApps.disabledBadge") %></span><% } %>
            </div>
            <% if (a.description) { %><div class="text-xs text-slate-500 mb-1"><%= a.description %></div><% } %>
            <div class="text-xs text-slate-600 mb-1"><code class="bg-slate-50 px-1.5 py-0.5 rounded"><%= a.clientId %></code></div>
            <div class="text-xs text-slate-400">
              <strong><%= t("adminOauthApps.redirects") %></strong> <% a.redirectUriList.forEach(function(u){ %><code class="bg-slate-50 px-1 mr-1"><%= u %></code><% }) %>
            </div>
            <div class="text-xs text-slate-400 mt-1">
              <strong><%= t("adminOauthApps.scopes") %></strong> <% a.scopesList.forEach(function(s){ %><code class="bg-slate-50 px-1 mr-1"><%= s %></code><% }) %>
            </div>
          </div>
          <div class="flex gap-1.5 flex-shrink-0">
            <form method="post" action="/admin/oauth-apps/<%= a.id %>/toggle" class="m-0">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs text-slate-700 hover:bg-slate-50"><%= a.enabled ? t("adminOauthApps.disable") : t("adminOauthApps.enable") %></button>
            </form>
            <form method="post" action="/admin/oauth-apps/<%= a.id %>/delete" class="m-0" data-confirm="<%= t("adminOauthApps.deleteConfirm") %>" data-confirm-danger="1" data-confirm-ok="<%= t("common.delete") %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="rounded-lg border border-red-200 bg-white px-2.5 py-1 text-xs text-red-700 hover:bg-red-50"><%= t("common.delete") %></button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<!-- Integration guide -->
<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-3"><%= t("adminOauthApps.guide.title") %></h2>
  <ol class="space-y-3 text-sm text-slate-700 list-decimal list-inside">
    <li><%= t("adminOauthApps.guide.step1") %><br/>
      <code class="block bg-slate-50 mt-1 p-2 rounded text-xs break-all"><%= baseUrl %>/oauth/authorize?client_id=&lt;client_id&gt;&redirect_uri=&lt;encoded&gt;&response_type=code&scope=read:events&state=&lt;<%= t("adminOauthApps.guide.random") %>&gt;</code>
    </li>
    <li><%- t("adminOauthApps.guide.step2") %></li>
    <li><%= t("adminOauthApps.guide.step3") %><br/>
      <code class="block bg-slate-50 mt-1 p-2 rounded text-xs break-all">POST <%= baseUrl %>/oauth/token<br/>Content-Type: application/x-www-form-urlencoded<br/>grant_type=authorization_code&code=...&client_id=...&client_secret=...&redirect_uri=...</code>
    </li>
    <li><%= t("adminOauthApps.guide.step4") %><br/>
      <code class="block bg-slate-50 mt-1 p-2 rounded text-xs break-all">curl -H "Authorization: Bearer &lt;access_token&gt;" <%= baseUrl %>/api/v1/events</code>
    </li>
  </ol>
  <p class="mt-4 text-xs text-slate-500"><%- t("adminOauthApps.guide.pkce") %></p>
</section>

<%- include('_nav_end') %>
