<%- include('_nav') %>

<h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 mb-2"><%= t("adminApi.heading") %></h1>
<p class="text-sm text-slate-500 mb-6"><%= t("adminApi.lead") %></p>

<% if (!ssoEnabled && apiEnabled) { %>
  <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 mb-6">
    <div class="text-sm font-medium text-amber-900"><%= t("adminApi.ssoSuggestion.title") %></div>
    <div class="mt-1 text-sm text-amber-800"><%- t("adminApi.ssoSuggestion.body") %></div>
  </div>
<% } %>

<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6">
  <div class="flex items-start justify-between gap-3 mb-3">
    <div>
      <h2 class="text-lg font-semibold text-slate-900"><%= t("adminApi.master.heading") %></h2>
      <p class="text-sm text-slate-500 mt-1"><%= t("adminApi.master.desc") %></p>
    </div>
    <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium <%= apiEnabled ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-500' %>">
      <span class="inline-block h-2 w-2 rounded-full <%= apiEnabled ? 'bg-emerald-500' : 'bg-slate-400' %>"></span>
      <%= apiEnabled ? t("adminApi.status.enabled") : t("adminApi.status.disabled") %>
    </span>
  </div>
  <form method="post" action="/admin/api/toggle" class="flex items-center gap-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label class="inline-flex items-center gap-2 cursor-pointer">
      <input type="checkbox" name="enabled" <%= apiEnabled ? "checked" : "" %> class="h-4 w-4 rounded border-slate-300 accent-brand-600" />
      <span class="text-sm text-slate-700"><%= t("adminApi.master.toggleLabel") %></span>
    </label>
    <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"><%= t("common.save") %></button>
  </form>
</section>

<!-- ============ APP 同步主开关（iOS / Android / 桌面 原生客户端） ============ -->
<section id="apps" class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6 scroll-mt-32">
  <div class="flex items-start justify-between gap-3 mb-3">
    <div>
      <h2 class="text-lg font-semibold text-slate-900"><%= t("adminApi.apps.heading") %></h2>
      <p class="text-sm text-slate-500 mt-1"><%= t("adminApi.apps.desc") %></p>
      <ul class="mt-2 text-sm text-slate-500 list-disc list-inside space-y-0.5">
        <li><%= t("adminApi.apps.bullet1") %></li>
        <li><%= t("adminApi.apps.bullet2") %></li>
        <li><%= t("adminApi.apps.bullet3") %></li>
      </ul>
    </div>
    <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium <%= appsEnabled ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-500' %>">
      <span class="inline-block h-2 w-2 rounded-full <%= appsEnabled ? 'bg-emerald-500' : 'bg-slate-400' %>"></span>
      <%= appsEnabled ? t("adminApi.status.enabled") : t("adminApi.status.disabled") %>
    </span>
  </div>
  <form method="post" action="/admin/apps/toggle" class="flex items-center gap-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label class="inline-flex items-center gap-2 cursor-pointer">
      <input type="checkbox" name="enabled" <%= appsEnabled ? "checked" : "" %> class="h-4 w-4 rounded border-slate-300 accent-brand-600" />
      <span class="text-sm text-slate-700"><%= t("adminApi.apps.toggleLabel") %></span>
    </label>
    <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"><%= t("common.save") %></button>
  </form>
  <% if (appsEnabled && typeof deviceCount !== 'undefined') { %>
    <p class="mt-3 text-xs text-slate-500"><%- t("adminApi.apps.deviceCount", { count: deviceCount }) %></p>
  <% } %>
</section>

<section id="qr-login" class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6 scroll-mt-32">
  <div class="flex items-start justify-between gap-3 mb-3">
    <div>
      <h2 class="text-lg font-semibold text-slate-900"><%= t("adminApi.qrLogin.heading") %></h2>
      <p class="text-sm text-slate-500 mt-1"><%= t("adminApi.qrLogin.desc") %></p>
      <ul class="mt-2 text-sm text-slate-500 list-disc list-inside space-y-0.5">
        <li><%= t("adminApi.qrLogin.bullet1") %></li>
        <li><%= t("adminApi.qrLogin.bullet2") %></li>
        <li><%= t("adminApi.qrLogin.bullet3") %></li>
      </ul>
      <p class="mt-2 text-xs text-slate-500"><%= t("adminApi.qrLogin.independence") %></p>
    </div>
    <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium <%= qrLoginEnabled ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-500' %>">
      <span class="inline-block h-2 w-2 rounded-full <%= qrLoginEnabled ? 'bg-emerald-500' : 'bg-slate-400' %>"></span>
      <%= qrLoginEnabled ? t("adminApi.status.enabled") : t("adminApi.status.disabled") %>
    </span>
  </div>
  <form method="post" action="/admin/qr-login/toggle" class="flex items-center gap-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label class="inline-flex items-center gap-2 cursor-pointer">
      <input type="checkbox" name="enabled" <%= qrLoginEnabled ? "checked" : "" %> class="h-4 w-4 rounded border-slate-300 accent-brand-600" />
      <span class="text-sm text-slate-700"><%= t("adminApi.qrLogin.toggleLabel") %></span>
    </label>
    <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"><%= t("common.save") %></button>
  </form>
  <% if (!appsEnabled && qrLoginEnabled) { %>
    <p class="mt-3 text-xs text-amber-700"><%= t("adminApi.qrLogin.needsApps") %></p>
  <% } %>
</section>

<% if (issuedToken) { %>
  <section class="rounded-2xl border-2 border-emerald-300 bg-emerald-50 p-5 sm:p-6 mb-6">
    <div class="text-sm font-medium text-emerald-900 mb-2"><%= t("adminApi.issued.heading", { label: issuedLabel }) %></div>
    <div class="flex items-center gap-2 mb-2">
      <code id="new-token" class="flex-1 block break-all rounded-md bg-white border border-emerald-300 px-3 py-2 text-sm font-mono text-slate-900"><%= issuedToken %></code>
      <button type="button" data-copy-token class="rounded-md bg-white border border-emerald-300 px-3 py-2 text-xs text-emerald-700 hover:bg-emerald-100"><%= t("common.copy") %></button>
    </div>
    <p class="text-xs text-emerald-800"><%= t("adminApi.issued.copyHint") %></p>
  </section>
  <script type="application/json" id="bwc-api-i18n" nonce="<%= cspNonce %>"><%-
  JSON.stringify({
    copySuccess: t("common.copied"),
    copyFailed: t("common.clipboardBlocked"),
  }) %></script>
  <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
    (function(){
      const BWC_I18N = (() => {
        try { return JSON.parse(document.getElementById('bwc-api-i18n').textContent); }
        catch { return {}; }
      })();
      document.querySelector("[data-copy-token]")?.addEventListener("click", async () => {
        const el = document.getElementById("new-token");
        try { await navigator.clipboard.writeText(el.textContent.trim()); window.bwc && window.bwc.toast(BWC_I18N.copySuccess, "success"); }
        catch { window.bwc && window.bwc.toast(BWC_I18N.copyFailed, "error"); }
      });
    })();
  </script>
<% } %>

<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-1"><%= t("adminApi.tokens.heading") %></h2>
  <p class="text-sm text-slate-500 mb-4"><%= t("adminApi.tokens.lead") %></p>

  <% if (!tokens || tokens.length === 0) { %>
    <div class="rounded-lg bg-slate-50 p-4 text-center text-sm text-slate-500"><%= t("adminApi.tokens.empty") %></div>
  <% } else { %>
    <div class="overflow-x-auto -mx-5 sm:mx-0">
      <table class="min-w-full text-sm">
        <thead class="text-xs text-slate-400 uppercase">
          <tr class="border-b border-slate-100">
            <th class="text-left font-medium py-2 px-5 sm:px-0 sm:pr-4"><%= t("adminApi.tokens.col.label") %></th>
            <th class="text-left font-medium py-2 pr-4"><%= t("adminApi.tokens.col.asUser") %></th>
            <th class="text-left font-medium py-2 pr-4"><%= t("adminApi.tokens.col.scope") %></th>
            <th class="text-left font-medium py-2 pr-4"><%= t("adminApi.tokens.col.lastUsed") %></th>
            <th class="text-left font-medium py-2 pr-4"><%= t("adminApi.tokens.col.expiry") %></th>
            <th class="text-right font-medium py-2 px-5 sm:px-0"><%= t("adminApi.tokens.col.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% tokens.forEach(function(tok){ %>
            <tr class="border-b border-slate-50">
              <td class="py-2 px-5 sm:px-0 sm:pr-4">
                <div class="text-slate-900 font-medium"><%= tok.label %></div>
                <code class="text-xs text-slate-500 font-mono">bwc_<%= tok.prefix %>_…</code>
              </td>
              <td class="py-2 pr-4 text-slate-700"><%= tok.userEmail %></td>
              <td class="py-2 pr-4">
                <% if (tok.scope === 'read') { %>
                  <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-700"><%= t("adminApi.tokens.scope.read") %></span>
                <% } else { %>
                  <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-xs text-emerald-700"><%= t("adminApi.tokens.scope.write") %></span>
                <% } %>
              </td>
              <td class="py-2 pr-4 text-xs text-slate-500">
                <% if (tok.lastUsedAtLocal) { %>
                  <%- tok.lastUsedAtLocal %>
                  <% if (tok.lastUsedIp) { %><span class="text-slate-400 font-mono"> · <%= tok.lastUsedIp %></span><% } %>
                <% } else { %>
                  <span class="text-slate-400"><%= t("adminApi.tokens.neverUsed") %></span>
                <% } %>
              </td>
              <td class="py-2 pr-4 text-xs">
                <%
                  // Color-code the expiry badge by urgency. Buckets chosen so a
                  // weekly dashboard glance catches anything that'll bite next
                  // week. Tokens with no expiry get a soft "永久" so they don't
                  // disappear visually, but they're also flagged below with
                  // a faint rotation reminder.
                  let _expBadge = '';
                  if (tok.daysUntilExpiry === null) {
                    _expBadge = '<span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-slate-600">' + t("adminApi.tokens.daysUntilExpiry.never") + '</span>';
                  } else if (tok.daysUntilExpiry < 0) {
                    _expBadge = '<span class="inline-flex items-center rounded-full bg-red-50 px-2 py-0.5 text-red-700">' + t("adminApi.tokens.daysUntilExpiry.expired", { n: Math.abs(tok.daysUntilExpiry) }) + '</span>';
                  } else if (tok.daysUntilExpiry <= 7) {
                    _expBadge = '<span class="inline-flex items-center rounded-full bg-red-50 px-2 py-0.5 text-red-700">' + t("adminApi.tokens.daysUntilExpiry.soon", { n: tok.daysUntilExpiry }) + '</span>';
                  } else if (tok.daysUntilExpiry <= 30) {
                    _expBadge = '<span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-amber-700">' + t("adminApi.tokens.daysUntilExpiry.soon", { n: tok.daysUntilExpiry }) + '</span>';
                  } else {
                    _expBadge = '<span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-emerald-700">' + t("adminApi.tokens.daysUntilExpiry.soon", { n: tok.daysUntilExpiry }) + '</span>';
                  }
                %>
                <%- _expBadge %>
                <% if (tok.expiresAtLocal) { %>
                  <div class="text-xs text-slate-400 mt-0.5"><%- tok.expiresAtLocal %></div>
                <% } %>
              </td>
              <td class="py-2 px-5 sm:px-0 text-right">
                <form method="post" action="/admin/api/tokens/<%= tok.id %>/rotate" class="m-0 inline-block"
                      data-confirm="<%= t("adminApi.tokens.rotate.confirm", { label: tok.label }) %>" data-confirm-ok="<%= t("adminApi.tokens.rotate.confirmOk") %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="graceDays" value="7" />
                  <button type="submit" class="text-xs text-brand-600 hover:text-brand-700 mr-2"><%= t("adminApi.tokens.rotate.button") %></button>
                </form>
                <form method="post" action="/admin/api/tokens/<%= tok.id %>/revoke" class="m-0 inline-block"
                      data-confirm="<%= t("adminApi.tokens.revoke.confirm", { label: tok.label }) %>" data-confirm-danger="1" data-confirm-ok="<%= t("adminApi.tokens.revoke.confirmOk") %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="text-xs text-red-600 hover:text-red-700"><%= t("adminApi.tokens.revoke.button") %></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-3"><%= t("adminApi.issue.heading") %></h2>
  <form method="post" action="/admin/api/tokens" class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-2xl">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label class="text-sm sm:col-span-2">
      <span class="block font-medium text-slate-700 mb-1"><%= t("adminApi.issue.labelField") %> <span class="text-xs text-slate-400"><%= t("adminApi.issue.labelHint") %></span></span>
      <input type="text" name="label" required maxlength="80"
             class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
    </label>
    <label class="text-sm">
      <span class="block font-medium text-slate-700 mb-1"><%= t("adminApi.issue.userField") %></span>
      <select name="userId" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100">
        <% allUsers.forEach(function(u){ %>
          <option value="<%= u.id %>"><%= u.email %><%= u.displayName ? ' (' + u.displayName + ')' : '' %></option>
        <% }) %>
      </select>
    </label>
    <label class="text-sm">
      <span class="block font-medium text-slate-700 mb-1"><%= t("adminApi.issue.scopeField") %></span>
      <select name="scope" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100">
        <option value="write" selected><%= t("adminApi.issue.scope.write") %></option>
        <option value="read"><%= t("adminApi.issue.scope.read") %></option>
      </select>
    </label>
    <label class="text-sm sm:col-span-2">
      <span class="block font-medium text-slate-700 mb-1"><%= t("adminApi.issue.expiryField") %> <span class="text-xs text-slate-400"><%= t("adminApi.issue.expiryHint") %></span></span>
      <input type="number" name="expiresInDays" value="0" min="0" max="3650"
             class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
    </label>
    <div class="sm:col-span-2 flex justify-end">
      <button type="submit" class="rounded-lg bg-brand-600 px-5 py-2 text-sm font-medium text-white hover:bg-brand-700"<%= apiEnabled ? '' : ' disabled title="' + t("adminApi.issue.disabledTitle") + '"' %>>
        <%= t("adminApi.issue.submit") %>
      </button>
    </div>
  </form>
</section>

<section id="idp" class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-1">外部 IdP(Keycloak)API 接入</h2>
  <p class="text-sm text-slate-500 mb-4">让外部平台用 Keycloak 签发的访问令牌直接调用本站 <code class="px-1 bg-slate-100 rounded">/api/v1</code>(ByWave 作为 OAuth resource server,用 Keycloak 的 JWKS 校验令牌)。</p>

  <% if (!idpApi.ssoConfigured) { %>
    <div class="rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800 mb-4">
      还没有启用任何 SSO 提供方。请先到 <a href="/admin/idp" class="underline">SSO 设置</a> 配置好 Keycloak,这里才能生效。
    </div>
  <% } %>

  <form method="post" action="/admin/api/idp" class="space-y-4 max-w-2xl">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label class="flex items-start gap-2">
      <input type="checkbox" name="enabled" <%= idpApi.enabled ? 'checked' : '' %> class="mt-0.5 h-4 w-4 rounded border-slate-300 accent-brand-600" />
      <span class="text-sm"><span class="font-medium text-slate-700">接受 Keycloak 令牌调用 API</span><span class="block text-xs text-slate-500 mt-0.5">关闭时,所有外部 IdP 令牌一律 403。需先在「API」总开关打开的前提下生效。</span></span>
    </label>
    <label class="block text-sm">
      <span class="block font-medium text-slate-700 mb-1">受信任的服务端 Client ID <span class="text-xs text-slate-400">(逗号分隔,可空)</span></span>
      <input type="text" name="serviceClients" value="<%= idpApi.serviceClients %>" placeholder="meeting-platform, another-service"
             class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
      <span class="text-xs text-slate-400 mt-1 block">这些 Keycloak client 签发的令牌,可带 <code class="px-1 bg-slate-100 rounded">X-Account</code> 头代<strong>任意</strong>账号读写(给会议平台这类服务端集成用)。<strong>普通用户登录令牌</strong>只能操作自己邮箱对应的账号,带 X-Account 指别人会被拒。</span>
    </label>
    <label class="flex items-start gap-2">
      <input type="checkbox" name="autoProvision" <%= idpApi.autoProvision ? 'checked' : '' %> class="mt-0.5 h-4 w-4 rounded border-slate-300 accent-brand-600" />
      <span class="text-sm"><span class="font-medium text-slate-700">自动开通账号</span><span class="block text-xs text-slate-500 mt-0.5">受信任服务端用 X-Account 指定一个还<strong>不存在</strong>的邮箱时,自动创建 ByWave 账号(批量开通用;无密码,只能经 IdP 进)。</span></span>
    </label>
    <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">保存外部 IdP 设置</button>
  </form>

  <div class="mt-5 border-t border-slate-100 pt-4 text-xs text-slate-500 space-y-1">
    <div class="font-medium text-slate-700">外部平台怎么调用:</div>
    <pre class="overflow-x-auto rounded bg-slate-50 border border-slate-200 p-3 font-mono"># 服务端先用 Keycloak client 拿到 access_token,再:
curl -H "Authorization: Bearer &lt;keycloak_access_token&gt;" \
     -H "X-Account: user@example.com" \
     <%= baseUrl %>/api/v1/events</pre>
    <div>· 令牌的 <code class="px-1 bg-slate-100 rounded">iss</code> 必须匹配某个已启用的 SSO 提供方,签名用其 JWKS 校验。</div>
    <div>· 普通用户令牌不需要 X-Account,只能读写自己账号。</div>

    <div class="font-medium text-slate-700 mt-3">批量管理账号(仅服务端 client,<strong>不带 X-Account</strong>):</div>
    <pre class="overflow-x-auto rounded bg-slate-50 border border-slate-200 p-3 font-mono"># 列出账号(把会议平台用户名册同步到 ByWave)
curl -H "Authorization: Bearer &lt;service_token&gt;" "<%= baseUrl %>/api/v1/accounts?limit=200&q=keyword"
# 主动开通账号(需勾选上方「自动开通账号」;已存在则返回 created:false)
curl -X POST -H "Authorization: Bearer &lt;service_token&gt;" -H "Content-Type: application/json" \
     -d '{"email":"u@example.com","displayName":"U"}' <%= baseUrl %>/api/v1/accounts</pre>
    <div>· <code class="px-1 bg-slate-100 rounded">/api/v1/accounts</code> 只接受白名单<strong>服务端 client</strong> 令牌,普通用户令牌会被拒(防止有人列举/创建账号)。</div>
    <div>· 日历变动会自动推送到你注册的 <a href="/admin/webhooks" class="underline">Webhook</a>(<code class="px-1 bg-slate-100 rounded">event.created/updated/deleted</code>),会议平台据此实时同步。</div>
  </div>
</section>

<section class="rounded-2xl border border-slate-200 bg-slate-50 p-5 sm:p-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-3"><%= t("adminApi.examples.heading") %></h2>
  <p class="text-sm text-slate-500 mb-3"><%= t("adminApi.examples.headerHint") %> <code class="rounded bg-white border border-slate-200 px-1.5 py-0.5 text-xs font-mono">Authorization: Bearer &lt;token&gt;</code></p>
  <div class="space-y-3 text-xs">
    <details>
      <summary class="cursor-pointer font-medium text-slate-700"><%= t("adminApi.examples.listCalendars") %></summary>
      <pre class="mt-2 overflow-x-auto rounded bg-white border border-slate-200 p-3 font-mono">curl -H "Authorization: Bearer &lt;token&gt;" \
  <%= baseUrl %>/api/calendars</pre>
    </details>
    <details>
      <summary class="cursor-pointer font-medium text-slate-700"><%= t("adminApi.examples.queryEvents") %></summary>
      <pre class="mt-2 overflow-x-auto rounded bg-white border border-slate-200 p-3 font-mono">curl -H "Authorization: Bearer &lt;token&gt;" \
  "<%= baseUrl %>/api/events?from=2026-05-01T00:00:00Z&to=2026-06-01T00:00:00Z"</pre>
    </details>
    <details>
      <summary class="cursor-pointer font-medium text-slate-700"><%= t("adminApi.examples.createEvent") %></summary>
      <pre class="mt-2 overflow-x-auto rounded bg-white border border-slate-200 p-3 font-mono">curl -X POST -H "Authorization: Bearer &lt;token&gt;" \
  -H "Content-Type: application/json" \
