<%- include('_nav') %>

<div class="flex flex-wrap items-end justify-between gap-3 mb-1">
  <h1 class="text-2xl sm:text-3xl font-semibold text-slate-900">审计日志</h1>
  <span class="text-sm text-slate-500">共 <strong class="text-slate-700"><%= total %></strong> 条记录</span>
</div>
<p class="text-sm text-slate-500 mb-5">所有管理员级别的操作（签发/撤销 token、备份恢复、系统更新、配置与安全改动等）都会写入这里，可追溯「谁、在何时、从哪个 IP、做了什么」。</p>

<!-- Filter bar -->
<form method="get" action="/admin/audit" class="mb-5 grid grid-cols-1 sm:grid-cols-[180px_1fr_1fr_auto] gap-2">
  <select name="cat" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100">
    <option value="">全部类别</option>
    <% categories.forEach(function(c){ %>
      <option value="<%= c.key %>" <%= filter.cat === c.key ? "selected" : "" %>><%= c.label %> (<%= c.count %>)</option>
    <% }) %>
  </select>
  <input type="text" name="actor" value="<%= filter.actor %>" placeholder="操作员邮箱…"
         class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
  <input type="text" name="q" value="<%= filter.q %>" placeholder="搜索动作 / 目标…"
         class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
  <div class="flex gap-2">
    <button type="submit" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700 whitespace-nowrap">筛选</button>
    <% if (filter.cat || filter.actor || filter.q) { %>
      <a href="/admin/audit" class="inline-flex items-center justify-center rounded-lg border border-slate-300 px-4 py-2 text-sm text-slate-600 hover:bg-slate-50 whitespace-nowrap">重置</a>
    <% } %>
  </div>
</form>

<% if (entries.length === 0) { %>
  <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-sm text-slate-500">
    <% if (filter.cat || filter.actor || filter.q) { %>
      没有匹配的审计记录。<a href="/admin/audit" class="text-brand-600 hover:underline">清除筛选</a>
    <% } else { %>
      还没有审计记录 —— 做点管理员操作就会出现。
    <% } %>
  </div>
<% } else { %>
  <div class="rounded-2xl border border-slate-200 bg-white overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="bg-slate-50 border-b border-slate-200">
          <tr class="text-left text-xs uppercase tracking-wide text-slate-500">
            <th class="px-4 py-3">时间</th>
            <th class="px-4 py-3">操作员</th>
            <th class="px-4 py-3">动作</th>
            <th class="px-4 py-3">目标</th>
            <th class="px-4 py-3">IP</th>
            <th class="px-4 py-3">详情</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% entries.forEach(function(e){ %>
            <tr class="hover:bg-slate-50/50 align-top">
              <td class="px-4 py-3 text-xs text-slate-500 whitespace-nowrap"><%- e.createdAtIso %></td>
              <td class="px-4 py-3 text-slate-700 max-w-[200px] truncate" title="<%= e.actorEmail || '已删除用户' %>"><%= e.actorEmail || '— 已删除用户' %></td>
              <td class="px-4 py-3 whitespace-nowrap">
                <span class="inline-block rounded-full px-2 py-0.5 text-[11px] font-medium <%= e.cat.badge %> mr-1.5"><%= e.cat.label %></span>
                <code class="text-xs text-slate-500 font-mono"><%= e.action %></code>
              </td>
              <td class="px-4 py-3 text-xs text-slate-500">
                <% if (e.targetType) { %>
                  <%= e.targetType %><% if (e.targetId) { %> · <code class="font-mono"><%= String(e.targetId).slice(0, 8) %>…</code><% } %>
                <% } else { %>—<% } %>
              </td>
              <td class="px-4 py-3 text-xs text-slate-500 font-mono whitespace-nowrap"><%= e.ip %></td>
              <td class="px-4 py-3">
                <% if (e.detailsJson) { %>
                  <details>
                    <summary class="text-xs text-brand-600 hover:text-brand-700 cursor-pointer select-none">查看</summary>
                    <pre class="mt-2 text-[10px] bg-slate-50 border border-slate-200 rounded p-2 font-mono whitespace-pre-wrap break-all max-w-[400px]"><%= e.detailsJson %></pre>
                  </details>
                <% } else { %><span class="text-xs text-slate-400">—</span><% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) {
       var baseQ = [];
       if (filter.cat) baseQ.push('cat=' + encodeURIComponent(filter.cat));
       if (filter.actor) baseQ.push('actor=' + encodeURIComponent(filter.actor));
       if (filter.q) baseQ.push('q=' + encodeURIComponent(filter.q));
       var prefix = baseQ.length ? ('?' + baseQ.join('&') + '&') : '?';
  %>
  <div class="mt-4 flex items-center justify-between text-sm">
    <span class="text-slate-500">第 <%= page %> / <%= totalPages %> 页</span>
    <div class="flex gap-2">
      <% if (page > 1) { %>
        <a href="<%= prefix %>page=<%= page - 1 %>" class="rounded-lg border border-slate-300 px-3 py-1.5 text-slate-600 hover:bg-slate-50">上一页</a>
      <% } else { %>
        <span class="rounded-lg border border-slate-200 px-3 py-1.5 text-slate-300 cursor-not-allowed">上一页</span>
      <% } %>
      <% if (page < totalPages) { %>
        <a href="<%= prefix %>page=<%= page + 1 %>" class="rounded-lg border border-slate-300 px-3 py-1.5 text-slate-600 hover:bg-slate-50">下一页</a>
      <% } else { %>
        <span class="rounded-lg border border-slate-200 px-3 py-1.5 text-slate-300 cursor-not-allowed">下一页</span>
      <% } %>
    </div>
  </div>
  <% } %>
<% } %>
