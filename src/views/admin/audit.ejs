<%- include('_nav') %>

<h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 mb-2">审计日志</h1>
<p class="text-sm text-slate-500 mb-6">所有 admin 级别的操作（签发/撤销 API token、备份恢复、系统更新、配置改动等）都会写入这里。仅保留最近 200 条；如果需要长期留存请定期下载备份。</p>

<% if (entries.length === 0) { %>
  <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-sm text-slate-500">
    还没有审计记录 —— 做点管理员操作就会出现。
  </div>
<% } else { %>
  <div class="rounded-2xl border border-slate-200 bg-white overflow-hidden">
    <table class="min-w-full text-sm">
      <thead class="bg-slate-50 border-b border-slate-200">
        <tr class="text-left text-xs uppercase tracking-wide text-slate-500">
          <th class="px-4 py-3">时间</th>
          <th class="px-4 py-3">操作员</th>
          <th class="px-4 py-3">动作</th>
          <th class="px-4 py-3">目标</th>
          <th class="px-4 py-3">IP</th>
          <th class="px-4 py-3">详情</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% entries.forEach(function(e){ %>
          <tr class="hover:bg-slate-50/50">
            <td class="px-4 py-3 text-xs text-slate-500 whitespace-nowrap"><%- e.createdAtIso %></td>
            <td class="px-4 py-3 text-slate-700 max-w-[200px] truncate" title="<%= e.actorEmail %>"><%= e.actorEmail %></td>
            <td class="px-4 py-3"><code class="text-xs bg-slate-100 px-1.5 py-0.5 rounded font-mono"><%= e.action %></code></td>
            <td class="px-4 py-3 text-xs text-slate-500">
              <% if (e.targetType) { %>
                <%= e.targetType %><% if (e.targetId) { %> · <code class="font-mono"><%= e.targetId.slice(0, 8) %>…</code><% } %>
              <% } else { %>—<% } %>
            </td>
            <td class="px-4 py-3 text-xs text-slate-500 font-mono"><%= e.ip %></td>
            <td class="px-4 py-3">
              <% if (e.detailsJson) { %>
                <details>
                  <summary class="text-xs text-brand-600 hover:text-brand-700 cursor-pointer">查看</summary>
                  <pre class="mt-2 text-[10px] bg-slate-50 border border-slate-200 rounded p-2 font-mono whitespace-pre-wrap break-all max-w-[400px]"><%= e.detailsJson %></pre>
                </details>
              <% } else { %><span class="text-xs text-slate-400">—</span><% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
