<%- include('_nav') %>

<div class="flex flex-wrap items-end justify-between gap-3 mb-1">
  <h1 class="text-2xl sm:text-3xl font-semibold text-slate-900"><%= t("adminAudit.heading") %></h1>
  <span class="text-sm text-slate-500"><%= t("adminAudit.totalPrefix") %> <strong class="text-slate-700"><%= total %></strong> <%= t("adminAudit.totalSuffix") %></span>
</div>
<p class="text-sm text-slate-500 mb-5"><%= t("adminAudit.lead") %></p>

<!-- Sign-in failure aggregation (sampled auth-failure rows, exact totals) -->
<div class="rounded-2xl border border-slate-200 bg-white p-5 mb-5">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-1">
    <h2 class="text-base font-semibold text-slate-900"><%= t("adminAudit.failures.title") %></h2>
    <div class="flex gap-1.5 text-xs">
      <% [["24h", t("adminAudit.failures.window24h")], ["7d", t("adminAudit.failures.window7d")], ["30d", t("adminAudit.failures.window30d")]].forEach(function(w){ %>
        <% if (failureAgg.window === w[0]) { %>
          <span class="rounded-full bg-slate-900 px-2.5 py-1 font-medium text-white"><%= w[1] %></span>
        <% } else { %>
          <a href="/admin/audit?fw=<%= w[0] %>" class="rounded-full border border-slate-300 px-2.5 py-1 text-slate-600 hover:bg-slate-50"><%= w[1] %></a>
        <% } %>
      <% }) %>
    </div>
  </div>
  <p class="text-sm text-slate-500 mb-4"><%= t("adminAudit.failures.lead") %></p>
  <% if (failureAgg.byAccount.length === 0 && failureAgg.byIp.length === 0) { %>
    <p class="text-sm text-slate-400"><%= t("adminAudit.failures.empty") %></p>
  <% } else { %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
    <div>
      <h3 class="text-sm font-medium text-slate-700 mb-2"><%= t("adminAudit.failures.byAccount") %></h3>
      <table class="min-w-full text-sm">
        <thead>
          <tr class="text-left text-xs uppercase tracking-wide text-slate-500 border-b border-slate-200">
            <th class="py-2 pr-3"><%= t("adminAudit.failures.colAccount") %></th>
            <th class="py-2 pr-3"><%= t("adminAudit.failures.colFailures") %></th>
            <th class="py-2 pr-3"><%= t("adminAudit.failures.colIps") %></th>
            <th class="py-2"><%= t("adminAudit.failures.colLast") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% failureAgg.byAccount.forEach(function(r){ %>
            <tr>
              <td class="py-2 pr-3 text-slate-700 max-w-[220px] truncate" title="<%= r.account %>"><%= r.account %></td>
              <td class="py-2 pr-3 font-medium text-slate-900"><%= r.failures %></td>
              <td class="py-2 pr-3 text-slate-500"><%= r.ips %></td>
              <td class="py-2 text-xs text-slate-500 whitespace-nowrap"><%- r.lastAtIso %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div>
      <h3 class="text-sm font-medium text-slate-700 mb-2"><%= t("adminAudit.failures.byIp") %></h3>
      <table class="min-w-full text-sm">
        <thead>
          <tr class="text-left text-xs uppercase tracking-wide text-slate-500 border-b border-slate-200">
            <th class="py-2 pr-3"><%= t("adminAudit.failures.colIp") %></th>
            <th class="py-2 pr-3"><%= t("adminAudit.failures.colFailures") %></th>
            <th class="py-2 pr-3"><%= t("adminAudit.failures.colAccounts") %></th>
            <th class="py-2"><%= t("adminAudit.failures.colLast") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% failureAgg.byIp.forEach(function(r){ %>
            <tr>
              <td class="py-2 pr-3 text-slate-700 font-mono text-xs"><%= r.ip %></td>
              <td class="py-2 pr-3 font-medium text-slate-900"><%= r.failures %></td>
              <td class="py-2 pr-3 text-slate-500"><%= r.accounts %></td>
              <td class="py-2 text-xs text-slate-500 whitespace-nowrap"><%- r.lastAtIso %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>
</div>

<!-- Filter bar -->
<form method="get" action="/admin/audit" class="mb-5 grid grid-cols-1 sm:grid-cols-[180px_1fr_1fr_auto] gap-2">
  <select name="cat" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100">
    <option value=""><%= t("adminAudit.filter.all") %></option>
    <% categories.forEach(function(c){ %>
      <option value="<%= c.key %>" <%= filter.cat === c.key ? "selected" : "" %>><%= c.label %> (<%= c.count %>)</option>
    <% }) %>
  </select>
  <input type="text" name="actor" value="<%= filter.actor %>" placeholder="<%= t("adminAudit.filter.actorPh") %>"
         class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
  <input type="text" name="q" value="<%= filter.q %>" placeholder="<%= t("adminAudit.filter.qPh") %>"
         class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
  <div class="flex gap-2">
    <button type="submit" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700 whitespace-nowrap"><%= t("adminAudit.filter.submit") %></button>
    <% if (filter.cat || filter.actor || filter.q) { %>
      <a href="/admin/audit" class="inline-flex items-center justify-center rounded-lg border border-slate-300 px-4 py-2 text-sm text-slate-600 hover:bg-slate-50 whitespace-nowrap"><%= t("adminAudit.filter.reset") %></a>
    <% } %>
  </div>
</form>

<% if (entries.length === 0) { %>
  <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-sm text-slate-500">
    <% if (filter.cat || filter.actor || filter.q) { %>
      <%= t("adminAudit.empty.filtered") %><a href="/admin/audit" class="text-brand-600 hover:underline"><%= t("adminAudit.clearFilters") %></a>
    <% } else { %>
      <%= t("adminAudit.empty.none") %>
    <% } %>
  </div>
<% } else { %>
  <div class="rounded-2xl border border-slate-200 bg-white overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="bg-slate-50 border-b border-slate-200">
          <tr class="text-left text-xs uppercase tracking-wide text-slate-500">
            <th class="px-4 py-3"><%= t("adminAudit.col.time") %></th>
            <th class="px-4 py-3"><%= t("adminAudit.col.actor") %></th>
            <th class="px-4 py-3"><%= t("adminAudit.col.action") %></th>
            <th class="px-4 py-3"><%= t("adminAudit.col.target") %></th>
            <th class="px-4 py-3">IP</th>
            <th class="px-4 py-3"><%= t("adminAudit.col.details") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% entries.forEach(function(e){ %>
            <tr class="hover:bg-slate-50/50 align-top">
              <td class="px-4 py-3 text-xs text-slate-500 whitespace-nowrap"><%- e.createdAtIso %></td>
              <td class="px-4 py-3 text-slate-700 max-w-[200px] truncate" title="<%= e.actorEmail || t("adminAudit.deletedUser") %>"><%= e.actorEmail || ('— ' + t("adminAudit.deletedUser")) %></td>
              <td class="px-4 py-3 whitespace-nowrap">
                <span class="inline-block whitespace-nowrap rounded-full px-2 py-0.5 text-[11px] font-medium <%= e.cat.badge %> mr-1.5"><%= e.cat.label %></span>
                <code class="text-xs text-slate-500 font-mono"><%= e.action %></code>
              </td>
              <td class="px-4 py-3 text-xs text-slate-500">
                <% if (e.targetType) { %>
                  <%= e.targetType %><% if (e.targetId) { %> · <code class="font-mono"><%= String(e.targetId).slice(0, 8) %>…</code><% } %>
                <% } else { %>—<% } %>
              </td>
              <td class="px-4 py-3 text-xs text-slate-500 font-mono whitespace-nowrap"><%= e.ip %></td>
              <td class="px-4 py-3">
                <% if (e.detailsJson) { %>
                  <details>
                    <summary class="text-xs text-brand-600 hover:text-brand-700 cursor-pointer select-none"><%= t("adminAudit.view") %></summary>
                    <pre class="mt-2 text-[10px] bg-slate-50 border border-slate-200 rounded p-2 font-mono whitespace-pre-wrap break-all max-w-[400px]"><%= e.detailsJson %></pre>
                  </details>
                <% } else { %><span class="text-xs text-slate-400">—</span><% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) {
       var baseQ = [];
       if (filter.cat) baseQ.push('cat=' + encodeURIComponent(filter.cat));
       if (filter.actor) baseQ.push('actor=' + encodeURIComponent(filter.actor));
       if (filter.q) baseQ.push('q=' + encodeURIComponent(filter.q));
       var prefix = baseQ.length ? ('?' + baseQ.join('&') + '&') : '?';
  %>
  <div class="mt-4 flex items-center justify-between text-sm">
    <span class="text-slate-500"><%= t("adminAudit.page", { page: page, totalPages: totalPages }) %></span>
    <div class="flex gap-2">
      <% if (page > 1) { %>
        <a href="<%= prefix %>page=<%= page - 1 %>" class="rounded-lg border border-slate-300 px-3 py-1.5 text-slate-600 hover:bg-slate-50"><%= t("adminAudit.prev") %></a>
      <% } else { %>
        <span class="rounded-lg border border-slate-200 px-3 py-1.5 text-slate-300 cursor-not-allowed"><%= t("adminAudit.prev") %></span>
      <% } %>
      <% if (page < totalPages) { %>
        <a href="<%= prefix %>page=<%= page + 1 %>" class="rounded-lg border border-slate-300 px-3 py-1.5 text-slate-600 hover:bg-slate-50"><%= t("adminAudit.next") %></a>
      <% } else { %>
        <span class="rounded-lg border border-slate-200 px-3 py-1.5 text-slate-300 cursor-not-allowed"><%= t("adminAudit.next") %></span>
      <% } %>
    </div>
  </div>
  <% } %>
<% } %>

<%- include('_nav_end') %>
