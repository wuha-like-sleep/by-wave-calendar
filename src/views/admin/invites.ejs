<%- include('_nav') %>

<h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 mb-2"><%= t("adminInvites.heading") %></h1>
<p class="text-sm text-slate-500 mb-6"><%= t("adminInvites.lead") %></p>

<%
  function fmtDate(d) {
    if (!d) return "—";
    const x = new Date(d);
    const p = (n) => String(n).padStart(2, "0");
    return `${x.getFullYear()}-${p(x.getMonth() + 1)}-${p(x.getDate())} ${p(x.getHours())}:${p(x.getMinutes())}`;
  }
  function inviteState(inv) {
    if (inv.revokedAt) return { key: "revoked", label: t("adminInvites.state.revoked"), cls: "bg-slate-100 text-slate-500" };
    if (inv.expiresAt && new Date(inv.expiresAt).getTime() < Date.now()) return { key: "expired", label: t("adminInvites.state.expired"), cls: "bg-amber-50 text-amber-700" };
    if (inv.usedCount >= inv.maxUses) return { key: "exhausted", label: t("adminInvites.state.exhausted"), cls: "bg-slate-100 text-slate-500" };
    return { key: "active", label: t("adminInvites.state.active"), cls: "bg-emerald-50 text-emerald-700" };
  }
%>

<% if (settings.registrationMode !== "invite") { %>
  <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 mb-6">
    <div class="text-sm font-medium text-amber-900"><%= t("adminInvites.modeWarn.title") %></div>
    <div class="mt-1 text-sm text-amber-800">
      <%- t("adminInvites.modeWarn.body", { mode: settings.registrationMode === "public" ? t("adminInvites.mode.public") : t("adminInvites.mode.closed") }) %>
    </div>
  </div>
<% } %>

<!-- Create invite -->
<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-1"><%= t("adminInvites.create.title") %></h2>
  <p class="text-sm text-slate-500 mb-4"><%- t("adminInvites.create.desc") %></p>
  <form method="post" action="/admin/invites" class="space-y-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="block text-sm font-medium text-slate-700"><%= t("adminInvites.field.email") %> <span class="text-slate-400 font-normal"><%= t("adminInvites.optional") %></span></label>
        <input type="email" name="email" autocomplete="off" placeholder="someone@example.com"
               class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700"><%= t("adminInvites.field.note") %> <span class="text-slate-400 font-normal"><%= t("adminInvites.optional") %></span></label>
        <input type="text" name="note" maxlength="200" placeholder="<%= t("adminInvites.notePlaceholder") %>"
               class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700"><%= t("adminInvites.field.maxUses") %></label>
        <input type="number" name="maxUses" min="1" max="1000" value="1"
               class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
        <p class="mt-1 text-xs text-slate-400"><%= t("adminInvites.maxUsesHint") %></p>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700"><%= t("adminInvites.field.expires") %></label>
        <input type="number" name="expiresInDays" min="0" max="365" value="7" placeholder="<%= t("adminInvites.expiresPlaceholder") %>"
               class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
        <p class="mt-1 text-xs text-slate-400"><%= t("adminInvites.expiresHint") %></p>
      </div>
    </div>
    <label class="inline-flex items-center gap-2 cursor-pointer">
      <input type="checkbox" name="sendEmail" class="h-4 w-4 rounded border-slate-300 accent-brand-600" />
      <span class="text-sm text-slate-700"><%= t("adminInvites.sendNow") %></span>
    </label>
    <div class="flex justify-end">
      <button type="submit" class="rounded-lg bg-brand-600 px-5 py-2 text-sm font-medium text-white hover:bg-brand-700"><%= t("adminInvites.create.submit") %></button>
    </div>
  </form>
</section>

<!-- Existing invites -->
<section id="list" class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-4"><%= t("adminInvites.list.title", { count: invites.length }) %></h2>
  <% if (!invites.length) { %>
    <p class="text-sm text-slate-500"><%= t("adminInvites.list.empty") %></p>
  <% } else { %>
    <div class="-mx-5 sm:mx-0 overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="text-left text-xs uppercase tracking-wide text-slate-400 border-b border-slate-200">
            <th class="px-3 py-2 font-medium"><%= t("adminInvites.col.status") %></th>
            <th class="px-3 py-2 font-medium"><%= t("adminInvites.col.email") %></th>
            <th class="px-3 py-2 font-medium"><%= t("adminInvites.col.usage") %></th>
            <th class="px-3 py-2 font-medium"><%= t("adminInvites.col.expires") %></th>
            <th class="px-3 py-2 font-medium"><%= t("adminInvites.col.created") %></th>
            <th class="px-3 py-2 font-medium text-right"><%= t("adminInvites.col.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% invites.forEach(function (inv) { const st = inviteState(inv); const url = baseUrl + "/register?invite=" + inv.token; %>
            <tr>
              <td class="px-3 py-3 align-top">
                <span class="inline-flex items-center whitespace-nowrap rounded-full px-2.5 py-0.5 text-xs font-medium <%= st.cls %>"><%= st.label %></span>
              </td>
              <td class="px-3 py-3 align-top">
                <div class="font-medium text-slate-800"><%= inv.email || t("adminInvites.anyEmail") %></div>
                <% if (inv.note) { %><div class="text-xs text-slate-400 mt-0.5"><%= inv.note %></div><% } %>
              </td>
              <td class="px-3 py-3 align-top text-slate-600"><%= inv.usedCount %> / <%= inv.maxUses %></td>
              <td class="px-3 py-3 align-top text-slate-600"><%= inv.expiresAt ? fmtDate(inv.expiresAt) : t("adminInvites.never") %></td>
              <td class="px-3 py-3 align-top text-slate-500"><%= fmtDate(inv.createdAt) %></td>
              <td class="px-3 py-3 align-top">
                <div class="flex flex-wrap items-center justify-end gap-2">
                  <% if (st.key === "active") { %>
                    <button type="button"
                            data-bwc-copy="<%= url %>" data-bwc-copy-msg="<%= t("app.js.copy.invite") %>"
                            class="rounded-md border border-slate-300 px-2.5 py-1 text-xs text-slate-700 hover:bg-slate-50"><%= t("adminInvites.copyLink") %></button>
                    <form method="post" action="/admin/invites/<%= inv.token %>/email" class="inline-flex items-center gap-1">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <% if (!inv.email) { %>
                      <input type="email" name="to" required placeholder="<%= t("adminInvites.sendTo") %>" class="w-36 rounded-md border border-slate-300 bg-white px-2 py-1 text-xs focus:border-brand-500 focus:outline-none" />
                      <% } %>
                      <button type="submit" class="rounded-md border border-slate-300 px-2.5 py-1 text-xs text-slate-700 hover:bg-slate-50"><%= t("adminInvites.sendMail") %></button>
                    </form>
                    <form method="post" action="/admin/invites/<%= inv.token %>/revoke" class="inline"
                          data-confirm="<%= t("adminInvites.revokeConfirm") %>" data-confirm-danger="1">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="rounded-md border border-rose-200 px-2.5 py-1 text-xs text-rose-600 hover:bg-rose-50"><%= t("adminInvites.revoke") %></button>
                    </form>
                  <% } else { %>
                    <span class="text-xs text-slate-400">—</span>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('_nav_end') %>
