<%- include('_nav') %>

<h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 mb-2">邀请注册</h1>
<p class="text-sm text-slate-500 mb-6">当站点注册模式设为「仅邀请」时，只有持有有效邀请链接的人才能注册。在这里生成、撤销邀请链接，或直接发邮件给受邀人。</p>

<%
  function fmtDate(d) {
    if (!d) return "—";
    const x = new Date(d);
    const p = (n) => String(n).padStart(2, "0");
    return `${x.getFullYear()}-${p(x.getMonth() + 1)}-${p(x.getDate())} ${p(x.getHours())}:${p(x.getMinutes())}`;
  }
  function inviteState(inv) {
    if (inv.revokedAt) return { key: "revoked", label: "已撤销", cls: "bg-slate-100 text-slate-500" };
    if (inv.expiresAt && new Date(inv.expiresAt).getTime() < Date.now()) return { key: "expired", label: "已过期", cls: "bg-amber-50 text-amber-700" };
    if (inv.usedCount >= inv.maxUses) return { key: "exhausted", label: "已用完", cls: "bg-slate-100 text-slate-500" };
    return { key: "active", label: "可用", cls: "bg-emerald-50 text-emerald-700" };
  }
%>

<% if (settings.registrationMode !== "invite") { %>
  <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 mb-6">
    <div class="text-sm font-medium text-amber-900">当前注册模式不是「仅邀请」</div>
    <div class="mt-1 text-sm text-amber-800">
      现在的模式是
      <strong><%= settings.registrationMode === "public" ? "公开注册" : "关闭注册" %></strong>，
      邀请链接不会生效。前往 <a href="/admin/site#registration" class="font-medium underline hover:text-amber-900">站点设置</a> 把模式改成「仅邀请」后，这些链接才会成为唯一的注册入口。
    </div>
  </div>
<% } %>

<!-- Create invite -->
<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 mb-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-1">生成邀请链接</h2>
  <p class="text-sm text-slate-500 mb-4">邮箱可留空（任何人都能用此链接注册）；填写邮箱则该链接<strong>仅限该邮箱</strong>注册，更安全。</p>
  <form method="post" action="/admin/invites" class="space-y-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="block text-sm font-medium text-slate-700">受邀邮箱 <span class="text-slate-400 font-normal">（可选）</span></label>
        <input type="email" name="email" autocomplete="off" placeholder="someone@example.com"
               class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700">备注 <span class="text-slate-400 font-normal">（可选）</span></label>
        <input type="text" name="note" maxlength="200" placeholder="例如：张三 / 市场部"
               class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700">可用次数</label>
        <input type="number" name="maxUses" min="1" max="1000" value="1"
               class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
        <p class="mt-1 text-xs text-slate-400">绑定邮箱的邀请建议设为 1。</p>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700">有效期（天）</label>
        <input type="number" name="expiresInDays" min="0" max="365" value="7" placeholder="0 = 永久"
               class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
        <p class="mt-1 text-xs text-slate-400">填 0 表示永不过期。</p>
      </div>
    </div>
    <label class="inline-flex items-center gap-2 cursor-pointer">
      <input type="checkbox" name="sendEmail" class="h-4 w-4 rounded border-slate-300 accent-brand-600" />
      <span class="text-sm text-slate-700">生成后立即把邀请链接发到上面的邮箱（需已配置 SMTP）</span>
    </label>
    <div class="flex justify-end">
      <button type="submit" class="rounded-lg bg-brand-600 px-5 py-2 text-sm font-medium text-white hover:bg-brand-700">生成邀请</button>
    </div>
  </form>
</section>

<!-- Existing invites -->
<section id="list" class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
  <h2 class="text-lg font-semibold text-slate-900 mb-4">已生成的邀请（<%= invites.length %>）</h2>
  <% if (!invites.length) { %>
    <p class="text-sm text-slate-500">还没有生成过邀请链接。</p>
  <% } else { %>
    <div class="-mx-5 sm:mx-0 overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="text-left text-xs uppercase tracking-wide text-slate-400 border-b border-slate-200">
            <th class="px-3 py-2 font-medium">状态</th>
            <th class="px-3 py-2 font-medium">邮箱 / 备注</th>
            <th class="px-3 py-2 font-medium">用量</th>
            <th class="px-3 py-2 font-medium">过期</th>
            <th class="px-3 py-2 font-medium">创建</th>
            <th class="px-3 py-2 font-medium text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% invites.forEach(function (inv) { const st = inviteState(inv); const url = baseUrl + "/register?invite=" + inv.token; %>
            <tr>
              <td class="px-3 py-3 align-top">
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= st.cls %>"><%= st.label %></span>
              </td>
              <td class="px-3 py-3 align-top">
                <div class="font-medium text-slate-800"><%= inv.email || "任意邮箱" %></div>
                <% if (inv.note) { %><div class="text-xs text-slate-400 mt-0.5"><%= inv.note %></div><% } %>
              </td>
              <td class="px-3 py-3 align-top text-slate-600"><%= inv.usedCount %> / <%= inv.maxUses %></td>
              <td class="px-3 py-3 align-top text-slate-600"><%= inv.expiresAt ? fmtDate(inv.expiresAt) : "永久" %></td>
              <td class="px-3 py-3 align-top text-slate-500"><%= fmtDate(inv.createdAt) %></td>
              <td class="px-3 py-3 align-top">
                <div class="flex flex-wrap items-center justify-end gap-2">
                  <% if (st.key === "active") { %>
                    <button type="button"
                            data-bwc-copy="<%= url %>"
                            class="rounded-md border border-slate-300 px-2.5 py-1 text-xs text-slate-700 hover:bg-slate-50">复制链接</button>
                    <form method="post" action="/admin/invites/<%= inv.token %>/email" class="inline-flex items-center gap-1">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <% if (!inv.email) { %>
                      <input type="email" name="to" required placeholder="发送到…" class="w-36 rounded-md border border-slate-300 px-2 py-1 text-xs focus:border-brand-500 focus:outline-none" />
                      <% } %>
                      <button type="submit" class="rounded-md border border-slate-300 px-2.5 py-1 text-xs text-slate-700 hover:bg-slate-50">发邮件</button>
                    </form>
                    <form method="post" action="/admin/invites/<%= inv.token %>/revoke" class="inline"
                          data-confirm="撤销后该链接立即失效，确定吗？" data-confirm-danger="1">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="rounded-md border border-rose-200 px-2.5 py-1 text-xs text-rose-600 hover:bg-rose-50">撤销</button>
                    </form>
                  <% } else { %>
                    <span class="text-xs text-slate-400">—</span>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('_nav_end') %>
