<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet for API calls. We don't request CHANGE_NETWORK_STATE or
         ACCESS_NETWORK_STATE because Retrofit + OkHttp don't need them
         for our use case. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera — needed only for the QR scan setup flow. We declare
         camera as NOT required so devices without a camera can still
         install the APP and use email/password login. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera"
                  android:required="false" />

    <!-- Calendar permissions — only needed when user enables "mirror to
         system calendar" feature. We request at runtime, not on install. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Notifications (Android 13+ requires runtime permission). We ask
         only when user enables "event start reminders" in settings. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Exact alarms — used by Reminders to schedule "N minutes before
         event start" notifications. Android 12+ treats this as a
         special permission the user grants via Settings → Apps →
         Special access → Alarms & reminders. If not granted, we fall
         back to setWindow() with a 60s tolerance which doesn't need
         this permission. USE_EXACT_ALARM (without "SCHEDULE_") is the
         Play Store-only variant — irrelevant for our APK distribution. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Cooperative scheduling — re-arming alarms after a reboot. The
         receiver also acts on boot completed to reschedule from the
         last cached events. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- In-app updater (v0.8). REQUEST_INSTALL_PACKAGES + the per-app
         "install unknown apps" toggle is what Android 8+ requires to
         hand off a downloaded APK to the system installer. We don't
         try to silent-install (impossible without system signature) —
         we just trigger the OS confirm dialog. User taps "安装" once
         per update. The "unknown sources" toggle is a one-time grant
         per app; subsequent updates skip that step.

         REQUEST_INSTALL_PACKAGES makes the Play Store reject the APK,
         which is fine — we ship via direct APK only. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- DownloadManager queries for in-progress / completed downloads. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:name=".BywaveApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.ByWaveCalendar"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ByWaveCalendar"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode">

            <!-- Standard launcher entry point. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- bywave:// URL scheme — server's pair-device QR codes
                 deep-link back into the APP via this. Mirrors iOS
                 CFBundleURLSchemes = "bywave". -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${appAuthRedirectScheme}" />
            </intent-filter>
        </activity>

        <!-- ReminderReceiver — fires when an AlarmManager pending intent
             lands. Materializes the saved-in-intent extras into a
             NotificationManagerCompat post. Not exported because the
             only sender is our own AlarmManager. -->
        <receiver
            android:name=".sync.ReminderReceiver"
            android:exported="false" />

        <!-- FileProvider — exposes the downloaded APK to the system
             package installer with a content:// URI. Android 7+ refuses
             file:// URIs in install intents; this is the canonical
             handoff path. Authority must match the one we build in
             ApkInstaller.kt (BuildConfig.APPLICATION_ID + ".fileprovider"). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
