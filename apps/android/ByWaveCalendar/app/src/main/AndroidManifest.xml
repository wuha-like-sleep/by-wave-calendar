<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet for API calls. We don't request CHANGE_NETWORK_STATE or
         ACCESS_NETWORK_STATE because Retrofit + OkHttp don't need them
         for our use case. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera — needed only for the QR scan setup flow. We declare
         camera as NOT required so devices without a camera can still
         install the APP and use email/password login. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera"
                  android:required="false" />

    <!-- Calendar permissions — only needed when user enables "mirror to
         system calendar" feature. We request at runtime, not on install. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Notifications (Android 13+ requires runtime permission). We ask
         only when user enables "event start reminders" in settings. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Exact alarms — used by Reminders to schedule "N minutes before
         event start" notifications. Android 12+ treats this as a
         special permission the user grants via Settings → Apps →
         Special access → Alarms & reminders. If not granted, we fall
         back to setWindow() with a 60s tolerance which doesn't need
         this permission. USE_EXACT_ALARM (without "SCHEDULE_") is the
         Play Store-only variant — irrelevant for our APK distribution. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 开机后重排提醒。AlarmManager 里的 PendingIntent 不跨重启，
         收不到这条广播 = 手机重启一次提醒全没了。真正的接收器是
         .sync.BootReceiver（见下面，必须 exported 才收得到系统广播）。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- In-app updater (v0.8). REQUEST_INSTALL_PACKAGES + the per-app
         "install unknown apps" toggle is what Android 8+ requires to
         hand off a downloaded APK to the system installer. We don't
         try to silent-install (impossible without system signature) —
         we just trigger the OS confirm dialog. User taps "安装" once
         per update. The "unknown sources" toggle is a one-time grant
         per app; subsequent updates skip that step.

         REQUEST_INSTALL_PACKAGES makes the Play Store reject the APK,
         which is fine — we ship via direct APK only. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- DownloadManager queries for in-progress / completed downloads. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:name=".BywaveApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.ByWaveCalendar"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ByWaveCalendar"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode">

            <!-- Standard launcher entry point. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- bywave:// URL scheme — server's pair-device QR codes
                 deep-link back into the APP via this. Mirrors iOS
                 CFBundleURLSchemes = "bywave". -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${appAuthRedirectScheme}" />
            </intent-filter>
        </activity>

        <!-- ReminderReceiver — fires when an AlarmManager pending intent
             lands. Materializes the saved-in-intent extras into a
             NotificationManagerCompat post. Not exported because the
             only sender is our own AlarmManager.
             ⚠️ 它**只**处理自己排的那个 PendingIntent：onReceive 拿不到
             事件标题就直接 return。开机广播不走这里，走下面的
             BootReceiver。 -->
        <receiver
            android:name=".sync.ReminderReceiver"
            android:exported="false" />

        <!-- BootReceiver — 开机 / 覆盖安装之后按 Room 缓存重排提醒。
             exported="true" 是必须的：BOOT_COMPLETED 和
             MY_PACKAGE_REPLACED 都是系统进程发过来的，不导出就收不到。
             它不接受任何来自外部的指令，onReceive 只认这几个 action，
             其余一律 return。 -->
        <receiver
            android:name=".sync.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- 部分国产 ROM 的「快速开机」发的是这个。 -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- FileProvider — exposes the downloaded APK to the system
             package installer with a content:// URI. Android 7+ refuses
             file:// URIs in install intents; this is the canonical
             handoff path. Authority must match the one we build in
             ApkInstaller.kt (BuildConfig.APPLICATION_ID + ".fileprovider"). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
