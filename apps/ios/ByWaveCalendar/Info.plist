<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>cn.bywave.calendar.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bywave</string>
			</array>
		</dict>
	</array>
	<!--
	UIBackgroundModes with remote-notification was removed for App Store
	v1.3.3 because aps-environment entitlement was also removed (server
	isn't sending APNs pushes yet). Re-add both together when re-enabling
	push. See ByWaveCalendar.entitlements for the full toggle checklist.
	-->
	<!--
	Languages this APP ships translations for. Required for iOS 16+ to
	expose the per-app language picker in Settings → ByWaveCalendar →
	Language. Without this key the picker is hidden even if .lproj
	bundles are present.
	-->
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hans</string>
		<string>zh-Hant</string>
		<string>en</string>
		<string>ja</string>
		<string>ko</string>
		<string>es</string>
		<string>fr</string>
		<string>de</string>
	</array>
	<!--
	Lets iOS mix-and-match resources across .lproj bundles so partial
	translations don't fall back to the development language wholesale.
	-->
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
	<!--
	Only standard HTTPS (ATS) is used — exempt from export compliance.
	Declaring it here skips the manual encryption questionnaire on
	every App Store Connect upload.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
