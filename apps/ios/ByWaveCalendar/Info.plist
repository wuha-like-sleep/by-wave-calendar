<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
    Minimal Info.plist — Xcode merges this with the auto-generated keys
    (NSCameraUsageDescription, NSCalendarsUsageDescription etc.) at
    build time via GENERATE_INFOPLIST_FILE=YES. We only need to provide
    the structured (non-string) values that can't be expressed as
    INFOPLIST_KEY_* build settings.
    -->

    <!--
    URL scheme registration. The /app/auth/native server endpoint
    redirects to bywave://auth/complete?code=…&state=… after a
    successful web login — this binding lets the OS deliver the URL
    back to the app via ASWebAuthenticationSession callback.
    -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>cn.bywave.calendar.auth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>bywave</string>
            </array>
        </dict>
    </array>

    <!--
    Silent push delivery wakes the APP in the background for ~30s to
    re-fetch events. Without this background-mode entitlement iOS
    drops content-available pushes when the APP isn't foregrounded.
    -->
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>
</dict>
</plist>
