<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
    Empty entitlements — APNs push capability removed for v1.3.3 App
    Store submission because the server isn't actually sending pushes
    (no APNs cert configured) and an unused capability invites reviewer
    questions. PushService.swift stays in place but its
    registerForRemoteNotifications call will now no-op via
    didFailToRegisterForRemoteNotificationsWithError — graceful.

    To re-enable later:
      - add back <key>aps-environment</key> with value "production"
      - re-tick "Push Notifications" on the App ID at
        developer.apple.com → Identifiers
      - restore UIBackgroundModes remote-notification in Info.plist
    -->
</dict>
</plist>
