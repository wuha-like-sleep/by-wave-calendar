# 宝塔面板里 "网站 → 设置 → 配置文件"，把 location / 段替换为下面这块。
# 也可以走 "反向代理" 功能并把目标地址填 http://127.0.0.1:3000
#
# ⚠️ 关键：CalDAV 用的是 PROPFIND / REPORT / MKCALENDAR / MKCOL / PROPPATCH
#    这些"非标准"HTTP 方法。宝塔默认 nginx 配置不一定会转发它们，
#    导致 iPhone / Mac 的「添加 CalDAV 帐户」一直转圈或报"无法验证账户"。
#    下面的配置显式允许并转发这些方法。
#
# ⚠️ 关键 2：X-Forwarded-For 必须用 $remote_addr，不能用 $proxy_add_x_forwarded_for。
#    Node 那边 .env 里对应的开关是 TRUST_PROXY，默认 loopback，也就是
#    「只认本机回环转发来的 X-Forwarded-For」——本文件这种 proxy_pass 到
#    127.0.0.1:3000 的部署不用改 .env，开箱即用。
#    如果 nginx 和 Node 不在同一台机器（或在不同容器里），把 nginx 那一侧的
#    地址/网段填进 TRUST_PROXY，例如 TRUST_PROXY=10.8.0.0/24 或 uniquelocal；
#    否则 req.ip 会恒等于 nginx 的地址，所有访客共用一个限流桶。

location / {
    # 显式允许 CalDAV / WebDAV 方法。如果宝塔上层的 server 块带
    # limit_except 或 if 拒绝未知方法，CalDAV 客户端拿到 405。
    # nginx 不会阻止这些方法，但有些"安全加固"配置会。
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;

    # ⚠️ 这里是 $remote_addr，不是 $proxy_add_x_forwarded_for —— 别改回去。
    #
    # $proxy_add_x_forwarded_for 的含义是「把客户端发来的 X-Forwarded-For 原样
    # 留着，再把真实对端地址追加到末尾」。追加，不是覆盖。于是客户端自己发一个
    #     X-Forwarded-For: 9.9.9.9
    # 过来，nginx 转给 Node 的就变成
    #     X-Forwarded-For: 9.9.9.9, <真实地址>
    # 伪造值排在真实地址**前面**。上游只要有一个环节按「最左边那项是客户端」
    # 来取（这是 X-Forwarded-For 的通用读法），拿到的就是 9.9.9.9。
    # 那是 1.6.x 之前的行为：当时服务端对 X-Forwarded-For 是「整条链都信」，
    # 于是取到最左边的伪造值 —— 限流每次换一个伪造值连打一次都挡不下来，
    # 审计日志和登录历史的 ip 列记的也是攻击者自己填的字符串。
    #
    # ⚠️ 现在**不是**这样了，别照着上面那段去吓唬人：服务端默认
    # TRUST_PROXY=loopback，只认「从本机回环转发进来的那一跳」，从右往左解析，
    # 伪造值排在左边够不到。实测 "9.9.9.9, 203.0.113.7" 取到的是 203.0.113.7。
    # 也就是说**老配置（$proxy_add_x_forwarded_for）升级后一样是安全的，
    # 站长不需要为了安全去改生产 nginx**。
    #
    # 这里仍然写 $remote_addr，是因为它更干净：这台 nginx 是整条链路上第一个
    # 见到真实 TCP 对端的人，覆盖写入让链条只有一项，少一层要解析的东西。
    # 但这是「新装机器照这个抄」，不是「已经在跑的必须改」。
    #
    # 例外：如果 nginx 前面还有一层你信任的 CDN（Cloudflare 等），那这里要保留
    # CDN 传来的链条，改成 $proxy_add_x_forwarded_for，同时把 CDN 的回源网段
    # 填进 .env 的 TRUST_PROXY（如 TRUST_PROXY=loopback,173.245.48.0/20）。
    # 两件事必须一起做——只做前一件就等于把伪造权还给客户端。
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        "upgrade";

    # 这一项决定「后台能不能传大文件」，而且**拦下来的是 nginx 不是本程序**：
    # 超过之后 nginx 自己回一个 HTML 413 并切断连接，浏览器只看到一个
    # 没头没尾的失败，Node 那边一行日志都没有、审计表里也没有记录 ——
    # 很容易被误判成「后台上传功能坏了」而去改代码。
    #
    # 三个用得上的地方，按大小排：
    #   · 后台「客户端更新」传安装包 —— DMG 约 110MB，上限 300MB
    #   · 后台「系统更新」传发版包   —— 目前约 2MB，上限 100MB
    #   · CalDAV REPORT（一次拉一个月的事件 multiget）—— 几 MB
    # 320m 覆盖上面全部并留了余量。**这里以前写的是 10m**，也就是说
    # 照本文件部署的站，连 100MB 的系统更新上传都从来没能成功过。
    client_max_body_size       320m;
    client_body_buffer_size    1m;

    # 大文件上传必须关掉请求体缓冲。默认 on 的话 nginx 会先把整个 110MB
    # 落到自己的临时目录、收完才转发给 Node —— 磁盘写两遍，而且上传进度条
    # 会在 100% 之后再干等一段时间（那段时间是 nginx 在转发）。
    proxy_request_buffering     off;

    # CalDAV REPORT 在大日历上可能需要几秒响应；默认 60s 在网络不稳
    # 的时候够用，但留点余地。
    # send_timeout 对上传尤其重要：110MB 在慢连接上要传好几分钟，
    # 120s 会在传到一半时直接断开。
    proxy_read_timeout         600s;
    proxy_send_timeout         600s;
    proxy_connect_timeout      10s;

    # 关掉响应 buffering 让 push 通知（SSE）和长响应能流式送出
    proxy_buffering            off;

    # 给浏览器和 iOS Calendar 一个机会复用 TCP 连接 —— 没有 keep-alive
    # 时每个 CalDAV 请求都要重连 + TLS 握手，10-20 个请求 = 慢得吓人。
    keepalive_timeout          65s;
    keepalive_requests         1000;
}

# 给 ICS 订阅设置一个友好的 CORS / 缓存头（可选）
location ~ ^/ics/ {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    # 这一段同样要转发真实地址：漏了的话订阅请求在 Node 眼里全是 127.0.0.1，
    # 会挤在同一个限流桶里互相把对方顶成 429。理由同上，用 $remote_addr。
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header Access-Control-Allow-Origin * always;
}

# ===== 推荐做法：让 Node 直接监听 443/80，绕过 nginx =====
# .env 里设 USE_HTTPS=true，让 Node 直接拿端口。
# 然后在宝塔站点设置里把 nginx 监听关掉（或改到其他端口）。
# CalDAV WebDAV 方法转发的问题就根本不存在 —— 因为没人挡在中间。
#
# 走这条路径时 .env 里设 TRUST_PROXY=off：没有反向代理，谁发来的
# X-Forwarded-For 都不该被采纳，req.ip 直接就是 TCP 对端地址。
#
# install.sh 默认就是这条路径；推荐生产环境用这个。
