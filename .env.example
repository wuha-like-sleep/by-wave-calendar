# Server
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Database
DATABASE_URL=postgres://calshare:calshare_dev@127.0.0.1:5432/calshare_dev

# Session cookie signing secret (generate: openssl rand -base64 48)
SESSION_SECRET=change-me-in-production-please-this-must-be-long-enough

# Allow public self-registration. Set to false to lock down to invite-only / admin-only.
REGISTRATION_OPEN=true

# Rate limit (requests per minute per IP)
RATE_LIMIT_GLOBAL_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10

# SSRF guard escape hatch. Outbound fetches of USER-SUPPLIED URLs (ICS
# subscriptions / one-shot URL imports, and — defense-in-depth — outbound
# webhooks) are blocked from reaching private / loopback / link-local /
# reserved IP ranges (e.g. 127.0.0.1, 169.254.169.254 cloud metadata,
# 10/8, 192.168/16). Leave this false unless you genuinely need to pull an
# ICS feed from an internal host on a trusted network. Protocol (http/https
# only) and embedded-credential checks always apply regardless.
ICS_ALLOW_PRIVATE_NETWORK=false

# HTTPS direct-listen (skip nginx reverse proxy).
# Set USE_HTTPS=true in production. HTTPS_CERT_PATH / HTTPS_KEY_PATH must point to
# the Let's Encrypt cert files generated by 宝塔 (typical path below).
# Cert files are hot-reloaded via fs.watch — no restart needed when 宝塔 renews them.
USE_HTTPS=false
HTTPS_PORT=443
HTTP_REDIRECT_PORT=80
HTTPS_CERT_PATH=/www/server/panel/vhost/cert/rl.lz-ss.com/fullchain.pem
HTTPS_KEY_PATH=/www/server/panel/vhost/cert/rl.lz-ss.com/privkey.pem

# SMTP — 用于邮箱验证码 / 登录提醒 / 邀请邮件。
# 建议在管理员后台 /admin 配置（DB），这里只是首次启动的初始化值（可留空）。
# 留空 SMTP_HOST + DB 也无配置 → 邮件功能停用，验证码退化为打到服务器日志（仅 dev）。
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ByWave-Calendar

# 站点名（默认 ByWave-Calendar）—— 管理员后台上传 logo 后这个一并改名
SITE_NAME=ByWave-Calendar

# 中国大陆 ICP 备案号 —— 留空不显示。仅 lz-ss.com 这种已备案的域名填写。
# ICP_NUMBER=沪ICP备2021023412号-2
# ICP_URL=https://beian.miit.gov.cn/

# Optional: pre-create initial admin (used by deploy/bt-panel/install.sh)
# If both set, scripts/create-admin.ts runs non-interactive.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# 反向代理信任。决定「访客的来访地址」从哪里取 —— 限流、审计日志、登录历史、
# 人机验证都按它计数。
#
#   loopback（默认）  nginx 和本程序装在同一台机器上（宝塔的标准装法）。不用改。
#   off              本程序直接监听 443、前面没有反向代理。
#   <地址或网段>      nginx 装在另一台机器 / 另一个容器里，或者前面套了 CDN。
#                    例：TRUST_PROXY=loopback,173.245.48.0/20
#
# ⚠️ 分离部署的站点不填这一项，所有访客会被算成同一个人共用一个访问频率额度，
#    访问量不大就会开始随机拒绝请求，而且后台看不出来。
# ⚠️ 不接受 true / all / 0.0.0.0/0（那等于谁都能自称任何地址），也不接受
#    写跳数（本程序用的库不支持，会静默把所有人记成同一个地址）。启动时会直接报错。
TRUST_PROXY=loopback
