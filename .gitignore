node_modules
dist
.env
.env.local
.env.*.local
*.log
.DS_Store
release/
drizzle/migrations/meta/_journal.json.bak

# Update-signing keys. The PRIVATE ed25519 key lives ONLY at
# ~/.bywave-update/update-ed25519-private.pem (outside the repo, chmod 600)
# and must never be committed. These patterns are a belt-and-suspenders
# guard against a stray key file landing inside the repo. The one PEM we DO
# ship is the PUBLIC key at deploy/update-signing-pub.pem — explicitly
# un-ignored below so it stays committed.
*.pem
*.key
*-private.pem
!deploy/update-signing-pub.pem

# Build outputs (regenerated by `npm run build:assets`)
src/public/lib/
src/public/css/styles.css
src/public/_built/

# User-uploaded files
src/public/uploads/

# Runtime data — Android release manifest + APK files served by
# /api/app/android/latest and /downloads/android/*.apk. Deploy admin
# drops files into <projectRoot>/data/ ; never committed.
# Anchored to repo root (leading slash) — otherwise this would also
# eat apps/desktop/src/.../data/ which is Kotlin source code.
/data/

# Native APP starter source. Android + desktop kept local until they
# reach the same maturity as iOS; uncomment when they're ready to push.
# apps/android/
# apps/desktop/
.claude/

# iCloud 同步产生的重复文件（~/Desktop 在 iCloud 里，会生成 "xxx 2.css" 这种）。
# 它们不匹配上面按确切文件名写的忽略规则，曾经被误提交过一次。
*\ [0-9].css
*\ [0-9].js
*\ [0-9].ts
*\ [0-9].json
*\ [0-9].ejs
